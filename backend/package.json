{
  "name": "entegrasyonik",
  "version": "1.0.0",
  "description": "Entegrasyonik",
  "main": "dist/entegrasyonik.js",
  "scripts": {
    "herokubuild": "npm run build && ncc build dist/entegrasyonik.js -o dist --external sharp",
    "build": "rimraf dist/ && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "forceBuild": "npm run build",
    "start": "npm run build && node dist/entegrasyonik.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint entegrasyonik.ts src tests",
    "format:check": "prettier --check",
    "depcruise": "depcruise --config .dependency-cruiser.cjs entegrasyonik.ts src",
    "knip": "knip --no-progress",
    "ratchet": "node quality/check-ratchets.js",
    "ratchet:update": "node quality/check-ratchets.js --update",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:integration": "jest --testPathIgnorePatterns __none__ --testPathPattern tests/integration",
    "verify": "npm run typecheck && npm run lint && npm run test:cov && npm run ratchet",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "start:local": "npm run build && node -r ./dev-tools/egress-guard.js dist/entegrasyonik.js",
    "seed:plans": "node dev-tools/seed-plans.js",
    "migrate:legacy-subscriptions": "node dev-tools/migrate-legacy-tenants-to-subscriptions.js",
    "migrate:trendyol-urls": "node dev-tools/migrate-trendyol-integration-urls.js",
    "license-check": "npx --yes license-checker --production --summary --excludePrivatePackages",
    "capabilities:docs": "npm run build && node dev-tools/capabilities-docs.js",
    "config:drift-scan": "npm run build && node dev-tools/config-drift-scan.js",
    "migrate:integration-config": "npm run build && node dev-tools/migrate-integration-config.js"
  },
  "author": "Duygu Emre Yalçınkaya",
  "license": "ISC",
  "workspaces": [],
  "bin": {
    "runapp": "dist/entegrasyonik.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.637.0",
    "@mongodb-js/zstd": "^1.2.0",
    "@rollup/plugin-json": "^6.1.0",
    "@types/bcrypt": "^6.0.0",
    "archiver": "^7.0.1",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.0",
    "bullmq": "^5.73.0",
    "cockatiel": "^3.2.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.1",
    "gcp-metadata": "^5.3.0",
    "helmet": "8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "kerberos": "^2.1.2",
    "lodash": "^4.17.23",
    "lru-cache": "^10.4.3",
    "mongodb": "^6.4.0",
    "mongodb-client-encryption": "^6.1.0",
    "mongoose": "^8.6.4",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^8.0.4",
    "pino": "10.3.1",
    "sharp": "^0.32.3",
    "snappy": "^7.2.2",
    "string-similarity": "^4.0.4",
    "typescript": "^5.3.3",
    "uuid": "^8.3.2",
    "webpack-node-externals": "^3.0.0",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@jest/globals": "^29.7.0",
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@types/archiver": "^6.0.4",
    "@types/compression": "^1.7.2",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.14",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/lodash": "^4.17.24",
    "@types/multer": "^1.4.12",
    "@types/nodemailer": "^7.0.11",
    "@types/string-similarity": "^4.0.2",
    "@types/uuid": "^8.3.2",
    "@types/xml2js": "^0.4.14",
    "dependency-cruiser": "18.4.0",
    "eslint": "9.39.5",
    "jest": "^29.7.0",
    "knip": "6.38.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "3.9.9",
    "rimraf": "^6.0.1",
    "rollup": "^4.21.0",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.5.1",
    "tsc-alias": "^1.8.16",
    "typescript-eslint": "8.70.1",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  }
}
