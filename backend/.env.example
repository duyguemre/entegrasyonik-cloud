# Örnek dosya — gerçek değerler .env içinde tutulur (git-ignored)
LOCAL_DB_URL=
LOCAL_DB_USER=
LOCAL_DB_PASSWORD=
LOCAL_DB_NAME=
DB_URL=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_SIZE=20
# ADR-0021 D8 / DB-08: mongoose autoIndex. Bos = ortama gore (APP_ENV=local: true, mevcut davranis; staging/production: false).
# staging/production'da false: indeksler yalniz onayli goc (backend/migrations) ile kurulur; yeni tenant provizyonu createIndexes calistirir.
# UYARI: staging/production'a bu surumu cikarmadan ONCE indeks gocleri calistirilmis olmali (autoIndex kapaninca yeni tanimlanan indeksler kendiliginden kurulmaz).
DB_AUTO_INDEX=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
# ADR-0006 Karar 3: web|worker|all (varsayılan all — bugünkü tek-instance davranış). `RUN_WORKERS_EMBEDDED`
# KALDIRILDI (koddan hiç okunmuyordu). "web" -> yalnızca API (+ /health /ready); "worker" -> yalnızca
# IntegrationEngine (+ /health /ready için minimal ayrı sunucu, tam API YOK); "all" -> ikisi.
APP_ROLE=all
NODE_ENV=development
# ADR-0017 §10: local|staging|production. Tanımsızsa NODE_ENV=production -> "production", aksi "local" (uyarı loglanır;
# staging'i doğru sınıflandırmak için AÇIKÇA ayarlayın — egress guard/e-posta yönlendirmesi buna bakar).
APP_ENV=local
# ADR-0017 Karar 1.3/1.7: trace|debug|info|warn|error|fatal|silent (tanımsızsa üretimde info, yerelde debug).
LOG_LEVEL=debug
# json (varsayılan; pino) | legacy (geri alma anahtarı — eski console davranışı).
LOG_FORMAT=json
# ADR-0026 WP-LOG L1: kalici log deposu (LogEvents; TTL 14 gun, info/debug 3 gun). Varsayilan KAPALI (sifir maliyet).
# Acmadan once LogEvents koleksiyonu/indeksleri migrations/0005 ile (onayli goc) olusturulmus olmalidir.
LOG_PERSIST_ENABLED=false
# Kalici en dusuk seviye (debug|info|warn|error); altindaki info/debug kayitlari LOG_PERSIST_SAMPLE_INFO yuzdesiyle orneklenir.
LOG_PERSIST_LEVEL=warn
LOG_PERSIST_SAMPLE_INFO=5
# ADR-0006 Karar 4 / ADR-0017: pod/instance kimliği (çoklu-pod lider/lease ayrımı, log alanı `pod`). Boşsa hostname:pid.
POD_NAME=
SERVER_NAME=
SERVER_CONTEXT=/api
SERVER_HOST=
SERVER_PORT=5001
SERVER_TIMEOUT_SEC=30
IMAGE_FILES_PATH=products/
CORS_ORIGINS=http://localhost:3020,http://127.0.0.1:3020,http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.111:3000,https://entegrasyonik.onrender.com,https://entegrasyonik-production.up.railway.app,https://entegrasyonik.com,https://app.entegrasyonik.com,https://www.entegrasyonik.com,app://.,http://localhost:4173,http://localhost:8081,http://localhost:8082
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
CORS_CREDENTIALS=true
# ADR-0027: oturum çerezi SameSite (lax|strict|none). Boş = eski davranış (development: lax, diğer: none).
# app.<alan> + api.<alan> aynı site olduğundan hedef düzende `lax` (Render/onrender.com gibi çapraz site origin emekliye ayrılınca).
SESSION_COOKIE_SAMESITE=
# ADR-0026 Karar 4 (backoffice `/admin-api`): AYRI CORS listesi (virgullu; CORS_ORIGINS ile KESISEMEZ -- kesisirse surec baslamaz;
# '*' kabul edilmez). Ornek: https://admin.entegrasyonik.com,http://localhost:3100. Bos = hicbir origin izinli degil (/admin-api tarayicidan kullanilamaz).
ADMIN_CORS_ORIGINS=
# Opsiyonel IP allowlist (virgullu IPv4/IPv6 ya da IPv4 CIDR; bos = kapali). IP, TRUSTED_PROXY_HOPS ile cozulen istemci IP'sidir.
ADMIN_IP_ALLOWLIST=
# Asama 3 sonunda true yapilacak: /api uzerinde platformAdmin yetenekleri + ga girisi + selectStore kapanir (yalniz /admin-api). Varsayilan false.
ADMIN_API_ONLY=false
# C19: mock modu FAIL-CLOSED — *_MOCKABLE_ENDPOINTS listesinde olmayan endpoint (veya bos liste) gercek adrese GITMEZ, NOT_SUPPORTED/MOCK_ENDPOINT_NOT_MOCKED hatasi verir.
TY_MOCK_MODE=true
TY_MOCK_BASE_URL=
TY_MOCKABLE_ENDPOINTS=inventory/sellers,products/sellers,product/sellers,products/batch-requests,batch-requests,price-and-inventory,order,claims,finance,qna,sellers
PAZARAMA_MOCK_MODE=true
PAZARAMA_MOCK_BASE_URL=
PAZARAMA_MOCKABLE_ENDPOINTS=product,order,finance,claim,qna,listing-state,QuestionAnswer
N11_MOCK_MODE=true
N11_MOCK_BASE_URL=
N11_MOCKABLE_ENDPOINTS=ws/OrderService.wsdl,ws/ProductService.wsdl,ws/ReturnService.wsdl,ws/SellerInvoiceService.wsdl,ws/SettlementService.wsdl,ws/ShipmentCompanyService.wsdl,ws/ShipmentService.wsdl,ms/product,ms/product-query,ms/product/tasks/product-create,ms/product/tasks/price-stock-update,ms/product/tasks/product-update,ms/product/task-details/page-query,cdn/categories,cdn/category
HEPSIBURADA_MOCK_MODE=true
HEPSIBURADA_MOCK_BASE_URL=
HEPSIBURADA_MOCKABLE_ENDPOINTS=rest/delivery/v1/shipmentPackages,product/api/products/all-products-of-merchant,suppliers,product/api/products/import,product/api/products/status,product/api/products/check-product-status,listings,ticket-api
IDEASOFT_MOCK_MODE=true
IDEASOFT_MOCK_BASE_URL=
BIZIMHESAP_MOCK_MODE=true
BIZIMHESAP_MOCK_BASE_URL=
JWT_SECRET=
JWT_SECRET_PREVIOUS=
JWT_ISSUER=entegrasyonik
# ADR-0001 adım 7: login/register süreç-içi IP rate limit (varsayılan 10 istek / 60 sn / IP)
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000
# ADR-0003 A.4: register IP başına kayıt sınırı (varsayılan 3 kayıt / 3600000 ms = 1 saat / IP; login'den ayrı kova)
REGISTER_RATE_LIMIT_MAX=3
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
# Hesap yaşam döngüsü (docs/API_ACCOUNT_LIFECYCLE.md): parola sıfırlama / e-posta doğrulama bağlantılarının tabanı. https zorunlu (yalnızca localhost için http).
# Tanımsızsa süreç BAŞLAR ama bu uçlar 503 EMAIL_NOT_CONFIGURED döner + log (fail-fast değil). SMTP: ZOHO_SMTP_*/FROM_* (aşağıda; src/services/mail/MailService.ts okur).
PUBLIC_APP_URL=
# E-posta (SMTP) — yalnızca değişken adları; değerler .env içinde tutulur (git-ignored)
ZOHO_SMTP_HOST=
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
FROM_EMAIL=
FROM_NAME=
# Parola sıfırlama isteği rate limit: IP+e-posta başına (varsayılan 3/saat), IP başına (varsayılan 10/saat); token onayı/e-posta doğrulama IP başına (20 / 10 dk)
PASSWORD_RESET_RATE_LIMIT_MAX=3
PASSWORD_RESET_RATE_LIMIT_IP_MAX=10
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=3600000
ACCOUNT_TOKEN_RATE_LIMIT_MAX=20
ACCOUNT_TOKEN_RATE_LIMIT_WINDOW_MS=600000
# X-Forwarded-For güveni: 0 = güvenme (varsayılan). Güvenilir ters vekil sayısı (ör. Railway/Render arkasında 1) yazılırsa sağdan N. adres kullanılır
TRUSTED_PROXY_HOPS=0
# ADR-0017 §10 "Rate limiting": genel API için kimlik-anahtarlı gevşek sınır (tek replika varsayımı; web pod >= 2 -> Redis).
GLOBAL_RATE_LIMIT_ENABLED=true
GLOBAL_RATE_LIMIT_MAX=600
GLOBAL_RATE_LIMIT_WINDOW_MS=60000

# ADR-0003 C.10 (adım 6): tenant sırları için alan şifreleme (AES-256-GCM). YALNIZCA değişken adları; değerleri insan üretir (Protokol 12).
# FIELD_ENCRYPTION_KEYS biçimi: virgülle ayrılmış "kid:base64(32 bayt)" çiftleri (kid: [A-Za-z0-9_-], en fazla 32 karakter). Örn. biçim: k1:<base64>,k2:<base64>
# Anahtar üretimi: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Tanımsız/geçersizse süreç BAŞLAMAZ. Rotasyon: yeni kid ekle + aktif yap -> migrate-encrypt-integration-secrets.js --rotate -> eski kid'i kaldır.
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_ACTIVE_KID=
# ADR-0003 B.6 (adım 5): tenant DB bağlantısı DB_URL/DB_USER/DB_PASSWORD'dan kurulur (Clients.dbConfig yalnızca dbname/poolsize).
# DB_URL `{{DBNAME}}` (ve isteğe bağlı {{USER}}/{{PASSWORD}}) yer tutucusu içerebilir; içermiyorsa yol kısmındaki DB adı tenant'ınkiyle değiştirilir.
# ADR-0013 B2: Atlas'ta uygulama kullanıcısına tanımlanan özel rolün kapsadığı üst tenant numarası; boşsa sınır uygulanmaz.
TENANT_DB_ROLE_MAX=
# ADR-0003 B.8 (adım 5): R2 depolama (tenant kaydından değil, yalnızca env'den). Anahtar yalnızca iki bucket'a yetkili kapsamlı token olmalı.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET_IMAGE=
R2_BUCKET_ARCHIVE=
# ADR-0031: görsel URL tabanının TEK kaynağı (config.images). Boşsa eski kök (images.entegrasyonik.com) kullanılır; production/staging'de uyarı loglanır.
R2_PUBLIC_URL_IMAGE=
R2_PUBLIC_URL_ARCHIVE=
# ADR-0027: tarayıcıdan doğrudan R2'ye imzalı PUT ile ürün görseli yükleme. R2_PUBLIC_URL_IMAGE üretimde https://cdn.<alan> olmalı
# (pazaryerlerine giden URL'ler bundan üretilir). Tavan (bayt, üst sınır 25 MB; varsayılan 10 MB), imza ömrü (sn, üst sınır 900; varsayılan 300).
IMAGE_UPLOAD_MAX_BYTES=
IMAGE_UPLOAD_URL_TTL_SEC=
# Cloudflare Image Transformations cdn. alanında AÇIK ise true (varsayılan false: boyutlandırma URL'i = orijinal URL).
IMAGE_TRANSFORMATIONS_ENABLED=false

# ADR-0008 Aşama A: ödeme sağlayıcısı seçimi. Yalnızca "mock" desteklenir (iyzico adaptörü AYRI bir görev).
# PAYMENT_ENV=live hiçbir kod yolunda kullanılmıyor (yalnızca gelecekteki iyzico adaptörü için ayrılmış) --
# "live" insan onayı olmadan hiçbir ortamda ayarlanmaz (ADR §1).
PAYMENT_PROVIDER=mock
PAYMENT_ENV=sandbox
# MockPaymentProvider webhook imzası (HMAC-SHA256) için sır; gerçek/production sırla AYNI OLMAMALI. En az 16 karakter.
# Anahtar üretimi: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BILLING_MOCK_HMAC_SECRET=
# ADR-0008 §4: webhook rotası IP/istek rate limit'li (varsayılan 60 istek / 60 sn / IP; login/register'dakinden ayrı kova)
BILLING_WEBHOOK_RATE_LIMIT_MAX=60
BILLING_WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
# ADR-0014 S4a: mock hosted checkout sayfası (/api/billing/mock-checkout/*) ve dev tetikleyici (/api/billing/mock/simulate).
# YALNIZCA PAYMENT_PROVIDER=mock + PAYMENT_ENV!=live + NODE_ENV!=production iken yanıt verir (aksi 404). Token/imza aynı
# BILLING_MOCK_HMAC_SECRET ile (alan ayrımlı). Boş bırakılırsa taban adres http://localhost:<SERVER_PORT|5001>.
MOCK_CHECKOUT_BASE_URL=
# İsteğe bağlı: ödeme sonucu sayfasındaki "Uygulamaya dön" bağlantısı (yalnızca http/https; boşsa bağlantı gösterilmez)
MOCK_CHECKOUT_RETURN_URL=
MOCK_CHECKOUT_RATE_LIMIT_MAX=30
MOCK_CHECKOUT_RATE_LIMIT_WINDOW_MS=60000
# ADR-0008 / ADR-0014 S4a: plan seed'i (npm run seed:plans) yalnızca dry-run'da yazmaz; --apply için doğrulanmış yedek beyanı:
# SEED_PLANS_BACKUP_CONFIRMED=yes   (backup/README.md; CLAUDE.md kural 3 -- yalnızca izinli DB'ler, varsayılan yalnızca local 127.0.0.1)
# ADR-0008 §3: EntitlementService.checkAccess guard'ının API katmanına (RunOperation.ts) ve IntegrationEngine iş
# planlayıcısına (Dispatcher/OrderQueueProducer) bağlanmasını açar. Varsayılan false (KAPALI) -- PRODUCTION'da AÇILMADAN
# ÖNCE legacy migration (npm run migrate:legacy-subscriptions --apply) çalışmış OLMALI ve insan onayı gerekir (Protokol 12).
ENTITLEMENT_GUARD_ENABLED=false

# ADR-0028 WP-A3: authenticate yetki kaynagi. legacy (varsayilan: Users alanlari) | dual (karar legacy'ye gore; Memberships
# okunur, sapma `authz.divergence` / eksik uyelik `membership.fallback` metrigi) | membership (karar Memberships'ten; uyelik
# yok/askida -> 403). Gecis: legacy -> dual (K1) -> 14 gun sapma=0 -> membership (K3). Degisim surec yeniden baslatmasi ister.
MEMBERSHIP_SOURCE=legacy
# Kimlik onbellegi TTL (ms; varsayilan 5000, 0 = kapali/her istek okur). Cok pod'da iptal gecikmesinin ust siniri budur.
# AUTH_IDENTITY_CACHE_TTL_MS=5000

# [F-12] Ürün Excel dışa aktarma satır (varyant) tavanı (varsayılan 20000; aşılırsa kullanıcıya filtre daraltma uyarısı döner).
# EXPORT_EXCEL_MAX_ROWS=20000

# ADR-0016 §2.2: platform/runtime/scheduler -- iş başına Mongo lease. Kaçış anahtarı; YALNIZ acil durumda "off".
SCHEDULER_LEASE=on
# ADR-0016 §2.4 / MM-14: ExportOrchestrator boşta uyku üst sınırı (15 sn varsayılan; web->worker sinyal kaybına DB yoklama yedeği).
EXPORT_IDLE_POLL_MS=15000

# ADR-0018 Karar 2b (Aşama B): aktif probe canlı mod kapısı. Varsayılan false -- probe YALNIZ kayıtlı fikstürlerle
# (replay) koşar, gerçek ağ isteği ATMAZ. "true" yapmak İNSAN KARARIDIR (platform düzeyi test hesapları gerekir,
# Karar 6 #3); mock modu açık bir entegrasyonla aynı anda "true" ise süreç fail-fast reddeder.
PROBES_LIVE=false
# ADR-0018 Karar 2c (Aşama B): haftalık kaynak izleyici (SourceMonitor) kapısı. Varsayılan false -- açıldığında
# descriptor.api.docs[].monitor==='auto' URL'lerine GERÇEK (dış web sayfası, kimlik bilgisi içermeyen) haftalık istek atar.
SOURCE_MONITOR_ENABLED=false
SOURCE_MONITOR_USER_AGENT=Entegrasyonik-SourceMonitor/1.0 (+https://entegrasyonik.com; kaynak-izleme, robots.txt uyumlu)

# ADR-0020 Karar 3.2/9.1 (Aşama B): platform ayar yayınında iki kişi kuralı. Varsayılan false -- tek platformAdmin
# varken açılırsa HİÇBİR "dangerous" değişiklik yayınlanamaz (Karar 9.1). Yerine gerekçe + yazılı onay + denetim +
# tek tık geri alma kullanılır. Açılma eşiği: aktif platformAdmin sayısı >=2 ve ekip dışı erişim, ya da bir olay.
TWO_PERSON_RULE_ENABLED=false

# ADR-0029 bildirim sistemi (varsayilan KAPALI; acmak insan karari: S1 DB kapisi, S2 canli SMTP)
NOTIFY_V2_ENABLED=false
NOTIFY_EMAIL_ENABLED=false

# ADR-0029 NB5/NB6 bildirim akisi/abonelik (hepsi istege bagli; varsayilanlar guvenli). Gercek sir BURAYA yazilmaz.
# NOTIFY_STREAM_ENABLED=true            # false: SSE bildirim zili kapali
# NOTIFY_STREAM_MAX_PER_USER=5          # kullanici basina en fazla acik SSE baglantisi
# NOTIFY_STREAM_MAX_TOTAL=2000          # surec basina toplam SSE baglantisi
# REALTIME_BUS=                         # 'redis': Redis pub/sub (coklu pod); bos: yerel bus
# PUBLIC_API_URL=                       # abonelikten cikma baglantisi API origin'i (bos: PUBLIC_APP_URL)
# NOTIFY_UNSUB_SECRET=                  # SIR: abonelik belirteci HMAC anahtari; e-posta acilacaksa zorunlu (yalniz .env)
# ALERT_EVALUATOR_ENABLED=false         # ADR-0017 Asama C / NB8: platform alarm degerlendiricisi (once migrations/0017 uygulanmali)
# ALERT_SHADOW_UNTIL=                   # ISO tarih (ornek 2026-10-20T00:00:00Z): bu tarihe dek yalniz kayit, bildirim/e-posta YOK (14 gun golge mod)
# ALERT_EMAIL_TO=                       # platform alarm alicilari (virgulle ayrik); bos = yalniz backoffice Uyarilar paneli

# MOB-04 web push (istege bagli). UCU de dolu ve gecerliyse kanal acilir; biri eksikse kanal KAPALI (surec yine baslar).
# Uretim: `npx web-push generate-vapid-keys` (docs/NOTIFICATION_PLAN.md "Web push yerel kurulum"). Anahtar ciftini DEGISTIRMEK tum abonelikleri gecersiz kilar.
# WEBPUSH_VAPID_PUBLIC=                 # base64url, 65 bayt (FE'ye getPushConfig ile verilir; sir degil)
# WEBPUSH_VAPID_PRIVATE=                # SIR: base64url, 32 bayt (yalniz .env)
# WEBPUSH_VAPID_SUBJECT=                # mailto:ops@ornek.com ya da https://... (push servisi iletisim adresi)
# EGRESS_ALLOW_WEBPUSH=1                # yalniz yerel `start:local`: egress guard push servis alan adlarina (FCM/Mozilla/Apple/WNS) izin verir

# [ADR-0030 X3] Idempotency-Key kipi: observe (varsayilan, yalnizca olcer/loglar) veya enforce (FE anahtar uretimi yayina alininca)
IDEMPOTENCY_ENFORCE=observe

# LIVE-RO canli salt-okuma kipi (docs/LIVE_READONLY.md). `npm run start:live-readonly` LIVE_READONLY=1'i kendisi kurar; elle acmak icin egress guard SARTTIR.
# LIVE_READONLY=true: yazan isciler/zamanlayicilar baslamaz, dis-etkili yazma RPC'leri 423 LIVE_READONLY doner, DB_URL yerel degilse surec baslamaz.
LIVE_READONLY=false
# Virgullu adaptor kodlari (orn. ideasoft): bu kipte OAuth token YENILEMESINE izin verir. Ideasoft refresh_token dondurur -> uretimle paylasilan baglantiyi bozabilir. Varsayilan: bos (kapali).
LIVE_READONLY_ALLOW_TOKEN_REFRESH=

# --- ADR-0034 sohbet aracisi (BR-1) ---
# AGENT_LLM_SCRIPTED=false             # true: sahte (scripted) LLM, yalniz yerel/test; production'da surec baslamaz

# --- ADR-0035 / MCP-1 uzak MCP + OAuth yetkilendirme sunucusu (varsayilan KAPALI; degerler yalniz .env'de) ---
# MCP_ENABLED=false                    # true: /oauth/* ve /.well-known/* acilir; JWT_OAUTH_SECRET + PUBLIC_API_URL + PUBLIC_APP_URL zorunlu (yoksa surec baslamaz)
# JWT_OAUTH_SECRET=                    # >=32 bayt; web JWT_SECRET'ten AYRI (ADR-0010 madde 8). Uretimde MCP acilacaksa zorunlu; rotasyon: eskisini _PREVIOUS'a tasi
# JWT_OAUTH_SECRET_PREVIOUS=
# MCP_RESOURCE_URI=                    # bos: ${PUBLIC_API_URL}/mcp (token `aud`'u, RFC 8707/9728)
# MCP_ALLOWED_ORIGINS=                 # /mcp icin ek izinli Origin'ler (virgulle); varsayilan CORS_ORIGINS + PUBLIC_APP_URL. Origin basligi yoksa denetim yok
