{
  "name": "client",
  "version": "1.0.0",
  "main": "main.js",
  "description": "Entegrator",
  "author": "Emre Yalçınkaya",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test:typecheck-ratchet": "node scripts/check-typecheck-baseline.js",
    "test": "vitest run",
    "test:style-ratchet": "node scripts/check-style-baseline.js",
    "test:pattern-ratchet": "node scripts/check-pattern-baseline.js",
    "test:no-console-ratchet": "node scripts/check-no-console-baseline.js",
    "lint": "eslint src packages/ui/src",
    "tokens": "vite-node scripts/build-tokens.ts",
    "test:e2e": "playwright test",
    "test:contract-paths": "node scripts/check-contract-paths.js",
    "test:preview-smoke": "vite build && playwright test -c playwright.preview.config.ts",
    "measure:bundle": "node scripts/measure-bundle.js",
    "preview": "vite preview",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "license-check": "npx --yes license-checker --production --summary --excludePrivatePackages",
    "dev:backoffice": "npm run dev -w @entegrasyonik/backoffice",
    "build:backoffice": "npm run build -w @entegrasyonik/backoffice",
    "test:backoffice": "npm run test -w @entegrasyonik/backoffice && npm run test -w @entegrasyonik/ui",
    "test:e2e:backoffice": "npm run test:e2e -w @entegrasyonik/backoffice"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "@vueup/vue-quill": "^1.2.0",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.6.7",
    "bson": "^6.10.4",
    "driver.js": "^1.3.6",
    "echarts": "^6.0.0",
    "electron-squirrel-startup": "^1.0.0",
    "express": "^4.18.2",
    "jsbarcode": "^3.11.6",
    "mitt": "^3.0.1",
    "pinia": "^2.1.7",
    "sortablejs": "^1.15.2",
    "sortablejs-vue3": "^1.2.11",
    "uuid": "^11.1.0",
    "vue": "^3.4.15",
    "vue-currency-input": "^3.1.0",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^9.8.0",
    "vue-router": "^4.0.0",
    "vuetify": "^3.8.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electron-forge/cli": "^7.3.0",
    "@electron-forge/maker-deb": "^7.3.0",
    "@electron-forge/maker-rpm": "^7.3.0",
    "@electron-forge/maker-squirrel": "^7.3.0",
    "@electron-forge/maker-zip": "^7.3.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.3.0",
    "@electron-forge/plugin-fuses": "^7.3.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^18.15.0",
    "@types/sortablejs": "^1.15.7",
    "@vitejs/plugin-vue": "^4.6.2",
    "electron": "^29.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "sass": "^1.70.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.0.12",
    "vite-node": "^2.1.9",
    "vite-plugin-vuetify": "^2.0.1",
    "vitest": "^2.1.9",
    "vue-tsc": "^1.2.0"
  },
  "workspaces": [
    "packages/*",
    "backoffice"
  ]
}
