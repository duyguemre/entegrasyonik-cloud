# Faz 3 T3 (ADR-0011): backend API taban adresi.
# Boş bırakılırsa veya bu dosyadan kopyalanmazsa restapi.ts AYNI varsayılana
# düşer: http://127.0.0.1:5001/api/ (davranış değişmez).
# Üretim/staging için gerçek değeri yerel `.env` (git-ignored) içinde tanımlayın.
VITE_API_BASE_URL=http://127.0.0.1:5001/api/

# R4 (frontend kod denetimi H-02): görsel sunucusu adresi. Boş bırakılırsa VITE_API_BASE_URL'e
# (o da boşsa yerel varsayılana) düşer — davranış değişmez. Görsel sunucusu API'den farklı bir
# adreste çalışıyorsa (ör. ayrı bir CDN/imageServer) burada AYRICA tanımlanabilir.
VITE_IMAGE_BASE_URL=

# ADR-0014 S4b: tanıtım sitesinin taban adresi ("Ana site" bağlantısı + kayıt formundaki yasal metin bağlantıları).
# Boş bırakılırsa yerel varsayılan (http://localhost:4321) kullanılır; üretim alan adı insan kararıdır.
VITE_SITE_URL=http://localhost:4321
