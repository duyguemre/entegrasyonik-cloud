# Tanıtım sitesi ortam değişkenleri (ADR-0014). Değerler kabuktan/CI'dan verilir; site `.env` dosyası OKUMAZ.
# Gerçek sır yok — yalnızca herkese açık adresler.

# TASLAK modu (varsayılan: true) — tüm sayfalarda noindex,nofollow + görünür TASLAK bandı.
# false yalnızca insan onayıyla (Protokol 12).
SITE_DRAFT=true

# Uygulamanın taban adresi (Giriş yap / Ücretsiz dene bağlantıları).
# Yerel: http://localhost:3000 — üretim adresi (ör. https://app.entegrasyonik.com) insan kararıdır.
PUBLIC_APP_URL=http://localhost:3000

# Sitenin kendi adresi (canonical + sitemap). Yalnızca SITE_DRAFT=false iken zorunlu; alan adı insan kararıdır.
# PUBLIC_SITE_URL=

# Yalnızca yerel/E2E: bileşen önizleme sayfasını (/bilesen-onizleme) derlemeye ekler. Production'da KULLANMAYIN.
# SITE_PREVIEW_ROUTES=true

# Yalnızca yerel/E2E/Lighthouse: derleme çıktı dizini (varsayılan dist).
# SITE_OUT_DIR=dist

# Iletisim e-posta adresi (/iletisim mailto). Bossa sayfada {{ILETISIM_E_POSTA}} yer tutucusu gosterilir (adres insan kararidir).
# PUBLIC_CONTACT_EMAIL=
