---
/**
 * /sss — sık sorulan sorular (ADR-0014 Karar 2). Kaynak: `getPublicFaqByCategory()` (her cevabın kanıtı `faq.ts`'te).
 * JS'siz `<details>` akordeonu + `FAQPage` JSON-LD şeması.
 *
 * S12 (PARÇA C): sorular altı kategoride; kategori ataması `faq.ts` kaydındadır; `getPublicFaq()` kategori sırasıyla
 * döner, JSON-LD de aynı sırayı kullanır. Boş kategori derleme hatasıdır.
 *
 * S14: `/sss#<soru-id>` bağlantısı hedef soruyu açar (ilerlemeli geliştirme; JS'siz durumda sayfa yine soruya kayar).
 *
 * S17 (S16 tasarım dili): arama + kategori sekmeleri.
 *  - JS'SİZ TEMEL: tüm sorular görünür; kategori sekmeleri sıradan sayfa içi bağlantılardır (#kategori); arama kutusu
 *    `hidden` gelir (çalışmayan bir denetim gösterilmez).
 *  - AŞAMALI GELİŞTİRME (`src/scripts/faq-filter.ts`): arama kutusu görünür olur; soru + cevap metninde Türkçe
 *    katlamalı eşleşme, sekmeler tek seçimli süzgece dönüşür (`aria-current`), sonuç sayısı `aria-live` ile duyurulur,
 *    eşleşme yoksa boş durum + destek/iletişim bağlantıları. Yalnızca `hidden` özniteliği değişir; ağ/depolama yok.
 *  - Sekme sayaçları YALNIZCA kayıttan hesaplanır (`data-stat`; tests/pages.test.ts yeniden hesaplar).
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import { crumbsFor } from '../data/seo'
import Section from '../components/Section.astro'
import PageHero from '../components/pages/PageHero.astro'
import Accordion from '../components/pages/Accordion.astro'
import HelpBand from '../components/pages/HelpBand.astro'
import CtaBand from '../components/pages/CtaBand.astro'
import Icon from '../components/home/Icon.astro'
import { getPublicFaq, getPublicFaqByCategory, getFaqPreview, type FaqCategoryId } from '../data/faq'
import { appUrls } from '../lib/site-config'

const crumbs = crumbsFor('/sss')
const items = getPublicFaq()
const categories = getPublicFaqByCategory()
/** Hero cam paneli: ana sayfa SSS önizlemesiyle aynı küratörlü seçki (popülerlik iddiası yok). */
const featured = getFaqPreview().slice(0, 5)

const CATEGORY_ICONS: Record<FaqCategoryId, 'bolt' | 'plug' | 'stock' | 'shield' | 'card' | 'chat'> = {
  baslangic: 'bolt',
  kanallar: 'plug',
  'stok-siparis': 'stock',
  'guvenlik-veri': 'shield',
  'fiyat-plan': 'card',
  'destek-olcek': 'chat',
}
---

<BaseLayout>

  <PageHero
    title="Sık sorulan sorular"
    eyebrow="Yardım"
    lead="Kurulumdan güvenliğe, stok yönetiminden fiyatlandırmaya: çok kanallı satış operasyonunuzu Entegrasyonik'e taşımadan önce merak ettiğiniz her şey."
    crumbs={crumbs}
    visualDesktopOnly
  >
    <div class="search" data-faq-search hidden>
      <label class="sr-only" for="faq-q">Sorularda ara</label>
      <span class="search__icon" aria-hidden="true"><Icon name="search" size="sm" /></span>
      <input
        id="faq-q"
        class="search__input"
        type="search"
        placeholder="Sorularda arayın"
        autocomplete="off"
        spellcheck="false"
        aria-controls="faq-groups"
        aria-describedby="faq-status"
        data-faq-input
      />
    </div>
    <Fragment slot="visual">
      <p class="panel-tag">Öne çıkan sorular</p>
      <ul class="hero-list" role="list">
        {
          featured.map((q) => (
            <li>
              <span class="hero-list__icon" aria-hidden="true"><Icon name={CATEGORY_ICONS[q.category]} size="sm" /></span>
              <a href={`#${q.id}`}>{q.question}</a>
            </li>
          ))
        }
      </ul>
    </Fragment>
  </PageHero>

  <Section labelledby="sss-title" class="tight-section faq-section">
    <h2 id="sss-title" class="sr-only">Sorular ve cevaplar</h2>
    <div class="faq-layout">
      <nav class="faq-tabs" aria-label="SSS kategorileri" data-faq-tabs>
        <ul role="list">
          <li>
            <a href="#sss-title" class="faq-tab" data-faq-tab="all" aria-current="true">
              <span class="faq-tab__icon" aria-hidden="true"><Icon name="help" size="sm" /></span>
              <span class="faq-tab__label">Tümü</span>
              <span class="faq-tab__count" data-stat="faq-total">{items.length}</span>
            </a>
          </li>
          {
            categories.map((c) => (
              <li>
                <a href={`#${c.id}`} class="faq-tab" data-faq-tab={c.id}>
                  <span class="faq-tab__icon" aria-hidden="true"><Icon name={CATEGORY_ICONS[c.id]} size="sm" /></span>
                  <span class="faq-tab__label">{c.label}</span>
                  <span class="faq-tab__count" data-stat={`faq-cat-${c.id}`}>{c.items.length}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="faq-main">
        <p class="faq-status" id="faq-status" role="status" aria-live="polite" data-faq-status></p>
        <div class="faq-groups" id="faq-groups">
          {
            categories.map((c) => (
              <section class="faq-group" id={c.id} aria-labelledby={`${c.id}-title`} data-faq-group={c.id}>
                <div class="faq-group__head">
                  <span class="faq-group__icon" aria-hidden="true"><Icon name={CATEGORY_ICONS[c.id]} size="md" /></span>
                  <div>
                    <h3 id={`${c.id}-title`}>{c.label}</h3>
                    <p>{c.lead}</p>
                  </div>
                </div>
                <Accordion items={c.items} />
              </section>
            ))
          }
        </div>
        <div class="faq-empty" data-faq-empty hidden>
          <span class="faq-empty__icon" aria-hidden="true"><Icon name="search" size="md" /></span>
          <p class="faq-empty__title">Aramanızla eşleşen bir soru bulamadık</p>
          <p class="faq-empty__text">Farklı bir sözcük deneyin ya da tüm soruları yeniden gösterin.</p>
          <button type="button" class="faq-empty__reset" data-faq-reset>Aramayı temizle</button>
        </div>
        <HelpBand text="Destek merkezinde adım adım rehberlere göz atın ya da işletmenize özel sorunuzu bize yazın." />
      </div>
    </div>
  </Section>

  <CtaBand
    id="sss-cta"
    title="Tüm kanallarınızı tek panelde yönetmeye başlayın"
    text="Ücretsiz denemeyle kanallarınızı bağlayın; merkezi stok yönetimi ve birleşik sipariş akışını kendi operasyonunuzda görün."
    primary={{ label: 'Ücretsiz deneyin', href: appUrls.register() }}
    secondary={{ label: 'Planları karşılaştırın', href: '/fiyatlandirma' }}
  />
</BaseLayout>

<script>
  import '../scripts/faq-filter'
</script>

<style>
  :global(.section.tight-section) {
    padding-block: calc(var(--site-section-y) * 0.72);
  }

  /* --- Hero cam paneli (S16 /guvenlik listesiyle aynı desen). Dar ekranda sorular hemen aşağıda olduğundan
     yinelenen panel gizlenir (PageHero `visualDesktopOnly`); içerik kaybı yok. --- */
  .panel-tag {
    margin: 0 0 var(--ek-space-3);
    color: var(--site-text-on-dark-meta);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hero-list li {
    display: flex;
    align-items: center;
    gap: var(--ek-space-3);
    padding-block: var(--ek-space-2);
  }
  .hero-list li + li {
    border-top: var(--site-border-width) solid var(--site-glass-border);
  }
  .hero-list__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-8);
    height: var(--ek-space-8);
    border-radius: var(--ek-radius-md);
    background: color-mix(in srgb, var(--ek-color-secondary) 18%, transparent);
    color: var(--site-accent-on-dark);
  }
  .hero-list a {
    display: inline-flex;
    align-items: center;
    min-height: var(--site-tap-target);
    color: var(--site-text-on-dark-heading);
    font-weight: var(--ek-font-weight-medium);
    line-height: var(--ek-line-height-tight);
    text-decoration: none;
  }
  .hero-list a:focus-visible {
    outline-color: var(--site-color-on-primary);
  }

  /* --- Hero araması (yalnızca JS ile görünür) --- */
  .search {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 36rem;
  }
  .search[hidden] {
    display: none;
  }
  .search__icon {
    position: absolute;
    inset-inline-start: var(--ek-space-4);
    display: inline-flex;
    color: var(--site-text-meta);
    pointer-events: none;
  }
  .search__input {
    width: 100%;
    min-height: calc(var(--site-tap-target) + var(--ek-space-2));
    padding: var(--ek-space-3) var(--ek-space-4) var(--ek-space-3) calc(var(--ek-space-4) * 2 + var(--ek-space-4));
    border: var(--site-border-width) solid transparent;
    border-radius: var(--ek-radius-lg);
    background: var(--ek-color-surface);
    box-shadow: var(--site-shadow-panel);
    color: var(--site-text-heading);
    font: inherit;
    font-size: var(--ek-font-size-lg);
  }
  .search__input::placeholder {
    color: var(--site-text-meta);
  }
  .search__input:focus-visible {
    outline: var(--site-focus-ring-width) solid var(--site-color-on-primary);
    outline-offset: var(--site-focus-ring-offset);
  }

  /* --- Düzen: sekmeler (masaüstünde solda yapışkan dikey, dar ekranda yatay kaydırılan şerit) --- */
  .faq-layout {
    display: grid;
    gap: var(--ek-space-8);
  }
  .faq-tabs {
    min-width: 0;
  }
  .faq-tabs ul {
    display: flex;
    gap: var(--ek-space-2);
    margin: 0;
    padding: 0 0 var(--ek-space-2);
    overflow-x: auto;
    list-style: none;
    scrollbar-width: thin;
  }
  .faq-tab {
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
    min-height: var(--site-tap-target);
    padding: var(--ek-space-1) var(--ek-space-3) var(--ek-space-1) var(--ek-space-2);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface);
    color: var(--site-text-body);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-medium);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--ek-duration-base) var(--ek-easing-standard),
      border-color var(--ek-duration-base) var(--ek-easing-standard),
      color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .faq-tab:hover {
    border-color: var(--ek-color-border-strong);
    color: var(--site-text-heading);
  }
  .faq-tab[aria-current='true'] {
    border-color: var(--ek-color-primary);
    background: var(--ek-color-primary);
    color: var(--site-color-on-primary);
  }
  .faq-tab:focus-visible {
    outline-offset: var(--site-focus-ring-offset);
  }
  .faq-tab__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-8);
    height: var(--ek-space-8);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface-muted);
    color: var(--site-link-accent);
  }
  .faq-tab[aria-current='true'] .faq-tab__icon {
    background: color-mix(in srgb, var(--ek-color-background) 16%, transparent);
    color: var(--site-color-on-primary);
  }
  .faq-tab__label {
    flex: 1;
  }
  .faq-tab__count {
    min-width: var(--ek-space-6);
    padding: 0 var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface-sunken);
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    font-variant-numeric: tabular-nums;
    line-height: var(--ek-space-6);
    text-align: center;
  }
  .faq-tab[aria-current='true'] .faq-tab__count {
    background: color-mix(in srgb, var(--ek-color-background) 18%, transparent);
    color: var(--site-color-on-primary);
  }

  /* --- İçerik --- */
  .faq-main {
    min-width: 0;
  }
  .faq-status:empty {
    display: none;
  }
  .faq-status {
    margin-bottom: var(--ek-space-5);
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-medium);
  }
  .faq-groups {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-12);
  }
  .faq-group {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-5);
    scroll-margin-top: calc(var(--site-header-height) + var(--ek-space-6));
  }
  .faq-group[hidden] {
    display: none;
  }
  .faq-group__head {
    display: flex;
    align-items: flex-start;
    gap: var(--ek-space-4);
  }
  .faq-group__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-12);
    height: var(--ek-space-12);
    border-radius: var(--ek-radius-lg);
    background: linear-gradient(140deg, var(--ek-color-primary), var(--ek-color-primary-darken-1));
    box-shadow: 0 var(--ek-space-2) var(--ek-space-4) calc(var(--ek-space-2) * -1) color-mix(in srgb, var(--ek-color-primary) 70%, transparent);
    color: var(--site-color-on-primary);
  }
  .faq-group h3 {
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-2xl);
    font-weight: var(--ek-font-weight-bold);
    letter-spacing: -0.01em;
    line-height: var(--ek-line-height-tight);
  }
  .faq-group__head p {
    margin-top: var(--ek-space-1);
    color: var(--site-text-body);
    font-size: var(--ek-font-size-md);
  }
  .faq-group :global(.acc) {
    box-shadow: var(--site-shadow-card);
  }
  .faq-group :global(.acc__item[hidden]) {
    display: none;
  }

  /* --- Boş durum (yalnızca JS süzgeci) --- */
  .faq-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--ek-space-3);
    padding: var(--ek-space-12) var(--ek-space-6);
    border: var(--site-border-width) dashed var(--ek-color-border-strong);
    border-radius: var(--site-radius-panel);
    background: var(--ek-color-surface-muted);
    text-align: center;
  }
  .faq-empty[hidden] {
    display: none;
  }
  .faq-empty__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-12);
    height: var(--ek-space-12);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface);
    color: var(--site-link-accent);
  }
  .faq-empty__title {
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-xl);
    font-weight: var(--ek-font-weight-bold);
  }
  .faq-empty__text {
    color: var(--site-text-body);
  }
  .faq-empty__reset {
    min-height: var(--site-tap-target);
    padding-inline: var(--ek-space-5);
    border: var(--site-border-width) solid var(--ek-color-border-strong);
    border-radius: var(--ek-radius-lg);
    background: var(--ek-color-surface);
    color: var(--site-text-heading);
    font: inherit;
    font-weight: var(--ek-font-weight-semibold);
    cursor: pointer;
  }
  .faq-empty__reset:hover {
    border-color: var(--ek-color-primary);
  }

  @media (min-width: 1024px) {
    .faq-layout {
      grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
      gap: var(--ek-space-12);
      align-items: start;
    }
    .faq-tabs {
      position: sticky;
      top: calc(var(--site-header-height) + var(--ek-space-6));
    }
    .faq-tabs ul {
      flex-direction: column;
      gap: var(--ek-space-1);
      padding: 0;
      overflow: visible;
    }
    .faq-tab {
      border-color: transparent;
      border-radius: var(--ek-radius-lg);
      background: transparent;
      white-space: normal;
    }
    .faq-tab:hover {
      border-color: transparent;
      background: var(--ek-color-surface-muted);
    }
  }
</style>
