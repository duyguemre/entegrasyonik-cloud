---
/**
 * /sss — sık sorulan sorular (ADR-0014 Karar 2). Kaynak: `getPublicFaqByCategory()` (her cevabın kanıtı `faq.ts`'te).
 * JS'siz `<details>` akordeonu + `FAQPage` JSON-LD şeması.
 *
 * S12 (PARÇA C): sorular altı kategoride (Başlangıç ve kurulum, Pazaryeri ve kanal uyumu, Stok ve sipariş yönetimi,
 * Güvenlik ve veri, Fiyatlandırma ve plan, Destek ve ölçeklenme). Kategori ataması `faq.ts` kaydındadır;
 * `getPublicFaq()` kategori sırasıyla döner, JSON-LD de aynı sırayı kullanır. Boş kategori derleme hatasıdır.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Section from '../components/Section.astro'
import PageHero from '../components/pages/PageHero.astro'
import PageMeta from '../components/pages/PageMeta.astro'
import Accordion from '../components/pages/Accordion.astro'
import CtaBand from '../components/pages/CtaBand.astro'
import Icon from '../components/home/Icon.astro'
import { getPublicFaq, getPublicFaqByCategory, type FaqCategoryId } from '../data/faq'
import { breadcrumbJsonLd, faqJsonLd } from '../lib/seo'
import { appUrls } from '../lib/site-config'

const title = 'Sık sorulan sorular'
const description =
  'Entegrasyonik hakkında sık sorulan sorular: kurulum, pazaryeri uyumu, merkezi stok ve overselling koruması, güvenlik, fiyatlandırma, destek ve ölçeklenme.'
const crumbs = [{ label: 'Ana sayfa', href: '/' }, { label: 'Sık sorulan sorular' }]
const items = getPublicFaq()
const categories = getPublicFaqByCategory()

const CATEGORY_ICONS: Record<FaqCategoryId, 'bolt' | 'plug' | 'stock' | 'shield' | 'card' | 'chat'> = {
  baslangic: 'bolt',
  kanallar: 'plug',
  'stok-siparis': 'stock',
  'guvenlik-veri': 'shield',
  'fiyat-plan': 'card',
  'destek-olcek': 'chat',
}
---

<BaseLayout title={title} description={description}>
  <PageMeta
    slot="head"
    title={title}
    description={description}
    jsonLd={[
      breadcrumbJsonLd([{ label: 'Ana sayfa', path: '/' }, { label: title, path: '/sss' }]),
      faqJsonLd(items),
    ]}
  />

  <PageHero
    title="Sık sorulan sorular"
    lead="Kurulumdan güvenliğe, stok yönetiminden fiyatlandırmaya: çok kanallı satış operasyonunuzu Entegrasyonik'e taşımadan önce merak ettiğiniz her şey."
    crumbs={crumbs}
  >
    <nav class="toc" aria-label="SSS kategorileri">
      {categories.map((c) => <a href={`#${c.id}`}>{c.label}</a>)}
    </nav>
  </PageHero>

  <Section labelledby="sss-title" class="tight-section">
    <h2 id="sss-title" class="sr-only">Sorular ve cevaplar</h2>
    <div class="faq-layout">
      <nav class="faq-nav" aria-label="Kategoriler">
        <ul role="list">
          {categories.map((c) => <li><a href={`#${c.id}`}>{c.label}</a></li>)}
        </ul>
      </nav>
      <div class="faq-groups">
        {
          categories.map((c) => (
            <section class="faq-group" id={c.id} aria-labelledby={`${c.id}-title`}>
              <div class="faq-group__head">
                <span class="faq-group__icon" aria-hidden="true"><Icon name={CATEGORY_ICONS[c.id]} size="md" /></span>
                <div>
                  <h3 id={`${c.id}-title`}>{c.label}</h3>
                  <p>{c.lead}</p>
                </div>
              </div>
              <Accordion items={c.items} />
            </section>
          ))
        }
      </div>
    </div>
    <p class="more">
      Sorunuzun yanıtını bulamadınız mı? <a href="/iletisim">Ekibimize yazın</a>; işletmenize özel sorularınızı birlikte yanıtlayalım.
    </p>
  </Section>

  <CtaBand
    id="sss-cta"
    title="Tüm kanallarınızı tek panelde yönetmeye başlayın"
    text="Ücretsiz denemeyle kanallarınızı bağlayın; merkezi stok yönetimi ve birleşik sipariş akışını kendi operasyonunuzda görün."
    primary={{ label: 'Ücretsiz deneyin', href: appUrls.register() }}
    secondary={{ label: 'Planları karşılaştırın', href: '/fiyatlandirma' }}
  />
</BaseLayout>

<style>
  /* Bölümler arası dikey ritim genel olarak sıkılaştırıldı (S11b). */
  .tight-section:global(.section) {
    padding-block: calc(var(--site-section-y) * 0.72);
  }
  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-2) var(--ek-space-3);
  }
  .toc a {
    display: inline-flex;
    align-items: center;
    min-height: var(--site-tap-target);
    padding-inline: var(--ek-space-4);
    border: var(--site-border-width) solid var(--site-color-on-primary-muted);
    border-radius: var(--ek-radius-full);
    color: var(--site-color-on-primary);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-medium);
    text-decoration: none;
    transition:
      background-color var(--ek-duration-base) var(--ek-easing-standard),
      border-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .toc a:hover {
    background: color-mix(in srgb, var(--ek-color-background) 12%, transparent);
    border-color: var(--site-color-on-primary);
  }
  .toc a:focus-visible {
    outline-color: var(--site-color-on-primary);
  }

  .faq-layout {
    display: grid;
    gap: var(--ek-space-10);
  }
  /* Mobil/tablet: kategori menüsü yatay bir şerit (sticky yan sütun için yer yok). */
  .faq-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-2) var(--ek-space-3);
    margin: 0 0 var(--ek-space-2);
    padding: 0;
    list-style: none;
  }
  .faq-nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--site-tap-target);
    padding-inline: var(--ek-space-4);
    border: var(--site-border-width) solid var(--ek-color-border-strong);
    border-radius: var(--ek-radius-full);
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-medium);
    text-decoration: none;
    transition: border-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .faq-nav a:hover {
    border-color: var(--ek-color-primary);
    color: var(--ek-color-primary);
  }

  .faq-groups {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-12);
    min-width: 0;
  }
  .faq-group {
    scroll-margin-top: calc(var(--site-header-height) + var(--ek-space-6));
  }
  .faq-group__head {
    display: flex;
    align-items: flex-start;
    gap: var(--ek-space-4);
    margin-bottom: var(--ek-space-5);
  }
  .faq-group__head p {
    margin-top: var(--ek-space-1);
    color: var(--ek-color-content-default);
    font-size: var(--ek-font-size-lg);
  }
  .faq-group__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-12);
    height: var(--ek-space-12);
    border-radius: var(--ek-radius-lg);
    background: color-mix(in srgb, var(--ek-color-secondary) 16%, transparent);
    color: var(--ek-color-secondary-darken-1);
  }
  .faq-nav__count {
    margin-inline-start: auto;
    padding-inline-start: var(--ek-space-2);
    color: var(--ek-color-content-muted);
    font-variant-numeric: tabular-nums;
  }
  .faq-group h3 {
    scroll-margin-top: var(--ek-space-16);
    font-size: var(--site-font-display-sm);
    font-weight: var(--site-font-display-weight);
    line-height: var(--site-font-display-line-height);
    letter-spacing: var(--site-font-display-tracking);
  }

  .more {
    margin-top: var(--ek-space-8);
    color: var(--ek-color-content-default);
    font-size: var(--ek-font-size-lg);
  }

  @media (min-width: 900px) {
    .faq-layout {
      grid-template-columns: minmax(12rem, 15rem) minmax(0, 1fr);
      align-items: start;
      gap: var(--ek-space-12);
    }
    .faq-nav {
      position: sticky;
      top: calc(var(--site-header-height) + var(--ek-space-6));
    }
    .faq-nav ul {
      flex-direction: column;
      align-items: stretch;
    }
    .faq-nav a {
      justify-content: flex-start;
      border: none;
      padding-inline: var(--ek-space-3);
      border-inline-start: var(--ek-space-1) solid var(--ek-color-border-default);
      border-radius: 0;
    }
    .faq-nav a:hover {
      border-inline-start-color: var(--ek-color-primary);
      background: var(--ek-color-surface-muted);
    }
  }
</style>
