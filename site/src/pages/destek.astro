---
/**
 * /destek — destek merkezi (S14). YENİ içerik üretmez: `getSupportCategories()` (faq.ts) mevcut SSS kayıtlarını beş
 * kategoride derler; "Kanal bağlama" kategorisi her mevcut entegrasyonun bağlantı rehberine
 * (`/entegrasyonlar/[kod]#baglanti-rehberi`, `connect.ts` verisi) bağlanır. Soru bağlantıları `/sss#<id>` hedefler
 * (SSS sayfası hedeflenen soruyu açar). Arama kutusu bilinçli olarak YOK (statik site; arama altyapısı yok).
 * Destek kanalı/süre taahhüdü yazılmaz: "Hâlâ yardım" kutusu SSS `destek` kaydının cevabını aynen kullanır.
 *
 * S16 (kullanıcı: "daha profesyonel, premium"): yardım merkezi girişi → konu kartları (beş kategoriye kısa yol) →
 * ayrı "Kanal bağlantı rehberleri" bandı (kanal rengi vurgulu kartlar) → kategori kartları (sorular) → destek
 * kanalları (uygulama içi talep, konu bazlı e-posta, SSS; YANIT SÜRESİ İDDİASI YOK) → altta iletişim bandı
 * (adres + e-posta gönder + adresi kopyala). Yeni olgu üretilmez; metinler SSS/iletişim kayıtlarından gelir.
 */
import Eyebrow from '../components/Eyebrow.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { crumbsFor } from '../data/seo'
import Section from '../components/Section.astro'
import Button from '../components/Button.astro'
import Icon from '../components/home/Icon.astro'
import SectionHead from '../components/pages/SectionHead.astro'
import PageHero from '../components/pages/PageHero.astro'
import ChannelMono from '../components/pages/ChannelMono.astro'
import EmailActions from '../components/pages/EmailActions.astro'
import { contactEmail } from '../lib/contact'
import { getPublicFaq, getSupportCategories } from '../data/faq'
import { getPublicIntegrations } from '../data/integrations'
import { connectGuides } from '../data/connect'
import { appUrls } from '../lib/site-config'

const crumbs = crumbsFor('/destek')

// Kanal bağlama (rehberli, geniş kart) ızgaranın başında; diğerleri kayıt sırasıyla 2x2.
const all = getSupportCategories()
const categories = [...all.filter((c) => c.channelGuides), ...all.filter((c) => !c.channelGuides)]
const tocCategories = all
const guideCodes = new Set(connectGuides.map((g) => g.code))
const channels = getPublicIntegrations().filter((i) => guideCodes.has(i.code))
const supportAnswer = getPublicFaq().find((f) => f.id === 'destek')?.answer
---

<BaseLayout>

  <PageHero
    title="Kurulumdan ilk siparişe, yanınızdayız"
    eyebrow="Destek merkezi"
    lead="Sık sorulan sorular ve kanal bağlantı rehberleri konularına göre ayrılmış hâlde; aradığınız cevaba kısa yoldan ulaşın."
    crumbs={crumbs}
  >
    <Fragment slot="visual">
      <p class="quick__tag">Hızlı başlangıç</p>
      <ul class="quick" role="list">
        <li>
          <a class="quick__link" href="#kanal-rehberleri">
            <span class="quick__icon" aria-hidden="true"><Icon name="plug" size="sm" /></span>
            <span>Kanal bağlantı rehberleri</span>
            <span class="quick__arrow" aria-hidden="true"><Icon name="arrow" size="sm" /></span>
          </a>
        </li>
        <li>
          <a class="quick__link" href="/ozellikler/stok-rezervasyonu">
            <span class="quick__icon" aria-hidden="true"><Icon name="stock" size="sm" /></span>
            <span>Aşırı satış nasıl önlenir</span>
            <span class="quick__arrow" aria-hidden="true"><Icon name="arrow" size="sm" /></span>
          </a>
        </li>
        <li>
          <a class="quick__link" href="/sss">
            <span class="quick__icon" aria-hidden="true"><Icon name="chat" size="sm" /></span>
            <span>Tüm sık sorulan sorular</span>
            <span class="quick__arrow" aria-hidden="true"><Icon name="arrow" size="sm" /></span>
          </a>
        </li>
      </ul>
    </Fragment>
  </PageHero>

  <Section labelledby="konu-title" class="tight-section section--topics">
    <SectionHead id="konu-title" eyebrow="Konuya göre göz atın" title="Size nasıl yardımcı olabiliriz?" lead="Bir konu seçin; ilgili sorulara ve rehberlere doğrudan gidin." />
    <ul class="topics" role="list" data-testid="support-topics">
      {
        tocCategories.map((c) => (
          <li>
            <a class="topic" href={`#${c.id}`}>
              <span class="topic__icon" aria-hidden="true">
                <Icon name={c.icon} size="md" />
              </span>
              <span class="topic__label">{c.label}</span>
              <span class="topic__lead">{c.lead}</span>
              <span class="topic__cta">
                Soruları görün <Icon name="arrow" size="sm" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="kanal-rehberleri" tone="muted" labelledby="rehber-title" class="tight-section">
    <SectionHead id="rehber-title" eyebrow="Adım adım" title="Kanal bağlantı rehberleri" lead="Her kanal için gereken bilgi türleri ve bağlantı adımları kendi sayfasında. Kod yazmanız gerekmez." />
    <ul class="chan-grid" role="list" data-testid="support-channel-guides">
      {
        channels.map((ch) => (
          <li>
            <a class="chan" href={`/entegrasyonlar/${ch.code}#baglanti-rehberi`} data-code={ch.code}>
              <span class="chan__strip" aria-hidden="true" />
              <ChannelMono code={ch.code} name={ch.name} size="md" />
              <span class="chan__text">
                <span class="chan__name">{ch.name} rehberi</span>
                <span class="chan__kind">{ch.kindLabel}</span>
              </span>
              <span class="chan__arrow" aria-hidden="true">
                <Icon name="arrow" size="sm" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section labelledby="kategori-title" class="tight-section">
    <SectionHead id="kategori-title" eyebrow="Sık sorulan sorular" title="Konulara göre sorular">
      <p>Her soru, tam cevabın yer aldığı SSS sayfasında açılır. <a href="/sss">Tüm soruları görün</a>.</p>
    </SectionHead>
    <ul class="support-grid" role="list">
      {
        categories.map((c) => (
          <li class:list={['support-cell', { 'support-cell--wide': c.channelGuides }]}>
            <article id={c.id} class="support-card" aria-labelledby={`${c.id}-title`} data-testid="support-category">
              <div class="support-card__head">
                <span class="support-card__icon" aria-hidden="true">
                  <Icon name={c.icon} size="md" />
                </span>
                <div>
                  <h3 id={`${c.id}-title`}>{c.label}</h3>
                  <p class="support-card__lead">{c.lead}</p>
                </div>
              </div>

              <div class="support-card__body">
              <ul class="questions" role="list">
                {c.items.map((q) => (
                  <li>
                    <a class="questions__link" href={`/sss#${q.id}`}>
                      <span>{q.question}</span>
                      <span class="questions__chev" aria-hidden="true">
                        <Icon name="chevron" size="sm" />
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
              </div>

              <div class="support-card__foot">
                {c.links.map((l) => (
                  <a class="support-card__more" href={l.href}>
                    {l.label} <span aria-hidden="true">→</span>
                  </a>
                ))}
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="muted" labelledby="kanallar-title" class="tight-section">
    <SectionHead id="kanallar-title" eyebrow="Destek kanalları" title="Aradığınızı bulamadınız mı?" lead={supportAnswer || undefined} />
    <ul class="channels" role="list" data-testid="support-channels">
      <li class="channel">
        <span class="channel__icon" aria-hidden="true"><Icon name="users" size="md" /></span>
        <h3>Uygulama içi destek</h3>
        <p>Hesabınız varsa: destek ekranından talep oluşturun, süreci aynı ekranda mesajlaşarak takip edin.</p>
        <Button href={appUrls.login()} variant="primary">Uygulamaya giriş yapın</Button>
      </li>
      <li class="channel">
        <span class="channel__icon" aria-hidden="true"><Icon name="mail" size="md" /></span>
        <h3>E-posta ile yazın</h3>
        <p>Satış öncesi sorular, teklif ve kanal talepleri için konunuzu seçip e-posta gönderin.</p>
        <Button href="/iletisim" variant="secondary">Konu seçerek yazın</Button>
      </li>
      <li class="channel">
        <span class="channel__icon" aria-hidden="true"><Icon name="help" size="md" /></span>
        <h3>Sık sorulan sorular</h3>
        <p>Başlangıçtan fiyatlandırmaya, en sık sorulan soruların cevapları tek sayfada.</p>
        <Button href="/sss" variant="secondary">Tüm sorular</Button>
      </li>
    </ul>
  </Section>

  <Section tone="stage" labelledby="iletisim-bandi-title" class="contact-band">
    <div class="band">
      <div class="band__copy">
        <Eyebrow class="band__eyebrow">İletişim</Eyebrow>
        <h2 id="iletisim-bandi-title">Bize doğrudan yazın</h2>
        <p>Genel iletişim adresimize e-posta gönderebilir veya adresi kopyalayıp dilediğiniz uygulamadan yazabilirsiniz.</p>
      </div>
      <div class="band__actions">
        <EmailActions email={contactEmail} id="destek-mail" tone="dark" subject="Destek talebi" />
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  import '../scripts/interactions'
</script>

<style>
  :global(.section.tight-section) {
    padding-block: calc(var(--site-section-y) * 0.72);
  }

  /* --- Hero görsel: hızlı başlangıç bağlantıları --- */
  .quick__tag {
    margin: 0 0 var(--ek-space-4);
    color: var(--site-color-on-primary-muted);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .quick {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
  }
  .quick__link {
    display: flex;
    align-items: center;
    gap: var(--ek-space-3);
    min-height: var(--site-tap-target);
    padding: var(--ek-space-3) var(--ek-space-4);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-lg);
    background: color-mix(in srgb, var(--ek-color-background) 6%, transparent);
    color: var(--site-color-on-primary);
    font-weight: var(--ek-font-weight-medium);
    text-decoration: none;
    transition:
      border-color var(--ek-duration-base) var(--ek-easing-standard),
      background-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .quick__link:hover {
    border-color: var(--site-color-on-primary-muted);
    background: color-mix(in srgb, var(--ek-color-background) 12%, transparent);
  }
  .quick__link:focus-visible {
    outline-color: var(--site-color-on-primary);
  }
  .quick__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-8);
    height: var(--ek-space-8);
    border-radius: var(--ek-radius-md);
    background: color-mix(in srgb, var(--ek-color-secondary) 22%, transparent);
    color: var(--ek-color-secondary);
  }
  .quick__arrow {
    margin-inline-start: auto;
    color: var(--site-color-on-primary-muted);
  }
  /* site-wdg W16: ok kayması global.css'teki tek kuraldan (a:hover .icon[data-icon='arrow']); yerel ikinci kayma kaldırıldı. */

  /* --- Kategori ızgarası --- */
  /* --- S16: konu kartları, kanal rehberleri, destek kanalları, iletişim bandı --- */
  .topics {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ek-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .topic {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    height: 100%;
    padding: var(--ek-space-5);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--site-radius-panel);
    background:
      radial-gradient(90% 70% at 0% 0%, color-mix(in srgb, var(--ek-color-secondary) 6%, transparent), transparent 70%),
      var(--ek-color-surface);
    box-shadow: var(--site-shadow-card);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--ek-duration-base) var(--ek-easing-standard),
      box-shadow var(--ek-duration-base) var(--ek-easing-standard),
      transform var(--ek-duration-base) var(--ek-easing-standard);
  }
  .topic:hover {
    border-color: color-mix(in srgb, var(--ek-color-secondary) 45%, var(--ek-color-border-default));
    box-shadow: var(--site-shadow-card-hover);
    transform: translateY(calc(var(--ek-space-1) * -0.5));
  }
  .topic:focus-visible,
  .chan:focus-visible {
    outline: var(--site-focus-ring-width) solid var(--site-color-focus-ring);
    outline-offset: var(--site-focus-ring-offset);
  }
  .topic__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-10);
    height: var(--ek-space-10);
    margin-bottom: var(--ek-space-2);
    border-radius: var(--ek-radius-lg);
    background: linear-gradient(140deg, var(--ek-color-primary), var(--ek-color-primary-darken-1));
    color: var(--site-color-on-primary);
  }
  .topic__label {
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-lg);
    font-weight: var(--ek-font-weight-bold);
  }
  .topic__lead {
    color: var(--site-text-body);
    font-size: var(--ek-font-size-sm);
    line-height: var(--site-font-body-line-height);
  }
  .topic__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-1);
    margin-top: auto;
    padding-top: var(--ek-space-2);
    color: var(--site-link-accent);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
  }
  .chan-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ek-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chan {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--ek-space-4);
    overflow: hidden;
    padding: var(--ek-space-4) var(--ek-space-5);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-xl);
    background:
      radial-gradient(70% 120% at 0% 50%, color-mix(in srgb, var(--chan) 8%, transparent), transparent 70%),
      var(--ek-color-surface);
    box-shadow: var(--site-shadow-card);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--ek-duration-base) var(--ek-easing-standard),
      box-shadow var(--ek-duration-base) var(--ek-easing-standard);
  }
  .chan:hover {
    border-color: color-mix(in srgb, var(--chan) 45%, var(--ek-color-border-default));
    box-shadow: var(--site-shadow-card-hover);
  }
  .chan__strip {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: calc(var(--site-border-width) * 3);
    background: var(--chan);
  }
  .chan__text {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }
  .chan__name {
    color: var(--site-text-heading);
    font-weight: var(--ek-font-weight-semibold);
  }
  .chan__kind {
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-sm);
  }
  .chan__arrow {
    display: inline-flex;
    color: var(--site-link-accent);
  }
  .channels {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ek-space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .channel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ek-space-3);
    padding: var(--ek-space-6);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--site-radius-panel);
    background: var(--ek-color-surface);
    box-shadow: var(--site-shadow-card);
  }
  .channel__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-10);
    height: var(--ek-space-10);
    border-radius: var(--ek-radius-lg);
    background: var(--site-accent-soft);
    box-shadow: inset 0 0 0 var(--site-border-width) color-mix(in srgb, var(--ek-color-secondary) 28%, transparent);
    color: var(--site-link-accent);
  }
  .channel h3 {
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-xl);
    font-weight: var(--ek-font-weight-bold);
  }
  .channel p {
    color: var(--site-text-body);
    font-size: var(--ek-font-size-md);
    line-height: var(--site-font-body-line-height);
  }
  .channel :global(.btn) {
    margin-top: auto;
  }
  :global(.section.contact-band) {
    padding-block: calc(var(--site-section-y) * 0.6);
  }
  .band {
    display: grid;
    gap: var(--ek-space-8);
    align-items: center;
  }
  .band__copy {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
  }
  .band h2 {
    font-size: var(--site-font-display-sm);
    font-weight: var(--site-font-display-weight);
    line-height: var(--site-font-display-line-height);
    letter-spacing: var(--site-font-display-tracking);
  }
  .band__copy p:not(.band__eyebrow) {
    color: var(--site-text-on-dark-body);
    font-size: var(--ek-font-size-lg);
  }
  .band__actions {
    padding: var(--ek-space-6);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--site-radius-panel);
    background: var(--site-glass-bg);
  }
  @media (min-width: 640px) {
    .topics,
    .chan-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .chan-grid,
    .channels {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .topics {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .band {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--ek-space-12);
    }
  }
  .support-grid {
    display: grid;
    gap: var(--ek-space-6);
  }
  .support-cell {
    display: flex;
  }
  .support-card {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-5);
    width: 100%;
    padding: var(--ek-space-6);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--site-radius-panel);
    background: var(--ek-color-surface);
    box-shadow: var(--site-shadow-card);
    /* site-wdg W14: üst bar payı html scroll-padding-top’ta; burada yalnız ek boşluk. */
    scroll-margin-top: var(--ek-space-2);
    transition:
      border-color var(--ek-duration-base) var(--ek-easing-standard),
      box-shadow var(--ek-duration-base) var(--ek-easing-standard);
  }
  .support-card:hover,
  .support-card:focus-within {
    border-color: var(--ek-color-border-strong);
    box-shadow: var(--site-shadow-card-hover);
  }
  .support-card__head {
    display: flex;
    align-items: flex-start;
    gap: var(--ek-space-4);
  }
  .support-card__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-12);
    height: var(--ek-space-12);
    border-radius: var(--ek-radius-lg);
    background: var(--ek-color-primary);
    color: var(--site-color-on-primary);
    box-shadow: var(--site-shadow-card);
  }
  .support-card h3 {
    font-size: var(--site-card-title-size);
    font-weight: var(--site-card-title-weight);
    line-height: var(--ek-line-height-tight);
  }
  .support-card__lead {
    margin-top: var(--ek-space-1);
    color: var(--ek-color-content-muted);
    font-size: var(--site-card-desc-size);
  }

  .support-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-5);
  }

  .questions {
    display: flex;
    flex-direction: column;
  }
  .questions li + li {
    border-top: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .questions__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ek-space-3);
    min-height: var(--site-tap-target);
    padding-block: var(--ek-space-3);
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-medium);
    line-height: var(--ek-line-height-tight);
    text-decoration: none;
  }
  .questions__link:hover span:first-child {
    color: var(--ek-color-primary);
  }
  .questions__chev {
    flex: none;
    color: var(--ek-color-content-muted);
    transform: rotate(-90deg);
  }
  .support-card__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-4);
    margin-top: auto;
    padding-top: var(--ek-space-4);
    border-top: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .support-card__more {
    color: var(--site-color-link);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-semibold);
  }
  /* site-wdg W18: kapsamlı renk global a:hover'ı eziyordu → hover rengi. */
  .support-card__more:hover {
    color: var(--site-color-link-hover);
