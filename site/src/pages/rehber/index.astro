---
/**
 * /rehber — bilgi merkezi hub'ı (S20, KB §8.1 R0). Konu kümeleri (Pazaryerleri, Mevzuat ve vergi, Operasyon ve stok,
 * Seçim rehberi), öne çıkan rehberler, resmi pazar verisi, sözlük bandı, SSS ve kapanış çağrısı.
 * Tüm metin `src/data/kb/**` kayıtlarından gelir; sayılar kayıttan hesaplanır ya da `facts.ts` belirtecidir.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import Section from '../../components/Section.astro'
import PageHero from '../../components/pages/PageHero.astro'
import SectionHead from '../../components/pages/SectionHead.astro'
import HeroActions from '../../components/pages/HeroActions.astro'
import Accordion from '../../components/pages/Accordion.astro'
import CtaBand from '../../components/pages/CtaBand.astro'
import Icon from '../../components/home/Icon.astro'
import { clusters, getGuide, getGuideCta, guideHref, guides, guidesIn, GLOSSARY_PATH, REHBER_PATH } from '../../data/kb'
import { glossary } from '../../data/kb/glossary'
import { sources } from '../../data/kb/sources'
import { GLOSSARY_PREVIEW, HUB, HUB_FAQ, MARKET_HIGHLIGHT, PRINCIPLES } from '../../data/kb/hub'
import { crumbsFor } from '../../data/seo'
import { formatTrDate } from '../../lib/kb-render'
import { appUrls } from '../../lib/site-config'

const crumbs = crumbsFor(REHBER_PATH)
const usedSources = new Set(guides.flatMap((g) => g.sources))
const officialCount = [...usedSources].filter((id) => sources[id].trust === 'R').length
const featured = guides.slice(0, 3)
const market = getGuide(MARKET_HIGHLIGHT.guide)!
const marketSource = sources[MARKET_HIGHLIGHT.source]
const glossaryPreview = GLOSSARY_PREVIEW.map((id) => glossary.find((t) => t.id === id)!)
const cta = getGuideCta('channels')

---

<BaseLayout path={REHBER_PATH}>
  <PageHero title={HUB.title} lead={HUB.lead} crumbs={crumbs} eyebrow="Rehber">
    <HeroActions
      actions={[
        { label: 'Konulara göz atın', href: '#konular' },
        { label: 'Sözlük', href: GLOSSARY_PATH },
      ]}
    />
    <Fragment slot="visual">
      <p class="hub-panel__tag">Rehber bir bakışta</p>
      <dl class="hub-panel" data-testid="hub-stats">
        <div>
          <dt>Rehber sayfası</dt>
          <dd>{guides.length}</dd>
        </div>
        <div>
          <dt>Sözlük terimi</dt>
          <dd>{glossary.length}</dd>
        </div>
        <div>
          <dt>Kaynak</dt>
          <dd>{usedSources.size}, {officialCount} resmi</dd>
        </div>
        <div>
          <dt>Son güncelleme</dt>
          <dd><time datetime={HUB.dateModified}>{formatTrDate(HUB.dateModified)}</time></dd>
        </div>
      </dl>
    </Fragment>
  </PageHero>

  <Section labelledby="rehber-hakkinda" class="hub-intro">
    <div class="hub-intro__grid">
      <div class="hub-answer" data-testid="guide-answer">
        <p class="hub-answer__tag"><Icon name="sparkle" size="sm" /> Bu rehber nedir?</p>
        <h2 id="rehber-hakkinda" class="sr-only">Rehber hakkında</h2>
        <p class="hub-answer__text">{HUB.answer}</p>
      </div>
      <ul class="hub-principles" role="list">
        {
          PRINCIPLES.map((p) => (
            <li>
              <span class="hub-principles__icon" aria-hidden="true">
                <Icon name={p.icon} size="sm" />
              </span>
              <span class="hub-principles__title">{p.title}</span>
              <span class="hub-principles__text">{p.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section tone="muted" id="konular" labelledby="konular-title">
    <SectionHead id="konular-title" eyebrow="Konular" title="Konu kümeleri" lead="Pazaryerinde satıştan mevzuata, stok operasyonundan yazılım seçimine: her küme kısa, kaynaklı rehberlerden oluşur." />

    <ul class="featured" role="list" aria-label="Öne çıkan rehberler">
      {
        featured.map((g) => (
          <li>
            <a class="featured__card" href={guideHref(g.slug)}>
              <span class="featured__cluster">{clusters.find((c) => c.id === g.cluster)!.title}</span>
              <span class="featured__title">{g.title}</span>
              <span class="featured__summary">{g.summary}</span>
              <span class="featured__more">
                Rehberi okuyun <Icon name="arrow" size="sm" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="clusters">
      {
        clusters.map((c) => (
          <section class="cluster" id={`kume-${c.id}`} aria-labelledby={`kume-${c.id}-title`} data-testid="hub-cluster">
            <header class="cluster__head">
              <span class="cluster__icon" aria-hidden="true">
                <Icon name={c.icon} size="md" />
              </span>
              <div>
                <h3 id={`kume-${c.id}-title`}>{c.title}</h3>
                <p>{c.lead}</p>
              </div>
            </header>
            <ul class="cluster__list" role="list">
              {guidesIn(c.id).map((g) => (
                <li>
                  <a href={guideHref(g.slug)}>
                    <span class="cluster__link-title">{g.title}</span>
                    <span class="cluster__link-summary">{g.summary}</span>
                    <Icon name="arrow" size="sm" />
                  </a>
                </li>
              ))}
              {c.id === 'secim' && (
                <li>
                  <a href={GLOSSARY_PATH}>
                    <span class="cluster__link-title">E-ticaret entegrasyon sözlüğü</span>
                    <span class="cluster__link-summary">{glossary.length} temel terimin kısa tanımı.</span>
                    <Icon name="arrow" size="sm" />
                  </a>
                </li>
              )}
            </ul>
          </section>
        ))
      }
    </div>
  </Section>

  <Section labelledby="pazar-title" class="hub-market">
    <div class="market">
      <div class="market__copy">
        <SectionHead id="pazar-title" eyebrow="Resmi veri" title={MARKET_HIGHLIGHT.title} compact />
        <p class="market__lead">{market.answer}</p>
        <a class="market__link" href={guideHref(market.slug)}>
          Pazar verisinin tamamı <Icon name="arrow" size="sm" />
        </a>
      </div>
      <figure class="market__stats">
        <dl>
          {
            MARKET_HIGHLIGHT.stats.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))
          }
        </dl>
        <figcaption>
          Kaynak: <a href={marketSource.url} rel="noopener noreferrer">{marketSource.publisher}</a> · Erişim:{' '}
          <time datetime={marketSource.accessed}>{formatTrDate(marketSource.accessed)}</time>
        </figcaption>
      </figure>
    </div>
  </Section>

  <Section tone="muted" labelledby="sozluk-title">
    <SectionHead id="sozluk-title" eyebrow="Sözlük" title="Sık kullanılan terimler" lead="Stok, pazaryeri, API ve mevzuat terimlerinin kısa tanımları tek sayfada." />
    <ul class="terms" role="list">
      {
        glossaryPreview.map((t) => (
          <li>
            <a href={`${GLOSSARY_PATH}#${t.id}`}>
              <span class="terms__name">{t.term}</span>
              <span class="terms__def">{t.definition}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <a class="terms__all" href={GLOSSARY_PATH}>
      Tüm terimler ({glossary.length}) <Icon name="arrow" size="sm" />
    </a>
  </Section>

  <Section labelledby="rehber-sss-title" size="narrow">
    <SectionHead id="rehber-sss-title" eyebrow="SSS" title="Rehber hakkında" />
    <Accordion items={HUB_FAQ} />
  </Section>

  <CtaBand
    id="rehber-cta"
    title={cta.title}
    text={cta.text}
    primary={{ label: 'Ücretsiz dene', href: appUrls.register() }}
    secondary={{ label: cta.link.label, href: cta.link.href }}
  />
</BaseLayout>

<style>
  /* --- Hero paneli --- */
  .hub-panel__tag {
    margin: 0 0 var(--ek-space-3);
    color: var(--site-text-on-dark-meta);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hub-panel {
    display: flex;
    flex-direction: column;
    margin: 0;
  }
  .hub-panel div {
    display: flex;
    justify-content: space-between;
    gap: var(--ek-space-4);
    padding-block: var(--ek-space-3);
  }
  .hub-panel div + div {
    border-top: var(--site-border-width) solid var(--site-glass-border);
  }
  .hub-panel dt {
    color: var(--site-text-on-dark-body);
    font-size: var(--ek-font-size-sm);
  }
  .hub-panel dd {
    margin: 0;
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
    font-variant-numeric: tabular-nums;
    text-align: end;
  }

  /* --- Giriş --- */
  :global(.section.hub-intro) {
    padding-block: calc(var(--site-section-y) * 0.6);
  }
  .hub-intro__grid {
    display: grid;
    gap: var(--ek-space-8);
  }
  .hub-answer {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
    max-width: var(--site-measure);
  }
  .hub-answer__tag {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    margin: 0;
    color: var(--site-link-accent);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hub-answer__text {
    margin: 0;
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-xl);
    line-height: var(--site-font-body-line-height);
    text-wrap: pretty;
  }
  .hub-principles {
    display: grid;
    align-content: start;
    gap: var(--ek-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hub-principles li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--ek-space-3);
    row-gap: var(--ek-space-1);
  }
  .hub-principles__icon {
    grid-row: span 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-8);
    height: var(--ek-space-8);
    border-radius: var(--ek-radius-md);
    background: var(--site-accent-soft);
    color: var(--site-link-accent);
  }
  .hub-principles__title {
    color: var(--site-text-heading);
    font-weight: var(--ek-font-weight-semibold);
  }
  .hub-principles__text {
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-sm);
    line-height: var(--site-font-body-line-height);
  }

  /* --- Öne çıkanlar --- */
  .featured {
    display: grid;
    gap: var(--ek-space-4);
    margin: 0 0 var(--ek-space-8);
    padding: 0;
    list-style: none;
  }
  .featured__card {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    height: 100%;
    padding: var(--ek-space-6);
    border-radius: var(--site-radius-panel);
    background: var(--site-gradient-stage);
    box-shadow: var(--site-shadow-card);
    color: var(--site-text-on-dark-body);
    text-decoration: none;
    transition:
      transform var(--ek-duration-base) var(--ek-easing-standard),
      box-shadow var(--ek-duration-base) var(--ek-easing-standard);
  }
  .featured__card:hover {
    transform: translateY(calc(var(--ek-space-1) * -0.5));
    box-shadow: var(--site-shadow-panel);
  }
  .featured__card:focus-visible {
    outline-color: var(--ek-color-primary);
  }
  .featured__cluster {
    color: var(--site-accent-on-dark);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .featured__title {
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-xl);
    font-weight: var(--ek-font-weight-bold);
    line-height: var(--ek-line-height-tight);
    text-wrap: balance;
  }
  .featured__summary {
    flex: 1;
    font-size: var(--ek-font-size-sm);
    line-height: var(--site-font-body-line-height);
  }
  .featured__more {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    margin-top: var(--ek-space-2);
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
  }

  /* --- Kümeler --- */
  .clusters {
    display: grid;
    gap: var(--ek-space-6);
  }
  .cluster {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-5);
    padding: var(--ek-space-6);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--site-radius-panel);
    background: var(--ek-color-surface);
    box-shadow: var(--site-shadow-card);
    scroll-margin-top: calc(var(--site-header-height) + var(--ek-space-6));
  }
  .cluster__head {
    display: flex;
    gap: var(--ek-space-4);
    align-items: flex-start;
  }
  .cluster__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-12);
    height: var(--ek-space-12);
    border-radius: var(--ek-radius-lg);
    background: linear-gradient(140deg, var(--ek-color-primary), var(--ek-color-primary-darken-1));
    color: var(--site-color-on-primary);
  }
  .cluster__head h3 {
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-xl);
    font-weight: var(--ek-font-weight-bold);
    line-height: var(--ek-line-height-tight);
  }
  .cluster__head p {
    margin: var(--ek-space-1) 0 0;
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-sm);
    line-height: var(--site-font-body-line-height);
  }
  .cluster__list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cluster__list li + li {
    border-top: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .cluster__list a {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
    min-height: var(--site-tap-target);
    padding: var(--ek-space-3) var(--ek-space-8) var(--ek-space-3) 0;
    color: var(--site-text-body);
    text-decoration: none;
  }
  .cluster__list a > :global(.icon) {
    position: absolute;
    inset-inline-end: 0;
    inset-block-start: 50%;
    transform: translateY(-50%);
    color: var(--site-text-meta);
    transition:
      transform var(--ek-duration-base) var(--ek-easing-standard),
      color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .cluster__list a:hover > :global(.icon) {
    color: var(--site-link-accent);
    transform: translate(calc(var(--ek-space-1) * 0.5), -50%);
  }
  .cluster__link-title {
    color: var(--site-text-heading);
    font-weight: var(--ek-font-weight-semibold);
    line-height: var(--ek-line-height-tight);
  }
  .cluster__list a:hover .cluster__link-title {
    color: var(--site-color-link);
  }
  .cluster__link-summary {
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-sm);
  }

  /* --- Pazar verisi --- */
  .market {
    display: grid;
    gap: var(--ek-space-8);
    align-items: center;
  }
  .market__copy {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-4);
  }
  .market__lead {
    max-width: var(--site-measure);
    margin: 0;
    color: var(--site-text-body);
    font-size: var(--site-font-body);
    line-height: var(--site-font-body-line-height);
  }
  .market__link,
  .terms__all {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    min-height: var(--site-tap-target);
    color: var(--site-link-accent);
    font-weight: var(--ek-font-weight-semibold);
  }
  .market__stats {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-4);
    margin: 0;
    padding: var(--ek-space-6);
    border-radius: var(--site-radius-panel);
    background: var(--site-gradient-stage);
    box-shadow: var(--site-shadow-panel);
  }
  .market__stats dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--ek-space-6) var(--ek-space-4);
    margin: 0;
  }
  .market__stats div:first-child {
    grid-column: 1 / -1;
  }
  .market__stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--ek-space-1);
  }
  .market__stats dt {
    color: var(--site-text-on-dark-body);
    font-size: var(--ek-font-size-sm);
  }
  .market__stats dd {
    margin: 0;
    color: var(--site-text-on-dark-heading);
    font-size: var(--site-font-display-sm);
    font-weight: var(--site-font-display-weight);
    letter-spacing: var(--site-font-display-tracking);
    line-height: var(--site-font-display-line-height);
    font-variant-numeric: tabular-nums;
  }
  .market__stats figcaption {
    padding-top: var(--ek-space-4);
    border-top: var(--site-border-width) solid var(--site-glass-border);
    color: var(--site-text-on-dark-meta);
    font-size: var(--ek-font-size-xs);
  }
  .market__stats figcaption a {
    color: var(--site-text-on-dark-heading);
  }

  /* --- Sözlük bandı --- */
  .terms {
    display: grid;
    gap: var(--ek-space-3);
    margin: 0 0 var(--ek-space-6);
    padding: 0;
    list-style: none;
  }
  .terms a {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
    height: 100%;
    padding: var(--ek-space-4);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-lg);
    background: var(--ek-color-surface);
    text-decoration: none;
    transition: border-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .terms a:hover {
    border-color: var(--ek-color-secondary-darken-1);
  }
  .terms__name {
    color: var(--site-text-heading);
    font-weight: var(--ek-font-weight-semibold);
  }
  .terms__def {
    display: -webkit-box;
    overflow: hidden;
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-sm);
    line-height: var(--site-font-body-line-height);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  @media (min-width: 640px) {
    .terms {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 768px) {
    .featured {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 768px) and (max-width: 1023.98px) {
    .hub-principles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .hub-intro__grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: var(--ek-space-16);
      align-items: start;
    }
    .hub-principles {
      padding-inline-start: var(--ek-space-8);
      border-inline-start: var(--site-border-width) solid var(--ek-color-border-default);
    }
    .clusters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .market {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--ek-space-16);
    }
    .terms {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
