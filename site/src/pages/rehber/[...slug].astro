---
/**
 * /rehber/<küme>/<sayfa> — rehber sayfaları (S20). Kayıt: `src/data/kb/guides/*` (KB 2026-09-30, §12 öncelik sırası).
 * Tüm düzen ve JSON-LD `GuideArticle` bileşenindedir; bu dosya yalnızca rotaları üretir.
 */
import GuideArticle from '../../components/rehber/GuideArticle.astro'
import { guides } from '../../data/kb'
import type { Guide } from '../../data/kb/types'

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }))
}

interface Props {
  guide: Guide
}

const { guide } = Astro.props
---

<GuideArticle guide={guide} />
