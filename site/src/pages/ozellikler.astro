---
/**
 * /ozellikler — yetenek anlatımı (ADR-0014 Karar 2, S2b; premium kart ızgarası S11). Yalnızca
 * `getPublicCapabilities('core')` (kayıtlı ve gösterilebilir yetenekler; yol haritası öğeleri gelmez).
 * Kanal listeleri entegrasyon kaydından türetilir. Kısmi yeteneklerde kapsam notu ve kanal bazında düzey görünür.
 *
 * S14: kart değer satırı kayıttaki somut akış cümlesidir (`action`, capabilities.ts); `summary` ikincil metin.
 *
 * S17 (S16 tasarım dili): koyu hero + "Bir bakışta" sayaçları (YALNIZCA kayıttan hesaplanır; tests/pages.test.ts
 * her `data-stat` değerini yeniden hesaplar), öne çıkan stok rezervasyonu kartı (derin sayfaya net geçiş), ardından
 * yetenek KÜMELERİ: solda yapışkan küme başlığı, sağda eşit yükseklikli kart ızgarası. Kanal kapsamı kartta
 * kompakt monogram şeridi (düzey şekille + metinle: dolu = destekleniyor, yarım = temel düzeyde), tam ayrıntı
 * yerel <details> içinde (JS gerekmez). Kümeler yalnızca SAYFA DÜZENİDİR (yeni iddia yok); kümeye atanmamış
 * bir yetenek "Diğer" kümesine düşer, böylece kayıttaki hiçbir yetenek kaybolmaz.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Section from '../components/Section.astro'
import Badge from '../components/Badge.astro'
import Icon from '../components/home/Icon.astro'
import PageHero from '../components/pages/PageHero.astro'
import PageMeta from '../components/pages/PageMeta.astro'
import HeroActions from '../components/pages/HeroActions.astro'
import StatPanel from '../components/pages/StatPanel.astro'
import SectionHead from '../components/pages/SectionHead.astro'
import LevelBadge from '../components/pages/LevelBadge.astro'
import ChannelMono from '../components/pages/ChannelMono.astro'
import NextLinks from '../components/pages/NextLinks.astro'
import CtaBand from '../components/pages/CtaBand.astro'
import { getPublicCapabilities, type ProductCapabilityStatus, type PublicProductCapability } from '../data/capabilities'
import { CAPABILITY_LEVEL_LABELS, getPublicIntegrations, type CapabilityLevel } from '../data/integrations'
import { getFeaturePoints } from '../data/feature-details'
import { breadcrumbJsonLd } from '../lib/seo'
import { appUrls } from '../lib/site-config'

const title = 'Özellikler'
const description =
  'Eşzamanlı siparişte stok rezervasyonu, tek listede siparişler, iade onayı ve reddi, müşteri sorularını yanıtlama, hakediş takibi: Entegrasyonik özellikleri ve kanal bazında kapsamları.'
const crumbs = [{ label: 'Ana sayfa', href: '/' }, { label: 'Özellikler' }]

const capabilities = getPublicCapabilities('core')
const channels = getPublicIntegrations()

const statusTone = (status: ProductCapabilityStatus): 'success' | 'warning' | 'neutral' =>
  status === 'available' ? 'success' : status === 'partial' ? 'warning' : 'neutral'

type IconName = 'stock' | 'layers' | 'orders' | 'returns' | 'chat' | 'finance' | 'notice' | 'database' | 'sparkle'
const ICON: Record<string, IconName> = {
  'stock-reservation': 'stock',
  'multi-channel-products': 'layers',
  'unified-orders': 'orders',
  returns: 'returns',
  questions: 'chat',
  finance: 'finance',
  'shipping-invoice-notice': 'notice',
  'erp-read': 'database',
}

/** Öne çıkan yetenek: derin sayfası olan stok rezervasyonu. */
const FEATURED_ID = 'stock-reservation'
const featured = capabilities.find((c) => c.id === FEATURED_ID)
const featuredPoints = getFeaturePoints(FEATURED_ID)

/** Sayfa düzeni kümeleri (iddia değil; yalnızca gruplama). */
const CLUSTERS: Array<{ id: string; title: string; lead: string; ids: string[] }> = [
  {
    id: 'stok-katalog',
    title: 'Ürün, stok ve katalog',
    lead: 'Fiyat ve stok değişikliklerini tek yerden kanallarınıza iletin; ERP kataloğunuzu panele alın.',
    ids: ['multi-channel-products', 'erp-read'],
  },
  {
    id: 'siparis',
    title: 'Sipariş ve gönderim',
    lead: 'Siparişleri tek listede toplayın; kargo ve fatura bilgisini ilgili pazaryerine iletin.',
    ids: ['unified-orders', 'shipping-invoice-notice'],
  },
  {
    id: 'satis-sonrasi',
    title: 'Satış sonrası ve müşteri',
    lead: 'İade taleplerini ve müşteri sorularını her pazaryeri paneline ayrı ayrı girmeden yanıtlayın.',
    ids: ['returns', 'questions'],
  },
  {
    id: 'finans',
    title: 'Finans',
    lead: 'Hakediş ve finansal hareketlerinizi satış verisiyle aynı yerde izleyin.',
    ids: ['finance'],
  },
]
const assigned = new Set([FEATURED_ID, ...CLUSTERS.flatMap((c) => c.ids)])
const leftovers = capabilities.filter((c) => !assigned.has(c.id))
const clusters = [
  ...CLUSTERS.map((cl) => ({ ...cl, items: cl.ids.map((id) => capabilities.find((c) => c.id === id)).filter((c): c is PublicProductCapability => !!c) })),
  ...(leftovers.length > 0 ? [{ id: 'diger', title: 'Diğer', lead: '', ids: [], items: leftovers }] : []),
].filter((cl) => cl.items.length > 0)

/*
 * "Bir bakışta" sayaçları — YALNIZCA kayıttan hesaplanır (tests/pages.test.ts EXPECTED_STATS aynı hesabı yapar).
 */
const stats = [
  { id: 'features', value: capabilities.length, label: 'temel özellik' },
  { id: 'features-available', value: capabilities.filter((c) => c.status === 'available').length, label: 'mevcut özellik' },
  { id: 'features-partial', value: capabilities.filter((c) => c.status === 'partial').length, label: 'kısmi, kanala göre değişen' },
  { id: 'integrations', value: channels.length, label: 'kullanılabilir entegrasyon' },
]

const LEVEL_STATE: Record<CapabilityLevel, 'yes' | 'limited'> = { supported: 'yes', limited: 'limited' }
---

<BaseLayout title={title} description={description}>
  <PageMeta
    slot="head"
    title={title}
    description={description}
    jsonLd={[breadcrumbJsonLd([{ label: 'Ana sayfa', path: '/' }, { label: title, path: '/ozellikler' }])]}
  />

  <PageHero
    title="Özellikler"
    eyebrow="Ürün"
    lead="Eşzamanlı siparişte stok rezerve edilir; siz iadeyi onaylar, müşteri sorusunu yanıtlar, fiyat ve stoğu tek yerden güncellersiniz. Her özelliğin hangi kanallarda ve hangi kapsamda çalıştığı yazılıdır."
    crumbs={crumbs}
  >
    <HeroActions
      actions={[
        { label: 'Özellikleri inceleyin', href: '#kumeler' },
        { label: 'Aşırı satış nasıl önlenir', href: '/ozellikler/stok-rezervasyonu' },
      ]}
    />
    <Fragment slot="visual">
      <StatPanel tag="Bir bakışta" stats={stats} testid="feature-stats">
        <ul class="hero-chans" role="list" aria-label="Kullanılabilir kanallar">
          {
            channels.map((c) => (
              <li>
                <a href={`/entegrasyonlar/${c.code}`} class="hero-chan" data-code={c.code}>
                  <span class="hero-chan__dot" aria-hidden="true" />
                  {c.name}
                </a>
              </li>
            ))
          }
        </ul>
      </StatPanel>
    </Fragment>
  </PageHero>

  {
    featured && (
      <Section labelledby="one-cikan-title" class="tight-section featured-section">
        <h2 id="one-cikan-title" class="sr-only">Öne çıkan özellik</h2>
        <article id={featured.id} class="featured" aria-labelledby={`${featured.id}-title`} data-testid="feature">
          <div class="featured__body">
            <div class="featured__top">
              <span class="cap-icon cap-icon--lg" aria-hidden="true">
                <Icon name={ICON[featured.id] ?? 'sparkle'} size="md" />
              </span>
              <p class="featured__eyebrow">Öne çıkan</p>
              <Badge tone={statusTone(featured.status)}>{featured.statusLabel}</Badge>
            </div>
            <h3 id={`${featured.id}-title`} class="featured__title">{featured.title}</h3>
            <p class="featured__value">{featured.action ?? featured.summary}</p>
            {featured.action && <p class="featured__desc">{featured.summary}</p>}
            <a class="featured__link" href="/ozellikler/stok-rezervasyonu" data-testid="feature-deep-link">
              Aşırı satış nasıl önlenir
              <Icon name="arrow" size="sm" />
            </a>
          </div>
          <div class="featured__aside">
            <p class="featured__aside-tag">Arka planda ne olur</p>
            {featuredPoints.length > 0 && (
              <ol class="featured__points" role="list">
                {featuredPoints.map((p) => (
                  <li>
                    <span class="featured__check" aria-hidden="true"><Icon name="check" size="sm" /></span>
                    <span>{p}</span>
                  </li>
                ))}
              </ol>
            )}
            {featured.caveat && (
              <p class="caveat">
                <Icon name="info" size="sm" />
                <span><strong>Kapsam notu:</strong> {featured.caveat}</span>
              </p>
            )}
          </div>
        </article>
      </Section>
    )
  }

  <Section id="kumeler" labelledby="kumeler-title" tone="muted" class="tight-section">
    <div class="clusters-head">
      <SectionHead
        id="kumeler-title"
        eyebrow="Yetenek kümeleri"
        title="Günlük operasyonunuzun her adımı"
        lead="Her kartta ne yaptığınız, arka planda ne olduğu ve hangi kanalda hangi düzeyde çalıştığı yer alır."
        compact
      />
      <ul class="legend" aria-label="Kanal kapsamı göstergesi">
        {
          (Object.keys(LEVEL_STATE) as CapabilityLevel[]).map((l) => (
            <li>
              <span class="lvl" data-state={LEVEL_STATE[l]} aria-hidden="true">
                {l === 'supported' && <Icon name="check" size="sm" />}
              </span>
              {CAPABILITY_LEVEL_LABELS[l]}
            </li>
          ))
        }
      </ul>
    </div>

    <nav class="cluster-nav" aria-label="Yetenek kümeleri">
      {
        clusters.map((cl) => (
          <a href={`#${cl.id}`}>
            {cl.title}
          </a>
        ))
      }
    </nav>

    <div class="clusters">
      {
        clusters.map((cl) => (
          <section class="cluster" id={cl.id} aria-labelledby={`${cl.id}-title`}>
            <div class="cluster__head">
              <h3 id={`${cl.id}-title`} class="cluster__title">{cl.title}</h3>
              {cl.lead && <p class="cluster__lead">{cl.lead}</p>}
            </div>
            <ul class="cap-grid" role="list">
              {cl.items.map((c) => (
                <li>
                  <article id={c.id} class="cap-card" aria-labelledby={`${c.id}-title`} data-testid="feature">
                    <div class="cap-card__top">
                      <span class="cap-icon" aria-hidden="true">
                        <Icon name={ICON[c.id] ?? 'sparkle'} size="sm" />
                      </span>
                      <Badge tone={statusTone(c.status)}>{c.statusLabel}</Badge>
                    </div>
                    <h4 id={`${c.id}-title`} class="cap-card__title">{c.title}</h4>
                    <p class="cap-card__value">{c.action ?? c.summary}</p>
                    {c.action && <p class="cap-card__desc">{c.summary}</p>}
                    {c.caveat && (
                      <p class="caveat">
                        <Icon name="info" size="sm" />
                        <span><strong>Kapsam notu:</strong> {c.caveat}</span>
                      </p>
                    )}
                    {c.channels.length > 0 && (
                      <div class="cap-card__channels">
                        <p class="cap-card__channels-label">Kanal kapsamı</p>
                        <ul class="chan-strip" role="list" aria-label={`${c.title}: kanal kapsamı`}>
                          {c.channels.map((ch) => (
                            <li class="chan-strip__item" data-code={ch.code} title={`${ch.name}: ${CAPABILITY_LEVEL_LABELS[ch.level]}`}>
                              <ChannelMono code={ch.code} name={ch.name} size="sm" />
                              <span class="lvl lvl--badge" data-state={LEVEL_STATE[ch.level]} aria-hidden="true">
                                {ch.level === 'supported' && <Icon name="check" size="sm" />}
                              </span>
                              <span class="sr-only">
                                {ch.name}: {CAPABILITY_LEVEL_LABELS[ch.level]}
                              </span>
                            </li>
                          ))}
                        </ul>
                        <details class="cap-card__more">
                          <summary>
                            <span>Kanal ayrıntısı</span>
                            <Icon name="chevron" size="sm" />
                          </summary>
                          <ul class="chan-list" role="list">
                            {c.channels.map((ch) => (
                              <li>
                                <a class="chan-list__link" href={`/entegrasyonlar/${ch.code}`} data-code={ch.code}>
                                  <ChannelMono code={ch.code} name={ch.name} size="sm" />
                                  <span class="chan-list__name">{ch.name}</span>
                                  <LevelBadge level={ch.level} label={CAPABILITY_LEVEL_LABELS[ch.level]} />
                                </a>
                              </li>
                            ))}
                          </ul>
                        </details>
                      </div>
                    )}
                  </article>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </Section>

  <Section labelledby="sonraki-title" class="tight-section">
    <SectionHead id="sonraki-title" eyebrow="Sonraki adım" title="Ayrıntısına inin" />
    <NextLinks
      links={[
        { href: '/entegrasyonlar', icon: 'plug', title: 'Entegrasyonlar', text: 'Her kanalın hangi işlemleri hangi düzeyde desteklediği.' },
        { href: '/guvenlik', icon: 'shield', title: 'Güvenlik', text: 'Pazaryeri anahtarlarınızın ve verinizin nasıl korunduğu.' },
        { href: '/fiyatlandirma', icon: 'card', title: 'Fiyatlandırma', text: 'Planlar, ücretsiz deneme ve plan karşılaştırması.' },
      ]}
    />
  </Section>

  <CtaBand
    id="ozellik-cta"
    title="Özellikleri kendi hesabınızda deneyin"
    text="Kanallarınızı bağlayın; siparişleriniz rezervasyondan geçsin, iade ve sorular tek ekranda toplansın."
    primary={{ label: 'Ücretsiz dene', href: appUrls.register() }}
    secondary={{ label: 'Entegrasyonlar', href: '/entegrasyonlar' }}
  />
</BaseLayout>

<style>
  .tight-section:global(.section) {
    padding-block: calc(var(--site-section-y) * 0.72);
  }

  /* --- Hero kanal çipleri (S16 /entegrasyonlar ile aynı) --- */
  .hero-chans {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-2);
    margin: var(--ek-space-5) 0 0;
    padding: 0;
    list-style: none;
  }
  .hero-chan {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    min-height: calc(var(--ek-space-8) + var(--ek-space-1));
    padding-inline: var(--ek-space-3);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-full);
    background: var(--site-glass-bg);
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-medium);
    text-decoration: none;
    transition: border-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .hero-chan:hover {
    border-color: var(--chan);
  }
  .hero-chan:focus-visible {
    outline-color: var(--site-color-on-primary);
  }
  .hero-chan__dot {
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--chan);
    box-shadow: 0 0 0 calc(var(--site-border-width) * 3) color-mix(in srgb, var(--chan) 30%, transparent);
  }

  /* --- İkon karosu (S16 /guvenlik ilke ikonu ile aynı dil) --- */
  .cap-icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-10);
    height: var(--ek-space-10);
    border-radius: var(--ek-radius-lg);
    background: linear-gradient(140deg, var(--ek-color-primary), var(--ek-color-primary-darken-1));
    box-shadow: 0 var(--ek-space-2) var(--ek-space-4) calc(var(--ek-space-2) * -1) color-mix(in srgb, var(--ek-color-primary) 70%, transparent);
    color: var(--site-color-on-primary);
  }
  .cap-icon--lg {
    width: var(--ek-space-12);
    height: var(--ek-space-12);
  }

  /* --- Kapsam notu --- */
  .caveat {
    display: flex;
    gap: var(--ek-space-2);
    align-items: flex-start;
    padding: var(--ek-space-3) var(--ek-space-4);
    border: var(--site-border-width) solid color-mix(in srgb, var(--ek-color-warning) 45%, transparent);
    border-radius: var(--ek-radius-md);
    background: var(--ek-color-warning-subtle);
    color: var(--site-text-heading);
    font-size: var(--site-card-desc-size);
    line-height: var(--site-font-body-line-height);
  }
  .caveat :global(.icon) {
    flex: none;
    margin-top: 0.15em;
  }

  /* --- Öne çıkan kart --- */
  .featured {
    display: grid;
    gap: var(--ek-space-8);
    padding: var(--ek-space-8) var(--ek-space-6);
    border: var(--site-border-width) solid color-mix(in srgb, var(--ek-color-secondary) 40%, var(--ek-color-border-default));
    border-radius: var(--site-radius-panel);
    background:
      radial-gradient(70% 90% at 0% 0%, color-mix(in srgb, var(--ek-color-secondary) 10%, transparent), transparent 70%),
      var(--ek-color-surface);
    box-shadow: var(--site-shadow-card-hover);
    scroll-margin-top: calc(var(--site-header-height) + var(--ek-space-6));
  }
  .featured__body {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
    min-width: 0;
  }
  .featured__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ek-space-3);
    margin-bottom: var(--ek-space-2);
  }
  .featured__eyebrow {
    color: var(--site-link-accent);
    font-size: var(--site-card-eyebrow-size);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .featured__title {
    color: var(--site-text-heading);
    font-size: var(--site-font-display-sm);
    font-weight: var(--site-font-display-weight);
    line-height: var(--site-font-display-line-height);
    letter-spacing: var(--site-font-display-tracking);
  }
  .featured__value {
    color: var(--site-text-body);
    font-size: var(--ek-font-size-xl);
    line-height: var(--site-font-body-line-height);
  }
  .featured__desc {
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-md);
    line-height: var(--site-font-body-line-height);
  }
  .featured__link {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: var(--ek-space-2);
    min-height: var(--site-tap-target);
    margin-top: var(--ek-space-2);
    padding-inline: var(--ek-space-5);
    border-radius: var(--ek-radius-lg);
    background: var(--ek-color-primary);
    color: var(--site-color-on-primary);
    font-weight: var(--ek-font-weight-semibold);
    text-decoration: none;
    transition: background-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .featured__link:hover {
    background: var(--ek-color-primary-darken-1);
  }
  .featured__link :global(.icon) {
    transition: transform var(--ek-duration-base) var(--ek-easing-standard);
  }
  .featured__link:hover :global(.icon) {
    transform: translateX(var(--ek-space-1));
  }
  :global(html:is([data-motion='paused'], [data-motion='reduced'])) .featured__link:hover :global(.icon) {
    transform: none;
  }
  .featured__aside {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-4);
    min-width: 0;
    padding: var(--ek-space-6);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-lg);
    background: var(--ek-color-surface-muted);
  }
  .featured__aside-tag {
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .featured__points {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .featured__points li {
    display: flex;
    gap: var(--ek-space-3);
    align-items: flex-start;
    color: var(--site-text-body);
    font-size: var(--ek-font-size-md);
    line-height: var(--site-font-body-line-height);
  }
  .featured__check {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-6);
    height: var(--ek-space-6);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-secondary-darken-1);
    color: var(--site-color-on-primary);
  }

  /* --- Kümeler --- */
  .clusters-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--ek-space-6);
    margin-bottom: var(--ek-space-6);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-2) var(--ek-space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-sm);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
  }
  /* Düzey göstergesi — S16 kapsam matrisiyle aynı şekil dili (dolu + onay = destekleniyor, yarım = temel düzey). */
  .lvl {
    box-sizing: border-box;
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-5);
    height: var(--ek-space-5);
    border-radius: var(--ek-radius-full);
    color: var(--site-color-on-primary);
  }
  .lvl :global(.icon) {
    width: var(--ek-space-3);
