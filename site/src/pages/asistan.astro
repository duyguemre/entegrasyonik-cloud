---
/**
 * /asistan — "Entegrasyonik Asistan" (S18): sohbetle yönetim, yerel uygulama ve ajanlar için VİZYON sayfası.
 *
 * DÜRÜSTLÜK (tests/upcoming.test.ts): bu yetenekler ürünün bugünkü sürümünde YOK. Sayfa `UPCOMING_SURFACES`
 * listesindedir; tüm metin `src/data/assistant.ts`'ten gelir (markup'ta sabit metin yazılmaz):
 *   - Planlanan her kart bir aşama rozeti taşır (Geliştirme aşamasında / Erken erişim / Planlanan) ve gelecek kipindedir.
 *   - "Güven" bölümü KANITLI (bugün kodda; her madde repo içi evidence'a bağlı) ve PLANLANAN maddeleri görsel
 *     olarak ayırır: kanıtlı = düz çerçeve + "Kodda" etiketi; planlanan = kesikli çerçeve + aşama rozeti.
 *   - Hero sahnesi açıkça "Örnek senaryo" etiketlidir (ChatScene.astro); rakamlar yalnızca orada, örnek veridir.
 * Erken erişim: form YOK (ADR-0014) — `mailto:` (EmailActions), konu "Asistan erken erişim".
 * Bölüm ritmi: koyu hero -> açık (sohbet) -> gri (yerel) -> koyu (ajanlar) -> açık (güven) -> gri (SSS) -> koyu (CTA).
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Section from '../components/Section.astro'
import Button from '../components/Button.astro'
import Icon from '../components/home/Icon.astro'
import Breadcrumb from '../components/pages/Breadcrumb.astro'
import SectionHead from '../components/pages/SectionHead.astro'
import PageMeta from '../components/pages/PageMeta.astro'
import Accordion from '../components/pages/Accordion.astro'
import EmailActions from '../components/pages/EmailActions.astro'
import ChatScene from '../components/assistant/ChatScene.astro'
import StageBadge from '../components/assistant/StageBadge.astro'
import {
  ASSISTANT_NAME,
  ASSISTANT_PATH,
  assistantHero as hero,
  chatSection,
  localSection,
  agentsSection,
  trustSection,
  assistantFaq,
  assistantCta,
} from '../data/assistant'
import { contactEmail } from '../lib/contact'
import { breadcrumbJsonLd } from '../lib/seo'

const title = ASSISTANT_NAME
const description =
  'Entegrasyonik Asistan: stok, sipariş ve fiyat işlerinizi sohbetle yöneteceğiniz, kritik işlemleri sizin onayınıza sunacak asistan. Geliştirme aşamasında; erken erişim listesi açık.'
const crumbs = [{ label: 'Ana sayfa', href: '/' }, { label: 'Asistan' }]
const [titleBefore, titleAfter] = hero.title.split(hero.accent)
---

<BaseLayout scenes title={title} description={description}>
  <PageMeta
    slot="head"
    title={title}
    description={description}
    jsonLd={[breadcrumbJsonLd([{ label: 'Ana sayfa', path: '/' }, { label: 'Asistan', path: ASSISTANT_PATH }])]}
  />

  <!-- Hero: koyu sahne + örnek senaryo sohbeti -->
  <Section tone="stage" labelledby="page-title" class="ai-hero">
    <Breadcrumb items={crumbs} inverse />
    <div class="ai-hero__grid">
      <div class="ai-hero__body">
        <p class="ai-hero__chip">
          <span class="ai-hero__chip-icon" aria-hidden="true"><Icon name="sparkle" size="sm" /></span>
          <span data-testid="early-access-badge">{hero.badge}</span>
          <span class="ai-hero__chip-sep" aria-hidden="true"></span>
          <span class="ai-hero__chip-meta">{hero.eyebrow}</span>
        </p>
        <h1 id="page-title">{titleBefore}<span class="ai-accent">{hero.accent}</span>{titleAfter}</h1>
        <p class="ai-hero__lead">{hero.lead}</p>
        <div class="ai-hero__actions">
          <Button href="#erken-erisim" variant="inverse" size="lg">{hero.primary}</Button>
          <Button href="#sohbet" variant="inverse-outline" size="lg">{hero.secondary}</Button>
        </div>
        <p class="ai-hero__note" data-testid="assistant-status-note">
          <Icon name="info" size="sm" />
          <span>{hero.note}</span>
        </p>
      </div>
      <div class="ai-hero__visual">
        <ChatScene />
      </div>
    </div>
  </Section>

  <!-- (a) Sohbetle yönet -->
  <Section id="sohbet" labelledby="sohbet-title" class="ai-section">
    <div class="split">
      <div class="split__aside">
        <SectionHead id="sohbet-title" eyebrow={chatSection.eyebrow} title={chatSection.title} lead={chatSection.lead} compact />
        <div class="prompts">
          <p class="prompts__label">{chatSection.examplesLabel}</p>
          <ul class="prompts__list" role="list">
            {
              chatSection.examples.map((q) => (
                <li class="prompt">
                  <Icon name="chat" size="sm" />
                  <span>{q}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <ul class="cards cards--2" role="list">
        {
          chatSection.cards.map((c) => (
            <li class="pcard" data-testid="assistant-card" data-stage={c.stage}>
              <div class="pcard__top">
                <span class="pcard__icon" aria-hidden="true"><Icon name={c.icon} size="md" /></span>
                <StageBadge stage={c.stage} />
              </div>
              <h3 class="pcard__title">{c.title}</h3>
              <p class="pcard__text">{c.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- (b) Yerel uygulama + açık standart -->
  <Section id="yerel" labelledby="yerel-title" tone="muted" class="ai-section">
    <SectionHead id="yerel-title" eyebrow={localSection.eyebrow} title={localSection.title} lead={localSection.lead} />
    <div class="local">
      <ul class="cards cards--2" role="list">
        {
          localSection.cards.map((c) => (
            <li class="pcard" data-testid="assistant-card" data-stage={c.stage}>
              <div class="pcard__top">
                <span class="pcard__icon" aria-hidden="true"><Icon name={c.icon} size="md" /></span>
                <StageBadge stage={c.stage} />
              </div>
              <h3 class="pcard__title">{c.title}</h3>
              <p class="pcard__text">{c.text}</p>
            </li>
          ))
        }
      </ul>
      <aside class="protocol" aria-labelledby="protocol-title" data-testid="protocol-explainer">
        <p class="protocol__tag">{localSection.protocol.name}</p>
        <h3 id="protocol-title" class="protocol__title">{localSection.protocol.title}</h3>
        <div class="plug" aria-hidden="true">
          <span class="plug__node"><Icon name="chat" size="sm" /><span>{localSection.protocol.nodes[0]}</span></span>
          <span class="plug__wire"><span class="plug__label">{localSection.protocol.short}</span></span>
          <span class="plug__node plug__node--core"><Icon name="layers" size="sm" /><span>{localSection.protocol.nodes[1]}</span></span>
        </div>
        <p class="protocol__text">{localSection.protocol.text}</p>
        <ul class="protocol__points" role="list">
          {
            localSection.protocol.points.map((p) => (
              <li>
                <Icon name="check" size="sm" />
                <span>{p}</span>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </Section>

  <!-- (c) Ajanlar -->
  <Section id="ajanlar" labelledby="ajanlar-title" tone="stage" class="ai-section">
    <SectionHead id="ajanlar-title" eyebrow={agentsSection.eyebrow} title={agentsSection.title} lead={agentsSection.lead} inverse />
    <div class="flow" aria-label={agentsSection.flowLabel} role="group">
      {
        agentsSection.flow.map((step, i) => (
          <>
            {i > 0 && (
              <span class="flow__arrow" aria-hidden="true">
                <Icon name="arrow" size="sm" />
              </span>
            )}
            <span class:list={['flow__step', { 'flow__step--you': i === agentsSection.flow.length - 2 }]}>{step}</span>
          </>
        ))
      }
    </div>
    <ul class="cards cards--4" role="list">
      {
        agentsSection.cards.map((c) => (
          <li class:list={['pcard', 'pcard--dark', { 'pcard--lead': c.id === agentsSection.highlight.id }]} data-testid="assistant-card" data-stage={c.stage}>
            <div class="pcard__top">
              <span class="pcard__icon" aria-hidden="true"><Icon name={c.icon} size="md" /></span>
              <StageBadge stage={c.stage} inverse />
            </div>
            {c.id === agentsSection.highlight.id && <p class="pcard__flag">{agentsSection.highlight.label}</p>}
            <h3 class="pcard__title">{c.title}</h3>
            <p class="pcard__text">{c.text}</p>
          </li>
        ))
      }
    </ul>
    <p class="principle-note">
      <Icon name="shield" size="sm" />
      <span>{agentsSection.principle}</span>
    </p>
  </Section>

  <!-- (d) Güven: kanıtlı vs planlanan -->
  <Section id="guven" labelledby="guven-title" class="ai-section">
    <SectionHead id="guven-title" eyebrow={trustSection.eyebrow} title={trustSection.title} lead={trustSection.lead} />
    <div class="trust">
      <div class="trust__col" data-testid="trust-proven-group">
        <div class="trust__head">
          <span class="trust__pill trust__pill--proven"><Icon name="check" size="sm" />{trustSection.provenLabel}</span>
          <p>{trustSection.provenLead}</p>
        </div>
        <ul class="trust__grid" role="list">
          {
            trustSection.proven.map((t) => (
              <li class="tcard" data-testid="trust-proven" data-proof={t.id}>
                <span class="tcard__icon" aria-hidden="true"><Icon name={t.icon} size="sm" /></span>
                <div class="tcard__body">
                  <h3 class="tcard__title">{t.title}</h3>
                  <p class="tcard__text">{t.text}</p>
                  <p class="tcard__where">
                    <Icon name="check" size="sm" />
                    <span>{trustSection.provenTag}: {t.where}</span>
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="trust__col trust__col--planned" data-testid="trust-planned-group">
        <div class="trust__head">
          <span class="trust__pill trust__pill--planned"><Icon name="clock" size="sm" />{trustSection.plannedLabel}</span>
          <p>{trustSection.plannedLead}</p>
        </div>
        <ul class="trust__list" role="list">
          {
            trustSection.planned.map((t) => (
              <li class="tcard tcard--planned" data-testid="trust-planned" data-stage={t.stage}>
                <span class="tcard__icon" aria-hidden="true"><Icon name={t.icon} size="sm" /></span>
                <div class="tcard__body">
                  <StageBadge stage={t.stage} />
                  <h3 class="tcard__title">{t.title}</h3>
                  <p class="tcard__text">{t.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <!-- SSS -->
  <Section id="sorular" labelledby="sorular-title" tone="muted" class="ai-section" size="narrow">
    <SectionHead id="sorular-title" eyebrow={assistantFaq.eyebrow} title={assistantFaq.title} />
    <Accordion items={assistantFaq.items} />
  </Section>

  <!-- (e) Erken erişim -->
  <Section id="erken-erisim" labelledby="erken-erisim-title" tone="stage" class="ai-section ai-cta">
    <div class="cta">
      <div class="cta__body">
        <p class="cta__eyebrow">{assistantCta.eyebrow}</p>
        <h2 id="erken-erisim-title">{assistantCta.title}</h2>
        <p class="cta__text">{assistantCta.text}</p>
        <ul class="cta__points" role="list">
          {
            assistantCta.points.map((p) => (
              <li>
                <Icon name="check" size="sm" />
                <span>{p}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="cta__panel" data-testid="assistant-cta">
        <EmailActions email={contactEmail} id="asistan-erken" subject={assistantCta.subject} tone="dark" sendLabel={assistantCta.sendLabel} />
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  import '../scripts/interactions'
</script>

<style>
  .ai-section:global(.section) {
    padding-block: calc(var(--site-section-y) * 0.78);
  }

  /* ------------------------------------------------------------------ hero */
  .ai-hero:global(.section) {
    padding-block: var(--ek-space-8) calc(var(--site-section-y) * 0.7);
    overflow: hidden;
  }
  .ai-hero__grid {
    display: grid;
    gap: var(--ek-space-12);
    margin-top: var(--ek-space-8);
  }
  .ai-hero__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ek-space-5);
    min-width: 0;
  }
  .ai-hero__chip {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ek-space-2);
    margin: 0;
    padding: var(--ek-space-1) var(--ek-space-3) var(--ek-space-1) var(--ek-space-1);
    border: var(--site-border-width) solid color-mix(in srgb, var(--ek-color-secondary) 45%, transparent);
    border-radius: var(--ek-radius-full);
    background: color-mix(in srgb, var(--ek-color-secondary) 12%, transparent);
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
  }
  .ai-hero__chip-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-6);
    height: var(--ek-space-6);
    border-radius: var(--ek-radius-full);
    background: var(--site-gradient-accent-on-dark);
    color: var(--site-stage-deep);
  }
  .ai-hero__chip-sep {
    width: var(--site-border-width);
    height: var(--ek-space-4);
    background: var(--site-glass-border);
  }
  .ai-hero__chip-meta {
    color: var(--site-text-on-dark-body);
    font-weight: var(--ek-font-weight-medium);
  }
  .ai-hero__body h1 {
    max-width: 14ch;
    font-size: var(--site-font-display-lg);
    font-weight: var(--site-font-display-weight);
    line-height: var(--site-font-display-line-height);
    letter-spacing: var(--site-font-display-tracking);
  }
  .ai-accent {
    background: var(--site-gradient-accent-on-dark);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ai-hero__lead {
    max-width: 38rem;
    color: var(--site-text-on-dark-body);
    font-size: var(--ek-font-size-xl);
    line-height: var(--site-font-body-line-height);
  }
  .ai-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-3);
    margin-top: var(--ek-space-1);
  }
  .ai-hero__note {
    display: flex;
    align-items: flex-start;
    gap: var(--ek-space-2);
    max-width: 38rem;
    margin: 0;
    padding-top: var(--ek-space-4);
    border-top: var(--site-border-width) solid var(--site-glass-border);
    color: var(--site-text-on-dark-meta);
    font-size: var(--ek-font-size-sm);
    line-height: var(--ek-line-height-normal);
  }
  .ai-hero__visual {
    min-width: 0;
  }
  @media (min-width: 1024px) {
    .ai-hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      align-items: center;
    }
  }

  /* ------------------------------------------------------------------ ortak kart */
  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ek-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .cards--2,
    .cards--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1200px) {
    .cards--4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
    min-width: 0;
    padding: var(--ek-space-6);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--site-radius-panel);
    background:
      radial-gradient(90% 70% at 100% 0%, color-mix(in srgb, var(--ek-color-secondary) 7%, transparent), transparent 70%),
      var(--ek-color-surface);
    box-shadow: var(--site-shadow-card);
    transition:
      border-color var(--ek-duration-base) var(--ek-easing-standard),
      box-shadow var(--ek-duration-base) var(--ek-easing-standard);
  }
  .pcard:hover {
    border-color: color-mix(in srgb, var(--ek-color-secondary) 40%, var(--ek-color-border-default));
    box-shadow: var(--site-shadow-card-hover);
  }
  .pcard__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--ek-space-3);
  }
  .pcard__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-12);
    height: var(--ek-space-12);
    border-radius: var(--ek-radius-lg);
    background: linear-gradient(140deg, var(--ek-color-primary), var(--ek-color-primary-darken-1));
    box-shadow: 0 var(--ek-space-2) var(--ek-space-4) calc(var(--ek-space-2) * -1) color-mix(in srgb, var(--ek-color-primary) 70%, transparent);
    color: var(--site-color-on-primary);
  }
  .pcard__title {
    color: var(--site-text-heading);
    font-size: var(--site-card-title-size);
    font-weight: var(--site-card-title-weight);
    letter-spacing: -0.01em;
  }
  .pcard__text {
    color: var(--site-text-body);
    font-size: var(--ek-font-size-md);
    line-height: var(--site-font-body-line-height);
  }
  .pcard--dark {
    border-color: var(--site-glass-border);
    background:
      radial-gradient(90% 70% at 100% 0%, color-mix(in srgb, var(--ek-color-secondary) 12%, transparent), transparent 70%),
      var(--site-glass-bg);
    box-shadow: none;
  }
  .pcard--dark .pcard__icon {
    background: color-mix(in srgb, var(--ek-color-secondary) 18%, transparent);
    box-shadow: none;
    color: var(--site-accent-on-dark);
  }
  .pcard--dark .pcard__title {
    color: var(--site-text-on-dark-heading);
  }
  .pcard--dark .pcard__text {
    color: var(--site-text-on-dark-body);
  }
  .pcard--lead {
    border-color: color-mix(in srgb, var(--ek-color-secondary) 55%, transparent);
    box-shadow: inset 0 var(--site-border-width) 0 color-mix(in srgb, var(--ek-color-secondary) 55%, transparent);
  }
  .pcard__flag {
    margin: 0;
    color: var(--site-accent-on-dark);
    font-size: var(--site-card-eyebrow-size);
    font-weight: var(--site-card-eyebrow-weight);
    letter-spacing: var(--site-card-eyebrow-tracking);
    text-transform: uppercase;
  }

  /* ------------------------------------------------------------------ (a) sohbet */
  .split {
    display: grid;
    gap: var(--ek-space-10);
  }
  @media (min-width: 1024px) {
    .split {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
  }
  .split__aside {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-8);
    min-width: 0;
  }
  .prompts {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
  }
  .prompts__label {
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .prompts__list {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .prompt {
    display: flex;
    align-items: center;
    gap: var(--ek-space-3);
    padding: var(--ek-space-3) var(--ek-space-4);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-lg) var(--ek-radius-lg) var(--ek-radius-lg) var(--ek-radius-sm);
    background: var(--ek-color-surface-sunken);
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-medium);
  }
  .prompt :global(.icon) {
    flex: none;
    color: var(--site-accent);
  }

  /* ------------------------------------------------------------------ (b) yerel */
  .local {
    display: grid;
    gap: var(--ek-space-6);
  }
  @media (min-width: 1024px) {
    .local {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: stretch;
    }
  }
  /* Dar ekranda açık standart açıklaması kartlardan ÖNCE gelir (MCP'nin ne olduğu önce anlaşılsın). */
  @media (max-width: 1023.98px) {
    .protocol {
      order: -1;
    }
  }
  .protocol {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-4);
    min-width: 0;
    padding: var(--ek-space-8) var(--ek-space-6);
    overflow: hidden;
    border-radius: var(--site-radius-panel);
    background:
      radial-gradient(120% 80% at 100% 0%, color-mix(in srgb, var(--ek-color-secondary) 22%, transparent), transparent 60%),
      var(--site-gradient-stage);
    box-shadow: var(--site-shadow-panel);
    color: var(--site-text-on-dark-body);
  }
  .protocol__tag {
    color: var(--site-accent-on-dark);
    font-size: var(--site-card-eyebrow-size);
    font-weight: var(--site-card-eyebrow-weight);
    letter-spacing: var(--site-card-eyebrow-tracking);
    text-transform: uppercase;
  }
  .protocol__title {
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-2xl);
    font-weight: var(--ek-font-weight-bold);
    letter-spacing: -0.01em;
    line-height: var(--ek-line-height-tight);
  }
  .protocol__text {
    font-size: var(--ek-font-size-md);
    line-height: var(--site-font-body-line-height);
  }
  .plug {
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
    padding: var(--ek-space-4);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-lg);
    background: var(--site-glass-bg);
  }
  .plug__node {
    display: inline-flex;
    flex: 1 1 0;
    flex-direction: column;
    align-items: center;
