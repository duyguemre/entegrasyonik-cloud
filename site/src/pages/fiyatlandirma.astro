---
/**
 * /fiyatlandirma — plan karşılaştırma + deneme + fiyat SSS'si (ADR-0014 Karar 2, S4b).
 * Tüm fiyat/limit/deneme değerleri `src/data/plans.ts` seçicilerinden (repo içindeki plans.seed.json) gelir; sayfa
 * hiçbir olgusal değer sabit yazmaz. Yol haritası özellikleri (ROADMAP_VISIBLE=false) kartlarda görünmez.
 * CTA'lar uygulamaya devreder: `${PUBLIC_APP_URL}/login?mode=register&plan=<kod>&interval=<aralık>`.
 * Kurumsal (özel teklif) planın CTA'sı /iletisim'e gider; sayfa henüz yayımlanmamışsa bağlantı üretilmez (kırık link yok).
 *
 * S17 (S16 tasarım dili): koyu hero + ortak `HeroActions`; önerilen plan (kayıttan: en çok özellikli sabit fiyatlı
 * plan) şerit + yükseltilmiş kartla vurgulanır; kart altında "Her planda" paneli (`getPlanCommonFeatures()`,
 * yalnızca `available` yetenekler). Karşılaştırma tablosu fiyat/limit satırlarının ardından özellik satırlarını
 * (her planda ortak + plan eklentileri + deneme) gösterir; ≥1024 px'te başlık satırı site header'ının altına
 * yapışır (kapsayıcı kaydırma kapsayıcısı DEĞİL, S16 CoverageMatrix deseni), daha dar ekranda yatay kaydırılır ve
 * ilk sütun sabit kalır. SSS ortak `Accordion`, kapanış ortak `CtaBand` + `HelpBand`.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Section from '../components/Section.astro'
import Button from '../components/Button.astro'
import Badge from '../components/Badge.astro'
import Icon from '../components/home/Icon.astro'
import PageHero from '../components/pages/PageHero.astro'
import PageMeta from '../components/pages/PageMeta.astro'
import HeroActions from '../components/pages/HeroActions.astro'
import SectionHead from '../components/pages/SectionHead.astro'
import Accordion from '../components/pages/Accordion.astro'
import HelpBand from '../components/pages/HelpBand.astro'
import CtaBand from '../components/pages/CtaBand.astro'
import { appUrls } from '../lib/site-config'
import { breadcrumbJsonLd } from '../lib/seo'
import { primaryNav, published } from '../data/navigation'
import { getPublicPlans, getPlanSourceNotice, getVatNotice, getPublicTrial, getTrialPlanCode } from '../data/plans'
import { getComparisonRows, getPricingFaq, getPlanPitch, getPlanCommonFeatures } from '../data/pricing'

const title = 'Fiyatlandırma'
const description =
  'Entegrasyonik planlarını karşılaştırın: kanal, ürün varyantı ve kullanıcı limitleri, deneme sürümü ve sık sorulan sorular.'

const plans = getPublicPlans()
const rows = getComparisonRows(plans)
const faq = getPricingFaq()
const trial = getPublicTrial()
const trialPlanCode = getTrialPlanCode()
const proposalNotice = getPlanSourceNotice()
const vatNotice = getVatNotice()
const commonFeatures = getPlanCommonFeatures()
const crumbs = [{ label: 'Ana sayfa', href: '/' }, { label: 'Fiyatlandırma' }]

const isPublished = (href: string) => published(primaryNav).some((i) => i.href === href)
const contactHref = isPublished('/iletisim') ? '/iletisim' : undefined
const faqPageHref = isPublished('/sss') ? '/sss' : undefined

const fmt = (n: number) => new Intl.NumberFormat('tr-TR').format(n)
const registerPlan = plans.find((p) => p.code === trialPlanCode) ?? plans.find((p) => p.priceKind === 'fixed')
const closingHref = appUrls.register({ plan: registerPlan?.code, interval: registerPlan?.interval })

// Hero görseli: sabit fiyatlı planlar ARTAN fiyat sırasındadır (getPublicPlans() garantisi) — çubuk yüksekliği
// bu sıraya göre CSS'te (nth-child) kademelenir. Inline `style` KULLANILMAZ (CSP `style-src 'self'`).
const fixedPlans = plans.filter((p) => p.priceKind === 'fixed')
// Görsel vurgu: en çok özelliği içeren sabit fiyatlı plan (gerçek veriden, iddia metni eklenmez).
const featuredCode = [...fixedPlans].sort((a, b) => b.features.length - a.features.length)[0]?.code

type LimitKey = (typeof plans)[number]['limits'][number]['key']
const LIMIT_ICON: Record<LimitKey, 'plug' | 'layers' | 'users'> = { channels: 'plug', skus: 'layers', users: 'users' }

// Karşılaştırma: plan eklentisi satırları — planlardaki özellik kodlarının birleşimi (kayıt sırası korunur).
const planFeatureRows = [...new Map(plans.flatMap((p) => p.features.map((f) => [f.code, f.label] as const))).entries()].map(
  ([code, label]) => ({ code, label, cells: plans.map((p) => p.features.some((f) => f.code === code)) }),
)
const trialDaysLabel = `${fmt(trial.days)} gün`
---

<BaseLayout title={title} description={description}>
  <PageMeta
    slot="head"
    title={title}
    description={description}
    jsonLd={[breadcrumbJsonLd([{ label: 'Ana sayfa', path: '/' }, { label: title, path: '/fiyatlandirma' }])]}
  />

  <PageHero
    title="İşinize uygun planı seçin"
    eyebrow="Fiyatlandırma"
    lead="Çok kanallı satış operasyonunuzu ölçeğinize uygun planla yönetin. Ücretsiz denemeyle başlayın; kanal, ürün ve ekip sayınız büyüdükçe planınızı uygulama içinden yükseltin."
    crumbs={crumbs}
  >
    <HeroActions
      actions={[
        { label: 'Planları karşılaştırın', href: '#karsilastir' },
        { label: 'Sık sorulan sorular', href: '#fiyat-sss' },
      ]}
    />
    {
      (proposalNotice || vatNotice) && (
        <div class="notice" role="note" data-testid="pricing-notice">
          <Icon name="info" size="sm" />
          <div>
            {proposalNotice && <strong>{proposalNotice}</strong>}
            <span>Fiyatlar ve plan içerikleri taslaktır; nihai değerler onaylandığında güncellenir.{vatNotice ? ` ${vatNotice}` : ''}</span>
          </div>
        </div>
      )
    }
    <Fragment slot="visual">
      <p class="panel-tag">Aylık fiyat kademesi</p>
      <ul class="tier-chart" role="list">
        {
          fixedPlans.map((p) => (
            <li data-featured={p.code === featuredCode ? 'true' : undefined}>
              <span class="tier-chart__price">{p.priceLabel}</span>
              <span class="tier-chart__bar" aria-hidden="true" />
              <span class="tier-chart__name">{p.name}</span>
            </li>
          ))
        }
      </ul>
      <p class="panel-caption">Kurumsal plan özel tekliftir; sabit fiyat gösterilmez.</p>
    </Fragment>
  </PageHero>

  <Section id="planlar" tone="muted" labelledby="plans-title" class="tight-section">
    <SectionHead
      id="plans-title"
      eyebrow="Planlar"
      title="Ölçeğinize uygun plan"
      lead="Her plan aynı çekirdekle gelir; kanal, ürün varyantı ve kullanıcı limitleri ölçeğinize göre değişir."
    />
    <ul class="plans" data-testid="plan-cards" role="list">
      {
        plans.map((plan) => {
          const isTrialPlan = trialPlanCode === plan.code
          const isFeatured = plan.code === featuredCode
          const pitch = getPlanPitch(plan.code)
          return (
            <li class="plan" data-plan={plan.code}>
              <article aria-labelledby={`plan-${plan.code}-name`} class:list={['plan__card', { 'plan__card--featured': isFeatured }]}>
                {isFeatured && <p class="plan__ribbon">Önerilen</p>}
                <header class="plan__head">
                  <h3 id={`plan-${plan.code}-name`}>{plan.name}</h3>
                  {pitch && <p class="plan__pitch">{pitch.headline}</p>}
                  {plan.tagline && <p class="plan__tagline">{plan.tagline}</p>}
                </header>

                <div class="plan__pricebox">
                  <div class="plan__price">
                    <span class="plan__amount" data-testid="plan-price">{plan.priceLabel}</span>
                    {plan.periodLabel && <span class="plan__period">{plan.periodLabel}</span>}
                  </div>
                  <p class="plan__vat">{plan.vatLabel || 'Kapsama göre size özel'}</p>
                  {isTrialPlan && (
                    <Badge tone="info" class="plan__trial">
                      {fmt(trial.days)} gün ücretsiz deneme{trial.cardRequired ? '' : ' · kart gerekmez'}
                    </Badge>
                  )}
                </div>

                <ul class="plan__list" aria-label={`${plan.name} plan limitleri`}>
                  {plan.limits.map((l) => (
                    <li>
                      <span class="plan__list-icon" aria-hidden="true"><Icon name={LIMIT_ICON[l.key]} size="sm" /></span>
                      <span class="plan__list-label">{l.label}</span>
                      <span class="plan__list-value">{l.value === null ? 'Özel limit' : fmt(l.value)}</span>
                    </li>
                  ))}
                </ul>

                {plan.features.length > 0 && (
                  <ul class="plan__features" aria-label={`${plan.name} plan özellikleri`}>
                    {plan.features.map((f) => (
                      <li>
                        <span class="plan__check" aria-hidden="true"><Icon name="check" size="sm" /></span>
                        <span>{f.label}</span>
                      </li>
                    ))}
                  </ul>
                )}

                <div class="plan__cta">
                  {plan.cta === 'trial' ? (
                    <Button
                      href={appUrls.register({ plan: plan.code, interval: plan.interval })}
                      variant={isFeatured || (!featuredCode && isTrialPlan) ? 'primary' : 'secondary'}
                      size="lg"
                      aria-label={`${plan.name} planı için ${isTrialPlan ? 'ücretsiz dene' : 'planı seç'}`}
                      data-testid="plan-cta"
                    >
                      {isTrialPlan ? 'Ücretsiz dene' : 'Planı seç'}
                    </Button>
                  ) : contactHref ? (
                    <Button href={contactHref} variant="secondary" size="lg" aria-label={`${plan.name} plan için teklif iste`} data-testid="plan-cta">
                      Teklif iste
                    </Button>
                  ) : (
                    <p class="plan__cta-note">Teklif için iletişim bilgileri hazırlanıyor.</p>
                  )}
                </div>
              </article>
            </li>
          )
        })
      }
    </ul>

    {
      commonFeatures.length > 0 && (
        <div class="common" data-testid="plan-common">
          <div class="common__head">
            <p class="common__title">Her planda</p>
            <a class="common__link" href="/ozellikler">
              Tüm özellikler <Icon name="arrow" size="sm" />
            </a>
          </div>
          <ul class="common__list" role="list">
            {commonFeatures.map((f) => (
              <li>
                <span class="plan__check" aria-hidden="true"><Icon name="check" size="sm" /></span>
                <span>{f}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </Section>

  <Section id="karsilastir" labelledby="compare-title" class="tight-section">
    <SectionHead
      id="compare-title"
      eyebrow="Karşılaştırma"
      title="Planları karşılaştırın"
      lead="Fiyat, limit ve özellikleri yan yana görün; tablo kaydırılırken plan adları üstte kalır."
    />
    <div class="table-wrap" role="region" aria-label="Plan karşılaştırma tablosu" tabindex="0">
      <table class="compare__table" data-testid="compare-table">
        <caption class="sr-only">Planların fiyat, limit ve özellik karşılaştırması</caption>
        <thead>
          <tr>
            <th scope="col">Plan</th>
            {
              plans.map((p) => (
                <th scope="col" class:list={{ 'is-featured': p.code === featuredCode }}>
                  {p.name}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          <tr class="compare__price-row" data-row-kind="limit">
            <th scope="row">{plans[0]?.intervalLabel} fiyat</th>
            {plans.map((p) => (
              <td class:list={{ 'is-featured': p.code === featuredCode }}>
                <span class="cell-strong">{p.priceLabel}</span>
                {p.vatLabel && <span class="cell-note">{p.vatLabel}</span>}
              </td>
            ))}
          </tr>
          {
            rows.map((row) => (
              <tr data-row-kind="limit">
                <th scope="row">{row.label}</th>
                {row.cells.map((c) => (
                  <td class:list={{ 'is-featured': c.planCode === featuredCode }}>{c.value === null ? 'Özel limit' : fmt(c.value)}</td>
                ))}
              </tr>
            ))
          }
          <tr class="compare__group">
            <td colspan={plans.length + 1}>Özellikler</td>
          </tr>
          <tr data-row-kind="feature">
            <th scope="row">Ücretsiz deneme</th>
            {plans.map((p) => (
              <td class:list={{ 'is-featured': p.code === featuredCode }}>
                {p.code === trialPlanCode ? (
                  <span class="cell-strong">{trialDaysLabel}</span>
                ) : (
                  <>
                    <span class="cell-dash" aria-hidden="true" />
                    <span class="sr-only">Yok</span>
                  </>
                )}
              </td>
            ))}
          </tr>
          {
            commonFeatures.map((f) => (
              <tr data-row-kind="feature">
                <th scope="row">{f}</th>
                {plans.map((p) => (
                  <td class:list={{ 'is-featured': p.code === featuredCode }}>
                    <span class="cell-check" aria-hidden="true"><Icon name="check" size="sm" /></span>
                    <span class="sr-only">Dahil</span>
                  </td>
                ))}
              </tr>
            ))
          }
          {
            planFeatureRows.map((r) => (
              <tr data-row-kind="feature">
                <th scope="row">{r.label}</th>
                {r.cells.map((has, idx) => (
                  <td class:list={{ 'is-featured': plans[idx].code === featuredCode }}>
                    {has ? (
                      <>
                        <span class="cell-check" aria-hidden="true"><Icon name="check" size="sm" /></span>
                        <span class="sr-only">Dahil</span>
                      </>
                    ) : (
                      <>
                        <span class="cell-dash" aria-hidden="true" />
                        <span class="sr-only">Dahil değil</span>
                      </>
                    )}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="compare__note">Plan içerikleri taslaktır; nihai kapsam onaylandığında güncellenir.</p>
  </Section>

  <Section id="fiyat-sss" tone="muted" labelledby="faq-title" size="narrow" class="tight-section">
    <SectionHead id="faq-title" eyebrow="SSS" title="Fiyatlandırma hakkında sorular" />
    <div data-testid="pricing-faq">
      <Accordion items={faq} />
    </div>
    <ul class="doc-links" role="list" aria-label="İlgili belgeler">
      {faqPageHref && (
        <li>
          <a href={faqPageHref}><Icon name="help" size="sm" />Tüm sık sorulan sorular</a>
        </li>
      )}
      <li>
        <a href="/yasal/abonelik-sozlesmesi"><Icon name="book" size="sm" />Abonelik sözleşmesi</a>
      </li>
      <li>
        <a href="/yasal/iptal-iade"><Icon name="book" size="sm" />İptal ve iade koşulları</a>
      </li>
    </ul>
    <HelpBand title="Planınızdan emin değil misiniz?" text="Operasyonunuzu anlatın, size uygun planı birlikte seçelim." links={[{ label: 'Bize yazın', href: '/iletisim' }, { label: 'Destek merkezi', href: '/destek' }]} />
  </Section>

  <CtaBand
    id="cta-title"
    title="Tüm kanallarınızı tek panelde yönetmeye bugün başlayın"
    text="Ücretsiz denemeyle pazaryeri hesaplarınızı bağlayın; merkezi stok yönetimi, overselling koruması ve birleşik sipariş akışını kendi operasyonunuzda görün."
    primary={{ label: 'Ücretsiz dene', href: closingHref }}
    secondary={{ label: 'Giriş yap', href: appUrls.login() }}
  />
</BaseLayout>

<style>
  .tight-section:global(.section) {
    padding-block: calc(var(--site-section-y) * 0.72);
  }

  /* --- Hero --- */
  /* Taslak fiyat notu (ürün kararı bekliyor): kaldırılmaz; cam zeminli küçük dipnot. */
  .notice {
    display: flex;
    gap: var(--ek-space-2);
    align-items: flex-start;
    max-width: var(--site-measure);
    margin-top: var(--ek-space-3);
    padding: var(--ek-space-3) var(--ek-space-4);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-lg);
    background: var(--site-glass-bg);
    color: var(--site-text-on-dark-body);
    font-size: var(--ek-font-size-xs);
    line-height: var(--site-font-body-line-height);
  }
  .notice :global(.icon) {
    flex: none;
    margin-top: 0.1em;
    color: var(--site-accent-on-dark);
  }
  .notice div {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
  }
  .notice strong {
    color: var(--site-text-on-dark-heading);
    font-weight: var(--ek-font-weight-semibold);
  }
  .panel-tag {
    margin: 0 0 var(--ek-space-5);
    color: var(--site-text-on-dark-meta);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .panel-caption {
    margin: var(--ek-space-5) 0 0;
    padding-top: var(--ek-space-4);
    border-top: var(--site-border-width) solid var(--site-glass-border);
    color: var(--site-text-on-dark-body);
    font-size: var(--ek-font-size-sm);
  }
  .tier-chart {
    display: flex;
    align-items: flex-end;
    gap: var(--ek-space-6);
    height: calc(var(--ek-space-16) * 2.4);
    margin: 0;
    padding: 0 var(--ek-space-4);
    list-style: none;
  }
  .tier-chart li {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    height: 100%;
    gap: var(--ek-space-2);
  }
  .tier-chart__bar {
    display: block;
    width: 100%;
    max-width: var(--ek-space-16);
    /* Planlar artan fiyat sırasındadır (getPublicPlans()); yükseklik bu sıraya göre kademelenir. */
    height: 40%;
    border-radius: var(--ek-radius-md) var(--ek-radius-md) 0 0;
    background: linear-gradient(180deg, color-mix(in srgb, var(--ek-color-secondary) 55%, transparent), color-mix(in srgb, var(--ek-color-secondary) 12%, transparent));
    box-shadow: inset 0 var(--site-border-width) 0 color-mix(in srgb, var(--ek-color-secondary) 80%, transparent);
  }
  .tier-chart li:nth-child(2) .tier-chart__bar {
    height: 68%;
  }
  .tier-chart li:nth-child(3) .tier-chart__bar {
    height: 90%;
  }
  .tier-chart li[data-featured] .tier-chart__bar {
    background: linear-gradient(180deg, var(--ek-color-secondary), color-mix(in srgb, var(--ek-color-secondary) 45%, var(--ek-color-primary-darken-1)));
  }
  .tier-chart__name {
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
  }
  .tier-chart__price {
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-lg);
    font-weight: var(--ek-font-weight-bold);
    font-variant-numeric: tabular-nums;
  }

  /* --- Plan kartları --- */
  .plans {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--ek-space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .plan {
    display: flex;
    min-width: 0;
  }
  .plan__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-5);
    width: 100%;
    padding: var(--ek-space-8) var(--ek-space-6) var(--ek-space-6);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--site-radius-panel);
    background: var(--ek-color-surface);
    box-shadow: var(--site-shadow-card);
    transition:
      border-color var(--ek-duration-base) var(--ek-easing-standard),
      box-shadow var(--ek-duration-base) var(--ek-easing-standard);
  }
  .plan__card:hover,
  .plan__card:focus-within {
    border-color: var(--ek-color-border-strong);
    box-shadow: var(--site-shadow-card-hover);
  }
  .plan__card--featured {
    border: calc(var(--site-border-width) * 2) solid var(--ek-color-secondary-darken-1);
    background:
      radial-gradient(90% 50% at 50% 0%, color-mix(in srgb, var(--ek-color-secondary) 12%, transparent), transparent 70%),
      var(--ek-color-surface);
    box-shadow: var(--site-shadow-card-hover);
  }
  .plan__card--featured:hover,
  .plan__card--featured:focus-within {
    border-color: var(--ek-color-secondary-darken-1);
  }
  .plan__ribbon {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 50%;
    padding: var(--ek-space-1) var(--ek-space-4);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-secondary-darken-1);
    color: var(--site-color-on-primary);
    font-size: var(--site-card-eyebrow-size);
    font-weight: var(--ek-font-weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: translate(-50%, -50%);
  }
  .plan__head {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
  }
  .plan__head h3 {
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-2xl);
    font-weight: var(--ek-font-weight-bold);
    letter-spacing: -0.01em;
  }
  .plan__pitch {
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-semibold);
  }
  .plan__tagline {
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-md);
    line-height: var(--site-font-body-line-height);
  }
  .plan__pricebox {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
    padding-block: var(--ek-space-4);
    border-block: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .plan__price {
    display: flex;
    align-items: baseline;
    gap: var(--ek-space-1);
  }
  .plan__amount {
    color: var(--site-text-heading);
    font-size: var(--site-font-display-sm);
    font-weight: var(--site-font-display-weight);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--site-font-display-tracking);
    line-height: 1.1;
  }
