---
/**
 * /fiyatlandirma — plan seçimi (ADR-0014 Karar 2, S4b; S17; S25 K46; S27b SR4-10 üst seviye fiyat sayfası).
 *
 * VERİ: tüm fiyat/limit/deneme değerleri tek görünüm kaydından — `src/data/plan-cards.ts` (`getPlanCards`,
 * `getPlanTrustPoints`, `getPlanNotice`, `getBillingIntervals`); o da `plans.ts` (repo içi seed) ve `pricing.ts`
 * kopyasını okur. Anasayfa planlar bölümü (S27a) AYNI kaydı kullanır. Sayfa hiçbir olgusal değer sabit yazmaz;
 * uydurma fiyat/indirim yok (yıllık seçenek seed'de yok → aralık geçişi gösterilmez).
 *
 * KURGU (S27b): koyu, ortalı kısa hero (vaat + güven çipleri + taslak notu) → kartlar hero'nun alt kenarına taşar
 * (göz ilk ekranda fiyatı görür) → önerilen plan koyu "vitrin" kartı (sayfanın tek koyu kartı; "her planda" çekirdeği ilk kartta, tekrar şeridi yok)
 * → kanıtlanabilir güven unsurları (kayıttan) → Otopilot her planda (K46; açık zeminde merdiven) → karşılaştırma
 * tablosu (grup ikonları, öne çıkan sütun) → iki sütunlu SSS (+ belgeler, yardım) → kapanış (ücretsiz deneme + demo).
 * Koyu sahne sayısı: hero + kapanış (BRAND §4). CTA'lar uygulamaya devreder:
 * `${PUBLIC_APP_URL}/login?mode=register&plan=<kod>&interval=<aralık>`; Kurumsal → /iletisim (yayımlı değilse not).
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import { crumbsFor } from '../data/seo'
import Section from '../components/Section.astro'
import Container from '../components/Container.astro'
import Button from '../components/Button.astro'
import Eyebrow from '../components/Eyebrow.astro'
import Icon from '../components/home/Icon.astro'
import PageHero from '../components/pages/PageHero.astro'
import SectionHead from '../components/pages/SectionHead.astro'
import Accordion from '../components/pages/Accordion.astro'
import HelpBand from '../components/pages/HelpBand.astro'
import CtaBand from '../components/pages/CtaBand.astro'
import { appUrls } from '../lib/site-config'
import { contactEmail, mailtoHref } from '../lib/contact'
import { primaryNav, published } from '../data/navigation'
import { getPublicPlans, getPublicTrial, getTrialPlanCode } from '../data/plans'
import { getComparisonRows, getPricingFaq, getPlanCommonFeatures, getPlanAgentRows, planAgentIntro } from '../data/pricing'
import { getPlanCards, getPlanTrustPoints, getPlanNotice, getBillingIntervals } from '../data/plan-cards'
import { AGENT_BRAND, AGENT_PATH } from '../data/agent-brand'

const plans = getPublicPlans()
const cards = getPlanCards(plans)
const rows = getComparisonRows(plans)
const faq = getPricingFaq()
const trial = getPublicTrial()
const trialPlanCode = getTrialPlanCode()
const notice = getPlanNotice()
const trust = getPlanTrustPoints()
const intervals = getBillingIntervals(plans)
const commonFeatures = getPlanCommonFeatures()
const agentRows = getPlanAgentRows(plans)
const crumbs = crumbsFor('/fiyatlandirma')

const isPublished = (href: string) => published(primaryNav).some((i) => i.href === href)
const faqPageHref = isPublished('/sss') ? '/sss' : undefined
const featuresHref = isPublished('/ozellikler') ? '/ozellikler' : undefined

const fmt = (n: number) => new Intl.NumberFormat('tr-TR').format(n)
const registerPlan = plans.find((p) => p.code === trialPlanCode) ?? plans.find((p) => p.priceKind === 'fixed')
const closingHref = appUrls.register({ plan: registerPlan?.code, interval: registerPlan?.interval })
const demoHref = mailtoHref(contactEmail, 'Entegrasyonik demo talebi')
const featuredCode = cards.find((c) => c.recommended)?.code
// Hero çipleri: güven kaydının ilk üç öğesi (deneme, kart, ajan ürünü); tamamı kartların altında şerit olarak.
const heroChips = trust.filter((t) => ['trial', 'card', 'agent'].includes(t.id))
const ladder = cards.filter((c) => c.agent)

// Karşılaştırma: plan eklentisi satırları — planlardaki özellik kodlarının birleşimi (kayıt sırası korunur).
const planFeatureRows = [...new Map(plans.flatMap((p) => p.features.map((f) => [f.code, f.label] as const))).entries()].map(
  ([code, label]) => ({ code, label, cells: plans.map((p) => p.features.some((f) => f.code === code)) }),
)
---

<BaseLayout>
  <PageHero
    title="İşinize uygun planı seçin"
    accent="uygun planı"
    eyebrow="Fiyatlandırma"
    lead="Bugün ihtiyacınız olan kapasiteyle başlayın; kanal, ürün ve ekip sayınız büyüdükçe planınızı uygulama içinden yükseltin."
    crumbs={crumbs}
    align="center"
    overlap
  >
    <ul class="hero-chips" role="list" aria-label="Plan güvenceleri">
      {
        heroChips.map((t) => (
          <li>
            <Icon name={t.icon} size="sm" />
            <span>
              {t.meta && <strong>{t.meta}</strong>} {t.label}
            </span>
          </li>
        ))
      }
    </ul>
    {
      notice && (
        <p class="notice" role="note" data-testid="pricing-notice" data-proposal-notice={notice.internal}>
          <Icon name="info" size="sm" />
          {notice.visitor}
        </p>
      )
    }
  </PageHero>

  <section id="planlar" class="plans-section" aria-labelledby="plans-title">
    <Container class="plans-wrap">
      <h2 id="plans-title" class="sr-only">Planlar</h2>
      {
        intervals.length > 1 && (
          <p class="interval-note" data-testid="interval-options">
            {intervals.map((i) => (i === 'year' ? 'Yıllık' : 'Aylık')).join(' · ')}
          </p>
        )
      }
      <ul class="plans" data-testid="plan-cards" role="list">
        {
          cards.map((c) => (
            <li class:list={['plan', { 'plan--featured': c.recommended }]} data-plan={c.code}>
              <article
                aria-labelledby={`plan-${c.code}-name`}
                class:list={['plan__card', { 'plan__card--featured': c.recommended }]}
                data-surface={c.recommended ? 'dark' : undefined}
              >
                {c.recommended && (
                  <p class="plan__ribbon">
                    <Icon name="sparkle" size="sm" />
                    Önerilen
                  </p>
                )}
                <header class="plan__head">
                  <h3 id={`plan-${c.code}-name`} class="plan__name">{c.name}</h3>
                  {c.headline && <p class="plan__pitch">{c.headline}</p>}
                </header>

                <div class="plan__pricebox">
                  <p class="plan__price">
                    <span class:list={['plan__amount', { 'plan__amount--quote': c.price.kind === 'quote' }]} data-testid="plan-price">
                      {c.price.label}
                    </span>
                    {c.price.period && <span class="plan__period">{c.price.period}</span>}
                  </p>
                  <p class="plan__vat">{c.price.note}</p>
                  {c.trial && <p class="plan__trial">{c.trial.label}</p>}
                </div>

                <div class="plan__cta">
                  {c.cta.href ? (
                    <Button
                      href={c.cta.href}
                      variant={c.recommended ? 'inverse' : c.cta.kind === 'trial' ? 'primary' : 'secondary'}
                      size="lg"
                      aria-label={c.cta.ariaLabel}
                      data-testid="plan-cta"
                    >
                      {c.cta.label}
                    </Button>
                  ) : null}
                  {!c.trial && <p class="plan__cta-note">{c.cta.note}</p>}
                </div>

                {c.tagline && <p class="plan__tagline">{c.tagline}</p>}

                <ul class="plan__limits" aria-label={`${c.name} plan limitleri`}>
                  {c.limits.map((l) => (
                    <li>
                      <span class="plan__limit-icon" aria-hidden="true">
                        <Icon name={l.icon} size="sm" />
                      </span>
                      <span class="plan__limit-label">{l.label}</span>
                      <span class="plan__limit-value">{l.display}</span>
                    </li>
                  ))}
                </ul>

                {c.includes.length > 0 && (
                  <div class="plan__inc">
                    <p class="plan__inc-label">{c.includesLabel}</p>
                    <ul class="plan__features" aria-label={`${c.name} plan özellikleri`}>
                      {[...new Set([...c.includes, ...c.addOns])].map((f) => (
                        <li>
                          <span class="plan__check" aria-hidden="true">
                            <Icon name="check" size="sm" />
                          </span>
                          <span>{f}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {c.agent && (
                  <div class="plan__agent" data-testid="plan-agent">
                    <p class="plan__agent-title">
                      <Icon name="sparkle" size="sm" />
                      {c.agent.title}
                    </p>
                    {c.agent.previous && <p class="plan__agent-prev">{c.agent.previous} planındakilere ek olarak:</p>}
                    <ul class="plan__agent-list" role="list">
                      {c.agent.items.map((it) => (
                        <li>{it}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </article>
            </li>
          ))
        }
      </ul>

      <ul class="trust" role="list" aria-label="Güvenceler" data-testid="plan-trust">
        {
          trust.map((t) => (
            <li class="trust__item" data-trust={t.id}>
              <span class="trust__icon" aria-hidden="true">
                <Icon name={t.icon} size="sm" />
              </span>
              <span class="trust__text">
                {t.meta ? (
                  <>
                    <strong>{t.meta}</strong> {t.label}
                  </>
                ) : (
                  t.label
                )}
              </span>
            </li>
          ))
        }
      </ul>
      {
        featuresHref && (
          <p class="trust__more">
            <a class="link" href={featuresHref}>
              Her planda gelen özelliklerin tamamı <Icon name="arrow" size="sm" />
            </a>
          </p>
        )
      }
    </Container>
  </section>

  {
    ladder.length > 0 && (
      <Section id="ajan-her-planda" labelledby="agent-plan-title" class="tight-section">
        <div class="agent-plan" data-testid="plan-ai">
          <div class="agent-plan__copy">
            <Eyebrow icon="sparkle">{planAgentIntro.eyebrow}</Eyebrow>
            <h2 id="agent-plan-title" class="agent-plan__title">
              {planAgentIntro.title}
            </h2>
            <p class="agent-plan__text">{planAgentIntro.text}</p>
            <ul class="agent-plan__points" role="list">
              {planAgentIntro.points.map((pt) => (
                <li>
                  <Icon name="check" size="sm" />
                  {pt}
                </li>
              ))}
            </ul>
            <a class="link" href={AGENT_PATH}>
              {AGENT_BRAND} nasıl çalışır <Icon name="arrow" size="sm" />
            </a>
          </div>
          <ol class="agent-ladder" aria-label={`${AGENT_BRAND}: planlara göre yetki`}>
            {ladder.map((c, i) => (
              <li class:list={['agent-ladder__step', { 'is-featured': c.recommended }]} data-plan={c.code} data-step={i + 1}>
                <p class="agent-ladder__name">
                  <span class="agent-ladder__level" aria-hidden="true">
                    {ladder.map((_, j) => (
                      <span class:list={{ on: j <= i }} />
                    ))}
                  </span>
                  {c.name}
                </p>
                {c.agent!.previous && <p class="agent-ladder__prev">{c.agent!.previous} planındakilere ek olarak</p>}
                <ul class="agent-ladder__list" role="list">
                  {c.agent!.items.map((it) => (
                    <li>
                      <Icon name="check" size="sm" />
                      {it}
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
        </div>
      </Section>
    )
  }

  <Section id="karsilastir" tone="muted" labelledby="compare-title" class="tight-section">
    <SectionHead
      id="compare-title"
      eyebrow="Karşılaştırma"
      title="Planları yan yana görün"
      lead={`Limitler, özellikler ve ${AGENT_BRAND} yetkileri tek tabloda; tablo kaydırılırken plan adları üstte kalır.`}
    />
    <div class="table-wrap" role="region" aria-label="Plan karşılaştırma tablosu" tabindex="0">
      <table class="compare__table" data-testid="compare-table">
        <caption class="sr-only">Planların fiyat, limit ve özellik karşılaştırması</caption>
        <thead>
          <tr>
            <th scope="col">Plan</th>
            {
              plans.map((p) => (
                <th scope="col" class:list={{ 'is-featured': p.code === featuredCode }}>
                  {p.name}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          <tr class="compare__price-row" data-row-kind="limit">
            <th scope="row">{plans[0]?.intervalLabel} fiyat</th>
            {plans.map((p) => (
              <td class:list={{ 'is-featured': p.code === featuredCode }}>
                <span class="cell-price">{p.priceLabel}</span>
                {p.vatLabel && <span class="cell-note">{p.vatLabel}</span>}
              </td>
            ))}
          </tr>
          {
            rows.map((row) => (
              <tr data-row-kind="limit">
                <th scope="row">{row.label}</th>
                {row.cells.map((c) => (
                  <td class:list={{ 'is-featured': c.planCode === featuredCode }}>{c.value === null ? 'Özel limit' : fmt(c.value)}</td>
                ))}
              </tr>
            ))
          }
          <tr class="compare__group">
            <td colspan={plans.length + 1}>
              <span class="compare__group-label">
                <Icon name="layers" size="sm" />
                Özellikler
              </span>
            </td>
          </tr>
          <tr data-row-kind="feature">
            <th scope="row">Ücretsiz deneme</th>
            {plans.map((p) => (
              <td class:list={{ 'is-featured': p.code === featuredCode }}>
                {p.code === trialPlanCode ? (
                  <span class="cell-strong">{fmt(trial.days)} gün</span>
                ) : (
                  <>
                    <span class="cell-dash" aria-hidden="true" />
                    <span class="sr-only">Yok</span>
                  </>
                )}
              </td>
            ))}
          </tr>
          {
            commonFeatures.map((f) => (
              <tr data-row-kind="feature">
                <th scope="row">{f}</th>
                {plans.map((p) => (
                  <td class:list={{ 'is-featured': p.code === featuredCode }}>
                    <span class="cell-check" aria-hidden="true">
                      <Icon name="check" size="sm" />
                    </span>
                    <span class="sr-only">Dahil</span>
                  </td>
                ))}
              </tr>
            ))
          }
          {
            planFeatureRows.map((r) => (
              <tr data-row-kind="feature">
                <th scope="row">{r.label}</th>
                {r.cells.map((has, idx) => (
                  <td class:list={{ 'is-featured': plans[idx].code === featuredCode }}>
                    {has ? (
                      <>
                        <span class="cell-check" aria-hidden="true">
                          <Icon name="check" size="sm" />
                        </span>
                        <span class="sr-only">Dahil</span>
                      </>
                    ) : (
                      <>
                        <span class="cell-dash" aria-hidden="true" />
                        <span class="sr-only">Dahil değil</span>
                      </>
                    )}
                  </td>
                ))}
              </tr>
            ))
          }
          <tr class="compare__group compare__group--agent">
            <td colspan={plans.length + 1}>
              <span class="compare__group-label">
                <Icon name="sparkle" size="sm" />
                {AGENT_BRAND} (her planda dahil)
              </span>
            </td>
          </tr>
          {
            agentRows.map((r) => (
              <tr data-row-kind="agent">
                <th scope="row">{r.label}</th>
                {r.cells.map(({ planCode, cell }) => (
                  <td class:list={{ 'is-featured': planCode === featuredCode }}>
                    {cell.kind === 'check' ? (
                      <>
                        <span class="cell-check" aria-hidden="true">
                          <Icon name="check" size="sm" />
                        </span>
                        <span class="sr-only">Dahil</span>
                      </>
                    ) : cell.kind === 'text' ? (
                      <span class="cell-strong">{cell.text}</span>
                    ) : (
                      <>
                        <span class="cell-dash" aria-hidden="true" />
                        <span class="sr-only">Dahil değil</span>
                      </>
                    )}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
        <tfoot>
          <tr>
            <th scope="row">
              <span class="sr-only">Plan seçimi</span>
            </th>
            {
              cards.map((c) => (
                <td class:list={{ 'is-featured': c.recommended }}>
                  {c.cta.href && (
                    <a class="compare__cta" href={c.cta.href} aria-label={c.cta.ariaLabel}>
                      {c.cta.label}
                      <Icon name="arrow" size="sm" />
                    </a>
                  )}
                </td>
              ))
            }
          </tr>
        </tfoot>
      </table>
    </div>
  </Section>

  <Section id="fiyat-sss" labelledby="faq-title" class="tight-section">
    <div class="faq-grid">
      <div class="faq-grid__aside">
        <SectionHead id="faq-title" eyebrow="SSS" title="Fiyatlandırma hakkında sorular" lead="Deneme, faturalama ve plan değişikliği hakkında merak edilenler." compact />
        <ul class="doc-links" role="list" aria-label="İlgili belgeler">
          {
            faqPageHref && (
              <li>
                <a href={faqPageHref}>
                  <Icon name="help" size="sm" />
                  Tüm sık sorulan sorular
                </a>
              </li>
            )
          }
          <li>
            <a href="/yasal/abonelik-sozlesmesi">
              <Icon name="book" size="sm" />
              Abonelik sözleşmesi
            </a>
          </li>
          <li>
            <a href="/yasal/iptal-iade">
              <Icon name="book" size="sm" />
              İptal ve iade koşulları
            </a>
          </li>
        </ul>
      </div>
      <div class="faq-grid__main">
        <div data-testid="pricing-faq">
          <Accordion items={faq} />
        </div>
        <HelpBand
          title="Planınızdan emin değil misiniz?"
          text="Operasyonunuzu anlatın, size uygun planı birlikte seçelim."
          links={[
            { label: 'Bize yazın', href: '/iletisim' },
            { label: 'Destek merkezi', href: '/destek' },
          ]}
        />
      </div>
    </div>
  </Section>

  <CtaBand
    id="cta-title"
    title="Operasyonunuzu bugün tek merkeze taşıyın"
    text={`Ücretsiz denemeyle kanallarınızı bağlayın; stok, sipariş ve ${AGENT_BRAND} önerilerini kendi işinizde görün.`}
    primary={{ label: 'Ücretsiz deneyin', href: closingHref }}
    secondary={{ label: 'Demo talep edin', href: demoHref }}
  />
</BaseLayout>

<style>
  /*
   * SITE-DL (F4): sayfa uygulamanın tasarım diline çevrildi — düz yüzey + 1px çerçeve + kart yarıçapı; gölge, degrade,
   * hover yükselmesi ve hap biçimi yok; tek vurgu eylem mavisi; ikonlar çerçeveli kare kutuda; onay işareti çıplak ikon.
   */
  :global(.section.tight-section) {
    padding-block: calc(var(--site-section-y) * 0.72);
  }

  /* --- Hero --- */
  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--ek-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hero-chips li {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    min-height: calc(var(--ek-space-8) + var(--ek-space-1));
    padding-inline: var(--ek-space-3) var(--ek-space-4);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-md);
    background: var(--site-glass-bg);
    color: var(--site-text-on-dark-body);
    font-size: var(--ek-font-size-sm);
  }
  .hero-chips :global(.icon) {
    color: var(--site-accent-on-dark);
  }
  .hero-chips strong {
    color: var(--site-text-on-dark-heading);
    font-weight: var(--ek-font-weight-semibold);
  }
  /* Taslak fiyat notu (N4): küçük, sakin dipnot — ziyaretçi dili; iç kayıt yalnız öznitelikte. */
  .notice {
    flex-basis: 100%;
    max-width: none;
    text-align: center;
    margin-top: var(--ek-space-2);
    color: var(--site-text-on-dark-meta);
    font-size: var(--ek-font-size-sm);
  }
  .notice :global(.icon) {
    display: inline-block;
    margin-inline-end: var(--ek-space-1);
    vertical-align: -0.2em;
    color: var(--site-accent-on-dark);
  }
  .trial__unit {
    color: var(--site-accent-on-dark);
    font-size: var(--ek-font-size-3xl);
    font-weight: var(--ek-font-weight-bold);
  }
  .trial__note {
    margin-top: var(--ek-space-3);
    color: var(--site-text-on-dark-body);
    font-size: var(--ek-font-size-lg);
  }
  .trial__list {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
    margin-top: var(--ek-space-5);
    padding-top: var(--ek-space-5);
    border-top: var(--site-border-width) solid var(--site-glass-border);
  }
  .trial__list li {
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-medium);
  }
  .trial__list :global(svg) {
    color: var(--site-accent-on-dark);
  }

  /* --- Plan kartları: hero'nun alt kenarına taşar --- */
  .plans-section {
    position: relative;
    z-index: 1;
    padding-bottom: calc(var(--site-section-y) * 0.6);
    background: linear-gradient(180deg, transparent var(--site-hero-overlap), var(--ek-color-surface-muted) var(--site-hero-overlap));
    border-bottom: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .plans-wrap {
    margin-top: calc(var(--site-hero-overlap) * -1);
  }
  .interval-note {
    margin: 0 auto var(--ek-space-4);
    text-align: center;
  }
  .plans {
    display: grid;
    gap: var(--ek-space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .plan {
    display: flex;
    min-width: 0;
  }
  .plan__card {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--ek-space-5);
    padding: var(--ek-space-8) var(--ek-space-6) var(--ek-space-6);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-card);
    background: var(--ek-color-surface);
    transition: border-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .plan__card:hover {
    border-color: var(--site-action-border);
  }
  /* Önerilen plan: sayfanın tek koyu kartı — DÜZ marka laciverti + ince çerçeve (degrade, ışıma, gölge, yükseltme yok). */
  .plan__card--featured {
    border-color: var(--ek-color-chrome-border);
    background: var(--ek-color-chrome);
    color: var(--site-text-on-dark-body);
  }
  .plan__card--featured:hover {
    border-color: var(--ek-color-chrome-soft-border);
  }
  .plan__ribbon {
    position: absolute;
    top: 0;
    left: 50%;
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-1);
    margin: 0;
    padding: var(--ek-space-1) var(--ek-space-3);
    /* Lacivert kartın üstünde: açık rozet (lacivert dolgu kaybolurdu). */
    border: var(--site-border-width) solid var(--site-action);
    border-radius: var(--ek-radius-md);
    background: var(--ek-color-background);
    color: var(--ek-color-primary);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    translate: -50% -50%;
  }
  .plan__head {
    display: grid;
    gap: var(--ek-space-1);
  }
  .plan__name {
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-2xl);
    font-weight: var(--ek-font-weight-bold);
    letter-spacing: -0.015em;
  }
  .plan__pitch {
    color: var(--site-text-body);
    font-size: var(--ek-font-size-md);
  }
  .plan__card--featured .plan__name {
    color: var(--site-text-on-dark-heading);
  }
  .plan__card--featured .plan__pitch {
    color: var(--site-text-on-dark-body);
  }
  .plan__pricebox {
    display: grid;
    gap: var(--ek-space-1);
  }
  .plan__price {
    display: flex;
    align-items: baseline;
    gap: var(--ek-space-1);
    margin: 0;
  }
  .plan__amount {
    color: var(--site-text-heading);
    font-size: var(--site-font-display-md);
    font-weight: var(--site-font-display-weight);
    letter-spacing: var(--site-font-display-tracking);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .plan__amount--quote {
    font-size: var(--site-font-display-sm);
  }
  .plan__period {
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-lg);
    font-weight: var(--ek-font-weight-medium);
  }
  .plan__vat {
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-sm);
  }
  .plan__card--featured .plan__amount {
    color: var(--site-text-on-dark-heading);
  }
  .plan__card--featured :is(.plan__period, .plan__vat) {
    color: var(--site-text-on-dark-meta);
  }
  .plan__trial {
    justify-self: start;
    margin-top: var(--ek-space-2);
    padding: calc(var(--ek-space-1) * 0.5) var(--ek-space-2);
    border: var(--site-border-width) solid var(--site-action-border);
    border-radius: var(--ek-radius-md);
    background: var(--site-action-subtle);
    color: var(--site-action-emphasis);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
  }
  .plan__cta {
    display: grid;
    gap: var(--ek-space-2);
  }
  .plan__cta :global(.btn) {
    width: 100%;
  }
  .plan__cta-note {
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-sm);
    text-align: center;
  }
  .plan__card--featured .plan__cta-note {
    color: var(--site-text-on-dark-meta);
  }
  .plan__tagline {
    padding-top: var(--ek-space-5);
    border-top: var(--site-border-width) solid var(--ek-color-border-default);
    color: var(--site-text-body);
    font-size: var(--ek-font-size-sm);
    line-height: var(--ek-line-height-normal);
  }
  .plan__card--featured .plan__tagline {
    border-top-color: var(--site-glass-border);
    color: var(--site-text-on-dark-body);
  }
  .plan__limits {
    display: grid;
    gap: var(--ek-space-2);
  }
  .plan__limits li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--ek-space-3);
    align-items: center;
    color: var(--site-text-body);
    font-size: var(--ek-font-size-md);
  }
  .plan__limit-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-8);
    height: var(--ek-space-8);

    border: var(--site-border-width) solid var(--site-action-border);
    border-radius: var(--ek-radius-tile);
    background: var(--site-action-subtle);
    color: var(--site-action);
  }
  .plan__limit-value {
    color: var(--site-text-heading);
    font-weight: var(--ek-font-weight-bold);
    font-variant-numeric: tabular-nums;
  }
  .plan__card--featured .plan__limits li {
    color: var(--site-text-on-dark-body);
  }
  .plan__card--featured .plan__limit-icon {
    border-color: var(--site-glass-border);
    background: var(--site-glass-bg);
    color: var(--site-accent-on-dark);
  }
  .plan__card--featured .plan__limit-value {
    color: var(--site-text-on-dark-heading);
  }
  .plan__inc {
    display: grid;
    gap: var(--ek-space-2);
  }
  .plan__inc-label {
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
  }
  .plan__card--featured .plan__inc-label {
    color: var(--site-text-on-dark-heading);
  }
  .plan__features {
    display: grid;
    gap: var(--ek-space-2);
  }
  .plan__features li {
    display: flex;
    gap: var(--ek-space-2);
    align-items: flex-start;
    color: var(--site-text-body);
    font-size: var(--ek-font-size-sm);
    line-height: var(--ek-line-height-normal);
  }
  .plan__card--featured .plan__features li {
    color: var(--site-text-on-dark-body);
  }
  /* Onay işareti: çıplak eylem mavisi ikon (dolu daire yok). */
  .plan__check {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-5);
    height: var(--ek-space-5);
    color: var(--site-action);
  }
  .plan__check :global(.icon) {
    width: var(--ek-space-4);
    height: var(--ek-space-4);
  }
  .plan__card--featured .plan__check {
    color: var(--site-accent-on-dark);
  }
  /* Otopilot bloğu: kartın tabanında, eylem tonu zeminli + ince çerçeveli "dahil" paneli. */
  .plan__agent {
    display: grid;
    gap: var(--ek-space-2);
    margin-top: auto;
    padding: var(--ek-space-4);
    border: var(--site-border-width) solid var(--site-action-border);
    border-radius: var(--ek-radius-tile);
    background: var(--site-action-subtle);
  }
  .plan__agent-title {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-bold);
  }
  .plan__agent-title :global(.icon) {
    color: var(--site-action);
  }
  .plan__agent-prev {
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-xs);
  }
  .plan__agent-list {
    display: grid;
    gap: var(--ek-space-1);
  }
  .plan__agent-list li {
    position: relative;
    padding-inline-start: var(--ek-space-4);
    color: var(--site-text-body);
    font-size: var(--ek-font-size-sm);
  }
  .plan__agent-list li::before {
    content: '';
    position: absolute;
    inset-inline-start: var(--ek-space-1);
    top: 0.6em;
    width: var(--ek-space-1);
    height: var(--ek-space-1);
    background: var(--site-action);
  }
  .plan__card--featured .plan__agent {
    border-color: var(--site-glass-border);
    background: var(--site-glass-bg);
  }
  .plan__card--featured :is(.plan__agent-title, .plan__agent-list li) {
    color: var(--site-text-on-dark-heading);
  }
  .plan__card--featured .plan__agent-title :global(.icon) {
    color: var(--site-accent-on-dark);
  }
  .plan__card--featured .plan__agent-prev {
    color: var(--site-text-on-dark-meta);
  }
  .plan__card--featured .plan__agent-list li::before {
    background: var(--site-accent-on-dark);
  }

  /* --- Güven unsurları (kayıttan) --- */
  .trust {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    margin: var(--ek-space-10) 0 0;
    padding: var(--ek-space-2);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-card);
    background: var(--ek-color-surface);
    list-style: none;
  }
  .trust__item {
    display: flex;
    gap: var(--ek-space-3);
    align-items: center;
    padding: var(--ek-space-3) var(--ek-space-4);
  }
  .trust__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-8);
    height: var(--ek-space-8);

    border: var(--site-border-width) solid var(--site-action-border);
    border-radius: var(--ek-radius-tile);
    background: var(--site-action-subtle);
    color: var(--site-action);
  }
  .trust__text {
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-medium);
    line-height: var(--ek-line-height-tight);
  }
  .trust__text strong {
    font-weight: var(--ek-font-weight-bold);
  }
  .trust__more {
    margin: var(--ek-space-4) auto 0;
    font-size: var(--ek-font-size-md);
    text-align: center;
  }

  /* --- Otopilot her planda (açık zemin; merdiven) --- */
  .agent-plan {
    display: grid;
    gap: var(--ek-space-10);
    align-items: center;
  }
  .agent-plan__copy {
    display: grid;
    gap: var(--ek-space-4);
    justify-items: start;
  }
  .agent-plan__title {
    color: var(--site-text-heading);
    font-size: var(--site-font-display-sm);
    font-weight: var(--site-font-display-weight);
    letter-spacing: var(--site-font-display-tracking);
    line-height: var(--site-font-display-line-height);
    text-wrap: balance;
  }
  .agent-plan__text {
    color: var(--site-text-body);
    font-size: var(--ek-font-size-lg);
    line-height: var(--site-font-body-line-height);
  }
  .agent-plan__points {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-2);
  }
  .agent-plan__points li {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    padding: var(--ek-space-1) var(--ek-space-2);
    border: var(--site-border-width) solid var(--site-action-border);
    border-radius: var(--ek-radius-md);
    background: var(--site-action-subtle);
    color: var(--site-action-emphasis);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
  }
  .agent-plan__points :global(.icon) {
    color: var(--site-action);
  }
  .agent-ladder {
    display: grid;
    gap: var(--ek-space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .agent-ladder__step {
    display: grid;
    align-content: start;
    gap: var(--ek-space-2);
    padding: var(--ek-space-5);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-card);
    background: var(--ek-color-surface);
  }
  .agent-ladder__step.is-featured {
    border-color: var(--site-action-border);
    background: var(--site-action-subtle);
  }
  .agent-ladder__name {
    display: flex;
    align-items: center;
    gap: var(--ek-space-3);
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-lg);
    font-weight: var(--ek-font-weight-bold);
  }
  /* Yetki seviyesi: dolu çubuk sayısı = kademe (yalnız görsel; metin "öncekine ek olarak" ile anlatır). */
  .agent-ladder__level {
    display: inline-flex;
    align-items: flex-end;
    gap: calc(var(--ek-space-1) * 0.5);
    height: var(--ek-space-4);
  }
  .agent-ladder__level span {
    width: calc(var(--ek-space-1) * 1.25);
    background: var(--ek-color-border-strong);
  }
  .agent-ladder__level span:nth-child(1) {
    height: 40%;
  }
  .agent-ladder__level span:nth-child(2) {
    height: 70%;
  }
  .agent-ladder__level span:nth-child(3) {
    height: 100%;
  }
  .agent-ladder__level span.on {
    background: var(--site-action);
  }
  .agent-ladder__prev {
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-xs);
  }
  .agent-ladder__list {
    display: grid;
    gap: var(--ek-space-2);
  }
  .agent-ladder__list li {
    display: flex;
    gap: var(--ek-space-2);
    align-items: flex-start;
    color: var(--site-text-body);
    font-size: var(--ek-font-size-sm);
  }
  .agent-ladder__list :global(.icon) {
    flex: none;
    margin-top: 0.15em;
    color: var(--site-action);
  }

  /* --- Karşılaştırma tablosu --- */
  .table-wrap {
    position: relative;
    overflow-x: auto;
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-card);
    background: var(--ek-color-surface);
  }
  .compare__table {
    width: 100%;
    min-width: 36rem;
    border-collapse: separate;
    border-spacing: 0;
    font-size: var(--ek-font-size-md);
  }
  .compare__table th,
  .compare__table td {
    padding: var(--ek-space-4) var(--ek-space-5);
    border-bottom: var(--site-border-width) solid var(--ek-color-border-default);
    text-align: start;
    vertical-align: middle;
  }
  .compare__table :is(thead th, tbody td, tfoot td):not(:first-child) {
    text-align: center;
  }
  /* Başlık bandı: sakin zemin + ince çizgi; plan adları mikro büyük harf. */
  .compare__table thead th {
    background: var(--ek-color-surface-muted);
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-bold);
    letter-spacing: var(--site-eyebrow-tracking);
    text-transform: uppercase;
  }
  .compare__table thead th:first-child {
    color: var(--site-text-meta);
  }
  /* Öne çıkan sütun: eylem tonu zemin, tüm satırlar boyunca süreklilik (üst şerit yok). */
  .compare__table .is-featured {
    background: var(--site-action-subtle);
  }
  .compare__table thead th.is-featured {
    background: var(--site-action-subtle);
    color: var(--site-action-emphasis);
  }
  .compare__table tbody th {
    color: var(--site-text-body);
    font-weight: var(--ek-font-weight-medium);
  }
  .compare__table td {
    color: var(--site-text-heading);
    font-variant-numeric: tabular-nums;
  }
  .compare__table tbody tr:not(.compare__group):hover > * {
    background: var(--ek-color-surface-muted);
  }
  .compare__table tbody tr:not(.compare__group):hover > .is-featured {
    background: var(--site-action-subtle);
  }
  .compare__group td {
    padding-block: var(--ek-space-3);
    background: var(--ek-color-surface-muted);
    text-align: start;
  }
  .compare__group-label {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-bold);
    letter-spacing: var(--site-eyebrow-tracking);
    text-transform: uppercase;
  }
  .compare__group-label :global(.icon) {
    color: var(--site-action);
  }
  .compare__group--agent td {
    background: var(--ek-color-surface-muted);
  }
  .compare__table tfoot td,
  .compare__table tfoot th {
    border-bottom: 0;
  }
  .compare__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-1);
    min-height: var(--site-tap-target);
    color: var(--site-link-accent);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
  }
  .cell-price {
    display: block;
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-xl);
    font-weight: var(--ek-font-weight-bold);
  }
  .cell-strong {
    display: block;
    color: var(--site-text-heading);
    font-weight: var(--ek-font-weight-bold);
  }
  .cell-note {
    display: block;
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-sm);
  }
  .cell-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-6);
    height: var(--ek-space-6);
    color: var(--site-action);
  }
  .cell-check :global(.icon) {
    width: var(--ek-space-5);
    height: var(--ek-space-5);
  }
  .cell-dash {
    display: inline-block;
    width: var(--ek-space-3);
    height: calc(var(--site-border-width) * 2);
    background: var(--ek-color-border-strong);
    vertical-align: middle;
  }

  /* --- SSS: iki sütun --- */
  .faq-grid {
    display: grid;
    gap: var(--ek-space-8);
  }
  .faq-grid__aside :global(.shead) {
    margin-bottom: var(--ek-space-6);
  }
  .doc-links {
    display: grid;
    gap: var(--ek-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .doc-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    min-height: var(--site-tap-target);
    padding-inline: var(--ek-space-3) var(--ek-space-4);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-tile);
    background: var(--ek-color-surface);
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-medium);
    transition:
    border-color var(--ek-duration-base) var(--ek-easing-standard),
    background-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .doc-links a:hover {
    border-color: var(--site-action-border);
    background: var(--site-action-subtle);
    color: var(--site-action-emphasis);
  }
  .doc-links :global(.icon) {
    color: var(--site-action);
  }

  /* <1024: tablo yatay kaydırılır; ilk sütun sabit (S16 CoverageMatrix deseni). */
  @media (max-width: 767.98px) {
    .compare__table th,
    .compare__table td {
      padding: var(--ek-space-3);
    }
    .compare__table th:first-child {
      width: 10rem;
      font-size: var(--ek-font-size-sm);
    }
    .plan__card {
      padding-inline: var(--ek-space-5);
    }
  }
  @media (max-width: 1023.98px) {
    .compare__table th:first-child {
      position: sticky;
      inset-inline-start: 0;
      z-index: 1;
      background: var(--ek-color-surface);
      border-inline-end: var(--site-border-width) solid var(--ek-color-border-default);
    }
    .compare__table thead th:first-child,
    .compare__group td:first-child {
      background: var(--ek-color-surface-muted);
    }
  }
  @media (min-width: 800px) {
    .plans {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
      align-items: stretch;
    }
    .agent-ladder {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: end;
    }
    /* Merdiven: her kademe bir öncekinden biraz yüksek başlar (yetki arttıkça). */
    .agent-ladder__step[data-step='1'] {
      margin-top: var(--ek-space-12);
    }
    .agent-ladder__step[data-step='2'] {
      margin-top: var(--ek-space-6);
    }
  }
  /* >=1024: tablo sığar → kapsayıcı kaydırma kapsayıcısı DEĞİL; başlık satırı site header'ının altına yapışır. */
  @media (min-width: 1024px) {
    .table-wrap {
      overflow: clip;
    }
    .compare__table thead th {
      position: sticky;
      top: var(--site-header-visible);
      z-index: 2;
    }
    .compare__table thead th:first-child {
      width: 34%;
      border-start-start-radius: var(--ek-radius-card);
    }
    .compare__table {
      table-layout: fixed;
    }
    .compare__table thead th:last-child {
      border-start-end-radius: var(--ek-radius-card);
    }
    .plans {
      gap: var(--ek-space-6);
    }
    .trust {
