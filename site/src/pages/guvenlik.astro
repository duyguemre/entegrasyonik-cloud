---
/**
 * /guvenlik — doğrulanabilir güvenlik anlatısı (ADR-0014 Karar 5).
 *
 * S16 (kullanıcı: "premium tasarım + high-level içerik"): teknik ayrıntı yığını yerine YÖNETİCİ DÜZEYİ çerçeve —
 * altı güvence ilkesi (`src/data/security-principles.ts`), her biri kısa başlık + tek cümle değer + JS'siz
 * `<details>` "Ayrıntı" bölümü. Ayrıntılar yalnızca kanıtlı kayıtlardır: `getPublicCapabilities('security')`
 * (her kayıt tam bir ilkede, `data-testid="security-claim"`; kanıt: tests/claims.test.ts) ve ilkenin kendi kanıtlı
 * maddeleri (kanıt: tests/pages.test.ts). Sertifika/uyumluluk, veri konumu, SLA ve süre iddiası YOKTUR.
 * KVKK bağlantısı yalnızca ilgili yasal sayfa `published` ise verilir (S5).
 */
import Eyebrow from '../components/Eyebrow.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { crumbsFor } from '../data/seo'
import Section from '../components/Section.astro'
import Badge from '../components/Badge.astro'
import Icon from '../components/home/Icon.astro'
import SectionHead from '../components/pages/SectionHead.astro'
import HeroActions from '../components/pages/HeroActions.astro'
import PageHero from '../components/pages/PageHero.astro'
import CtaBand from '../components/pages/CtaBand.astro'
import { getPublicCapabilities, type PublicProductCapability } from '../data/capabilities'
import { securityPrinciples } from '../data/security-principles'
import { fairSection, fairPrinciples } from '../data/fair-play'
import { legalNav, published } from '../data/navigation'

const crumbs = crumbsFor('/guvenlik')

const security = getPublicCapabilities('security')
const byId = new Map(security.map((c) => [c.id, c]))
const assigned = new Set(securityPrinciples.flatMap((p) => p.capabilityIds))
// Hiçbir kayıt kaybolmasın: bir ilkeye bağlanmamış kayıt varsa son ilkenin ayrıntısına düşer (test ayrıca uyarır).
const orphans = security.filter((c) => !assigned.has(c.id))
const principles = securityPrinciples.map((p, idx) => ({
  ...p,
  claims: [
    ...p.capabilityIds.map((id) => byId.get(id)).filter((c): c is PublicProductCapability => !!c),
    ...(idx === securityPrinciples.length - 1 ? orphans : []),
  ],
}))

const legal = published(legalNav)
const kvkk = legal.find((i) => i.href === '/yasal/kvkk-aydinlatma')
const privacy = legal.find((i) => i.href === '/yasal/gizlilik')
const subscription = legal.find((i) => i.href === '/yasal/abonelik-sozlesmesi')
const legalCards = [kvkk, privacy, subscription].filter((x): x is NonNullable<typeof x> => !!x)
---

<BaseLayout>

  <PageHero
    title="Verileriniz sizin, kontrol sizde"
    accent="kontrol sizde"
    eyebrow="Güvenlik"
    lead="Pazaryeri anahtarlarınızdan operasyon verinize kadar her şey korunur ve yalnızca size aittir. Korumaları aşağıda yönetici düzeyinde özetliyoruz; merak ettiğiniz ilkenin ayrıntısını açabilirsiniz."
    crumbs={crumbs}
  >
    <HeroActions
      actions={[
        { label: 'Güvence ilkeleri', href: '#ilkeler' },
        { label: 'Adil rekabet', href: `#${fairSection.id}` },
        { label: 'Kapsam ve KVKK', href: '#kapsam' },
      ]}
    />
    <Fragment slot="visual">
      <p class="panel-tag">Güvence ilkeleri</p>
      <ul class="hero-list" role="list">
        {
          principles.map((p) => (
            <li>
              <span class="hero-list__icon" aria-hidden="true"><Icon name={p.icon} size="sm" /></span>
              <a href={`#ilke-${p.id}`}>{p.title}</a>
            </li>
          ))
        }
      </ul>
    </Fragment>
  </PageHero>

  <Section id="ilkeler" labelledby="ilkeler-title" class="tight-section">
    <SectionHead id="ilkeler-title" eyebrow="Yönetici özeti" title="Güvence ilkelerimiz">
      <p>Her ilke, ürünün bugün uyguladığı bir korumaya dayanır. Teknik ayrıntılar her kartın "Ayrıntı" bölümündedir.</p>
    </SectionHead>

    <ol class="principles" role="list" data-testid="security-principles">
      {
        principles.map((p) => (
          <li class="principle" id={`ilke-${p.id}`} data-principle={p.id}>
            <span class="principle__icon" aria-hidden="true">
              <Icon name={p.icon} size="md" />
            </span>
            <h3 class="principle__title">{p.title}</h3>
            <p class="principle__value">{p.value}</p>
            <details class="principle__more">
              <summary>
                <span>Ayrıntı</span>
                <Icon name="chevron" size="sm" />
              </summary>
              <div class="principle__detail">
                {p.claims.length > 0 && (
                  <ul class="claims" role="list">
                    {p.claims.map((c) => (
                      <li class="claim" data-testid="security-claim" data-claim={c.id}>
                        <p class="claim__title">
                          <Icon name="check" size="sm" />
                          <span>{c.title}</span>
                          {c.status === 'partial' && <Badge tone="warning">{c.statusLabel}</Badge>}
                        </p>
                        <p class="claim__text">{c.summary}</p>
                        {c.caveat && <p class="claim__caveat">{c.caveat}</p>}
                      </li>
                    ))}
                  </ul>
                )}
                {p.points.length > 0 && (
                  <ul class="claims" role="list">
                    {p.points.map((pt) => (
                      <li class="claim" data-testid="security-point">
                        <p class="claim__text claim__text--point">
                          <Icon name="check" size="sm" />
                          <span>{pt.text}</span>
                        </p>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </details>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- PRC-MKT (K58): adil rekabet ilkesi — üst tutum; metin `src/data/fair-play.ts`, seçenekler docs/site-fair/COPY.md -->
  <Section id={fairSection.id} labelledby="adil-rekabet-title" tone="muted" class="tight-section">
    <div class="fair" data-testid="fair-play">
      <div class="head head--compact fair__head">
        <Eyebrow>{fairSection.eyebrow}</Eyebrow>
        <h2 id="adil-rekabet-title">{fairSection.title}</h2>
        <p>{fairSection.lead}</p>
      </div>
      <ol class="fair__list" role="list">
        {
          fairPrinciples.map((f) => (
            <li class="fair__item" data-fair={f.id}>
              <span class="fair__icon" aria-hidden="true"><Icon name={f.icon} size="sm" /></span>
              <div>
                <h3 class="fair__title">{f.title}</h3>
                <p class="fair__text">{f.value}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <Section id="kapsam" labelledby="kapsam-title" class="tight-section">
    <div class="scope">
      <div class="head head--compact">
        <Eyebrow>Şeffaflık</Eyebrow>
        <h2 id="kapsam-title">Kapsam ve KVKK</h2>
        <p>
          Bu sayfa bir sertifikasyon veya bağımsız denetim belgesi değildir; yalnızca ürünün uyguladığı teknik önlemleri özetler.
          Sunulan tüm bilgiler ürünün mevcut sürümüne aittir.
        </p>
        {
          kvkk ? (
            <p>
              Kişisel verilerin işlenmesine ilişkin ayrıntılar için <a href={kvkk.href}>{kvkk.label}</a>
              {privacy ? (
                <>
                  {' '}ve <a href={privacy.href}>{privacy.label}</a>
                </>
              ) : null}
              {' '}sayfalarına bakabilirsiniz.
            </p>
          ) : (
            <p data-testid="kvkk-pending">KVKK aydınlatma metni ve gizlilik politikası yayımlandığında bu sayfadan erişilebilecektir.</p>
          )
        }
      </div>
      {
        legalCards.length > 0 && (
          <ul class="docs" role="list" aria-label="İlgili yasal belgeler">
            {legalCards.map((d) => (
              <li>
                <a class="doc" href={d.href}>
                  <span class="doc__icon" aria-hidden="true">
                    <Icon name="book" size="sm" />
                  </span>
                  <span class="doc__label">{d.label}</span>
                  <Icon name="arrow" size="sm" />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </Section>

  <CtaBand
    id="guvenlik-cta"
    title="Güvenlik sorularınızı birlikte yanıtlayalım"
    text="Güvenlik yaklaşımımıza dair ek bilgi istiyorsanız iletişim sayfasından bize ulaşabilirsiniz."
    primary={{ label: 'İletişim', href: '/iletisim' }}
    secondary={{ label: 'Sık sorulan sorular', href: '/sss' }}
  />
</BaseLayout>

<style>
  :global(.section.tight-section) {
    padding-block: calc(var(--site-section-y) * 0.72);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-2);
    max-width: 46rem;
    margin-bottom: var(--ek-space-10);
  }
  .head--compact {
    margin-bottom: 0;
  }
  /* SITE-DL-03: mikro bölüm etiketi kendi satırında kalır (başlıkla yan yana düşmesin). */
  .head :global(.eyebrow) {
    flex: 0 0 100%;
  }
  .head h2 {
    color: var(--site-text-heading);
    font-size: var(--site-font-display-sm);
    font-weight: var(--site-font-display-weight);
    line-height: var(--site-font-display-line-height);
    letter-spacing: var(--site-font-display-tracking);
  }
  .head p:not(.eyebrow) {
    color: var(--site-text-body);
    font-size: var(--ek-font-size-lg);
    line-height: var(--site-font-body-line-height);
  }
  .head a {
    color: var(--site-link-accent);
    font-weight: var(--ek-font-weight-semibold);
  }

  /* --- Hero --- */
  .panel-tag {
    margin: 0 0 var(--ek-space-3);
    color: var(--site-text-on-dark-meta);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hero-list li {
    display: flex;
    align-items: center;
    gap: var(--ek-space-3);
    padding-block: var(--ek-space-2);
  }
  .hero-list li + li {
    border-top: var(--site-border-width) solid var(--site-glass-border);
  }
  .hero-list__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-8);
    height: var(--ek-space-8);
    border-radius: var(--ek-radius-md);
    background: var(--site-glass-bg);
    color: var(--site-accent-on-dark);
    box-sizing: border-box;
    border: var(--site-border-width) solid var(--site-glass-border);
  }
  .hero-list a {
    /* site-wdg W12: 44 px dokunma hedefi + hover (sss.astro hero listesiyle aynı desen). */
    display: inline-flex;
    align-items: center;
    min-height: var(--site-tap-target);
    color: var(--site-text-on-dark-heading);
    font-weight: var(--ek-font-weight-medium);
    line-height: var(--ek-line-height-tight);
    text-decoration: none;
  }
  .hero-list a:hover {
    color: var(--site-accent-on-dark);
  }

  /* --- Adil rekabet (PRC-MKT) --- sakin, sayfanın güvence kartlarından hafif: ince çizgili liste, kontur ikon karosu */
  .fair {
    display: grid;
    gap: var(--ek-space-8);
    /* site-wdg W14: üst bar payı html scroll-padding-top’ta; burada yalnız ek boşluk. */
    scroll-margin-top: var(--ek-space-2);
  }
  .fair__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 var(--ek-space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fair__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--ek-space-4);
    align-items: start;
    padding-block: var(--ek-space-5);
    border-top: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .fair__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-10);
    height: var(--ek-space-10);
    border: var(--site-border-width) solid var(--site-action-border);
    border-radius: var(--ek-radius-tile);
    background: var(--site-action-subtle);
    color: var(--site-action);
  }
  .fair__title {
    margin-bottom: var(--ek-space-1);
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-lg);
    font-weight: var(--ek-font-weight-bold);
    letter-spacing: -0.01em;
  }
  .fair__text {
    color: var(--site-text-body);
    font-size: var(--ek-font-size-md);
    line-height: var(--site-font-body-line-height);
  }
  @media (min-width: 768px) {
    .fair__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .fair {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--ek-space-12);
      align-items: start;
    }
  }

  /* --- İlkeler --- */
  .principles {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ek-space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .principle {
    /* SITE-DL-03: düz kart; hover/açık = lacivert tonlu çerçeve (gölge yok). */
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
    min-width: 0;
    padding: var(--ek-space-6);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-card);
    background: var(--ek-color-surface);
    /* site-wdg W14: üst bar payı html scroll-padding-top’ta; burada yalnız ek boşluk. */
    scroll-margin-top: var(--ek-space-2);
    transition: border-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .principle:hover,
  .principle:focus-within,
  .principle:has(details[open]) {
    border-color: var(--site-action-border);
  }
  .principle__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-12);
    height: var(--ek-space-12);
    margin-bottom: var(--ek-space-1);
    border-radius: var(--ek-radius-tile);
    background: var(--site-action-subtle);
    color: var(--site-action);
    border: var(--site-border-width) solid var(--site-action-border);
  }
  .principle__title {
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-xl);
    font-weight: var(--ek-font-weight-bold);
    letter-spacing: -0.01em;
  }
  .principle__value {
    margin-bottom: var(--ek-space-2);
    color: var(--site-text-body);
    font-size: var(--ek-font-size-md);
    line-height: var(--site-font-body-line-height);
  }
  .principle__more {
    margin-top: auto;
    border-top: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .principle__more summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--site-tap-target);
    padding-top: var(--ek-space-3);
    color: var(--site-link-accent);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-semibold);
    list-style: none;
    cursor: pointer;
  }
  .principle__more summary::-webkit-details-marker {
    display: none;
  }
  /* site-wdg W18: "Ayrıntı" açıcısına hover geri bildirimi (renk; alt çizgi yok — BRAND §5). */
  .principle__more summary:hover {
    color: var(--site-action-emphasis);
  }
  .principle__more summary:focus-visible {
    outline: var(--site-focus-ring-width) solid var(--site-color-focus-ring);
    outline-offset: var(--site-focus-ring-offset);
    border-radius: var(--ek-radius-sm);
  }
  .principle__more summary :global(.icon) {
    transition: transform var(--ek-duration-base) var(--ek-easing-standard);
  }
  .principle__more[open] summary :global(.icon) {
    transform: rotate(180deg);
  }
  .principle__detail {
    padding-top: var(--ek-space-3);
  }
  .claims {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .claims + .claims {
    margin-top: var(--ek-space-4);
  }
  .claim {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
  }
  .claim__title,
  .claim__text--point {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--ek-space-2);
  }
  .claim__title {
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-semibold);
  }
  .claim__title span {
    flex: 1;
    min-width: 0;
  }
  .claim__title :global(.icon),
  .claim__text--point :global(.icon) {
    margin-top: calc(var(--ek-space-1) * 0.5);
    color: var(--site-action);
  }
  .claim__text {
    color: var(--site-text-body);
    font-size: var(--ek-font-size-sm);
    line-height: var(--site-font-body-line-height);
  }
  .claim__title + .claim__text,
  .claim__caveat {
    padding-inline-start: calc(var(--ek-space-4) + var(--ek-space-2));
  }
  .claim__text--point span {
    flex: 1;
    min-width: 0;
  }
  .claim__caveat {
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-sm);
    font-style: italic;
  }
  @media (prefers-reduced-motion: reduce) {
    .principle__more summary :global(.icon) {
      transition: none;
    }
  }

  /* --- Kapsam + yasal belgeler --- */
  .scope {
    display: grid;
    gap: var(--ek-space-8);
    align-items: start;
  }
  .docs {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .doc {
    /* SITE-DL-03: düz satır kartı; hover = lacivert tonlu zemin + çerçeve. */
    display: flex;
    align-items: center;
    gap: var(--ek-space-3);
    min-height: calc(var(--site-tap-target) + var(--ek-space-4));
    padding: var(--ek-space-3) var(--ek-space-5);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-tile);
    background: var(--ek-color-surface);
    color: var(--site-text-heading);
    font-weight: var(--ek-font-weight-semibold);
    text-decoration: none;
    transition: 
      background-color var(--ek-duration-base) var(--ek-easing-standard),
      border-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .doc:hover {
    border-color: var(--site-action-border);
    background: var(--site-action-subtle);
    color: var(--site-action-emphasis);
  }
  .doc:focus-visible {
    outline: var(--site-focus-ring-width) solid var(--site-color-focus-ring);
    outline-offset: var(--site-focus-ring-offset);
  }
  .doc__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-8);
    height: var(--ek-space-8);
    border-radius: var(--ek-radius-md);
    background: var(--site-action-subtle);
    color: var(--site-action);
    box-sizing: border-box;
    border: var(--site-border-width) solid var(--site-action-border);
  }
  .doc__label {
    flex: 1;
  }
  .doc > :global(.icon:last-child) {
    color: var(--site-link-accent);
  }

  @media (min-width: 768px) {
    .principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .principles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .scope {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      gap: var(--ek-space-12);
    }
  }

  .doc:hover .doc__icon {
    background: var(--ek-color-surface);
  }
</style>
