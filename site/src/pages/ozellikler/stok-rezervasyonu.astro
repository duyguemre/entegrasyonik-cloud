---
/**
 * /ozellikler/stok-rezervasyonu — "Aşırı satış (overselling) nasıl önlenir?" (S14). Sorun → nasıl çalışır → fayda
 * anlatısı + SSS + CTA. İçerik YALNIZCA kayıttan gelir: `getStockReservationStory()` (capabilities.ts, `basedOn`
 * bağlı), `stock-reservation` yeteneğinin özeti/kapsam notu ve `feature-details.ts` maddeleri, SSS kayıtları.
 *
 * Koyu "nasıl çalışır" sahnesi (`data-scene="stock-flow"`): iki adsız kanaldan son adet için eşzamanlı sipariş →
 * merkezi stok → biri rezerve, diğeri aşırı satış olarak işaretlenir → güncel stok bağlı kanallara iletilir.
 * Hareket kuralları (ADR-0014 Karar 3): yalnızca transform/opacity; tüm animasyonlar
 * `@media (prefers-reduced-motion: no-preference)` + `html[data-motion='play']` koşullu (reduced-motion / "Hareket"
 * durdurulmuş / JS'siz durumda sahne anlamlı statik son hâlindedir); döngüler yalnızca sahne görünürken çalışır.
 * Görünür metinde rakam yok (tests/pages.test.ts); adım numaraları CSS sayacıyla çizilir.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import { crumbsFor } from '../../data/seo'
import Section from '../../components/Section.astro'
import Icon from '../../components/home/Icon.astro'
import PageHero from '../../components/pages/PageHero.astro'
import Accordion from '../../components/pages/Accordion.astro'
import CtaBand from '../../components/pages/CtaBand.astro'
import SectionHead from '../../components/pages/SectionHead.astro'
import HeroActions from '../../components/pages/HeroActions.astro'
import HelpBand from '../../components/pages/HelpBand.astro'
import { getPublicCapabilities, getStockReservationStory } from '../../data/capabilities'
import { getFeaturePoints } from '../../data/feature-details'
import { getPublicFaq } from '../../data/faq'
import { appUrls } from '../../lib/site-config'

const crumbs = crumbsFor('/ozellikler/stok-rezervasyonu')

const capability = getPublicCapabilities('core').find((c) => c.id === 'stock-reservation')
if (!capability) throw new Error('stok rezervasyonu sayfası: yetenek kaydı yok')
const story = getStockReservationStory()
const [formulaPoint, ...points] = getFeaturePoints('stock-reservation')

const FAQ_IDS = ['asiri-satis', 'stok-senkron', 'siparis-yonetimi', 'secim-kriterleri']
const faqItems = getPublicFaq().filter((f) => FAQ_IDS.includes(f.id))

const PROBLEM_ICONS = ['orders', 'clock', 'info'] as const
const BENEFIT_ICONS = ['stock', 'refresh', 'eye', 'layers'] as const
/** S17 anlatı rotası: bölüm etiketleri ve başlıkları tek yerden (bölüm başlıklarıyla birebir aynı). */
const STORY_RAIL = [
  { id: 'sorun', eyebrow: 'Sorun', title: 'Aynı son ürün iki kanalda satıldığında', icon: 'info', tone: 'warn' },
  { id: 'nasil-calisir', eyebrow: 'Nasıl çalışır', title: 'Her sipariş önce rezervasyondan geçer', icon: 'stock', tone: 'brand' },
  { id: 'fayda', eyebrow: 'Fayda', title: 'Stoğunuz tek merkezde, kontrol sizde', icon: 'check', tone: 'ok' },
] as const
/** Yayın satırındaki adsız kanal düğümleri (yalnızca dekoratif). */
const PUBLISH_NODES = ['a', 'b', 'c', 'd'] as const
---

<BaseLayout scenes>

  <PageHero title="Aşırı satış (overselling) nasıl önlenir?" lead={capability.summary} crumbs={crumbs} eyebrow="Stok rezervasyonu">
    <HeroActions
      actions={[
        { label: 'Ücretsiz deneyin', href: appUrls.register() },
        { label: 'Nasıl çalışır', href: '#nasil-calisir' },
      ]}
    />
    <Fragment slot="visual">
      <figure class="ledger" data-scene="reveal">
        <figcaption class="ledger__tag">Kullanılabilir stok</figcaption>
        <ul class="ledger__rows" role="list">
          <li class="ledger__row" data-reveal>
            <span class="ledger__label">Eldeki stok</span>
            <span class="ledger__bar" aria-hidden="true"><span class="ledger__fill ledger__fill--stock"></span></span>
          </li>
          <li class="ledger__row" data-reveal>
            <span class="ledger__label"><span class="ledger__op" aria-hidden="true">−</span> Rezerve edilen</span>
            <span class="ledger__bar" aria-hidden="true"><span class="ledger__fill ledger__fill--reserved"></span></span>
          </li>
          <li class="ledger__row ledger__row--result" data-reveal>
            <span class="ledger__label"><span class="ledger__op" aria-hidden="true">=</span> Kullanılabilir</span>
            <span class="ledger__bar" aria-hidden="true"><span class="ledger__fill ledger__fill--available"></span></span>
          </li>
        </ul>
        <p class="ledger__caption">{formulaPoint}</p>
      </figure>
    </Fragment>
  </PageHero>

  <!-- S17: anlatı omurgası — hero kenarına binen üç adımlı rota (sayfanın kendi bölüm başlıkları; numara CSS sayacı) -->
  <div class="rail-wrap">
    <nav class="story-rail" aria-label="Bu sayfadaki anlatı" data-testid="story-rail">
      <ol role="list">
        {
          STORY_RAIL.map((r) => (
            <li>
              <a href={`#${r.id}`} class="story-rail__link" data-tone={r.tone}>
                <span class="story-rail__icon" aria-hidden="true"><Icon name={r.icon} size="sm" /></span>
                <span class="story-rail__body">
                  <span class="story-rail__eyebrow">{r.eyebrow}</span>
                  <span class="story-rail__title">{r.title}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>

  <!-- Sorun -->
  <Section id="sorun" labelledby="sorun-title" class="tight-section">
    <SectionHead id="sorun-title" eyebrow={STORY_RAIL[0].eyebrow} title={STORY_RAIL[0].title} />
    <ol class="problems" role="list">
      {
        story.problems.map((p, idx) => (
          <li class="problem" data-testid="stock-problem">
            <span class="problem__icon" aria-hidden="true">
              <Icon name={PROBLEM_ICONS[idx % PROBLEM_ICONS.length]} size="md" />
            </span>
            <h3 class="problem__title">{p.title}</h3>
            <p class="problem__text">{p.text}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Nasıl çalışır: koyu sahne + akış -->
  <Section tone="stage" id="nasil-calisir" labelledby="nasil-title" class="flow-section">
    <SectionHead id="nasil-title" eyebrow={STORY_RAIL[1].eyebrow} title={STORY_RAIL[1].title} inverse />
    <div class="flow-layout">
      <ol class="flow-steps" role="list" data-testid="stock-steps">
        {
          story.steps.map((s) => (
            <li class="flow-step">
              <h3 class="flow-step__title">{s.title}</h3>
              <p class="flow-step__text">{s.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="flow-card" data-scene="stock-flow" aria-hidden="true">
        <div class="flow-orders">
          <div class="flow-order" data-part="order-a">
            <span class="flow-order__dot flow-order__dot--a"></span>
            <span>{story.scene.orderA}</span>
          </div>
          <div class="flow-order" data-part="order-b">
            <span class="flow-order__dot flow-order__dot--b"></span>
            <span>{story.scene.orderB}</span>
          </div>
        </div>

        <div class="flow-wires flow-wires--in" data-part="wires-in">
          <span class="flow-wire"><span class="flow-signal flow-signal--a"></span></span>
          <span class="flow-wire"><span class="flow-signal flow-signal--b"></span></span>
        </div>

        <div class="flow-hub" data-part="hub">
          <div class="flow-hub__head">
            <Icon name="stock" size="sm" />
            <span>{story.scene.hub}</span>
          </div>
          <div class="flow-units">
            <span class="flow-unit flow-unit--sold"></span>
            <span class="flow-unit flow-unit--sold"></span>
            <span class="flow-unit flow-unit--sold"></span>
            <span class="flow-unit flow-unit--last" data-part="last-unit">
              <Icon name="lock" size="sm" />
            </span>
          </div>
          <p class="flow-hub__note">{story.scene.lastUnit}</p>
        </div>

        <div class="flow-wires flow-wires--out" data-part="wires-out">
          <span class="flow-wire"></span>
          <span class="flow-wire"></span>
        </div>

        <div class="flow-results">
          <div class="flow-result flow-result--ok" data-part="result-ok">
            <Icon name="check" size="sm" />
            <div>
              <strong>{story.scene.reserved}</strong>
              <span>{story.scene.reservedNote}</span>
            </div>
          </div>
          <div class="flow-result flow-result--warn" data-part="result-oversold">
            <Icon name="info" size="sm" />
            <div>
              <strong>{story.scene.oversold}</strong>
              <span>{story.scene.oversoldNote}</span>
            </div>
          </div>
        </div>

        <div class="flow-publish" data-part="publish">
          <p class="flow-publish__label">
            <Icon name="refresh" size="sm" />
            <span>{story.scene.publish}</span>
          </p>
          <div class="flow-publish__track">
            <span class="flow-publish__line"><span class="flow-beam"></span></span>
            <ul class="flow-publish__nodes" role="list">
              {PUBLISH_NODES.map((n) => <li class={`flow-node flow-node--${n}`}></li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- Fayda -->
  <Section id="fayda" tone="muted" labelledby="fayda-title" class="tight-section">
    <SectionHead id="fayda-title" eyebrow={STORY_RAIL[2].eyebrow} title={STORY_RAIL[2].title} />
    <ul class="benefits" role="list" data-testid="stock-benefits">
      {
        story.benefits.map((b, idx) => (
          <li class="benefit">
            <span class="benefit__icon" aria-hidden="true">
              <Icon name={BENEFIT_ICONS[idx % BENEFIT_ICONS.length]} size="md" />
            </span>
            <div>
              <h3 class="benefit__title">{b.title}</h3>
              <p class="benefit__text">{b.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <div class="facts">
      <div class="facts__list">
        <h3 class="facts__title">Arka planda ne olur</h3>
        <ul class="bullets" role="list">
          {
            points.map((p) => (
              <li>
                <span class="bullets__check" aria-hidden="true"><Icon name="check" size="sm" /></span>
                <span>{p}</span>
              </li>
            ))
          }
        </ul>
      </div>
      {
        capability.caveat && (
          <p class="facts__caveat">
            <Icon name="info" size="sm" />
            <span><strong>Kapsam notu:</strong> {capability.caveat}</span>
          </p>
        )
      }
    </div>
  </Section>

  <!-- SSS -->
  <Section labelledby="stok-sss-title" class="tight-section" size="narrow">
    <SectionHead id="stok-sss-title" eyebrow="SSS" title="Stok rezervasyonu hakkında sorular" />
    <Accordion items={faqItems} />
    <HelpBand
      title="Başka bir sorunuz mu var?"
      text="Destek merkezine göz atın ya da tüm sık sorulan soruları inceleyin."
      links={[
        { label: 'Destek merkezi', href: '/destek' },
        { label: 'Tüm sorular', href: '/sss' },
      ]}
    />
  </Section>

  <CtaBand
    id="stok-cta"
    title="Eşzamanlı siparişte stoğunuzu koruyun"
    text="Kanallarınızı bağlayın; siparişleriniz rezervasyondan geçsin, aşırı satış görünür olsun."
    primary={{ label: 'Ücretsiz deneyin', href: appUrls.register() }}
    secondary={{ label: 'Tüm özellikler', href: '/ozellikler' }}
  />
</BaseLayout>

<script>
  import '../../scripts/interactions'
</script>

<style>
  :global(.section.tight-section) {
    padding-block: calc(var(--site-section-y) * 0.72);
  }

  /* ------------------------------------------------------------------ Hero görsel: kullanılabilir stok defteri */
  .ledger {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-5);
    margin: 0;
  }
  .ledger__tag {
    color: var(--site-color-on-primary-muted);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ledger__rows {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-4);
  }
  .ledger__row {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--ek-space-4);
    align-items: center;
  }
  .ledger__row--result {
    padding-top: var(--ek-space-4);
    border-top: var(--site-border-width) solid var(--site-glass-border);
  }
  .ledger__label {
    color: var(--site-color-on-primary);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-medium);
  }
  .ledger__op {
    display: inline-block;
    min-width: var(--ek-space-4);
    color: var(--site-accent-on-dark);
    font-weight: var(--ek-font-weight-bold);
  }
  .ledger__bar {
    position: relative;
    display: block;
    height: var(--ek-space-3);
    border-radius: var(--ek-radius-full);
    background: color-mix(in srgb, var(--ek-color-background) 14%, transparent);
    overflow: hidden;
  }
  .ledger__fill {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 100%;
    border-radius: inherit;
    transform-origin: left center;
  }
  .ledger__fill--stock {
    background: color-mix(in srgb, var(--ek-color-background) 70%, transparent);
  }
  /* Rezerve çubuğu sağ uçtan dolar: kullanılabilir (sol) + rezerve (sağ) = eldeki stok, görsel olarak toplanır. */
  .ledger__fill--reserved {
    transform-origin: right center;
    background: var(--ek-color-warning);
    transform: scaleX(0.35);
  }
  .ledger__fill--available {
    background: var(--ek-color-secondary);
    transform: scaleX(0.65);
  }
  .ledger__caption {
    color: var(--site-color-on-primary-muted);
    font-size: var(--ek-font-size-sm);
  }

  /* ------------------------------------------------------------------ S17 anlatı rotası (hero kenarına biner) */
  .rail-wrap {
    position: relative;
    z-index: 1;
    width: min(100% - 2 * var(--site-gutter), var(--site-container-max));
    margin: calc(var(--ek-space-10) * -1) auto 0;
  }
  .story-rail ol {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow: hidden;
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--site-radius-panel);
    background: var(--ek-color-surface);
    box-shadow: var(--site-shadow-card-hover);
    counter-reset: rail;
  }
  .story-rail li {
    counter-increment: rail;
  }
  .story-rail li + li {
    border-top: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .story-rail__link {
    display: flex;
    align-items: center;
    gap: var(--ek-space-4);
    height: 100%;
    padding: var(--ek-space-4) var(--ek-space-5);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .story-rail__link:hover {
    background: var(--ek-color-surface-muted);
  }
  .story-rail__link:focus-visible {
    outline-offset: calc(var(--site-focus-ring-width) * -1);
  }
  .story-rail__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-10);
    height: var(--ek-space-10);
    border-radius: var(--ek-radius-lg);
  }
  .story-rail__link[data-tone='warn'] .story-rail__icon {
    background: var(--ek-color-warning-subtle);
    color: var(--ek-color-warning);
  }
  .story-rail__link[data-tone='brand'] .story-rail__icon {
    background: linear-gradient(140deg, var(--ek-color-primary), var(--ek-color-primary-darken-1));
    color: var(--site-color-on-primary);
  }
  .story-rail__link[data-tone='ok'] .story-rail__icon {
    background: var(--ek-color-success-subtle);
    color: var(--ek-color-success);
  }
  .story-rail__body {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
    min-width: 0;
  }
  .story-rail__eyebrow {
    color: var(--site-link-accent);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .story-rail__eyebrow::before {
    content: counter(rail, decimal-leading-zero) ' · ';
    color: var(--site-text-meta);
  }
  .story-rail__title {
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-semibold);
    line-height: var(--ek-line-height-tight);
  }

  /* ------------------------------------------------------------------ Sorun kartları */
  .problems,
  .flow-steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .problems {
    display: grid;
    gap: var(--ek-space-5);
    counter-reset: problem;
  }
  .problem {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
    padding: var(--ek-space-6);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--site-radius-panel);
    background: var(--ek-color-surface);
    box-shadow: var(--site-shadow-card);
  }
  .problem:last-child {
    border-color: color-mix(in srgb, var(--ek-color-warning) 45%, var(--ek-color-border-default));
    background: linear-gradient(180deg, var(--ek-color-warning-subtle), var(--ek-color-surface) 70%);
  }
  .problem__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-10);
    height: var(--ek-space-10);
    border-radius: var(--ek-radius-lg);
    background: var(--ek-color-surface-muted);
    color: var(--ek-color-content-strong);
  }
  .problem:last-child .problem__icon {
    background: var(--ek-color-warning-subtle);
    color: var(--ek-color-warning);
  }
  .problem__title {
    font-size: var(--site-card-title-size);
    font-weight: var(--site-card-title-weight);
    line-height: var(--ek-line-height-tight);
  }
  .problem__text {
    color: var(--ek-color-content-default);
    font-size: var(--site-card-desc-size);
  }

  /* ------------------------------------------------------------------ Nasıl çalışır (koyu sahne) */
  .flow-layout {
    display: grid;
    gap: var(--ek-space-10);
    align-items: center;
  }
  .flow-steps {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-6);
    counter-reset: flow;
  }
  .flow-step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    padding-inline-start: var(--ek-space-16);
    counter-increment: flow;
  }
  /* Adım numarası CSS sayacıyla (görünür HTML metninde rakam yok). */
  .flow-step::before {
    content: counter(flow, decimal-leading-zero);
    position: absolute;
    inset-inline-start: 0;
    top: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-12);
    height: var(--ek-space-12);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-lg);
    background: var(--site-glass-bg);
    color: var(--site-accent-on-dark);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-bold);
    letter-spacing: 0.04em;
  }
  .flow-step:not(:last-child)::after {
    content: '';
    position: absolute;
    inset-inline-start: calc(var(--ek-space-6) - var(--site-border-width) / 2);
    top: calc(var(--ek-space-12) + var(--ek-space-2));
    bottom: calc(var(--ek-space-6) * -1 + var(--ek-space-2));
    width: var(--site-border-width);
    background: linear-gradient(180deg, var(--site-glass-border), transparent);
  }
  .flow-step__title {
    font-size: var(--ek-font-size-xl);
    font-weight: var(--ek-font-weight-semibold);
    line-height: var(--ek-line-height-tight);
  }
  .flow-step__text {
    font-size: var(--ek-font-size-lg);
    line-height: var(--ek-line-height-normal);
  }

  .flow-card {
    --flow-wire-h: var(--ek-space-8);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    padding: var(--ek-space-6);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--site-radius-panel);
    background: var(--site-glass-bg);
    box-shadow: var(--site-shadow-panel);
    -webkit-backdrop-filter: blur(var(--site-glass-blur));
    backdrop-filter: blur(var(--site-glass-blur));
    color: var(--site-color-on-primary);
    font-size: var(--ek-font-size-sm);
  }
  .flow-orders,
  .flow-results {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--ek-space-3);
  }
  .flow-order {
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
    padding: var(--ek-space-3);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-lg);
    background: color-mix(in srgb, var(--ek-color-background) 8%, transparent);
    font-weight: var(--ek-font-weight-medium);
  }
  .flow-order__dot {
    flex: none;
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
  }
  .flow-order__dot--a {
    background: var(--ek-color-secondary);
  }
  .flow-order__dot--b {
    background: var(--site-accent-on-dark);
  }

  .flow-wires {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    height: var(--flow-wire-h);
  }
  .flow-wire {
    position: relative;
    justify-self: center;
    width: var(--site-border-width);
