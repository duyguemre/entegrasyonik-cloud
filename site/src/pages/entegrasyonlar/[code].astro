---
/**
 * /entegrasyonlar/[code] — entegrasyon detay sayfası (ADR-0014 Karar 2, S2b). Statik yollar `getPublicIntegrations()`
 * ile VERİDEN üretilir (yol haritası öğesi için sayfa YOK). İçerik: yetenek matrisi, sunulmayanlar/sınırlamalar,
 * nasıl bağlanır (yalnızca kimlik bilgisi TÜRLERİ — sır/örnek değer yok).
 *
 * S11b: "Sınırlamalar ve sunulmayanlar" artık matrisle AYNI bölümde sticky yan kutu (masaüstü) / matrisin
 * hemen altında kompakt şerit (mobil); "Nasıl bağlanırsınız" + "Diğer entegrasyonlar" tek bölümde birleşti
 * (sol: adımlar, sağ: gerekli bilgiler, altta çip şeridi) — 4 ayrı tam-genişlik bölüm yerine 2 bölüm, boşluk
 * kapandı. Hero görseli artık kayıttan hesaplanan bir kapsam segment çubuğu + ilk 4 yeteneğin mini listesini
 * gösteriyor (sayılar yalnızca `aria-label`'da — görünür metinde rakam yok, `tests/pages.test.ts` bunu zorlar).
 *
 * S14: "Nasıl bağlanırsınız" → adım adım "Bağlantı rehberi" (`#baglanti-rehberi`): numaralı adım rayı (numaralar CSS
 * sayacı; adımlar `getConnectGuide()` + hesap açma adımı + pazaryerlerinde "pasif bağlantı" kontrolü — SSS
 * `teknik-bilgi` kaydıyla aynı kanıt) ve sağda gerekli bilgileri maskeli alanlarla gösteren örnek ayar paneli
 * (yalnızca kimlik bilgisi TÜRLERİ; değer/sır yok). SEO: başlık/açıklama kurulum niyetine göre güçlendirildi,
 * `HowTo` JSON-LD adımları sayfadaki adımlarla birebir aynıdır.
 *
 * S16 (kullanıcı: "daha profesyonel, premium"): hero'da kayıttan türeyen durum rozeti (`statusLabel`) ve kanal rengi
 * ışıması; yetenek matrisi başlık satırlı kart tabloya dönüştü; yan sütunda her zaman "Bir bakışta" özet kartı
 * (durum, tür, kapsam, gerekli bilgi türleri, rehbere bağlantı) + varsa sınırlar. Rakam/uydurma durum yok.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import Section from '../../components/Section.astro'
import Badge from '../../components/Badge.astro'
import Icon from '../../components/home/Icon.astro'
import PageHero from '../../components/pages/PageHero.astro'
import LevelBadge from '../../components/pages/LevelBadge.astro'
import ChannelMono from '../../components/pages/ChannelMono.astro'
import CtaBand from '../../components/pages/CtaBand.astro'
import SectionHead from '../../components/pages/SectionHead.astro'
import { getPublicIntegrations, type PublicIntegration, type CoverageLevel } from '../../data/integrations'
import { getConnectGuide } from '../../data/connect'
import { getPublicCapabilities } from '../../data/capabilities'
import { guideSteps as buildGuideSteps } from '../../lib/seo'
import { crumbsFor } from '../../data/seo'
import { appUrls } from '../../lib/site-config'

export function getStaticPaths() {
  return getPublicIntegrations().map((integration) => ({
    params: { code: integration.code },
    props: { integration },
  }))
}

interface Props {
  integration: PublicIntegration
}

const { integration: i } = Astro.props
const coverageTone: Record<CoverageLevel, 'success' | 'info' | 'warning'> = {
  broad: 'success',
  partial: 'info',
  limited: 'warning',
}

const heading = `${i.name} entegrasyonu`
const crumbs = crumbsFor(`/entegrasyonlar/${i.code}`)

const guide = getConnectGuide(i.code, i.kind)
// Rehber adımları (hesap açma + kayıttaki adımlar + pazaryerinde bağlantı durumu kontrolü): HowTo JSON-LD ile AYNI dizi
// (src/lib/seo.ts `guideSteps`; başlık/açıklama/HowTo src/data/seo.ts kaydından BaseLayout'ta üretilir).
const guideSteps = buildGuideSteps(i)
const secretsSummary = getPublicCapabilities('security').find((c) => c.id === 'secrets-encryption')?.summary
const others = getPublicIntegrations().filter((x) => x.code !== i.code)
const hasLimits = i.limitations.length > 0 || i.notProvided.length > 0

// Hero görseli: kapsam segment çubuğu (destekleniyor/kısmi oranı, kayıttan) — görünür metinde rakam YOK,
// gerçek sayı yalnızca `aria-label`'da (ekran okuyucu için). İlk 4 yetenek: ikonlu mini önizleme.
const totalCapabilities = i.capabilities.length
const supportedCount = i.capabilities.filter((c) => c.level === 'supported').length
const limitedCount = totalCapabilities - supportedCount
const METER_SEGMENTS = 5
const filledSegments = totalCapabilities > 0 ? Math.round((supportedCount / totalCapabilities) * METER_SEGMENTS) : 0
const meterLabel =
  limitedCount > 0
    ? `Yetenek matrisinde bir kısmı destekleniyor, bir kısmı kısmi kapsamlı; ayrıntı aşağıdadır.`
    : `Yetenek matrisindeki tüm işlemler destekleniyor; ayrıntı aşağıdadır.`
const previewCapabilities = i.capabilities.slice(0, 4)
---

<BaseLayout>

  <PageHero title={heading} lead={i.summary} crumbs={crumbs} eyebrow={i.kindLabel}>
    <span class="hero-status" data-testid="integration-status">
      <span class="hero-status__dot" aria-hidden="true"></span>
      {i.statusLabel}
    </span>
    <Badge tone={coverageTone[i.coverage]}>{i.coverageLabel}</Badge>
    {guide && <a class="hero-guide-link" href="#baglanti-rehberi">Bağlantı rehberi</a>}
    <Fragment slot="visual">
      <div class="hero-visual" data-code={i.code}>
        <div class="hero-visual__id">
          <ChannelMono code={i.code} name={i.name} size="lg" />
          <p class="hero-visual__kind">{i.kindLabel}</p>
        </div>
        <div class="hero-meter" role="img" aria-label={meterLabel}>
          {
            Array.from({ length: METER_SEGMENTS }).map((_, idx) => (
              <span class:list={['hero-meter__seg', { 'hero-meter__seg--on': idx < filledSegments }]} />
            ))
          }
        </div>
        <ul class="hero-preview">
          {
            previewCapabilities.map((c) => (
              <li>
                <Icon name={c.level === 'supported' ? 'check' : 'info'} size="sm" />
                <span>{c.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </Fragment>
  </PageHero>

  <Section labelledby="matris-title" class="tight-section">
    <SectionHead id="matris-title" title="Yetenek matrisi" lead="Bu entegrasyonda hangi işlemlerin tam, hangilerinin temel düzeyde desteklendiği." />
    <div class="matrix-layout matrix-layout--split">
      <div class="matrix">
      <p class="matrix__head" aria-hidden="true"><span>İşlem</span><span>Ne yapılır</span></p>
      <ul class="rows" role="list" data-testid="capability-matrix">
        {
          i.capabilities.map((c) => (
            <li class="row" data-level={c.level}>
              <span class="row__icon" aria-hidden="true">
                <Icon name={c.level === 'supported' ? 'check' : 'info'} size="sm" />
              </span>
              <div class="row__body">
                <div class="row__label">
                  <h3>{c.label}</h3>
                  <LevelBadge level={c.level} label={c.levelLabel} />
                </div>
                <p class="row__note">{c.note}</p>
              </div>
            </li>
          ))
        }
      </ul>
      </div>
      <aside class="limits-aside" aria-label={hasLimits ? 'Bir bakışta, sınırlamalar ve sunulmayanlar' : 'Bir bakışta'}>
        <div class="glance" data-code={i.code} data-testid="integration-glance">
          <div class="glance__head">
            <ChannelMono code={i.code} name={i.name} size="sm" />
            <h3>Bir bakışta</h3>
          </div>
          <dl class="glance__list">
            <div><dt>Durum</dt><dd><span class="glance__status"><span class="hero-status__dot" aria-hidden="true"></span>{i.statusLabel}</span></dd></div>
            <div><dt>Tür</dt><dd>{i.kindLabel}</dd></div>
            <div><dt>Kapsam</dt><dd>{i.coverageLabel}</dd></div>
            {guide && (
              <div class="glance__creds">
                <dt>Gerekli bilgiler</dt>
                <dd>
                  <ul role="list">
                    {guide.credentials.map((c) => (
                      <li><Icon name="key" size="sm" /> {c}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            )}
          </dl>
          {guide && <a class="glance__link" href="#baglanti-rehberi">Nasıl bağlanır? <Icon name="arrow" size="sm" /></a>}
        </div>
        {
          hasLimits && (
          <>
            {i.limitations.length > 0 && (
              <div class="bound-card bound-card--warn" aria-labelledby="sinirlamalar-title" data-testid="limitations">
                <h3 id="sinirlamalar-title">
                  <Icon name="info" size="sm" /> Sınırlamalar
                </h3>
                <ul class="bullets" role="list">
                  {i.limitations.map((text) => (
                    <li>{text}</li>
                  ))}
                </ul>
              </div>
            )}
            {i.notProvided.length > 0 && (
              <div class="bound-card bound-card--off" aria-labelledby="sunulmayan-title" data-testid="not-provided">
                <h3 id="sunulmayan-title">
                  <Icon name="x" size="sm" /> Sunulmayanlar
                </h3>
                <ul class="bullets bullets--off" role="list">
                  {i.notProvided.map((text) => (
                    <li>{text}</li>
                  ))}
                </ul>
              </div>
            )}
          </>
          )
        }
      </aside>
    </div>
  </Section>

  <Section id="baglanti-rehberi" labelledby="baglan-title" tone="muted" class="tight-section">
    <SectionHead
      id="baglan-title"
      eyebrow="Bağlantı rehberi"
      title={`${i.name} nasıl bağlanır?`}
      lead="Kod yazmanız gerekmez: aşağıdaki adımları izleyin, yalnızca listelenen kimlik bilgisi türlerini hazır bulundurun."
    />
    {
      guide && (
        <div class="guide">
          <ol class="guide-steps" role="list" data-testid="connect-steps">
            {guideSteps.map((step, idx) => (
              <li class="guide-step" id={`rehber-adim-${idx + 1}`}>
                <p class="guide-step__text">
                  {step}
                  {idx === 0 && (
                    <>
                      {' '}
                      <a href={appUrls.register()}>Hesap oluşturun</a>
                    </>
                  )}
                </p>
              </li>
            ))}
          </ol>

          <section class="cred-panel" aria-labelledby="bilgiler-title">
            <div class="cred-panel__head">
              <ChannelMono code={i.code} name={i.name} size="sm" />
              <div>
                <p class="cred-panel__eyebrow">Örnek ayar ekranı</p>
                <h3 id="bilgiler-title">Gerekli bilgiler</h3>
              </div>
            </div>
            <ul class="cred-fields" role="list" data-testid="credential-types">
              {guide.credentials.map((label) => (
                <li class="cred-field">
                  <span class="cred-field__label">{label}</span>
                  <span class="cred-field__input" aria-hidden="true">
                    <span class="cred-field__mask"></span>
                    <Icon name="lock" size="sm" />
                  </span>
                </li>
              ))}
            </ul>
            {secretsSummary && (
              <p class="cred-panel__note">
                <Icon name="shield" size="sm" />
                <span>
                  {secretsSummary} <a href="/guvenlik">Güvenlik yaklaşımımız</a>
                </span>
              </p>
            )}
            {guide.note && <p class="cred-panel__warn">{guide.note}</p>}
          </section>
        </div>
      )
    }
    <div class="related">
      <h3 class="related__label">Diğer entegrasyonlar</h3>
      <ul class="others" role="list">
        {
          others.map((o) => (
            <li>
              <a class="others__link" href={`/entegrasyonlar/${o.code}`} data-code={o.code}>
                <ChannelMono code={o.code} name={o.name} size="sm" />
                <span>{o.name}</span>
              </a>
            </li>
          ))
        }
        <li><a class="others__all" href="/entegrasyonlar">Tüm entegrasyonlar</a></li>
      </ul>
    </div>
  </Section>

  <CtaBand
    id="detay-cta"
    title={`${i.name} kanalınızı bağlayın`}
    text="Hesabınızı oluşturun ve kimlik bilgilerinizi girerek başlayın."
    primary={{ label: 'Ücretsiz dene', href: appUrls.register() }}
    secondary={{ label: 'İletişime geçin', href: '/iletisim' }}
  />
</BaseLayout>

<script>
  import '../../scripts/interactions'
</script>

<style>
  /* Bölümler arası dikey ritim genel olarak sıkılaştırıldı (S11b). */
  .tight-section:global(.section) {
    padding-block: calc(var(--site-section-y) * 0.72);
  }

  /* --- Hero görsel: kanal monogramı + kapsam segment çubuğu + ilk 4 yetenek --- */
  .hero-visual {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-5);
  }
  /* Kanal rengi ışıması (dekoratif) */
  .hero-visual::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: calc(var(--ek-space-6) * -1);
    border-radius: inherit;
    background: radial-gradient(60% 50% at 50% 0%, color-mix(in srgb, var(--chan) 34%, transparent), transparent 70%);
    pointer-events: none;
  }
  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    padding: var(--ek-space-1) var(--ek-space-3);
    border: var(--site-border-width) solid color-mix(in srgb, var(--ek-color-success-subtle) 45%, transparent);
    border-radius: var(--ek-radius-full);
    background: color-mix(in srgb, var(--ek-color-success) 22%, transparent);
    color: var(--ek-color-success-subtle);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
  }
  .hero-status__dot {
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: currentColor;
    box-shadow: 0 0 0 calc(var(--site-border-width) * 3) color-mix(in srgb, currentColor 25%, transparent);
  }
  .hero-visual__id {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--ek-space-3);
    text-align: center;
  }
  .hero-visual__kind {
    color: var(--site-color-on-primary-muted);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .hero-meter {
    display: flex;
    gap: var(--ek-space-1);
  }
  .hero-meter__seg {
    flex: 1;
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: color-mix(in srgb, var(--ek-color-background) 22%, transparent);
  }
  .hero-meter__seg--on {
    background: var(--ek-color-secondary);
  }
  .hero-preview {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
    padding-top: var(--ek-space-4);
    border-top: var(--site-border-width) solid var(--site-glass-border);
  }
  .hero-preview li {
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
    color: var(--site-color-on-primary-muted);
    font-size: var(--ek-font-size-sm);
  }
  .hero-preview :global(svg) {
    flex: none;
    color: var(--ek-color-secondary);
  }

  /* --- Yetenek matrisi + sınırlar yan kutusu --- */
  .matrix-layout {
    display: grid;
    gap: var(--ek-space-8);
    align-items: start;
  }
  .matrix {
    min-width: 0;
    overflow: hidden;
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--site-radius-panel);
    background: var(--ek-color-surface);
    box-shadow: var(--site-shadow-card);
  }
  .matrix__head {
    display: none;
    max-width: none;
    padding: var(--ek-space-3) var(--ek-space-6) var(--ek-space-3) calc(var(--ek-space-6) + var(--ek-space-8) + var(--ek-space-4));
    border-bottom: var(--site-border-width) solid var(--ek-color-border-default);
    background: var(--ek-color-surface-muted);
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .rows {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Desteklenen/kısmi işlemler ikon + renk + etiketle ayrılır (yalnızca renk anlam taşımaz: ikon + metin de var). */
  .row {
    display: grid;
    gap: var(--ek-space-3) var(--ek-space-4);
    grid-template-columns: auto 1fr;
    align-items: start;
    padding: var(--ek-space-5) var(--ek-space-6);
    border-inline-start: var(--ek-space-1) solid transparent;
  }
  .row {
    transition: background-color var(--ek-duration-fast) var(--ek-easing-standard);
  }
  .row:hover {
    background: var(--ek-color-surface-muted);
  }
  .row[data-level='limited'] {
    border-inline-start-color: var(--ek-color-warning);
  }
  .row + .row {
    border-top: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .row__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-8);
    height: var(--ek-space-8);
    margin-top: var(--ek-space-1);
    border-radius: var(--ek-radius-full);
  }
  .row[data-level='supported'] .row__icon {
    background: var(--ek-color-success-subtle);
    color: var(--ek-color-success);
  }
  .row[data-level='limited'] .row__icon {
    background: var(--ek-color-warning-subtle);
    color: var(--ek-color-warning);
  }
  .row__body {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    min-width: 0;
  }
  .row__label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ek-space-2) var(--ek-space-3);
  }
  .row__label h3 {
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-lg);
  }
  .row__note {
    color: var(--site-text-body);
    font-size: var(--ek-font-size-md);
    line-height: var(--site-font-body-line-height);
  }

  /* "Bir bakışta" özet kartı */
  .glance {
    position: relative;
    overflow: hidden;
    padding: var(--ek-space-5);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--site-radius-panel);
    background:
      radial-gradient(80% 60% at 100% 0%, color-mix(in srgb, var(--chan) 8%, transparent), transparent 70%),
      var(--ek-color-surface);
    box-shadow: var(--site-shadow-card);
  }
  .glance::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: calc(var(--site-border-width) * 3);
    background: var(--chan);
  }
  .glance__head {
    display: flex;
    align-items: center;
    gap: var(--ek-space-3);
    margin-bottom: var(--ek-space-4);
  }
  .glance__head h3 {
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-lg);
  }
  .glance__list {
    margin: 0;
  }
  .glance__list > div {
    display: flex;
    justify-content: space-between;
    gap: var(--ek-space-4);
    padding-block: var(--ek-space-3);
    border-top: var(--site-border-width) solid var(--ek-color-border-default);
    font-size: var(--ek-font-size-md);
  }
  .glance__list dt {
    color: var(--site-text-meta);
  }
  .glance__list dd {
    margin: 0;
    color: var(--site-text-heading);
    font-weight: var(--ek-font-weight-semibold);
    text-align: end;
  }
  .glance__list > .glance__creds {
    flex-direction: column;
    gap: var(--ek-space-2);
  }
  .glance__creds dd {
    text-align: start;
  }
  .glance__creds ul {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .glance__creds li {
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
    font-weight: var(--ek-font-weight-medium);
  }
  .glance__creds :global(.icon) {
    color: var(--site-accent);
  }
  .glance__status {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    color: var(--ek-color-success);
  }
  .glance__link {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    min-height: var(--site-tap-target);
    margin-top: var(--ek-space-2);
    color: var(--site-link-accent);
    font-weight: var(--ek-font-weight-semibold);
    text-decoration: none;
  }
  .glance__link:hover {
    text-decoration: underline;
  }

  /* Yan kutu (masaüstü sticky; "Sınırlamalar ve sunulmayanlar" artık ayrı bölüm değil, S11b). */
  .limits-aside {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-5);
  }
  .bound-card {
    padding: var(--ek-space-5);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-inline-start: var(--ek-space-1) solid var(--ek-color-border-strong);
    border-radius: var(--ek-radius-lg);
    background: var(--ek-color-surface);
  }
  .bound-card--warn {
    border-inline-start-color: var(--ek-color-warning);
  }
  .bound-card--off {
    border-inline-start-color: var(--ek-color-content-muted);
  }
  .bound-card h3 {
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
    font-size: var(--ek-font-size-lg);
  }
  .bound-card--warn h3 {
    color: var(--ek-color-warning);
  }
  .bound-card--off h3 {
    color: var(--ek-color-content-muted);
  }
  .bullets {
    display: flex;
