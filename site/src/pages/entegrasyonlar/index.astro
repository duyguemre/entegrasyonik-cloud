---
/**
 * /entegrasyonlar — mevcut entegrasyonların vitrini (ADR-0014 Karar 2, S2b).
 * Yalnızca `getPublicIntegrations()` seçicisi: `available` entegrasyonlar; yol haritası öğeleri hiçbir koşulda yok
 * (`ROADMAP_VISIBLE=false`). Kapsam ve sınırlar dürüstçe (Destekleniyor / Sınırlı / Sunulmuyor) gösterilir.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import Section from '../../components/Section.astro'
import PageHero from '../../components/pages/PageHero.astro'
import PageMeta from '../../components/pages/PageMeta.astro'
import IntegrationCard from '../../components/pages/IntegrationCard.astro'
import ComparisonTable from '../../components/pages/ComparisonTable.astro'
import CtaBand from '../../components/pages/CtaBand.astro'
import { getPublicIntegrations, COVERAGE_LABELS, type CoverageLevel, type IntegrationKind } from '../../data/integrations'
import { breadcrumbJsonLd } from '../../lib/seo'
import { appUrls } from '../../lib/site-config'

const title = 'Entegrasyonlar'
const description =
  'Entegrasyonik ile bağlanabilen pazaryeri, e-ticaret ve ERP entegrasyonları; her birinin kapsamı ve sınırları açıkça yazılıdır.'
const crumbs = [{ label: 'Ana sayfa', href: '/' }, { label: 'Entegrasyonlar' }]

const all = getPublicIntegrations()
const groups: Array<{ kind: IntegrationKind; id: string; heading: string; note: string }> = [
  { kind: 'marketplace', id: 'pazaryerleri', heading: 'Pazaryerleri', note: 'Ürün, stok, sipariş ve satış sonrası süreçler.' },
  { kind: 'ecommerce', id: 'e-ticaret', heading: 'E-ticaret altyapıları', note: 'Kendi mağazanızın ürün ve siparişleri.' },
  { kind: 'erp', id: 'erp', heading: 'ERP ve muhasebe', note: 'Ürün kataloğu ve siparişlerin okunması.' },
]
const visibleGroups = groups
  .map((g) => ({ ...g, items: getPublicIntegrations(g.kind) }))
  .filter((g) => g.items.length > 0)

// Küçük türler (ör. tek kartlık "E-ticaret altyapıları"/"ERP ve muhasebe") tam genişlikte kendi satırında
// yalnız kalınca sağda büyük bir boşluk bırakıyordu (S11). İki (veya daha az) kartlık ardışık türler tek bir
// satırda yan yana kümelenir; zengin türler (ör. Pazaryerleri) tam genişlikte kalır.
const SMALL_GROUP_MAX = 2
type VisibleGroup = (typeof visibleGroups)[number]
const rows: VisibleGroup[][] = []
for (const g of visibleGroups) {
  const prevRow = rows[rows.length - 1]
  const prevIsSmall = prevRow && prevRow.length === 1 && prevRow[0].items.length <= SMALL_GROUP_MAX
  if (prevIsSmall && g.items.length <= SMALL_GROUP_MAX) prevRow.push(g)
  else rows.push([g])
}

// Hero görseli: kapsam segmenti göstergesinin (kart altındaki nokta şeridi) açıklaması — uydurma rakam yok,
// yalnızca `data-level` özniteliğinde (görünür metin değil) sayı geçer.
const COVERAGE_METER: Record<CoverageLevel, number> = { broad: 3, partial: 2, limited: 1 }
const coverageLevels = Object.keys(COVERAGE_LABELS) as CoverageLevel[]
---

<BaseLayout title={title} description={description}>
  <PageMeta
    slot="head"
    title={title}
    description={description}
    jsonLd={[breadcrumbJsonLd([{ label: 'Ana sayfa', path: '/' }, { label: title, path: '/entegrasyonlar' }])]}
  />

  <PageHero
    title="Entegrasyonlar"
    lead="Pazaryeri, e-ticaret altyapısı ve ERP bağlantılarınızı tek panelden yönetin. Her entegrasyonun neyi desteklediği ve neyi desteklemediği açıkça yazılıdır."
    crumbs={crumbs}
  >
    <nav class="kind-nav" aria-label="Entegrasyon türleri">
      {visibleGroups.map((g) => <a href={`#${g.id}`}>{g.heading}</a>)}
      <a href="#karsilastirma">Kapsam karşılaştırması</a>
    </nav>
    <Fragment slot="visual">
      <p class="stat-panel__tag">Kapsam nasıl okunur</p>
      <ul class="legend" role="list">
        {
          coverageLevels.map((level) => (
            <li>
              <span class="legend__meter" aria-hidden="true" data-level={COVERAGE_METER[level]}>
                <span></span><span></span><span></span>
              </span>
              <span class="legend__label">{COVERAGE_LABELS[level]}</span>
            </li>
          ))
        }
      </ul>
      <p class="stat-panel__caption">Her kartın altında aynı gösterge; ayrıntı detay sayfasındadır.</p>
    </Fragment>
  </PageHero>

  <Section labelledby="katalog-title" class="tight-section">
    <h2 id="katalog-title" class="sr-only">Entegrasyon kataloğu</h2>
    {
      rows.map((row, index) => (
        <div class:list={['kind-row', { 'kind-row--cluster': row.length > 1 }]} data-first={index === 0 ? 'true' : undefined}>
          {row.map((g) => (
            <div class="kind-group" id={g.id}>
              <div class="group__head">
                <h3 id={`${g.id}-title`}>{g.heading}</h3>
                <p>{g.note}</p>
              </div>
              <ul class="grid" role="list">
                {g.items.map((integration) => (
                  <li>
                    <IntegrationCard integration={integration} />
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      ))
    }
  </Section>

  <Section id="karsilastirma" labelledby="karsilastirma-title" tone="muted" class="tight-section">
    <div class="group__head">
      <h2 id="karsilastirma-title">Kapsam karşılaştırması</h2>
      <p>
        Kapsam entegrasyona göre değişir. “Sunulmuyor”, ilgili işlemin bu sürümde o entegrasyonda bulunmadığı anlamına gelir.
      </p>
    </div>
    <ComparisonTable integrations={all} labelledby="karsilastirma-title" />
    <p class="fineprint">Listede yer almayan bir entegrasyon şu an mevcut değildir.</p>
  </Section>

  <CtaBand
    id="entegrasyon-cta"
    title="Kanallarınızı tek panelde toplayın"
    text="Hesabınızı oluşturun, kanal kimlik bilgilerinizi bağlayın ve ürün, stok ve siparişlerinizi tek yerden yönetin."
    primary={{ label: 'Ücretsiz dene', href: appUrls.register() }}
    secondary={{ label: 'Sık sorulan sorular', href: '/sss' }}
  />
</BaseLayout>

<script>
  import '../../scripts/interactions'
</script>

<style>
  .kind-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-2) var(--ek-space-3);
  }
  .kind-nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--site-tap-target);
    padding-inline: var(--ek-space-4);
    border: var(--site-border-width) solid var(--site-color-on-primary-muted);
    border-radius: var(--ek-radius-full);
    color: var(--site-color-on-primary);
    font-weight: var(--ek-font-weight-medium);
    text-decoration: none;
    transition:
      background-color var(--ek-duration-base) var(--ek-easing-standard),
      border-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .kind-nav a:hover {
    background: color-mix(in srgb, var(--ek-color-background) 12%, transparent);
    border-color: var(--site-color-on-primary);
  }
  .kind-nav a:focus-visible {
    outline-color: var(--site-color-on-primary);
  }
  /* Bölümler arası dikey ritim genel olarak sıkılaştırıldı (S11b). */
  .tight-section:global(.section) {
    padding-block: calc(var(--site-section-y) * 0.72);
  }
  /* Tek Section içinde art arda kataloğu türleri — her biri kendi tam bölümü olmadığı için S9'daki aşırı
     boşluk giderildi; yalnızca ince bir ayraçla ayrılır. */
  .kind-row + .kind-row {
    margin-top: var(--ek-space-12);
    padding-top: var(--ek-space-12);
    border-top: var(--site-border-width) solid var(--ek-color-border-default);
  }
  /* İki küçük tür (≤2 kart) yan yana kümelenir: tek başına kaldığında sağda büyük boşluk bırakan tek kartlık
     bölüm yerine, aynı satırda iki dar sütun (S11). */
  .kind-row--cluster {
    display: grid;
    gap: var(--ek-space-10);
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .kind-row--cluster {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .group__head {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    margin-bottom: var(--ek-space-6);
  }
  .group__head h3 {
    font-size: var(--site-font-display-sm);
    font-weight: var(--site-font-display-weight);
    line-height: var(--site-font-display-line-height);
    letter-spacing: var(--site-font-display-tracking);
  }
  .group__head p {
    color: var(--ek-color-content-muted);
    font-size: var(--ek-font-size-lg);
  }
  /* `flex` (grid değil): tek/iki ögeli türlerde kart tam satır genişliğine gerilmez, doğal boyutunda solda
     kalır — geniş boş sütun bırakmaz. Çok ögeli türlerde ise doğal olarak birden çok sütuna sarar. */
  .grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-6);
  }
  .grid > li {
    display: flex;
    flex: 1 1 20rem;
    max-width: 26rem;
  }
  .grid > li > :global(*) {
    width: 100%;
  }
  .fineprint {
    margin-top: var(--ek-space-6);
    color: var(--ek-color-content-muted);
    font-size: var(--ek-font-size-md);
  }

  /* --- Hero görsel: kapsam gösterge kılavuzu --- */
  .stat-panel__tag {
    margin: 0 0 var(--ek-space-4);
    color: var(--site-color-on-primary-muted);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .stat-panel__caption {
    margin: var(--ek-space-5) 0 0;
    color: var(--site-color-on-primary-muted);
    font-size: var(--ek-font-size-sm);
  }
  .legend {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-4);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: var(--ek-space-3);
  }
  .legend li + li {
    padding-top: var(--ek-space-4);
    border-top: var(--site-border-width) solid var(--site-glass-border);
  }
  .legend__meter {
    display: inline-flex;
    flex: none;
    gap: var(--ek-space-1);
  }
  .legend__meter span {
    width: var(--ek-space-5);
    height: var(--ek-space-1);
    border-radius: var(--ek-radius-full);
    background: color-mix(in srgb, var(--ek-color-background) 24%, transparent);
  }
  .legend__meter[data-level='1'] span:nth-child(1),
  .legend__meter[data-level='2'] span:nth-child(-n + 2),
  .legend__meter[data-level='3'] span {
    background: var(--ek-color-secondary);
  }
  .legend__label {
    color: var(--site-color-on-primary);
    font-size: var(--ek-font-size-lg);
    font-weight: var(--ek-font-weight-semibold);
  }
</style>
