---
/**
 * /entegrasyonlar — mevcut entegrasyonların vitrini (ADR-0014 Karar 2, S2b).
 * Yalnızca `getPublicIntegrations()` seçicisi: `available` entegrasyonlar; yol haritası öğeleri hiçbir koşulda yok
 * (`ROADMAP_VISIBLE=false`). Kapsam ve farklar sakin bir dille "Kanal bazında kapsam" bölümünde (S12: ana sayfadaki
 * kapsam matrisi buraya taşındı; `CoverageMatrix`) ve kartlarda eksiksiz gösterilir.
 * 2026-10-02 pazarlama düzeni: hero'da merkez diyagramı (Entegrasyonik + bağlı kanallar), ferah çip'li kartlar,
 * sayfa sonunda kanıtlı "Geliştirme listemizde" kanal başlıkları (DevelopmentList, BACKLOG kanıtlı).
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import { crumbsFor } from '../../data/seo'
import Section from '../../components/Section.astro'
import PageHero from '../../components/pages/PageHero.astro'
import IntegrationCard from '../../components/pages/IntegrationCard.astro'
import CoverageMatrix from '../../components/pages/CoverageMatrix.astro'
import CtaBand from '../../components/pages/CtaBand.astro'
import HeroActions from '../../components/pages/HeroActions.astro'
import StatPanel from '../../components/pages/StatPanel.astro'
import Eyebrow from '../../components/Eyebrow.astro'
import DevelopmentList from '../../components/pages/DevelopmentList.astro'
import ChannelMono from '../../components/pages/ChannelMono.astro'
import Logo from '../../components/Logo.astro'
import { getPublicIntegrations, COVERAGE_LABELS, type CoverageLevel, type IntegrationKind } from '../../data/integrations'
import { appUrls } from '../../lib/site-config'

const crumbs = crumbsFor('/entegrasyonlar')

const all = getPublicIntegrations()
const groups: Array<{ kind: IntegrationKind; id: string; heading: string; note: string }> = [
  { kind: 'marketplace', id: 'pazaryerleri', heading: 'Pazaryerleri', note: 'Ürün, stok, sipariş ve satış sonrası süreçler.' },
  { kind: 'ecommerce', id: 'e-ticaret', heading: 'E-ticaret altyapıları', note: 'Kendi mağazanızın ürün ve siparişleri.' },
  { kind: 'erp', id: 'erp', heading: 'ERP ve muhasebe', note: 'Ürün kataloğu ve siparişlerin okunması.' },
]
// Yalnızca kayıtta gerçekten entegrasyonu olan türler sekme olur (kargo/fatura gibi uygulanmamış türler görünmez).
const visibleGroups = groups
  .map((g) => ({ ...g, items: getPublicIntegrations(g.kind) }))
  .filter((g) => g.items.length > 0)

/*
 * S16 kapsam özeti sayaçları — YALNIZCA kayıttan hesaplanır (sabit rakam yazılmaz). tests/pages.test.ts her
 * `data-stat` değerini aynı kayıttan yeniden hesaplayıp karşılaştırır.
 */
const capabilityKinds = new Set(all.flatMap((i) => i.capabilities.map((c) => c.key)))
const stats = [
  { id: 'integrations', value: all.length, label: 'kullanılabilir entegrasyon' },
  { id: 'marketplaces', value: getPublicIntegrations('marketplace').length, label: 'pazaryeri' },
  { id: 'kinds', value: visibleGroups.length, label: 'kategori' },
  { id: 'capabilities', value: capabilityKinds.size, label: 'işlem türü' },
]

const COVERAGE_METER: Record<CoverageLevel, number> = { broad: 3, partial: 2, limited: 1 }
const coverageLevels = Object.keys(COVERAGE_LABELS) as CoverageLevel[]
// Merkez diyagramı: kanallar iki yana bölünür (yalnızca görsel; anlam aşağıdaki kartlarda).
const half = Math.ceil(all.length / 2)
const sides = [all.slice(0, half), all.slice(half)]
---

<BaseLayout>

  <PageHero
    title="Sattığınız her yer, aynı merkezde"
    accent="aynı merkezde"
    eyebrow="Entegrasyonlar"
    lead="Pazaryerleriniz, e-ticaret siteniz ve ERP'niz aynı ekranda buluşur. Her kanalın hangi işlemleri desteklediğini kanal kanal açıkça gösteriyoruz."
    crumbs={crumbs}
  >
    <HeroActions
      actions={[
        { label: 'Kataloğa göz atın', href: '#katalog' },
        { label: 'Kanal bazında kapsam', href: '#kapsam' },
      ]}
    />
    <Fragment slot="visual">
      <div class="hub" aria-hidden="true">
        {
          sides.map((side, si) => (
            <ul class:list={['hub__side', `hub__side--${si === 0 ? 'start' : 'end'}`]} role="list">
              {side.map((c) => (
                <li data-code={c.code}>
                  <ChannelMono code={c.code} name={c.name} size="sm" />
                  <span>{c.name}</span>
                </li>
              ))}
            </ul>
          ))
        }
        <div class="hub__core">
          <Logo tone="inverse" />
        </div>
      </div>
      <StatPanel tag="Kapsam özeti" stats={stats} testid="integration-stats" />
    </Fragment>
  </PageHero>

  <Section id="katalog" labelledby="katalog-title" class="tight-section">
    <div class="cat-head">
      <div class="cat-head__text">
        <Eyebrow>Katalog</Eyebrow>
        <h2 id="katalog-title">Entegrasyon kataloğu</h2>
        <p>Kategoriye göre süzün; her kartta desteklenen işlemler ve kapsam düzeyi yer alır.</p>
      </div>
      <ul class="legend" role="list" aria-label="Kapsam göstergesi">
        {
          coverageLevels.map((level) => (
            <li>
              <span class="legend__meter" aria-hidden="true" data-level={COVERAGE_METER[level]}>
                <span></span><span></span><span></span>
              </span>
              {COVERAGE_LABELS[level]}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="filters" role="group" aria-label="Kategoriye göre süz" data-int-filter data-testid="integration-filter">
      <button type="button" class="filter" aria-pressed="true" data-filter="all">
        Tümü <span class="filter__count" data-stat="integrations">{all.length}</span>
      </button>
      {
        visibleGroups.map((g) => (
          <button type="button" class="filter" aria-pressed="false" data-filter={g.kind} aria-controls="int-grid">
            {g.heading} <span class="filter__count" data-stat={`kind-${g.kind}`}>{g.items.length}</span>
          </button>
        ))
      }
    </div>
    <p class="sr-only" role="status" aria-live="polite" data-int-filter-status></p>

    <ul class="grid" role="list" id="int-grid" data-testid="integration-grid">
      {
        all.map((integration) => (
          <li data-kind={integration.kind}>
            <IntegrationCard integration={integration} />
          </li>
        ))
      }
    </ul>
    <p class="fineprint">Bu sayfada yer alan entegrasyonları hesabınıza bugün bağlayabilirsiniz. Listede olmayan bir kanal için <a href="/iletisim">bize yazın</a>.</p>
  </Section>

  <Section id="kapsam" labelledby="kapsam-title" tone="muted" class="tight-section">
    <div class="group__head">
      <Eyebrow>Kapsam</Eyebrow>
      <h2 id="kapsam-title">Kanal bazında kapsam</h2>
      <p>
        Her kanalın desteklediği işlemler bir bakışta. Kapsam, kanalın sunduğu olanaklara göre farklılaşır; ayrıntılar
        her entegrasyonun kendi sayfasındadır.
      </p>
    </div>
    <CoverageMatrix integrations={all} labelledby="kapsam-title" />
  </Section>

  <Section labelledby="gelistirme-baslik" class="tight-section">
    <DevelopmentList
      area="channels"
      id="gelistirme-baslik"
      title="Bağlantı ağımız büyüyor"
      lead="Geliştirme listemizdeki yeni kanal ve sistem bağlantıları."
    />
  </Section>

  <CtaBand
    id="entegrasyon-cta"
    title="Kanallarınızı bugün bağlayın"
    text="Hesabınızı oluşturun, kanal bilgilerinizi girin; ürün, stok ve siparişleriniz ilk günden aynı akışta ilerlesin."
    primary={{ label: 'Ücretsiz deneyin', href: appUrls.register() }}
    secondary={{ label: 'Sık sorulan sorular', href: '/sss' }}
  />
</BaseLayout>

<script>
  import '../../scripts/interactions'
  import '../../scripts/integration-filter'
</script>

<style>
  :global(.section.tight-section) {
    padding-block: calc(var(--site-section-y) * 0.72);
  }

  /* --- Katalog başlığı + gösterge --- */
  .cat-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--ek-space-6);
    margin-bottom: var(--ek-space-6);
  }
  .cat-head__text {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    max-width: 40rem;
  }
  .cat-head h2,
  .group__head h2 {
    color: var(--site-text-heading);
    font-size: var(--site-font-display-sm);
    font-weight: var(--site-font-display-weight);
    line-height: var(--site-font-display-line-height);
    letter-spacing: var(--site-font-display-tracking);
  }
  .cat-head p:not(.eyebrow),
  .group__head p:not(.eyebrow) {
    color: var(--site-text-body);
    font-size: var(--ek-font-size-lg);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-2) var(--ek-space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-sm);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
  }
  .legend__meter {
    display: inline-flex;
    gap: calc(var(--ek-space-1) * 0.5);
  }
  .legend__meter span {
    width: var(--ek-space-3);
    height: var(--ek-space-1);
    border-radius: var(--ek-radius-sm);
    background: var(--ek-color-border-default);
  }
  .legend__meter[data-level='1'] span:nth-child(1),
  .legend__meter[data-level='2'] span:nth-child(-n + 2),
  .legend__meter[data-level='3'] span {
    background: var(--site-accent);
  }

  /* --- Süzgeç çipleri --- */
  .filters {
    /* SITE-DL-03: köşeli süzgeç şeridi; seçili = lacivert ton (gölge yok). */
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-2);
    margin-bottom: var(--ek-space-8);
    padding: var(--ek-space-1);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-tile);
    background: var(--ek-color-surface-muted);
    width: fit-content;
    max-width: 100%;
  }
  .filter {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    min-height: var(--site-tap-target);
    padding-inline: var(--ek-space-4);
    border: var(--site-border-width) solid transparent;
    border-radius: var(--ek-radius-md);
    background: transparent;
    color: var(--site-text-body);
    font: inherit;
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-medium);
    cursor: pointer;
    transition: 
      background-color var(--ek-duration-fast) var(--ek-easing-standard),
      border-color var(--ek-duration-fast) var(--ek-easing-standard),
      color var(--ek-duration-fast) var(--ek-easing-standard);
  }
  .filter:hover {
    color: var(--site-text-heading);
    background: var(--ek-color-surface);
  }
  .filter:focus-visible {
    outline: var(--site-focus-ring-width) solid var(--site-color-focus-ring);
    outline-offset: var(--site-focus-ring-offset);
  }
  .filter[aria-pressed='true'] {
    border-color: var(--site-action-border);
    background: var(--site-action-subtle);
    color: var(--site-action-emphasis);
    font-weight: var(--ek-font-weight-semibold);
  }
  .filter__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--ek-space-6);
    height: var(--ek-space-6);
    padding-inline: var(--ek-space-1);
    border-radius: var(--ek-radius-sm);
    background: var(--ek-color-surface);
    color: var(--site-text-body);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    font-variant-numeric: tabular-nums;
    box-sizing: border-box;
    border: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .filter[aria-pressed='true'] .filter__count {
    background: var(--ek-color-surface);
    color: var(--site-action-emphasis);
    border-color: var(--site-action-border);
  }

  /* --- Kart ızgarası --- */
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ek-space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .grid > li {
    display: flex;
    min-width: 0;
  }
  .grid > li[hidden] {
    display: none;
  }
  .grid > li > :global(*) {
    width: 100%;
  }
  @media (min-width: 700px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .fineprint {
    margin-top: var(--ek-space-8);
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-md);
  }
  .fineprint a {
    color: var(--site-link-accent);
    font-weight: var(--ek-font-weight-semibold);
  }
  .group__head {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    margin-bottom: var(--ek-space-6);
  }
  /* --- Hero görsel: merkez diyagramı (düz yüzeyler; degrade yok) --- */
  .hub {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--ek-space-4);
    margin-bottom: var(--ek-space-6);
    padding-bottom: var(--ek-space-6);
    border-bottom: var(--site-border-width) solid var(--site-glass-border);
  }
  .hub__side {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
  }
  .hub__side--end {
    grid-column: 3;
    grid-row: 1;
  }
  .hub__side li {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
    padding: var(--ek-space-2);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-tile);
    background: var(--site-glass-bg);
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-medium);
  }
  /* Bağlantı çizgisi: kanal kutusundan merkeze doğru (kanal renginde ince hat). */
  .hub__side li::after {
    content: '';
    position: absolute;
    top: 50%;
    width: var(--ek-space-4);
    height: var(--site-border-width);
    background: color-mix(in srgb, var(--chan) 70%, transparent);
  }
  .hub__side--start li::after {
    left: 100%;
  }
  .hub__side--end li::after {
    right: 100%;
  }
  .hub__core {
    grid-column: 2;
    grid-row: 1;
    display: grid;
    place-items: center;
    padding: var(--ek-space-4);
    border: var(--site-border-width) solid var(--ek-color-chrome-soft-border);
    border-radius: var(--ek-radius-card);
    background: var(--ek-color-chrome);
  }
  .hub__core :global(.logo__word) {
    display: none;
  }
  .hub__core :global(.logo__mark) {
    width: var(--ek-space-12);
    height: var(--ek-space-12);
  }
</style>
