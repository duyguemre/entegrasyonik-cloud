  name:
    | 'stock'
    | 'layers'
    | 'orders'
    | 'returns'
    | 'chat'
    | 'finance'
    | 'notice'
    | 'plug'
    | 'database'
    | 'lock'
    | 'shield'
    | 'users'
    | 'card'
    | 'check'
    | 'x'
    | 'chevron'
    | 'arrow'
