const { name, size = 'md', class: className } = Astro.props
---

<svg class:list={['icon', `icon--${size}`, className]} data-icon={name} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path d={PATHS[name]}></path>
</svg>

<style>
  .icon {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .icon--sm {
    width: var(--ek-space-4);
    height: var(--ek-space-4);
  }
  .icon--md {
    width: var(--ek-space-6);
    height: var(--ek-space-6);
  }
  .icon--lg {
    width: var(--ek-space-8);
    height: var(--ek-space-8);
  }
</style>
