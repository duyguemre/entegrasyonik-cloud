---
/**
 * Hero (ADR-0014 Karar 2, bölüm 1; S12 pazarlama dili) — değer önerisi + birincil/ikincil CTA + CANLI HİSSİ veren
 * "sipariş ve stok merkezi" paneli. Sahne: `data-scene="hero-mock"` (src/styles/scenes.css + scenes-loops.css +
 * src/scripts/scenes.ts). Panel tamamen HTML/CSS ile çizilir (görsel dosya yok) ve AÇIKÇA "Örnek görünüm" etiketlidir:
 * sipariş ve sayılar gerçek veri değil, arayüz örneğidir; müşteri/logo/ölçüm uydurulmaz.
 *
 * S12 (kullanıcı geri bildirimi): ana mesajda pazaryeri ADI geçmez ("pazaryerleri"); panelde kanal adı yerine
 * isimsiz renkli noktalar (`--site-channel-*`, `[data-code]` eşlemesi) ve genel etiketler ("Pazaryeri siparişi",
 * "Web mağaza"). Panel renkleri site paletinden (lacivert + tek vurgu teal). Güven maddeleri üst seviye
 * faydadır; her biri kanıtlı bir yetenek kaydına bağlıdır (kayıt yoksa madde gösterilmez).
 * Statik hâl (reduced-motion / durdurulmuş / JS'siz): üç sipariş "Rezerve", stok 9, rezerve 3, kanallar senkron.
 * Hareketli hâl (yalnızca görünürken, 12 sn döngü): siparişler sırayla vurgulanır -> rezerve edilir -> stok sayacı
 * akarak azalır -> güncelleme sinyali kanal noktalarına yayılır.
 */
import Button from '../Button.astro'
import Icon from './Icon.astro'
import { appUrls } from '../../lib/site-config'
import { getPublicIntegrations } from '../../data/integrations'
import { getPublicCapabilities } from '../../data/capabilities'
import { getPublicTrial } from '../../data/plans'

const trial = getPublicTrial()
// Kanal noktaları: yalnızca mevcut entegrasyonların RENGİ (ad DOM'a yazılmaz; panel aria-hidden'dır).
const channels = getPublicIntegrations().map((c) => ({ code: c.code }))
const marketplaces = getPublicIntegrations('marketplace')
const storefront = getPublicIntegrations('ecommerce')[0]

// Üst seviye faydalar — her biri kanıtlı bir yetenek kaydına dayanır (capabilities.ts); kayıt yoksa gösterilmez.
const capIds = new Set(getPublicCapabilities().map((c) => c.id))
const benefits = [
  { icon: 'stock' as const, label: 'Merkezi stok yönetimi', requires: ['stock-reservation', 'multi-channel-products'] },
  { icon: 'orders' as const, label: 'Tüm siparişler tek ekranda', requires: ['unified-orders'] },
  { icon: 'shield' as const, label: 'Kurumsal düzeyde güvenlik', requires: ['secrets-encryption', 'tenant-database', 'role-based-access'] },
].filter((b) => b.requires.every((id) => capIds.has(id)))

// Panel örneği: iki pazaryeri siparişi + bir web mağaza siparişi (genel etiket; renk kanal paletinden).
const orders = [
  { code: marketplaces[0]?.code, label: 'Pazaryeri siparişi' },
  { code: marketplaces[1]?.code, label: 'Pazaryeri siparişi' },
  storefront ? { code: storefront.code, label: 'Web mağaza' } : { code: marketplaces[2]?.code, label: 'Pazaryeri siparişi' },
]
---

<section class="hero" aria-labelledby="hero-title" data-testid="hero" data-surface="dark">
  <div class="hero__bg" aria-hidden="true" data-scene="hero-bg">
    <span class="hero__grid"></span>
    <span class="hero__orb hero__orb--a" data-part="orb"></span>
    <span class="hero__orb hero__orb--b" data-part="orb"></span>
  </div>

  <div class="hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow"><span class="hero__eyebrow-dot" aria-hidden="true"></span>Çok kanallı satış yönetimi</p>
      <h1 id="hero-title" class="hero__title">
        Tüm pazaryerleriniz, <span class="hero__accent">tek stok</span>, tek panel.
      </h1>
      <p class="hero__lead" data-testid="hero-lead">
        Pazaryerlerindeki ürün, stok, sipariş ve iade operasyonunuzu tek merkezde birleştirin. Eşzamanlı gelen
        siparişlerde stok rezerve edilir, aşırı satış riski azalır; ekibiniz panel panel dolaşmak yerine satışa odaklanır.
      </p>
      <div class="hero__actions">
        <Button href={appUrls.register()} variant="inverse" size="lg" data-testid="hero-cta-primary">Ücretsiz dene</Button>
        <Button href="#nasil-calisir" variant="inverse-outline" size="lg" data-testid="hero-cta-secondary">Nasıl çalışır</Button>
      </div>
      <p class="hero__note">{trial.days} gün ücretsiz deneme{!trial.cardRequired && ', kart bilgisi gerekmez'}.</p>
      <ul class="hero__trust" aria-label="Öne çıkan faydalar" data-testid="hero-benefits">
        {
          benefits.map((b) => (
            <li>
              <span class="hero__trust-icon" aria-hidden="true">
                <Icon name={b.icon} size="sm" />
              </span>
              <span>{b.label}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__visual" data-parallax-root>
      <div class="mock" data-scene="hero-mock" data-tilt aria-hidden="true" data-testid="hero-mock">
        <div class="mock__bar">
          <span class="mock__dots"><i></i><i></i><i></i></span>
          <span class="mock__title">Sipariş ve stok merkezi</span>
          <span class="mock__tag">Örnek görünüm</span>
        </div>

        <div class="mock__body">
          <div class="mock__channels-row">
            <p class="mock__label">Satış kanalları</p>
            <ul class="mock__channels">
              {channels.map((c) => <li class="mock__chan" data-part="chan" data-code={c.code} />)}
            </ul>
            <span class="mock__sync"><i class="mock__live"></i>Senkron</span>
            <div class="mock__rail"><span class="mock__glow" data-part="glow"></span></div>
          </div>

          <div class="mock__cols">
            <div class="mock__stock">
              <p class="mock__label">Merkezi stok</p>
              <p class="mock__big">
                <span class="mock__num mock__num--a" data-part="num">12</span>
                <span class="mock__num mock__num--b" data-part="num">11</span>
                <span class="mock__num mock__num--c" data-part="num">10</span>
                <span class="mock__num mock__num--d" data-part="num">9</span>
              </p>
              <p class="mock__unit">adet · tüm kanallarda</p>
              <div class="mock__meter"><span class="mock__fill" data-part="fill"></span></div>
              <p class="mock__sub">
                Rezerve
                <span class="mock__resv">
                  <b class="mock__rnum mock__rnum--a" data-part="rnum">0</b>
                  <b class="mock__rnum mock__rnum--b" data-part="rnum">1</b>
                  <b class="mock__rnum mock__rnum--c" data-part="rnum">2</b>
                  <b class="mock__rnum mock__rnum--d" data-part="rnum">3</b>
                </span>
              </p>
            </div>

            <div class="mock__feed">
              <p class="mock__label">Gelen siparişler</p>
              <ul class="mock__rows">
                {
                  orders.map((o) => (
                    <li class="mock__row" data-part="row" data-code={o.code}>
                      <span class="mock__rchan">
                        <span class="mock__rdot" />
                        <span class="mock__rlabel">{o.label}</span>
                      </span>
                      <span class="mock__pills">
                        <span class="mock__pill mock__pill--new" data-part="pill-new">Yeni</span>
                        <span class="mock__pill mock__pill--ok">Rezerve</span>
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>

        <p class="mock__toast" data-part="toast">
          <span class="mock__toast-icon"><Icon name="refresh" size="sm" /></span>
          <span>Stok güncellemesi kanallara iletildi</span>
        </p>
      </div>
      <p class="sr-only">Örnek görünüm — gerçek veri değildir.</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: var(--ek-space-12) var(--ek-space-16);
    background: var(--site-stage-mesh);
    color: var(--site-text-on-dark-heading);
  }

  /* --- Arka plan: ızgara dokusu (radyal solma) + iki yavaş ışıma (tek vurgu ailesi: teal + lacivert) --- */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image: var(--site-texture-grid);
    background-size: var(--site-texture-grid-size);
    -webkit-mask-image: var(--site-texture-fade);
    mask-image: var(--site-texture-fade);
  }
  .hero__orb {
    position: absolute;
    width: 32rem;
    max-width: 90vw;
    aspect-ratio: 1 / 1;
    border-radius: var(--ek-radius-full);
  }
  .hero__orb--a {
    inset-block-start: -8rem;
    inset-inline-end: -6rem;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--ek-color-secondary) 24%, transparent), transparent);
  }
  .hero__orb--b {
    inset-block-end: -10rem;
    inset-inline-start: -8rem;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--ek-color-primary-darken-1) 38%, transparent), transparent);
  }

  .hero__inner {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--site-gutter);
    max-width: calc(var(--site-container-max) + 2 * var(--site-gutter));
    display: grid;
    gap: var(--ek-space-12);
    align-items: center;
  }
  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ek-space-6);
    min-width: 0;
  }
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    padding: var(--ek-space-1) var(--ek-space-3);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-full);
    background: var(--site-glass-bg);
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.04em;
  }
  .hero__eyebrow-dot {
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--site-accent);
    box-shadow: var(--site-glow-ring);
  }
  .hero__title {
    color: var(--site-text-on-dark-heading);
    font-size: var(--site-font-display-lg);
    font-weight: var(--site-font-display-weight);
    line-height: var(--site-font-display-line-height);
    letter-spacing: var(--site-font-display-tracking);
    text-wrap: balance;
  }
  .hero__accent {
    background: var(--site-gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--site-accent);
  }
  .hero__lead {
    color: var(--site-text-on-dark-body);
    font-size: var(--ek-font-size-xl);
    line-height: var(--site-font-body-line-height);
    max-width: 36rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-3);
  }
  .hero__note {
    color: var(--site-text-on-dark-meta);
    font-size: var(--ek-font-size-md);
  }
  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-3) var(--ek-space-6);
    padding-top: var(--ek-space-5);
    border-top: var(--site-border-width) solid var(--site-glass-border);
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-medium);
  }
  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
  }
  .hero__trust-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-6);
    height: var(--ek-space-6);
    border-radius: var(--ek-radius-md);
    background: color-mix(in srgb, var(--site-accent) 16%, transparent);
    color: var(--site-accent);
  }

  /* --- Ürün paneli --- */
  .hero__visual {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
    min-width: 0;
  }
  .hero__visual::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -14% -12% 4%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--ek-color-secondary) 22%, transparent), transparent);
    pointer-events: none;
  }
  /*
   * İkinci (en uzak) ofset pencere katmanı: .mock::after ile birlikte 2 katmanlı derinlik yığını oluşturur.
   * S9: her iki katman da imleç konumuna (`pointer: fine`) ve kaydırma konumuna göre birkaç piksel kayar
   * (src/scripts/interactions.ts `--depth-a-*`/`--depth-b-*`); JS'siz/hareket kapalıyken sabit ofsette kalır.
   */
  .hero__visual::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: calc(var(--ek-space-8) * -1) calc(var(--ek-space-6) * -1) calc(var(--ek-space-3) * -1) var(--ek-space-8);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--site-radius-panel);
    background: var(--site-glass-bg);
    opacity: 0.5;
    translate: var(--depth-b-x, 0) var(--depth-b-y, 0);
    transition: translate var(--ek-duration-slow) var(--ek-easing-standard);
    pointer-events: none;
  }
  .mock {
    /* Panel açık yüzeydir: hero'nun koyu-zemin vurgusu yerine açık-zemin (AA) vurgu tonu. */
    --site-accent: var(--ek-color-secondary-darken-1);
    --mock-ink: var(--ek-color-primary);
    position: relative;
    border-radius: var(--site-radius-panel);
    background: var(--ek-color-background);
    box-shadow: var(--site-shadow-panel);
    color: var(--site-text-body);
    font-size: var(--ek-font-size-sm);
    line-height: var(--ek-line-height-tight);
    user-select: none;
  }
  .mock::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: var(--ek-space-5) calc(var(--ek-space-4) * -1) calc(var(--ek-space-5) * -1) var(--ek-space-5);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--site-radius-panel);
    background: var(--site-glass-bg);
    translate: var(--depth-a-x, 0) var(--depth-a-y, 0);
    transition: translate var(--ek-duration-slow) var(--ek-easing-standard);
    pointer-events: none;
  }
  .mock__bar {
    display: flex;
    align-items: center;
    gap: var(--ek-space-3);
    padding: var(--ek-space-3) var(--ek-space-4);
    border-bottom: var(--site-border-width) solid var(--ek-color-border-default);
    border-start-start-radius: var(--site-radius-panel);
    border-start-end-radius: var(--site-radius-panel);
    background: var(--ek-color-surface-muted);
  }
  .mock__dots {
    display: inline-flex;
    gap: var(--ek-space-1);
  }
  .mock__dots i {
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-border-strong);
  }
  .mock__title {
    flex: 1;
    min-width: 0;
    color: var(--site-text-heading);
    font-weight: var(--ek-font-weight-semibold);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mock__tag {
    padding: var(--ek-space-1) var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface-sunken);
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    white-space: nowrap;
  }
  .mock__body {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-4);
    padding: var(--ek-space-4);
  }
  .mock__label {
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Kanal satırı: isimsiz renkli noktalar + "Senkron" durumu + güncelleme ışını */
  .mock__channels-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--ek-space-2) var(--ek-space-3);
    padding: var(--ek-space-3) var(--ek-space-4);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-lg);
    background: var(--ek-color-surface-muted);
  }
  .mock__channels {
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
  }
  .mock__chan {
    position: relative;
    flex: none;
    width: var(--ek-space-3);
    height: var(--ek-space-3);
    border-radius: var(--ek-radius-full);
    background: var(--chan, var(--site-accent));
    box-shadow: 0 0 0 calc(var(--site-border-width) * 2) var(--ek-color-background);
  }
  /* Sinyal halkası: 12 sn döngüde kanal güncellemesi geldiğinde belirir (scenes-loops.css); statik hâlde görünmez. */
  .mock__chan::after {
    content: '';
    position: absolute;
    inset: calc(var(--ek-space-1) * -1);
    border: var(--site-border-width) solid var(--chan, var(--site-accent));
    border-radius: var(--ek-radius-full);
    opacity: 0;
    pointer-events: none;
  }
  .mock__sync {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-1);
    color: var(--site-accent);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
  }
  .mock__live {
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--site-accent);
    box-shadow: 0 0 0 calc(var(--site-border-width) * 3) var(--site-accent-soft);
  }
  .mock__rail {
    grid-column: 1 / -1;
    position: relative;
    overflow: hidden;
    height: calc(var(--site-border-width) * 2);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-border-default);
  }
  .mock__glow {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 28%;
    border-radius: var(--ek-radius-full);
    background: linear-gradient(90deg, transparent, var(--site-accent), transparent);
    opacity: 0;
  }

  .mock__cols {
    display: grid;
    gap: var(--ek-space-4);
  }
  .mock__stock,
  .mock__feed {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    padding: var(--ek-space-4);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-lg);
    background: var(--ek-color-surface);
  }
  .mock__stock {
    background:
      radial-gradient(120% 90% at 100% 0%, var(--site-accent-soft), transparent 60%),
      var(--ek-color-surface);
  }
  .mock__big {
    display: grid;
    overflow: hidden;
    max-width: none;
    color: var(--mock-ink);
    font-size: var(--site-font-display-sm);
    font-weight: var(--site-font-display-weight);
    letter-spacing: var(--site-font-display-tracking);
    line-height: 1.1;
  }
  .mock__num {
    grid-area: 1 / 1;
    opacity: 0;
  }
  .mock__num--d {
    opacity: 1;
  }
  .mock__unit {
    margin-top: calc(var(--ek-space-1) * -1);
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-xs);
  }
  .mock__meter {
    margin-top: auto;
    overflow: hidden;
    height: calc(var(--ek-space-1) * 1.5);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface-sunken);
  }
  .mock__fill {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--ek-radius-full);
    background: linear-gradient(90deg, var(--mock-ink), var(--site-accent));
    transform-origin: 0 50%;
    scale: 0.75 1;
  }
  .mock__sub {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    max-width: none;
    color: var(--site-text-meta);
  }
  .mock__resv {
    display: inline-grid;
    color: var(--mock-ink);
    font-weight: var(--ek-font-weight-bold);
    text-align: end;
  }
  .mock__rnum {
    grid-area: 1 / 1;
    opacity: 0;
  }
  .mock__rnum--d {
    opacity: 1;
  }
  .mock__rows {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
  }
  .mock__row {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ek-space-3);
    padding: var(--ek-space-2);
    border-radius: var(--ek-radius-md);
  }
  /* Satır vurgusu: sipariş rezerve edilirken kısa süre belirir (döngü: scenes-loops.css); statik hâlde görünmez. */
  .mock__row::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--site-accent-soft);
    opacity: 0;
  }
  .mock__rchan {
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
    min-width: 0;
    color: var(--site-text-heading);
    font-weight: var(--ek-font-weight-semibold);
  }
  .mock__rdot {
    flex: none;
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--chan, var(--site-accent));
