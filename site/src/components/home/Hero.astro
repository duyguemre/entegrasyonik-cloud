---
/**
 * Hero (ADR-0014 Karar 2, bölüm 1; S12 pazarlama dili; S13 "show merkezi") — değer önerisi + birincil/ikincil CTA +
 * sistemin genelini anlatan koyu, derinlikli bir SHOW SAHNESİ. Sahne kökü: `data-scene="hero-mock"` (src/styles/scenes.css
 * giriş + scenes-loops.css döngü + src/scripts/scenes.ts durum). Tamamen HTML/CSS/satır içi SVG (görsel dosya, kütüphane
 * yok). Sipariş ve sayılar gerçek veri değil, arayüz örneğidir (S15: görünür "Örnek görünüm" rozeti kullanıcı isteğiyle
 * kaldırıldı; panel aria-hidden dekoratif bir sahnedir, sayılar hiçbir yerde ölçüm/iddia olarak sunulmaz).
 *
 * S13 (kullanıcı: "beyaz fonlu amatör kalmış ... show merkezi ... sistemin genelini ilgilendiren showlar"): tek ekran
 * takibi yerine 30 sn'de dönen DÖRT sahne (her biri 7,5 sn, çapraz geçişli; altta ilerleme göstergesi):
 *   1) Tek merkez      — isimsiz kanal noktalarından siparişler merkeze akar, stok 12 -> 9 düşer, senkron dalgası yayılır
 *   2) Rezervasyon     — son adet için eşzamanlı iki sipariş: biri rezerve edilir, diğeri aşırı satış olarak işaretlenir
 *   3) Kanallara yayın — tek güncelleme tüm kanallara sırayla iletilir
 *   4) Güvenlik        — kalkan + şifreli anahtar + izolasyon/rol maddeleri
 * Her sahne kanıtlı bir yetenek kaydına dayanır (kayıt yoksa derleme durur — sahne kanıtsız gösterilmez). Kanal ADI yok:
 * isimsiz renkli noktalar (`--site-channel-*`, `[data-code]` eşlemesi) ve genel etiketler ("Pazaryeri siparişi").
 * Statik hâl (reduced-motion / "Hareket" durdurulmuş / JS'siz): YALNIZCA 1. sahnenin son durumu — üç sipariş
 * "Rezerve", stok 9, rezerve 3; diğer sahneler görünmez. Döngü yalnızca görünürken çalışır, üzerine gelince durur.
 *
 * S21 (kullanıcı: "çerçeveyi daha cool, premium, site ile daha uyumlu"): sahne içeriği aynen korunur; ÇERÇEVE
 * "uygulama penceresi"ne yükseltildi — pencere çubuğu (nötr noktalar + ortada başlık hapı + sessiz araç çubukları),
 * marka gradyanından kenar ışığı, cam kasa (bezel), üst kenarda her sahne geçişinde tek sakin parıltı, zemin ışıması.
 * Adaylar (katmanlı derinlik, çerçevesiz sahne) ve gerekçe: docs/s21-review/README.md; korumalar: tests/hero-frame.test.ts.
 *
 * S22 (SR2-HOME): kopyanın en üstünde ajan ürününe giriş hapı — ad + tek cümle değer + sayfa bağlantısı. Metin
 * `heroAgentEntry` kaydından (src/data/assistant.ts); İSTİSNA DEĞİLDİR (claims.test.ts katı taraması; "yolda" dili yok),
 * aşama etiketi ("Erken erişim") görünür. Operasyon merkezi penceresinin canlı noktasıyla aynı görsel dil.
 * Ana mesaj (başlık, açıklama, CTA'lar) değişmedi.
 */
import Button from '../Button.astro'
import Icon from './Icon.astro'
import { appUrls } from '../../lib/site-config'
import { getPublicIntegrations } from '../../data/integrations'
import { getPublicCapabilities } from '../../data/capabilities'
import { getPublicTrial } from '../../data/plans'
import { ASSISTANT_PATH, heroAgentEntry as agent } from '../../data/assistant'

const trial = getPublicTrial()
// Kanal noktaları: yalnızca mevcut entegrasyonların RENGİ (ad DOM'a yazılmaz; sahne aria-hidden'dır).
const channels = getPublicIntegrations().map((c) => ({ code: c.code }))
const marketplaces = getPublicIntegrations('marketplace')
const storefront = getPublicIntegrations('ecommerce')[0]

// Üst seviye faydalar — her biri kanıtlı bir yetenek kaydına dayanır (capabilities.ts); kayıt yoksa gösterilmez.
const capIds = new Set(getPublicCapabilities().map((c) => c.id))
const benefits = [
  { icon: 'stock' as const, label: 'Merkezi stok yönetimi', requires: ['stock-reservation', 'multi-channel-products'] },
  { icon: 'orders' as const, label: 'Tüm siparişler tek ekranda', requires: ['unified-orders'] },
  { icon: 'shield' as const, label: 'Kurumsal düzeyde güvenlik', requires: ['secrets-encryption', 'tenant-database', 'role-based-access'] },
].filter((b) => b.requires.every((id) => capIds.has(id)))

// Show sahneleri: her biri bir yetenek kaydına dayanır. Zamanlama 4 sahneye göre kuruludur (scenes-loops.css) →
// kayıt eksikse sahneyi sessizce düşürmek yerine derleme durur (kanıtsız gösterim yok, zamanlama bozulmaz).
const scenes = [
  { key: 'hub', label: 'Tek merkez', short: 'Merkez', requires: ['unified-orders', 'stock-reservation'] },
  { key: 'race', label: 'Rezervasyon', short: 'Rezerve', requires: ['stock-reservation'] },
  { key: 'publish', label: 'Kanallara yayın', short: 'Yayın', requires: ['multi-channel-products'] },
  { key: 'secure', label: 'Güvenlik', short: 'Güvenlik', requires: ['secrets-encryption', 'tenant-database'] },
]
for (const s of scenes) {
  for (const id of s.requires) if (!capIds.has(id)) throw new Error(`Hero show sahnesi "${s.key}" için yetenek kaydı yok: ${id}`)
}

// Sahne 1: iki pazaryeri siparişi + bir web mağaza siparişi (genel etiket; renk kanal paletinden). Her sipariş kendi
// kanal noktasından merkeze akar (şerit `data-order` = sipariş sırası).
const orders = [
  { code: marketplaces[0]?.code, label: 'Pazaryeri siparişi' },
  { code: marketplaces[1]?.code, label: 'Pazaryeri siparişi' },
  storefront ? { code: storefront.code, label: 'Web mağaza' } : { code: marketplaces[2]?.code, label: 'Pazaryeri siparişi' },
]
const orderOfLane = new Map<number, number>()
orders.forEach((o, k) => {
  const lane = channels.findIndex((c) => c.code === o.code)
  if (lane >= 0 && !orderOfLane.has(lane)) orderOfLane.set(lane, k)
})

// Sahne 2: son adet için iki farklı kanaldan eşzamanlı sipariş.
const raceA = marketplaces[0]?.code
const raceB = marketplaces[1]?.code ?? storefront?.code

// Sahne 4: güvenlik maddeleri (her biri kayda bağlı).
const secureItems = [
  { label: 'Şifreli anahtarlar', requires: 'secrets-encryption' },
  { label: 'Veri izolasyonu', requires: 'tenant-database' },
  { label: 'Rol tabanlı erişim', requires: 'role-based-access' },
].filter((i) => capIds.has(i.requires))
---

<section class="hero" aria-labelledby="hero-title" data-testid="hero" data-surface="dark">
  <div class="hero__bg" aria-hidden="true" data-scene="hero-bg">
    <span class="hero__grid"></span>
    <span class="hero__orb hero__orb--a" data-part="orb"></span>
    <span class="hero__orb hero__orb--b" data-part="orb"></span>
  </div>

  <div class="hero__inner">
    <div class="hero__copy">
      <a class="hero__agent" href={ASSISTANT_PATH} data-testid="hero-agent-entry">
        <span class="hero__agent-row">
          <span class="hero__agent-badge"><i class="hero__agent-live" aria-hidden="true"></i>{agent.badge}</span>
          <strong class="hero__agent-name">{agent.name}</strong>
          <span class="hero__agent-cta"><span class="hero__agent-cta-label">{agent.cta}</span><Icon name="arrow" size="sm" /></span>
        </span>
        <span class="hero__agent-value">{agent.value}</span>
      </a>
      <p class="hero__eyebrow"><span class="hero__eyebrow-dot" aria-hidden="true"></span>Çok kanallı satış yönetimi</p>
      <h1 id="hero-title" class="hero__title">
        Tüm pazaryerleriniz, <span class="hero__accent">tek stok</span>, tek panel.
      </h1>
      <p class="hero__lead" data-testid="hero-lead">
        Pazaryerlerindeki ürün, stok, sipariş ve iade operasyonunuzu tek merkezde birleştirin. Eşzamanlı gelen
        siparişlerde stok rezerve edilir, aşırı satış riski azalır; ekibiniz panel panel dolaşmak yerine satışa odaklanır.
      </p>
      <div class="hero__actions">
        <Button href={appUrls.register()} variant="inverse" size="lg" data-testid="hero-cta-primary">Ücretsiz dene</Button>
        <Button href="#nasil-calisir" variant="inverse-outline" size="lg" data-testid="hero-cta-secondary">Nasıl çalışır</Button>
      </div>
      <p class="hero__note">{trial.days} gün ücretsiz deneme{!trial.cardRequired && ', kart bilgisi gerekmez'}.</p>
      <ul class="hero__trust" aria-label="Öne çıkan faydalar" data-testid="hero-benefits">
        {
          benefits.map((b) => (
            <li>
              <span class="hero__trust-icon" aria-hidden="true">
                <Icon name={b.icon} size="sm" />
              </span>
              <span>{b.label}</span>
            </li>
          ))
        }
      </ul>
    </div>


    <div class="hero__visual" data-testid="hero-visual">
      <div class="show" data-scene="hero-mock" data-tilt aria-hidden="true" data-testid="hero-mock">
        <span class="show__rim" aria-hidden="true"><span class="show__sheen" data-part="frame-sheen"></span></span>
        <div class="show__bar">
          <span class="show__dots"><i></i><i></i><i></i></span>
          <span class="show__brand"><i class="show__live"></i>Operasyon merkezi</span>
          <span class="show__tools"><i></i><i></i></span>
        </div>

        <div class="show__stage">
          {/* 1) Tek merkez: kanallardan gelen siparişler tek stokta buluşur (statik hâl = bu sahnenin son durumu) */}
          <div class="show__scene show__scene--hub" data-part="show-scene">
            <p class="show__cap">
              <span class="show__kicker">Tek merkez</span>
              <span class="show__headline">Kanallardan gelen siparişler tek stokta buluşur</span>
            </p>
            <div class="hub">
              <svg class="hub__lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <line x1="7" y1="18" x2="50" y2="50"></line>
                <line x1="7" y1="50" x2="50" y2="50"></line>
                <line x1="7" y1="82" x2="50" y2="50"></line>
                <line x1="93" y1="18" x2="50" y2="50"></line>
                <line x1="93" y1="50" x2="50" y2="50"></line>
                <line x1="93" y1="82" x2="50" y2="50"></line>
              </svg>
              <div class="hub__lanes">
                {
                  channels.map((_, i) => (
                    <span class="hub__lane" data-code={channels[i].code} data-order={orderOfLane.get(i)}>
                      {orderOfLane.has(i) && <span class="hub__mover" data-part="hub-in" />}
                      <span class="hub__mover hub__mover--out" data-part="hub-out" />
                    </span>
                  ))
                }
              </div>
              <ul class="hub__nodes">
                {channels.map((c) => <li class="hub__node" data-part="chan" data-code={c.code} />)}
              </ul>
              <div class="hub__core" data-part="hub-core">
                <p class="hub__label">Merkezi stok</p>
                <p class="hub__big">
                  <span class="hub__num" data-part="num">12</span>
                  <span class="hub__num" data-part="num">11</span>
                  <span class="hub__num" data-part="num">10</span>
                  <span class="hub__num hub__num--final" data-part="num">9</span>
                </p>
                <div class="hub__meter"><span class="hub__fill" data-part="fill"></span></div>
                <p class="hub__sub">
                  Rezerve
                  <span class="hub__resv">
                    <b class="hub__num" data-part="rnum">0</b>
                    <b class="hub__num" data-part="rnum">1</b>
                    <b class="hub__num" data-part="rnum">2</b>
                    <b class="hub__num hub__num--final" data-part="rnum">3</b>
                  </span>
                </p>
              </div>
            </div>
            <ul class="feed">
              {
                orders.map((o) => (
                  <li class="show__row" data-part="row" data-code={o.code}>
                    <span class="show__rlabel">
                      <span class="show__rdot" />
                      {o.label}
                    </span>
                    <span class="show__pills">
                      <span class="show__pill show__pill--new" data-part="pill-new">Yeni</span>
                      <span class="show__pill show__pill--ok">Rezerve</span>
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>

          {/* 2) Rezervasyon: son adet için eşzamanlı iki sipariş -> biri rezerve, diğeri aşırı satış olarak işaretlenir */}
          <div class="show__scene show__scene--race" data-part="show-scene">
            <p class="show__cap">
              <span class="show__kicker">Stok rezervasyonu</span>
              <span class="show__headline">Son adet için eşzamanlı iki sipariş; yalnızca biri rezerve edilir</span>
            </p>
            <div class="race">
              <div class="race__order race__order--a" data-part="race-a" data-code={raceA}>
                <span class="race__who"><span class="show__rdot"></span>Pazaryeri siparişi</span>
                <span class="race__st">
                  <span class="race__badge race__badge--new" data-part="race-out">Yeni sipariş</span>
                  <span class="race__badge race__badge--ok" data-part="race-in"><Icon name="check" size="sm" />Rezerve edildi</span>
                </span>
              </div>
              <span class="race__lane race__lane--a"><span class="race__pkt" data-part="race-pkt"></span></span>
              <div class="race__product">
                <span class="race__thumb"><Icon name="stock" size="md" /></span>
                <span class="race__plabel">Kalan stok</span>
                <span class="race__big">
                  <span class="hub__num" data-part="race-out">1</span>
                  <span class="hub__num" data-part="race-in">0</span>
                </span>
                <span class="race__lock" data-part="race-lock"><Icon name="lock" size="sm" />Kilitlendi</span>
              </div>
              <span class="race__lane race__lane--b"><span class="race__pkt" data-part="race-pkt"></span></span>
              <div class="race__order race__order--b" data-part="race-b" data-code={raceB}>
                <span class="race__who"><span class="show__rdot"></span>Pazaryeri siparişi</span>
                <span class="race__st">
                  <span class="race__badge race__badge--new" data-part="race-out">Yeni sipariş</span>
                  <span class="race__badge race__badge--warn" data-part="race-in"><Icon name="info" size="sm" />Aşırı satış işaretlendi</span>
                </span>
              </div>
            </div>
            <p class="show__result" data-part="race-result"><Icon name="shield" size="sm" />Stok eksiye düşmez</p>
          </div>

          {/* 3) Kanallara yayın: tek güncelleme tüm kanallara sırayla iletilir */}
          <div class="show__scene show__scene--publish" data-part="show-scene">
            <p class="show__cap">
              <span class="show__kicker">Kanallara yayın</span>
              <span class="show__headline">Fiyat ve stok değişikliği bağlı kanallara tek yerden iletilir</span>
            </p>
            <div class="pub">
              <div class="pub__src">
                <span class="pub__thumb"><Icon name="layers" size="md" /></span>
                <span class="pub__title">Ürün kartı</span>
                <span class="pub__field"><span>Fiyat</span><i class="pub__bar"></i></span>
                <span class="pub__field"><span>Stok</span><i class="pub__bar pub__bar--short"></i></span>
                <span class="pub__flag" data-part="pub-flag"><Icon name="refresh" size="sm" />Güncellendi</span>
              </div>
              <ul class="pub__list">
                {
                  channels.map((c) => (
                    <li class="pub__row" data-code={c.code}>
                      <span class="pub__track"><span class="pub__beam" data-part="pub-beam" /></span>
                      <span class="show__rdot" />
                      <span class="pub__skel" />
                      <span class="pub__check" data-part="pub-check"><Icon name="check" size="sm" /></span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>

          {/* 4) Güvenlik: kalkan + şifreli anahtar + izolasyon / rol maddeleri */}
          <div class="show__scene show__scene--secure" data-part="show-scene">
            <p class="show__cap">
              <span class="show__kicker">Kurumsal güvenlik</span>
              <span class="show__headline">Anahtarlar şifreli saklanır, veriniz hesabınıza ayrılır</span>
            </p>
            <div class="sec">
              <div class="sec__emblem">
                <span class="sec__wave" data-part="sec-wave"></span>
                <span class="sec__wave" data-part="sec-wave"></span>
                <span class="sec__wave" data-part="sec-wave"></span>
                <span class="sec__core"><Icon name="shield" size="lg" /></span>
              </div>
              <div class="sec__side">
                <div class="sec__key">
                  <span class="sec__klabel"><Icon name="key" size="sm" />API anahtarı</span>
                  <span class="sec__kval">
                    <span class="sec__mask">••••••••••••</span>
                    <span class="sec__scan" data-part="sec-scan"></span>
                  </span>
                  <span class="sec__lock" data-part="sec-lock"><Icon name="lock" size="sm" />Şifreli</span>
                </div>
                <ul class="sec__list">
                  {
                    secureItems.map((i) => (
                      <li class="sec__item" data-part="sec-item">
                        <span class="sec__tick"><Icon name="check" size="sm" /></span>
                        {i.label}
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
          </div>
        </div>

        <ol class="show__nav">
          {
            scenes.map((s) => (
              <li class="show__step">
                <span class="show__track"><span class="show__prog" data-part="show-prog" /></span>
                <span class="show__slabel" data-part="show-step">
                  <span class="show__slabel-long">{s.label}</span>
                  <span class="show__slabel-short">{s.short}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: var(--ek-space-12) var(--ek-space-16);
    background: var(--site-stage-mesh);
    color: var(--site-text-on-dark-heading);
  }

  /* --- Arka plan: ızgara dokusu (radyal solma) + iki yavaş ışıma (tek vurgu ailesi: teal + lacivert) --- */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image: var(--site-texture-grid);
    background-size: var(--site-texture-grid-size);
    -webkit-mask-image: var(--site-texture-fade);
    mask-image: var(--site-texture-fade);
  }
  .hero__orb {
    position: absolute;
    width: 32rem;
    max-width: 90vw;
    aspect-ratio: 1 / 1;
    border-radius: var(--ek-radius-full);
  }
  .hero__orb--a {
    inset-block-start: -8rem;
    inset-inline-end: -6rem;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--ek-color-secondary) 24%, transparent), transparent);
  }
  .hero__orb--b {
    inset-block-end: -10rem;
    inset-inline-start: -8rem;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--ek-color-primary-darken-1) 38%, transparent), transparent);
  }

  .hero__inner {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--site-gutter);
    max-width: calc(var(--site-container-max) + 2 * var(--site-gutter));
    display: grid;
    gap: var(--ek-space-12);
    align-items: center;
  }
  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ek-space-6);
    min-width: 0;
  }
  /* S22: ajan girişi hapı — cam zemin + marka gradyanından ince kenar; odak/üzerine gelme durumları site genelindeki
     bağlantı dilinde. Dar ekranda değer cümlesi gizlenir (ad + aşama + bağlantı kalır). */
  .hero__agent {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
    max-width: 36rem;
    padding: var(--ek-space-3) var(--ek-space-4);
    border: var(--site-border-width) solid color-mix(in srgb, var(--ek-color-secondary) 38%, transparent);
    border-radius: var(--ek-radius-lg);
    background:
      linear-gradient(100deg, color-mix(in srgb, var(--ek-color-secondary) 14%, transparent), transparent 75%),
      var(--site-glass-bg);
    color: var(--site-text-on-dark-body);
    font-size: var(--ek-font-size-sm);
    text-decoration: none;
    transition: border-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .hero__agent:hover {
    border-color: var(--site-accent-on-dark);
  }
  .hero__agent:focus-visible {
    outline: var(--site-focus-ring-width) solid var(--site-color-focus-ring);
    outline-offset: var(--site-focus-ring-offset);
  }
  .hero__agent-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ek-space-2) var(--ek-space-3);
  }
  .hero__agent-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    padding: 0 var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--site-gradient-accent-on-dark);
    color: var(--site-stage-deep);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-bold);
    line-height: var(--ek-line-height-normal);
  }
  .hero__agent-live {
    width: calc(var(--ek-space-1) * 1.5);
    height: calc(var(--ek-space-1) * 1.5);
    border-radius: var(--ek-radius-full);
    background: var(--site-stage-deep);
  }
  .hero__agent-name {
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-semibold);
  }
  .hero__agent-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-1);
    margin-inline-start: auto;
    color: var(--site-accent-on-dark);
    font-weight: var(--ek-font-weight-semibold);
  }
  .hero__agent:hover .hero__agent-cta :global(.icon) {
    translate: calc(var(--ek-space-1) * 0.5) 0;
  }
  .hero__agent-value {
    color: var(--site-text-on-dark-body);
    line-height: var(--ek-line-height-normal);
  }
  /* Dar ekran: kart zaten bağlantı; "Keşfedin" etiketi tek başına alt satıra düşmesin — yalnızca ok kalır. */
  @media (max-width: 479.98px) {
    .hero__agent-cta-label {
      position: absolute;
      width: var(--site-border-width);
      height: var(--site-border-width);
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    padding: var(--ek-space-1) var(--ek-space-3);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-full);
    background: var(--site-glass-bg);
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.04em;
  }
  .hero__eyebrow-dot {
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--site-accent);
    box-shadow: var(--site-glow-ring);
  }
  .hero__title {
    color: var(--site-text-on-dark-heading);
    font-size: var(--site-font-display-lg);
    font-weight: var(--site-font-display-weight);
    line-height: var(--site-font-display-line-height);
    letter-spacing: var(--site-font-display-tracking);
    text-wrap: balance;
  }
  .hero__accent {
    background: var(--site-gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--site-accent);
  }
  .hero__lead {
    color: var(--site-text-on-dark-body);
    font-size: var(--ek-font-size-xl);
    line-height: var(--site-font-body-line-height);
    max-width: 36rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-3);
  }
  .hero__note {
    color: var(--site-text-on-dark-meta);
    font-size: var(--ek-font-size-md);
  }
  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-3) var(--ek-space-6);
    padding-top: var(--ek-space-5);
    border-top: var(--site-border-width) solid var(--site-glass-border);
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-medium);
  }
  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
  }
  .hero__trust-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-6);
    height: var(--ek-space-6);
    border-radius: var(--ek-radius-md);
    background: color-mix(in srgb, var(--site-accent) 16%, transparent);
    color: var(--site-accent);
  }


  /* --- Show sahnesi (S13): koyu, derinlikli sahne; 4 dönen sahne (döngü: scenes-loops.css) --- */
  /*
   * S21 çerçeve ("uygulama penceresi"; üç aday karşılaştırıldı: docs/s21-review/README.md): pencere çubuğu + marka
   * gradyanından ince kenar ışığı + üst kenarda sahne geçişlerinde sakin parıltı + zemine oturan ışıma. S9'un ofsetli
   * iki "hayalet" paneli (ve imleç paralaksı) kalktı — sahneyle yarışan, hizası kaymış kenarlar üretiyordu.
   * Boyut: çerçeve öğeleri yalnızca `position: absolute` / gölge / arka plan → yerleşim ve yükseklik değişmez (CLS 0).
   */
  .hero__visual {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  /* Zemin ışıması: panelin altına düşen yumuşak teal hale (panel havada asılı kalmasın). */
  .hero__visual::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 12% -10% -14%;
    background:
      radial-gradient(46% 22% at 50% 96%, color-mix(in srgb, var(--ek-color-secondary) 38%, transparent), transparent 80%),
      radial-gradient(closest-side, color-mix(in srgb, var(--ek-color-secondary) 16%, transparent), transparent);
    pointer-events: none;
  }
  .show {
    /* Sahne zamanlaması: 30 sn döngü, 4 eşit dilim (scenes-loops.css `--show-delay` ile kaydırır). */
    --show-cycle: var(--site-motion-loop-marquee);
    --show-slot: calc(var(--show-cycle) / 4);
    --show-line: color-mix(in srgb, var(--ek-color-background) 12%, transparent);
    --show-line-strong: color-mix(in srgb, var(--ek-color-background) 20%, transparent);
    --show-glass: color-mix(in srgb, var(--ek-color-background) 5%, transparent);
    --show-glass-strong: color-mix(in srgb, var(--ek-color-background) 9%, transparent);
    --show-solid: color-mix(in srgb, var(--ek-color-content-strong) 86%, var(--ek-color-primary));
    --show-glow: color-mix(in srgb, var(--ek-color-secondary) 60%, transparent);
    --show-warn: color-mix(in srgb, var(--ek-color-amber) 85%, var(--ek-color-background));
    --show-warn-soft: color-mix(in srgb, var(--ek-color-amber) 22%, transparent);
    --show-edge: color-mix(in srgb, var(--ek-color-secondary) 75%, var(--ek-color-background));
    position: relative;
    display: flex;
    flex-direction: column;
    /* Degrade kenarlık: iç zemin padding-box, marka gradyanından kenar ışığı border-box (tek öğe, ek katman yok). */
    border: var(--site-border-width) solid transparent;
    border-radius: var(--site-radius-panel);
    background:
      radial-gradient(80% 45% at 50% 0%, color-mix(in srgb, var(--ek-color-secondary) 14%, transparent), transparent 70%) padding-box,
      radial-gradient(60% 40% at 100% 100%, color-mix(in srgb, var(--ek-color-primary-darken-1) 40%, transparent), transparent 70%) padding-box,
      linear-gradient(170deg, color-mix(in srgb, var(--ek-color-primary) 52%, var(--ek-color-content-strong)) 0%, var(--ek-color-content-strong) 100%) padding-box,
      linear-gradient(
          160deg,
          color-mix(in srgb, var(--ek-color-secondary) 85%, transparent) 0%,
          color-mix(in srgb, var(--ek-color-background) 22%, transparent) 26%,
          color-mix(in srgb, var(--ek-color-background) 7%, transparent) 60%,
          color-mix(in srgb, var(--ek-color-primary-lighten) 55%, transparent) 100%
        )
        border-box;
    box-shadow:
      var(--site-shadow-panel),
      /* Cam kasa (bezel): panelin çevresinde ince, yarı saydam ikinci çerçeve + onun kılcal kenarı */
      0 0 0 calc(var(--site-border-width) * 6) color-mix(in srgb, var(--ek-color-background) 4%, transparent),
      0 0 0 calc(var(--site-border-width) * 7) color-mix(in srgb, var(--ek-color-background) 7%, transparent),
      0 0 7rem -2rem color-mix(in srgb, var(--ek-color-secondary) 34%, transparent),
      inset 0 var(--site-border-width) 0 color-mix(in srgb, var(--ek-color-background) 16%, transparent);
    color: var(--site-text-on-dark-body);
    font-size: var(--ek-font-size-sm);
    line-height: var(--ek-line-height-tight);
    user-select: none;
  }
  /* Üst kenar ışığı: ortada parlak, uçlara sönen ince çizgi + altında yumuşak ışıma; üzerinde yavaş parıltı. */
  .show__rim {
    position: absolute;
    z-index: 1;
    top: calc(var(--site-border-width) * -1);
    left: 10%;
    right: 10%;
    overflow: hidden;
    height: var(--site-border-width);
    background: linear-gradient(90deg, transparent, var(--show-edge) 35%, var(--ek-color-background) 50%, var(--show-edge) 65%, transparent);
    pointer-events: none;
  }
  .show__rim::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: 0 0 var(--ek-space-5) var(--ek-space-1) var(--show-glow);
    opacity: 0.8;
  }
  .show__sheen {
    position: absolute;
    inset: 0;
    width: 30%;
    background: linear-gradient(90deg, transparent, var(--ek-color-background), transparent);
    opacity: 0;
    translate: -100% 0;
  }
  /* Pencere çubuğu: nötr pencere noktaları | ortada başlık | sağda sessiz araç çubukları */
  .show__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--ek-space-3);
    padding: var(--ek-space-3) var(--ek-space-4);
    border-bottom: var(--site-border-width) solid var(--show-line);
    border-radius: var(--site-radius-panel) var(--site-radius-panel) 0 0;
    background: linear-gradient(180deg, var(--show-glass-strong), var(--show-glass));
  }
  .show__dots {
    display: inline-flex;
    gap: var(--ek-space-2);
  }
  .show__dots i,
  .show__tools i {
    display: block;
    width: calc(var(--ek-space-2) + var(--site-border-width) * 2);
    height: calc(var(--ek-space-2) + var(--site-border-width) * 2);
    border-radius: var(--ek-radius-full);
    background: var(--show-line-strong);
    box-shadow: inset 0 0 0 var(--site-border-width) var(--show-line);
  }
  .show__tools {
    display: inline-flex;
    justify-content: flex-end;
    gap: var(--ek-space-2);
  }
  .show__tools i {
    width: var(--ek-space-5);
    height: calc(var(--ek-space-1) + var(--site-border-width) * 2);
    background: var(--show-line);
    box-shadow: none;
  }
  .show__tools i:first-child {
    width: var(--ek-space-8);
  }
  .show__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    padding: var(--ek-space-1) var(--ek-space-3);
    border: var(--site-border-width) solid var(--show-line);
    border-radius: var(--ek-radius-full);
    background: var(--show-glass);
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .show__live {
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--site-accent-on-dark);
    box-shadow: 0 0 0 calc(var(--site-border-width) * 3) color-mix(in srgb, var(--ek-color-secondary) 25%, transparent), 0 0 var(--ek-space-3) var(--show-glow);
  }

  /* Sahneler aynı ızgara hücresinde üst üste durur (yükseklik = en uzun sahne; yerleşim animasyonla değişmez). */
  .show__stage {
    position: relative;
    display: grid;
    padding: var(--ek-space-4);
  }
  .show__stage::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--site-texture-dots);
    background-size: var(--site-texture-dots-size);
    opacity: 0.5;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 45%, var(--ek-color-content-strong), transparent 80%);
    mask-image: radial-gradient(ellipse 70% 60% at 50% 45%, var(--ek-color-content-strong), transparent 80%);
    pointer-events: none;
  }
  .show__scene {
    --show-delay: calc(var(--show-slot) * var(--n, 0));
    grid-area: 1 / 1;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-4);
    min-width: 0;
  }
  /* Statik hâl: yalnızca 1. sahne görünür (diğerleri yalnızca döngüde belirir). */
  .show__scene:not(:first-child) {
    opacity: 0;
  }
  .show__scene:nth-child(2),
  .show__step:nth-child(2) {
    --n: 1;
  }
  .show__scene:nth-child(3),
  .show__step:nth-child(3) {
    --n: 2;
  }
  .show__scene:nth-child(4),
  .show__step:nth-child(4) {
    --n: 3;
  }
  .show__cap {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
    max-width: none;
  }
  .show__kicker {
    color: var(--site-accent);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .show__headline {
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-lg);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: -0.01em;
    line-height: var(--ek-line-height-tight);
    text-wrap: balance;
  }
  .show__rdot {
    flex: none;
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--chan, var(--site-accent));
    box-shadow: 0 0 var(--ek-space-2) color-mix(in srgb, var(--chan, var(--site-accent)) 70%, transparent);
  }
  .hub__num {
    grid-area: 1 / 1;
    opacity: 0;
  }
  .hub__num--final {
    opacity: 1;
  }

  /* 1) Tek merkez: kanal noktaları iki sütunda, çizgiler merkeze; paketler şerit boyunca (kutu köşesinden köşesine) kayar */
  .hub {
    position: relative;
    aspect-ratio: 2 / 1;
  }
  /* derinlik: merkezin arkasında sönümlenen eşmerkezli halkalar (statik doku) */
  .hub::before {
    content: '';
    position: absolute;
    inset: -8% 18%;
    border-radius: var(--ek-radius-full);
    background: repeating-radial-gradient(
      circle at 50% 50%,
      transparent 0 1.9rem,
      color-mix(in srgb, var(--ek-color-secondary) 16%, transparent) 1.9rem calc(1.9rem + var(--site-border-width)),
      transparent calc(1.9rem + var(--site-border-width)) 3.2rem
    );
    -webkit-mask-image: radial-gradient(closest-side, var(--ek-color-content-strong) 30%, transparent);
    mask-image: radial-gradient(closest-side, var(--ek-color-content-strong) 30%, transparent);
    pointer-events: none;
  }
  .hub__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .hub__lines line {
    stroke: color-mix(in srgb, var(--ek-color-secondary) 32%, transparent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .hub__lanes,
  .hub__nodes {
    position: absolute;
    inset: 0;
  }
  .hub__lane {
    position: absolute;
    /* Varsayılan: sol üst düğüm (7,18) -> merkez (50,50). Başlangıç köşesi (--px/--py) ve yön (--dx/--dy). */
    --px: 0%;
    --py: 0%;
    --dx: 100%;
    --dy: 100%;
    inset-inline-start: 7%;
    inset-block-start: 18%;
    width: 43%;
    height: 32%;
  }
  .hub__lane:nth-child(2) {
    inset-block-start: 50%;
    height: 0;
    --dy: 0%;
  }
  .hub__lane:nth-child(3) {
    inset-block-start: 50%;
    --py: 100%;
    --dy: -100%;
  }
  .hub__lane:nth-child(n + 4) {
    inset-inline-start: 50%;
    --px: 100%;
    --dx: -100%;
  }
  .hub__lane:nth-child(5) {
    inset-block-start: 50%;
    height: 0;
    --dy: 0%;
  }
  .hub__lane:nth-child(6) {
    inset-block-start: 50%;
    --py: 100%;
    --dy: -100%;
  }
  .hub__lane[data-order='1'] {
    --k: 1;
  }
  .hub__lane[data-order='2'] {
    --k: 2;
  }
  .hub__mover {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .hub__mover::before {
    content: '';
    position: absolute;
    inset-inline-start: var(--px);
    inset-block-start: var(--py);
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    translate: -50% -50%;
    background: var(--chan, var(--site-accent));
    box-shadow: 0 0 var(--ek-space-3) calc(var(--site-border-width) * 2) color-mix(in srgb, var(--chan, var(--site-accent)) 75%, transparent);
  }
  .hub__mover--out::before {
    width: calc(var(--ek-space-1) * 1.5);
    height: calc(var(--ek-space-1) * 1.5);
    background: var(--site-accent);
    box-shadow: 0 0 var(--ek-space-3) calc(var(--site-border-width) * 2) var(--show-glow);
  }
  .hub__node {
    position: absolute;
    inset-inline-start: 7%;
    inset-block-start: 18%;
    width: var(--ek-space-4);
    height: var(--ek-space-4);
    border-radius: var(--ek-radius-full);
    translate: -50% -50%;
    background: radial-gradient(circle, var(--chan, var(--site-accent)) 0 45%, color-mix(in srgb, var(--chan, var(--site-accent)) 30%, transparent) 48% 100%);
    box-shadow: 0 0 var(--ek-space-4) color-mix(in srgb, var(--chan, var(--site-accent)) 55%, transparent);
  }
  .hub__node:nth-child(2),
  .hub__node:nth-child(5) {
    inset-block-start: 50%;
  }
  .hub__node:nth-child(3),
  .hub__node:nth-child(6) {
    inset-block-start: 82%;
  }
  .hub__node:nth-child(n + 4) {
    inset-inline-start: 93%;
  }
  /* Senkron halkası: dalga düğüme ulaştığında yayılıp söner (döngü); statik hâlde görünmez. */
  .hub__node::after {
    content: '';
    position: absolute;
    inset: calc(var(--ek-space-2) * -1);
    border: var(--site-border-width) solid var(--chan, var(--site-accent));
    border-radius: var(--ek-radius-full);
    opacity: 0;
  }
  .hub__core {
    position: absolute;
    inset-inline-start: 50%;
    inset-block-start: 50%;
    translate: -50% -50%;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
    width: 46%;
    padding: var(--ek-space-3) var(--ek-space-4);
    border: var(--site-border-width) solid color-mix(in srgb, var(--ek-color-secondary) 42%, transparent);
    border-radius: var(--ek-radius-lg);
    background:
      radial-gradient(120% 100% at 50% 0%, color-mix(in srgb, var(--ek-color-secondary) 18%, transparent), transparent 70%),
      var(--show-solid);
    box-shadow:
      0 0 3rem -0.5rem color-mix(in srgb, var(--ek-color-secondary) 45%, transparent),
      inset 0 var(--site-border-width) 0 color-mix(in srgb, var(--ek-color-background) 14%, transparent);
  }
  .hub__core::after {
    content: '';
    position: absolute;
    inset: calc(var(--site-border-width) * -1);
    border: var(--site-border-width) solid var(--site-accent);
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
  }
  .hub__label {
    color: var(--site-text-on-dark-meta);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hub__big {
    display: grid;
    overflow: hidden;
    max-width: none;
    color: var(--site-text-on-dark-heading);
    font-size: var(--site-font-display-sm);
    font-weight: var(--site-font-display-weight);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--site-font-display-tracking);
    line-height: 1.05;
  }
  .hub__meter {
    overflow: hidden;
    height: calc(var(--ek-space-1) * 1.25);
    border-radius: var(--ek-radius-full);
    background: var(--show-line);
  }
  .hub__fill {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--ek-radius-full);
    background: var(--site-gradient-accent);
    transform-origin: 0 50%;
    scale: 0.75 1;
  }
  .hub__sub {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    max-width: none;
    color: var(--site-text-on-dark-meta);
    font-size: var(--ek-font-size-xs);
  }
  .hub__resv {
    display: inline-grid;
    overflow: hidden;
    color: var(--site-text-on-dark-heading);
    font-weight: var(--ek-font-weight-bold);
    font-variant-numeric: tabular-nums;
    text-align: end;
  }

  .feed {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--ek-space-2);
  }
  .show__row {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ek-space-2);
    min-width: 0;
    padding: var(--ek-space-2) var(--ek-space-3);
    border: var(--site-border-width) solid var(--show-line);
    border-radius: var(--ek-radius-md);
    background: var(--show-glass);
  }
  .show__row:nth-child(2) {
    --k: 1;
  }
  .show__row:nth-child(3) {
    --k: 2;
  }
  /* Satır vurgusu: sipariş merkeze ulaştığında kısa süre belirir (döngü); statik hâlde görünmez. */
  .show__row::before {
    content: '';
    position: absolute;
    inset: calc(var(--site-border-width) * -1);
    z-index: -1;
    border: var(--site-border-width) solid var(--site-accent-line);
    border-radius: inherit;
    background: color-mix(in srgb, var(--ek-color-secondary) 14%, transparent);
    opacity: 0;
  }
  .show__rlabel {
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
    max-width: 100%;
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
  }
  .show__pills {
    display: inline-grid;
  }
  .show__pill {
    grid-area: 1 / 1;
