---
/**
 * Hero (ADR-0014 Karar 2, bölüm 1) — değer önerisi + birincil/ikincil CTA + CANLI HİSSİ veren ürün paneli mock'u.
 * Sahne: `data-scene="hero-mock"` (S7; src/styles/scenes.css + scenes-loops.css + src/scripts/scenes.ts).
 * Panel tamamen HTML/CSS ile çizilir (görsel dosya yok) ve AÇIKÇA "Örnek görünüm" etiketlidir: ürün, sipariş ve
 * sayılar gerçek veri değil, arayüz örneğidir; müşteri/logo/ölçüm uydurulmaz.
 * Statik hâl (reduced-motion / durdurulmuş / JS'siz): üç sipariş listede "Rezerve", stok 9, rezerve 3, kanallar bağlı.
 * Hareketli hâl (yalnızca görünürken, 12 sn döngü): siparişler sırayla düşer -> rezerve edilir -> stok sayısı değişir ->
 * güncelleme sinyali kanal çiplerine yayılır.
 * Kanal çipleri YALNIZCA `getPublicIntegrations()` çıktısındandır (logo yok: marka izni Açık Soru 3).
 */
import Button from '../Button.astro'
import Icon from './Icon.astro'
import { appUrls } from '../../lib/site-config'
import { getPublicIntegrations } from '../../data/integrations'
import { getPublicCapabilities } from '../../data/capabilities'
import { getPublicTrial } from '../../data/plans'
import { joinTr } from './links'

const integrations = getPublicIntegrations()
const marketplaceNames = joinTr(getPublicIntegrations('marketplace').map((i) => i.name))
const trial = getPublicTrial()
const channels = integrations.map((c) => ({ name: c.name, code: c.code }))
const marketplaces = getPublicIntegrations('marketplace')

const trustIds = ['secrets-encryption', 'tenant-database', 'role-based-access']
const trust = getPublicCapabilities('security').filter((c) => trustIds.includes(c.id))

// Panel örneği: sipariş satırları (kanal + durum). Sayılar arayüz örneğidir (etiket: "Örnek görünüm").
const orders = marketplaces.slice(0, 3)
---

<section class="hero" aria-labelledby="hero-title" data-testid="hero">
  <div class="hero__bg" aria-hidden="true" data-scene="hero-bg">
    <span class="hero__grid"></span>
    <span class="hero__orb hero__orb--a" data-part="orb"></span>
    <span class="hero__orb hero__orb--b" data-part="orb"></span>
  </div>

  <div class="hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow"><span class="hero__eyebrow-dot" aria-hidden="true"></span>Pazaryeri entegrasyon ve stok yönetimi</p>
      <h1 id="hero-title" class="hero__title">
        Tüm pazaryerleriniz, <span class="hero__accent">tek stok</span>, tek panel.
      </h1>
      <p class="hero__lead">
        Entegrasyonik; {marketplaceNames} kanallarındaki ürün, stok, sipariş ve iade süreçlerinizi tek panelde toplar.
        Aynı stok için eşzamanlı siparişlerde stok rezervasyonuyla aşırı satış riskini azaltır.
      </p>
      <div class="hero__actions">
        <Button href={appUrls.register()} variant="inverse" size="lg" data-testid="hero-cta-primary">Ücretsiz dene</Button>
        <Button href="#nasil-calisir" variant="inverse-outline" size="lg" data-testid="hero-cta-secondary">Nasıl çalışır</Button>
      </div>
      <p class="hero__note">{trial.days} gün ücretsiz deneme{!trial.cardRequired && ', kart bilgisi gerekmez'}.</p>
      <ul class="hero__trust" aria-label="Güvenlik özeti">
        {
          trust.map((t) => (
            <li>
              <Icon name="check" size="sm" />
              <span>{t.title}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__visual" data-parallax-root>
      <div class="mock" data-scene="hero-mock" data-tilt aria-hidden="true" data-testid="hero-mock">
        <div class="mock__bar">
          <span class="mock__dots"><i></i><i></i><i></i></span>
          <span class="mock__title">Stok ve siparişler</span>
          <span class="mock__tag">Örnek görünüm</span>
        </div>

        <div class="mock__body">
          <div class="mock__section">
            <p class="mock__label">Bağlı kanallar</p>
            <ul class="mock__channels">
              {
                channels.map((c) => (
                  <li class="mock__chan" data-part="chan" data-code={c.code}>
                    <span class="mock__dot"></span>
                    {c.name}
                  </li>
                ))
              }
            </ul>
            <div class="mock__rail"><span class="mock__glow" data-part="glow"></span></div>
          </div>

          <div class="mock__cols">
            <div class="mock__stock">
              <p class="mock__label">Kullanılabilir stok</p>
              <p class="mock__big">
                <span class="mock__num mock__num--a" data-part="num">12</span>
                <span class="mock__num mock__num--b" data-part="num">11</span>
                <span class="mock__num mock__num--c" data-part="num">10</span>
                <span class="mock__num mock__num--d" data-part="num">9</span>
              </p>
              <div class="mock__meter"><span class="mock__fill" data-part="fill"></span></div>
              <p class="mock__sub">
                Rezerve
                <span class="mock__resv">
                  <b class="mock__rnum mock__rnum--a" data-part="rnum">0</b>
                  <b class="mock__rnum mock__rnum--b" data-part="rnum">1</b>
                  <b class="mock__rnum mock__rnum--c" data-part="rnum">2</b>
                  <b class="mock__rnum mock__rnum--d" data-part="rnum">3</b>
                </span>
              </p>
            </div>

            <div class="mock__feed">
              <p class="mock__label">Sipariş akışı</p>
              <ul class="mock__rows">
                {
                  orders.map((o) => (
                    <li class="mock__row" data-part="row" data-code={o.code}>
                      <span class="mock__rchan">
                        <span class="mock__rmono" aria-hidden="true">{o.name.slice(0, 1)}</span>
                        {o.name}
                      </span>
                      <span class="mock__skel"><i></i><i></i></span>
                      <span class="mock__pills">
                        <span class="mock__pill mock__pill--new" data-part="pill-new">Yeni</span>
                        <span class="mock__pill mock__pill--ok">Rezerve</span>
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>

        <p class="mock__toast" data-part="toast">
          <Icon name="bolt" size="sm" />
          <span>Stok güncellemesi kanallara iletildi</span>
        </p>
      </div>
      <p class="sr-only">Örnek görünüm — gerçek veri değildir.</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: var(--ek-space-12) var(--ek-space-16);
    background: var(--site-stage-mesh);
    color: var(--site-color-on-primary);
  }

  /* --- Arka plan: ızgara dokusu (radyal solma) + iki yavaş ışıma --- */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image: var(--site-texture-grid);
    background-size: var(--site-texture-grid-size);
    -webkit-mask-image: var(--site-texture-fade);
    mask-image: var(--site-texture-fade);
  }
  .hero__orb {
    position: absolute;
    width: 32rem;
    max-width: 90vw;
    aspect-ratio: 1 / 1;
    border-radius: var(--ek-radius-full);
  }
  .hero__orb--a {
    inset-block-start: -8rem;
    inset-inline-end: -6rem;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--ek-color-secondary) 26%, transparent), transparent);
  }
  .hero__orb--b {
    inset-block-end: -10rem;
    inset-inline-start: -8rem;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--ek-color-primary-darken-1) 40%, transparent), transparent);
  }

  .hero__inner {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--site-gutter);
    max-width: calc(var(--site-container-max) + 2 * var(--site-gutter));
    display: grid;
    gap: var(--ek-space-12);
    align-items: center;
  }
  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ek-space-6);
    min-width: 0;
  }
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    padding: var(--ek-space-1) var(--ek-space-3);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-full);
    background: var(--site-glass-bg);
    color: var(--site-color-on-primary);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.04em;
  }
  .hero__eyebrow-dot {
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-secondary);
    box-shadow: var(--site-glow-ring);
  }
  .hero__title {
    position: relative;
    color: var(--site-color-on-primary);
    font-size: var(--site-font-display-lg);
    font-weight: var(--site-font-display-weight);
    line-height: var(--site-font-display-line-height);
    letter-spacing: var(--site-font-display-tracking);
    text-wrap: balance;
  }
  .hero__accent {
    background: var(--site-gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--ek-color-secondary);
  }
  /*
   * Tek seferlik parlama (S10): statik gradient korunur; sayfa yüklenince (hero-mock paneli oturduktan hemen
   * sonra) ince bir ışık bandı BAŞLIĞIN TAMAMININ üzerinden BİR KEZ geçer. Yalnızca opacity/translate;
   * `mix-blend-mode` katman rengini metnin altındaki renklerle karıştırır, düzeni etkilemez.
   * ÖNEMLİ (a11y): `::after` üretilmiş içerik `.hero__title` (h1, blok düzeyi) üzerindedir — `.hero__accent`
   * (satır içi `<span>`) DEĞİL. `position: relative` bir satır içi öğeye uygulandığında (denendi: hem gerçek
   * bir iç `<span>` hem de salt `display: inline-block`/`position: relative` ile) Chromium'un erişilebilir ad
   * hesaplamasına fazladan bir boşluk sızdırıyordu ("tek stok ,"), h1'in erişilebilir adını bozuyordu; blok
   * düzeyindeki `.hero__title` üzerinde bu sorun yok. Bu yüzden ışık bandı tüm başlığın üzerinden geçer,
   * yalnızca vurgulanan kelimenin üzerinden değil.
   */
  .hero__title::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 30%, color-mix(in srgb, var(--ek-color-background) 65%, transparent) 50%, transparent 70%);
    /* `screen` (yalnızca aydınlatır) kullanılır: koyu "sahne" zemininde `overlay` kontrast-koruyucu
       davranışı yüzünden ışık bandı neredeyse görünmez kalıyordu. */
    mix-blend-mode: screen;
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    @keyframes hero-accent-shine {
      0% {
        opacity: 0;
        translate: -18% 0;
      }
      45% {
        opacity: 1;
        translate: 0 0;
      }
      100% {
        opacity: 0;
        translate: 18% 0;
      }
    }
    html[data-motion='play'] .hero__title::after {
      animation: hero-accent-shine var(--site-motion-duration-reveal-lg) var(--site-motion-ease-reveal) 1;
      animation-delay: var(--site-motion-duration-reveal-lg);
    }
  }
  .hero__lead {
    color: var(--site-color-on-primary-muted);
    font-size: var(--ek-font-size-xl);
    line-height: var(--ek-line-height-normal);
    max-width: 38rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-3);
  }
  .hero__note {
    color: var(--site-color-on-primary-muted);
    font-size: var(--ek-font-size-md);
  }
  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-2) var(--ek-space-5);
    padding-top: var(--ek-space-5);
    border-top: var(--site-border-width) solid var(--site-glass-border);
    color: var(--site-color-on-primary);
    font-size: var(--ek-font-size-md);
  }
  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
  }
  .hero__trust :global(.icon) {
    color: var(--ek-color-secondary);
  }

  /* --- Ürün paneli mock'u --- */
  .hero__visual {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
    min-width: 0;
  }
  /* Panelin arkasında yumuşak ışıma: derinlik hissi (dekoratif) */
  .hero__visual::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -14% -12% 4%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--ek-color-secondary) 24%, transparent), transparent);
    pointer-events: none;
  }
  /*
   * İkinci (en uzak) ofset pencere katmanı: .mock::after ile birlikte 2 katmanlı derinlik yığını oluşturur.
   * S9: her iki katman da imleç konumuna (`pointer: fine`) ve kaydırma konumuna göre birkaç piksel kayar
   * (src/scripts/interactions.ts `--depth-a-*`/`--depth-b-*`); JS'siz/hareket kapalıyken sabit ofsette kalır.
   */
  .hero__visual::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: calc(var(--ek-space-8) * -1) calc(var(--ek-space-6) * -1) calc(var(--ek-space-3) * -1) var(--ek-space-8);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--site-radius-panel);
    background: var(--site-glass-bg);
    opacity: 0.5;
    translate: var(--depth-b-x, 0) var(--depth-b-y, 0);
    transition: translate var(--ek-duration-slow) var(--ek-easing-standard);
    pointer-events: none;
  }
  .mock {
    position: relative;
    border-radius: var(--site-radius-panel);
    background: var(--ek-color-background);
    box-shadow: var(--site-shadow-panel);
    color: var(--ek-color-content-default);
    font-size: var(--ek-font-size-sm);
    line-height: var(--ek-line-height-tight);
    user-select: none;
  }
  /* Katman hissi: panelin arkasında ofsetli, yarı saydam ikinci pencere (S9: parallax ile hafifçe kayar). */
  .mock::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: var(--ek-space-5) calc(var(--ek-space-4) * -1) calc(var(--ek-space-5) * -1) var(--ek-space-5);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--site-radius-panel);
    background: var(--site-glass-bg);
    translate: var(--depth-a-x, 0) var(--depth-a-y, 0);
    transition: translate var(--ek-duration-slow) var(--ek-easing-standard);
    pointer-events: none;
  }
  .mock__bar {
    display: flex;
    align-items: center;
    gap: var(--ek-space-3);
    padding: var(--ek-space-3) var(--ek-space-4);
    border-bottom: var(--site-border-width) solid var(--ek-color-border-default);
    border-start-start-radius: var(--site-radius-panel);
    border-start-end-radius: var(--site-radius-panel);
    background: var(--ek-color-surface-muted);
  }
  .mock__dots {
    display: inline-flex;
    gap: var(--ek-space-1);
  }
  .mock__dots i {
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-border-strong);
  }
  .mock__title {
    flex: 1;
    min-width: 0;
    color: var(--ek-color-content-strong);
    font-weight: var(--ek-font-weight-semibold);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mock__tag {
    padding: var(--ek-space-1) var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-info-subtle);
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    white-space: nowrap;
  }
  .mock__body {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-4);
    padding: var(--ek-space-4);
  }
  .mock__label {
    margin-bottom: var(--ek-space-2);
    color: var(--ek-color-content-muted);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .mock__channels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--ek-space-1);
  }
  .mock__chan {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-1);
    min-width: 0;
    padding: var(--ek-space-1) var(--ek-space-2);
    border: var(--site-border-width) solid color-mix(in srgb, var(--chan, var(--ek-color-border-default)) 40%, var(--ek-color-border-default));
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface);
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-medium);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* Sinyal halkası: 12 sn döngüde kanal güncellemesi geldiğinde belirir (scenes-loops.css); statik hâlde görünmez. */
  .mock__chan::after {
    content: '';
    position: absolute;
    inset: calc(var(--ek-space-1) * -1);
    border: var(--site-border-width) solid var(--ek-color-secondary);
    border-radius: var(--ek-radius-full);
    opacity: 0;
    pointer-events: none;
  }
  .mock__dot {
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--chan, var(--ek-color-success));
  }
  .mock__rail {
    position: relative;
    overflow: hidden;
    height: calc(var(--ek-space-1) * 1.5);
    margin-top: var(--ek-space-3);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface-sunken);
  }
  .mock__glow {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 28%;
    border-radius: var(--ek-radius-full);
    background: var(--site-gradient-accent);
    opacity: 0;
  }
  .mock__cols {
    display: grid;
    gap: var(--ek-space-4);
  }
  .mock__stock,
  .mock__feed {
    padding: var(--ek-space-3) var(--ek-space-4);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-lg);
    background: var(--ek-color-surface);
  }
  .mock__big {
    display: grid;
    max-width: none;
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-3xl);
    font-weight: var(--site-font-display-weight);
    letter-spacing: var(--site-font-display-tracking);
    line-height: 1.1;
  }
  .mock__num {
    grid-area: 1 / 1;
    opacity: 0;
  }
  .mock__num--d {
    opacity: 1;
  }
  .mock__meter {
    overflow: hidden;
    height: var(--ek-space-2);
    margin-block: var(--ek-space-3);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface-sunken);
  }
  .mock__fill {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--ek-radius-full);
    background: var(--site-gradient-accent);
    transform-origin: 0 50%;
    scale: 0.75 1;
  }
  .mock__sub {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    max-width: none;
    color: var(--ek-color-content-muted);
  }
  .mock__resv {
    display: inline-grid;
    color: var(--ek-color-content-strong);
    font-weight: var(--ek-font-weight-bold);
    text-align: end;
  }
  .mock__rnum {
    grid-area: 1 / 1;
    opacity: 0;
  }
  .mock__rnum--d {
    opacity: 1;
  }
  .mock__rows {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
  }
  .mock__row {
    display: grid;
    grid-template-columns: minmax(0, 6.5rem) minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--ek-space-3);
    padding-block: var(--ek-space-1);
  }
  .mock__rchan {
    display: flex;
    align-items: center;
    gap: var(--ek-space-1);
    overflow: hidden;
    color: var(--ek-color-content-strong);
    font-weight: var(--ek-font-weight-semibold);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .mock__rmono {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-5);
    height: var(--ek-space-5);
    border-radius: var(--ek-radius-full);
    background: var(--chan-fill, var(--ek-color-primary));
    color: var(--site-color-on-primary);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--site-font-display-weight);
  }
  .mock__skel {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
  }
  .mock__skel i {
    display: block;
    height: var(--ek-space-1);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface-sunken);
  }
  .mock__skel i:first-child {
    width: 84%;
  }
  .mock__skel i:last-child {
    width: 52%;
  }
  .mock__pills {
