---
/**
 * Senaryo / kullanım hikâyesi (S7; S12 canlı anlatım): "Bir sipariş geldiğinde ne olur" — beş adımlık, kaydırmayla adım
 * adım beliren zaman çizgisi. S12 (kullanıcı geri bildirimi: "görseller fazla teknik"): mini arayüz kopyaları yerine
 * her adımda koyu marka yüzeyinde CANLI bir sahne — akan sipariş kartları, akan stok sayacı, merkezden kanallara
 * yayılan senkron dalgası, pazaryerine giden kargo paketi, ilerleyen iade adımları. Kanal adı yok (renkli noktalar).
 *
 * Metinler pazarlama dilinde kısaltılmıştır ama her adım yayımlanmış bir yetenek kaydına bağlıdır (`cap`; kayıt yoksa
 * derleme hata verir) ve o kaydın söylediğinin ötesine geçmez (tests/home.test.ts). Sahneler aria-hidden; sayılar
 * örnektir — bunu bölüm girişindeki tek cümle söyler (S15-C deseni: sahne başına ayrı "örnek" etiketi yok). Adım başına bir sahne (`data-scene="story-step"`): görünür olunca
 * düğüm, çizgi, kart ve sahne parçaları sırayla belirir (scenes.css); döngüler yalnızca görünürken (scenes-loops.css).
 * Statik hâl (reduced-motion / durdurulmuş / JS'siz): her sahne son durumunu gösterir (sipariş listede, stok 11,
 * tüm kanallar güncel, paket pazaryerinde, iade adımları tamam).
 *
 * S13-C (kullanıcı geri bildirimi: "beyaz kart ile animasyon arka planı arasında çok fazla kontrast"): bölüm artık
 * tek bir koyu sahnedir (`tone="stage"`). Kartlar koyu cam (yarı saydam yüzey + ince iç kenar ışığı + derin yumuşak
 * gölge), canlı sahne paneli kartın içine GÖMÜLÜ daha derin bir yüzeydir — beyaz/koyu sert geçişi yoktur.
 *
 * S15-B (renk uyumu): üç cam katman TEK renk ailesindedir (koyu lacivert + marka ikincil/teal), nötr gri/beyaz pus yok:
 *   kart (`--story-card-*`: teal'e çalan yarı saydam yüzey, teal kenar ışığı) > sahne (`--story-scene-*`: aynı ailenin
 *   bir ton daha derini) > öğeler (`--story-item-*`: bir ton açık teal cam, ince teal kenar, üst kenarda ince ışık).
 *
 * S16 (kullanıcı geri bildirimi: "kutular çok koyu, ağır duruyor"): koyu tek sahne kurgusu bırakıldı. Bölüm açık
 * (`tone="muted"`) zemindedir; kartlar beyaz yüzey + ince kenarlık + yumuşak gölge (`--site-shadow-card`), adım
 * numarası (01–05) + ikonlu düğüm net hiyerarşi kurar. Sahne paneli kartın içinde çok hafif teal tonlu bir yüzey,
 * öğeler beyaz; tüm iç metinler açık zemin metin tonlarını (`--site-text-*`) kullanır (AA). Katman token adları ve
 * tek renk ailesi (teal) korunur; hareket/döngü/reduced-motion davranışı değişmedi (scenes*.css).
 */
import Section from '../Section.astro'
import SectionHeading from './SectionHeading.astro'
import Icon from './Icon.astro'
import { getPublicCapabilities } from '../../data/capabilities'
import { getPublicIntegrations } from '../../data/integrations'

const capIds = new Set(getPublicCapabilities('core').map((c) => c.id))
const cap = (id: string) => {
  if (!capIds.has(id)) throw new Error(`Yetenek kaydı bulunamadı: ${id}`)
  return id
}

const codes = getPublicIntegrations().map((i) => i.code)
const sources = [
  { code: codes[0], label: 'Pazaryeri' },
  { code: codes[1], label: 'Pazaryeri' },
  { code: getPublicIntegrations('ecommerce')[0]?.code ?? codes[2], label: 'Web mağaza' },
]

const steps = [
  {
    key: 'incoming',
    cap: cap('unified-orders'),
    icon: 'orders' as const,
    title: 'Sipariş gelir',
    text: 'Pazaryerlerinden ve web mağazanızdan gelen siparişler düzenli aralıklarla çekilir, tek listede toplanır.',
  },
  {
    key: 'reserve',
    cap: cap('stock-reservation'),
    icon: 'stock' as const,
    title: 'Stok rezerve edilir',
    text: 'Eşzamanlı siparişlerde yalnızca mevcut stok kadar rezervasyon yapılır; stok eksiye düşmez, aşan sipariş aşırı satış olarak işaretlenir.',
  },
  {
    key: 'sync',
    cap: cap('multi-channel-products'),
    icon: 'refresh' as const,
    title: 'Tüm kanallar güncellenir',
    text: 'Güncellenen stok, fiyat ve ürün bilgisi bağlı satış kanallarına tek merkezden iletilir.',
  },
  {
    key: 'notice',
    cap: cap('shipping-invoice-notice'),
    icon: 'notice' as const,
    title: 'Kargo ve fatura bilgisi iletilir',
    text: 'Panelden girdiğiniz kargo takip bilgisi ve fatura bağlantısı, siparişin geldiği pazaryerine iletilir.',
  },
  {
    key: 'returns',
    cap: cap('returns'),
    icon: 'returns' as const,
    title: 'İade talebi yönetilir',
    text: 'İade talepleri kanal bazında listelenir; panelden onaylanır veya reddedilir.',
  },
]
---

<Section tone="muted" id="senaryo" labelledby="senaryo-baslik" class="story-section">
  <SectionHeading
    id="senaryo-baslik"
    eyebrow="Senaryo"
    title="Bir sipariş geldiğinde ne olur?"
    lead="Siparişin düştüğü andan iadeye kadar her adım tek merkezde ilerler. Aşağıdaki sahneler örnek görünümdür."
  />

  <ol class="story" data-testid="story-steps">
    {
      steps.map((s, i) => (
        <li class="story__step" data-scene="story-step" data-cap={s.cap}>
          <div class="story__rail" aria-hidden="true">
            <span class="story__node" data-part="story-node">
              <Icon name={s.icon} size="md" />
            </span>
            <span class="story__line" data-part="story-line">
              {i < steps.length - 1 && <span class="story__packet" data-part="story-packet" />}
            </span>
          </div>
          <div class="story__card" data-part="story-card" data-tilt>
            <div class="story__copy">
              <p class="story__index">
                <span class="story__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="sr-only">Adım {i + 1}</span>
              </p>
              <h3 class="story__title">{s.title}</h3>
              <p class="story__text">{s.text}</p>
            </div>

            <div class="viz" data-viz={s.key} aria-hidden="true">
              {s.key === 'incoming' && (
                <div class="vin">
                  <ul class="vin__sources">
                    {sources.map((src) => (
                      <li class="vin__src" data-part="mini-item" data-code={src.code}>
                        <span class="vdot" />
                        {src.label}
                      </li>
                    ))}
                  </ul>
                  <span class="vin__pipe">
                    <i class="vin__spark" data-part="viz-spark" />
                  </span>
                  <div class="vin__inbox" data-part="mini-item">
                    <p class="vin__inbox-title">
                      <Icon name="orders" size="sm" />
                      Sipariş merkezi
                    </p>
                    <ul class="vin__list">
                      {sources.map((src, k) => (
                        <li class="vin__order" data-code={src.code} data-part={k === 0 ? 'viz-drop' : undefined}>
                          <span class="vdot" />
                          <span class="vin__bar" />
                          <span class="vin__pill">{k === 0 ? 'Yeni' : 'Alındı'}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              )}

              {s.key === 'reserve' && (
                <div class="vres">
                  <div class="vres__counter" data-part="mini-item">
                    <p class="vres__label">Kullanılabilir stok</p>
                    <p class="vres__num">
                      <span class="vres__n vres__n--from" data-part="viz-count-out">12</span>
                      <span class="vres__n vres__n--to" data-part="viz-count-in">11</span>
                    </p>
                    <span class="vres__meter">
                      <i class="vres__fill" data-part="viz-meter" />
                    </span>
                  </div>
                  <div class="vres__chip" data-part="mini-item">
                    <span class="vres__lock" data-part="viz-lock">
                      <Icon name="lock" size="sm" />
                    </span>
                    <span>
                      <b>1 adet rezerve</b>
                      <small>Sipariş için ayrıldı</small>
                    </span>
                  </div>
                </div>
              )}

              {s.key === 'sync' && (
                <div class="vsync">
                  <span class="vsync__wave" data-part="viz-wave" />
                  <span class="vsync__wave vsync__wave--2" data-part="viz-wave" />
                  <span class="vsync__wave vsync__wave--3" data-part="viz-wave" />
                  <span class="vsync__hub">
                    <Icon name="refresh" size="md" />
                  </span>
                  <ul class="vsync__ring">
                    {codes.map((code) => (
                      <li class="vsync__chan" data-code={code} data-part="viz-chan">
                        <span class="vdot" />
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {s.key === 'notice' && (
                <div class="vship">
                  <div class="vship__track">
                    <span class="vship__end vship__end--from" data-part="mini-item">
                      <Icon name="layers" size="sm" />
                    </span>
                    <span class="vship__road">
                      <span class="vship__lane" data-part="viz-parcel">
                        <span class="vship__parcel">
                          <Icon name="notice" size="sm" />
                        </span>
                      </span>
                    </span>
                    <span class="vship__end vship__end--to" data-part="mini-item" data-code={codes[0]}>
                      <span class="vdot" />
                    </span>
                  </div>
                  <ul class="vship__checks">
                    <li data-part="mini-item">
                      <Icon name="check" size="sm" />
                      Kargo takip bilgisi
                    </li>
                    <li data-part="mini-item">
                      <Icon name="check" size="sm" />
                      Fatura bağlantısı
                    </li>
                  </ul>
                </div>
              )}

              {s.key === 'returns' && (
                <div class="vret">
                  <div class="vret__card" data-part="mini-item" data-code={codes[1]}>
                    <span class="vdot" />
                    <span class="vret__title">İade talebi</span>
                    <span class="vret__bar" />
                  </div>
                  <div class="vret__steps" data-part="mini-item">
                    <span class="vret__track">
                      <i class="vret__progress" data-part="viz-progress" />
                    </span>
                    <ol class="vret__labels">
                      <li>
                        <span class="vret__dot" />
                        Talep
                      </li>
                      <li>
                        <span class="vret__dot" />
                        İnceleme
                      </li>
                      <li>
                        <span class="vret__dot" />
                        Onay / red
                      </li>
                    </ol>
                  </div>
                </div>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .story {
    /*
     * Katman hiyerarşisi — kart > sahne > öğeler, tek renk ailesi (teal). S16: açık zemin; kart beyaz, sahne çok
     * hafif teal tonlu, öğeler beyaz + ince teal kenar. Token adları S15-B'den korunur (tests/home-demos.test.ts).
     */
    --story-card-tint: color-mix(in srgb, var(--ek-color-secondary) 3%, var(--ek-color-surface));
    --story-card-base: var(--ek-color-surface);
    --story-card-edge: var(--ek-color-border-default);
    --story-scene-bg: color-mix(in srgb, var(--ek-color-secondary) 6%, var(--ek-color-surface-muted));
    --story-scene-edge: color-mix(in srgb, var(--ek-color-secondary) 14%, var(--ek-color-border-default));
    --story-item-bg: color-mix(in srgb, var(--ek-color-secondary) 2%, var(--ek-color-surface));
    --story-item-edge: color-mix(in srgb, var(--ek-color-secondary) 24%, var(--ek-color-border-default));
    --story-item-light: color-mix(in srgb, var(--ek-color-content-strong) 6%, transparent);
    --story-item-skel: color-mix(in srgb, var(--ek-color-secondary) 16%, var(--ek-color-surface-sunken));
    display: flex;
    flex-direction: column;
    margin: var(--ek-space-12) 0 0;
    padding: 0;
    list-style: none;
  }
  .story__step {
    position: relative;
    display: grid;
    grid-template-columns: var(--ek-space-10) minmax(0, 1fr);
    gap: var(--ek-space-4);
  }
  .story__rail {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block-start: var(--ek-space-5);
  }
  /* Düğüm: beyaz disk + ince teal halka + teal ikon (açık zeminde net, ağır değil). */
  .story__node {
    position: relative;
    z-index: 1;
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-10);
    height: var(--ek-space-10);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface);
    box-shadow:
      0 0 0 var(--site-border-width) var(--story-item-edge),
      0 0 0 var(--ek-space-1) var(--site-accent-soft),
      var(--site-shadow-card);
    color: var(--site-accent);
  }
  .story__line {
    position: relative;
    flex: 1;
    width: calc(var(--site-border-width) * 2);
    margin-block: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: linear-gradient(180deg, var(--site-accent-line), var(--ek-color-border-default));
    transform-origin: 50% 0;
  }
  .story__step:last-child .story__line {
    background: linear-gradient(180deg, var(--site-accent-line), transparent);
  }
  /* Adımlar arasında akan veri paketi (döngü: scenes-loops.css `loop-story-packet`); statik/JS'siz hâlde görünmez. */
  .story__packet {
    position: absolute;
    inset-inline-start: 50%;
    inset-block-start: 0;
    translate: -50% 0;
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--site-accent);
    box-shadow: var(--site-glow-ring);
    opacity: 0;
    pointer-events: none;
  }
  /*
   * Açık kart: beyaz yüzey (üst sol köşede çok hafif teal ışıma) + ince kenarlık + yumuşak iki katmanlı gölge.
   * Üst kenarda ince vurgu çizgisi yalnızca hover/odakta belirir (sakin hiyerarşi).
   */
  .story__card {
    position: relative;
    display: grid;
    gap: var(--ek-space-5);
    margin-bottom: var(--ek-space-6);
    padding: var(--ek-space-5);
    border: var(--site-border-width) solid var(--story-card-edge);
    border-radius: var(--site-radius-panel);
    background:
      radial-gradient(70% 90% at 0% 0%, var(--story-card-tint), transparent 70%),
      var(--story-card-base);
    box-shadow: var(--site-shadow-card);
    transition:
      box-shadow var(--ek-duration-base) var(--ek-easing-standard),
      border-color var(--ek-duration-base) var(--ek-easing-standard),
      transform var(--tilt-transition-duration, var(--ek-duration-fast)) var(--ek-easing-standard);
  }
  .story__card::before {
    content: '';
    position: absolute;
    inset-block-start: calc(var(--site-border-width) * -1);
    inset-inline: var(--ek-space-6);
    height: calc(var(--site-border-width) * 2);
    border-radius: var(--ek-radius-full);
    background: var(--site-gradient-hairline);
    opacity: 0;
    transition: opacity var(--ek-duration-base) var(--ek-easing-standard);
  }
  .story__card:hover {
    border-color: var(--story-item-edge);
    box-shadow: var(--site-shadow-card-hover);
  }
  .story__card:hover::before {
    opacity: 1;
  }
  .story__step:last-child .story__card {
    margin-bottom: 0;
  }
  .story__copy {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    min-width: 0;
  }
  /* Kart hiyerarşisi: adım numarası (büyük, vurgu) -> eyebrow -> başlık -> gövde (site-tokens.css `--site-card-*`). */
  .story .story__index {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-3);
    margin-bottom: var(--ek-space-1);
  }
  .story__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--ek-space-10);
    height: var(--ek-space-8);
    padding-inline: var(--ek-space-2);
    border-radius: var(--ek-radius-md);
    background: var(--site-accent-soft);
    box-shadow: inset 0 0 0 var(--site-border-width) color-mix(in srgb, var(--ek-color-secondary) 30%, transparent);
    color: var(--site-link-accent);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-bold);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }
  .story__title {
    color: var(--site-card-title-color);
    font-size: var(--ek-font-size-2xl);
    font-weight: var(--site-card-title-weight);
    letter-spacing: -0.01em;
  }
  .story__text {
    color: var(--site-card-value-color);
    font-size: var(--site-card-value-size);
    font-weight: var(--site-card-value-weight);
    line-height: var(--site-font-body-line-height);
  }

  /* ------------------------------------------------------------ Canlı sahne yüzeyi (açık, hafif teal tonlu) */
  .viz {
    container-type: inline-size;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 14rem;
    padding: var(--ek-space-6) var(--ek-space-5);
    border: var(--site-border-width) solid var(--story-scene-edge);
    border-radius: var(--ek-radius-xl);
    /* Kartın içine gömülü, bir ton tonlu yüzey: üst sağda çok hafif teal ışıma, altta düz. */
    background:
      radial-gradient(90% 80% at 100% 0%, color-mix(in srgb, var(--ek-color-secondary) 10%, transparent), transparent 65%),
      var(--story-scene-bg);
    box-shadow: inset 0 var(--site-border-width) var(--ek-space-1) var(--story-item-light);
    color: var(--site-text-body);
    font-size: var(--ek-font-size-sm);
  }
  .viz::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--site-texture-dots);
    background-size: var(--site-texture-dots-size);
    -webkit-mask-image: var(--site-texture-fade);
    mask-image: var(--site-texture-fade);
    opacity: 0.55;
  }
  .vdot {
    flex: none;
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--chan, var(--site-accent));
    box-shadow: 0 0 0 calc(var(--site-border-width) * 3) color-mix(in srgb, var(--chan, var(--site-accent)) 18%, transparent);
  }
  /* Öğe camı: sahneden bir ton açık, aynı teal ailesi; üst kenarda ince ışık. */
  .viz :is(.vin__src, .vin__inbox, .vres__counter, .vres__chip, .vship__checks li, .vret__card, .vret__steps) {
    border: var(--site-border-width) solid var(--story-item-edge);
    border-radius: var(--ek-radius-lg);
    background: var(--story-item-bg);
    box-shadow: 0 var(--site-border-width) calc(var(--site-border-width) * 2) var(--story-item-light);
  }

  /* 1) Sipariş gelir: kaynaklar -> akış -> sipariş merkezi */
  /* Dar sahne (mobil/tablet): kaynaklar üstte yan yana, akış dikey, merkez altta; geniş sahnede soldan sağa. */
  .vin {
    display: grid;
    gap: var(--ek-space-3);
  }
  .vin__sources {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-2);
  }
  .vin__pipe {
    display: none;
  }
  @container (min-width: 26rem) {
    .vin {
      grid-template-columns: auto minmax(var(--ek-space-6), 1fr) minmax(0, 1.6fr);
      align-items: center;
      gap: var(--ek-space-2);
    }
    .vin__sources {
      flex-direction: column;
    }
    .vin__pipe {
      display: block;
    }
  }
  .vin__src {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    padding: var(--ek-space-1) var(--ek-space-3) var(--ek-space-1) var(--ek-space-2);
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    white-space: nowrap;
  }
  .vin__pipe {
    position: relative;
    height: calc(var(--site-border-width) * 2);
    border-radius: var(--ek-radius-full);
    background: linear-gradient(90deg, transparent, var(--site-accent-line));
  }
  /* Kıvılcım şeridi boru boyunca uzanır; döngü şeridi 0 -> %100 kaydırır (nokta ::before). Statik hâlde görünmez. */
  .vin__spark {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .vin__spark::before {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    translate: -50% -50%;
    border-radius: var(--ek-radius-full);
    background: var(--site-accent);
    box-shadow: var(--site-glow-ring);
  }
  .vin__inbox {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    padding: var(--ek-space-3);
    min-width: 0;
  }
  .vin__inbox-title {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
  }
  .vin__inbox-title :global(.icon) {
    color: var(--site-accent);
  }
  .vin__list {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
  }
  .vin__order {
    display: flex;
    align-items: center;
