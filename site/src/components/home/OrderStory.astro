---
/**
 * Senaryo / kullanım hikâyesi (S7; S12 canlı anlatım): "Bir sipariş geldiğinde ne olur" — beş adımlık, kaydırmayla adım
 * adım beliren zaman çizgisi. S12 (kullanıcı geri bildirimi: "görseller fazla teknik"): mini arayüz kopyaları yerine
 * her adımda koyu marka yüzeyinde CANLI bir sahne — akan sipariş kartları, akan stok sayacı, merkezden kanallara
 * yayılan senkron dalgası, pazaryerine giden kargo paketi, ilerleyen iade adımları. Kanal adı yok (renkli noktalar).
 *
 * Metinler pazarlama dilinde kısaltılmıştır ama her adım yayımlanmış bir yetenek kaydına bağlıdır (`cap`; kayıt yoksa
 * derleme hata verir) ve o kaydın söylediğinin ötesine geçmez (tests/home.test.ts). Sahneler aria-hidden; sayılar
 * örnektir — bunu bölüm girişindeki tek cümle söyler (S15-C deseni: sahne başına ayrı "örnek" etiketi yok). Adım başına bir sahne (`data-scene="story-step"`): görünür olunca
 * düğüm, çizgi, kart ve sahne parçaları sırayla belirir (scenes.css); döngüler yalnızca görünürken (scenes-loops.css).
 * Statik hâl (reduced-motion / durdurulmuş / JS'siz): her sahne son durumunu gösterir (sipariş listede, stok 11,
 * tüm kanallar güncel, paket pazaryerinde, iade adımları tamam).
 *
 * S13-C (kullanıcı geri bildirimi: "beyaz kart ile animasyon arka planı arasında çok fazla kontrast"): bölüm artık
 * tek bir koyu sahnedir (`tone="stage"`). Kartlar koyu cam (yarı saydam yüzey + ince iç kenar ışığı + derin yumuşak
 * gölge), canlı sahne paneli kartın içine GÖMÜLÜ daha derin bir yüzeydir — beyaz/koyu sert geçişi yoktur.
 *
 * S15-B (renk uyumu): üç cam katman TEK renk ailesindedir (koyu lacivert + marka ikincil/teal), nötr gri/beyaz pus yok:
 *   kart (`--story-card-*`: teal'e çalan yarı saydam yüzey, teal kenar ışığı) > sahne (`--story-scene-*`: aynı ailenin
 *   bir ton daha derini) > öğeler (`--story-item-*`: bir ton açık teal cam, ince teal kenar, üst kenarda ince ışık).
 *
 * S16 (kullanıcı geri bildirimi: "kutular çok koyu, ağır duruyor"): koyu tek sahne kurgusu bırakıldı. Bölüm açık
 * (`tone="muted"`) zemindedir; kartlar beyaz yüzey + ince kenarlık + yumuşak gölge (`--site-shadow-card`), adım
 * numarası (01–05) + ikonlu düğüm net hiyerarşi kurar. Sahne paneli kartın içinde çok hafif teal tonlu bir yüzey,
 * öğeler beyaz; tüm iç metinler açık zemin metin tonlarını (`--site-text-*`) kullanır (AA). Katman token adları ve
 * tek renk ailesi (teal) korunur; hareket/döngü/reduced-motion davranışı değişmedi (scenes*.css).
 *
 * S27a (N3 "anasayfa kurgusunu kısalt", N9 hareket ekonomisi): bölüm ~2.000 px'ten tek ekranlık YATAY zaman çizgisine
 * indi. Beş adım ve metinleri (kayıt bağları) aynen korunur; adım başına canlı mini sahne paneli (`.viz`) ve döngüleri
 * kaldırıldı — aynı hikâyeyi hero vitrini (stok) ve sorun–çözüm kartı (sıfır aşırı satış) zaten canlı anlatıyor.
 * Masaüstünde beş sütun, aralarında tek ince hat; dar ekranda dikey liste. Giriş: düğüm → hat → kart (scenes.css).
 */
import Section from '../Section.astro'
import SectionHeading from './SectionHeading.astro'
import Icon from './Icon.astro'
import { getPublicCapabilities } from '../../data/capabilities'
import { getPublicIntegrations } from '../../data/integrations'

const capIds = new Set(getPublicCapabilities('core').map((c) => c.id))
const cap = (id: string) => {
  if (!capIds.has(id)) throw new Error(`Yetenek kaydı bulunamadı: ${id}`)
  return id
}

// SITE-DL-02 (akış): "Tüm kanallar güncellenir" adımındaki kanal noktaları — ad yok, yalnız marka rengi (data-code).
const dotCodes = getPublicIntegrations()
  .slice(0, 4)
  .map((c) => c.code)

// Her adımın kart altındaki canlı ayrıntısı (dekoratif, aria-hidden): akış adıma vardığında `before` -> `after`.
// Durağan hâl (hareket kapalı / JS'siz) = `after` (akışın SON karesi). Sayılar senaryoyu anlatan örnektir.
const steps = [
  {
    key: 'incoming',
    live: { before: 'Yeni sipariş', after: 'Listeye eklendi' },
    cap: cap('unified-orders'),
    icon: 'orders' as const,
    title: 'Sipariş gelir',
    text: 'Pazaryerlerinden ve web mağazanızdan gelen siparişler düzenli aralıklarla çekilir, tek listede toplanır.',
  },
  {
    key: 'reserve',
    live: { before: 'Stok 9', after: 'Stok 8 · rezerve' },
    cap: cap('stock-reservation'),
    icon: 'stock' as const,
    title: 'Stok rezerve edilir',
    text: 'Eşzamanlı siparişlerde yalnızca mevcut stok kadar rezervasyon yapılır; stok eksiye düşmez, aşan sipariş aşırı satış olarak işaretlenir.',
  },
  {
    key: 'sync',
    live: { before: 'Kanallar bekliyor', after: 'Kanallar güncel' },
    cap: cap('multi-channel-products'),
    icon: 'refresh' as const,
    title: 'Tüm kanallar güncellenir',
    text: 'Güncellenen stok, fiyat ve ürün bilgisi bağlı satış kanallarınıza iletilir.',
  },
  {
    key: 'notice',
    live: { before: 'Kargo ve fatura', after: 'Pazaryerine iletildi' },
    cap: cap('shipping-invoice-notice'),
    icon: 'notice' as const,
    title: 'Kargo ve fatura bilgisi iletilir',
    text: 'Panelden girdiğiniz kargo takip bilgisi ve fatura bağlantısı, siparişin geldiği pazaryerine iletilir.',
  },
  {
    key: 'returns',
    live: { before: 'İade talebi', after: 'Onaylandı' },
    cap: cap('returns'),
    icon: 'returns' as const,
    title: 'İade talebi yönetilir',
    text: 'İade talepleri kanal bazında listelenir; panelden onaylanır veya reddedilir.',
  },
]
---

<Section tone="muted" id="senaryo" labelledby="senaryo-baslik" class="story-section">
  <SectionHeading
    id="senaryo-baslik"
    eyebrow="Senaryo"
    title="Bir sipariş geldiğinde ne olur?"
    lead="Siparişin düştüğü andan iadeye kadar her adım aynı akışta, sizin gözünüzün önünde ilerler."
  />

  <ol class="story" data-testid="story-steps">
    {
      steps.map((s, i) => (
        <li class="story__step" data-scene="story-step" data-cap={s.cap}>
          <div class="story__rail" aria-hidden="true">
            <span class="story__node" data-part="story-node">
              <Icon name={s.icon} size="md" />
            </span>
            <span class="story__line" data-part="story-line">
              <i class="story__fill" />
              <i class="story__packet" />
            </span>
          </div>
          <div class="story__card" data-part="story-card">
            <p class="story__index">
              <span class="story__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="sr-only">Adım {i + 1}</span>
            </p>
            <h3 class="story__title">{s.title}</h3>
            <p class="story__text">{s.text}</p>
            <div class="story__live" aria-hidden="true">
              {s.key === 'sync' && (
                <span class="story__dots">
                  {dotCodes.map((code) => (
                    <i data-code={code} />
                  ))}
                </span>
              )}
              <span class="story__swap">
                <span class="story__live-old">{s.live.before}</span>
                <span class="story__live-new">
                  <span class="story__tick"><Icon name="check" size="sm" /></span>
                  {s.live.after}
                </span>
              </span>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  /* Kart katmanı tek renk ailesinde (teal) — S15-B token sözleşmesi korunur. */
  .story {
    --story-card-tint: color-mix(in srgb, var(--site-action) 6%, var(--ek-color-background));
    --story-card-edge: color-mix(in srgb, var(--site-action) 22%, var(--ek-color-border-default));
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: var(--ek-space-10) 0 0;
    padding: 0;
    list-style: none;
  }
  .story__step {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--ek-space-4);
  }
  .story__rail {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  /* Düğüm: beyaz disk + ince teal halka + teal ikon. */
  .story__node {
    position: relative;
    z-index: 1;
    display: inline-grid;
    place-items: center;
    width: var(--ek-space-12);
    height: var(--ek-space-12);
    border: var(--site-border-width) solid var(--story-card-edge);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-background);
    box-shadow: 0 0 0 var(--ek-space-1) color-mix(in srgb, var(--site-action) 10%, transparent), var(--site-shadow-card);
    color: var(--site-accent);
  }
  .story__line {
    flex: 1;
    width: calc(var(--site-border-width) * 2);
    min-height: var(--ek-space-6);
    background: linear-gradient(180deg, var(--site-action), var(--story-card-edge));
    transform-origin: 50% 0;
  }
  .story__step:last-child .story__line {
    background: linear-gradient(180deg, var(--story-card-edge), transparent);
  }
  .story__card {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    padding: var(--ek-space-2) 0 var(--ek-space-6);
  }
  .story .story__index {
    margin: 0;
  }
  .story__num {
    color: var(--site-accent);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-bold);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }
  .story__title {
    margin: 0;
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-lg);
    font-weight: var(--ek-font-weight-bold);
  }
  .story__text {
    margin: 0;
    color: var(--site-text-body);
    font-size: var(--ek-font-size-sm);
    line-height: var(--ek-line-height-normal);
  }

  /* Geniş ekran: beş sütun; düğümler tek yatay hat üzerinde, kartlar altında. */
  @media (min-width: 1024px) {
    .story {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--ek-space-6);
    }
    .story__step {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      gap: var(--ek-space-5);
    }
    .story__rail {
      flex-direction: row;
    }
    .story__line {
      width: auto;
      min-height: 0;
      height: calc(var(--site-border-width) * 2);
      margin-inline-end: calc(var(--ek-space-6) * -1);
      background: linear-gradient(90deg, var(--site-action), var(--story-card-edge));
      transform-origin: 0 50%;
    }
    /* Giriş "büyüme" yönü yataya döner (scenes.css varsayılanı dikey). */
    .story .story__line[data-part='story-line'] {
      --grow-from: 0 1;
    }
    .story__step:last-child .story__line {
      background: linear-gradient(90deg, var(--story-card-edge), transparent);
      margin-inline-end: 0;
    }
    .story__card {
      height: 100%;
      padding: var(--ek-space-5);
      border: var(--site-border-width) solid var(--story-card-edge);
      border-radius: var(--site-radius-panel);
      background: var(--story-card-tint);
      box-shadow: var(--site-shadow-card);
    }
  }

  /* ================= SITE-DL-02 — uygulamanın tasarım dili (frontend/DESIGN_SYSTEM.md §35) =================
     Düz yüzey + 1px ince çerçeve + kart yarıçapı; gölge, degrade, ışıma, hover yükselmesi yok; tek vurgu eylem
     mavisi; ikonlar çerçeveli köşeli kutuda; hap rozet yerine köşeli çip. Yukarıdaki kuralları EZER (aynı özgüllük,
     kaynak sırası). */

  .story {
    --story-card-tint: var(--ek-color-surface);
    --story-card-edge: var(--ek-color-border-default);
  }
  /* Düğüm: çerçeveli köşeli ikon kutusu (yuvarlak disk + halka yerine). */
  .story__node {
    border-color: var(--site-action-border);
    border-radius: var(--ek-radius-tile);
    background: var(--ek-color-surface);
    box-shadow: none;
  }
  .story__line,
  .story__step:last-child .story__line {
    background: var(--ek-color-border-strong);
  }
  .story__step:last-child .story__line {
    visibility: hidden;
  }
  @media (min-width: 1024px) {
    .story__card {
      border-radius: var(--ek-radius-card);
      box-shadow: none;
    }
  }

  /* SITE-DL-02 (akış) — "Bir sipariş geldiğinde ne olur?": sipariş adımdan adıma İLERLER.
     Döngü (--story-T): sipariş paketi hat üzerinde bir düğümden ötekine gider; vardığı adım etkinleşir (düğüm:
     action-subtle + action-border; kart: aynı vurgu, yalnız o adımdayken), kart altındaki canlı ayrıntı `önce` ->
     `sonra` değişir (yeni sipariş -> listede, stok 9 -> 8 rezerve, kanallar güncel, pazaryerine iletildi, onaylandı),
     geçilen hat eylem mavisiyle dolar. Tur bitince hepsi sıfırlanır. Yalnız opacity/scale/translate.
     Durağan hâl (hareket kapalı / reduced / JS'siz) = akışın SON karesi: tüm düğümler etkin, hatlar dolu, tüm
     ayrıntılar `sonra` durumunda. Dar ekranda (dikey liste) her adım kendi turunu döner; paket yalnız masaüstünde. */
  .story {
    --story-T: calc(var(--site-motion-loop-scene) * 1.25);
    --story-d0: var(--site-motion-duration-reveal-lg);
    --fill-from: 1 0;
  }
  .story__node {
    isolation: isolate;
    border-color: var(--ek-color-border-default);
  }
  .story__node::before {
    content: '';
    position: absolute;
    inset: calc(var(--site-border-width) * -1);
    z-index: -1;
    border: var(--site-border-width) solid var(--site-action-border);
    border-radius: inherit;
    background: var(--site-action-subtle);
    pointer-events: none;
  }
  .story__line {
    position: relative;
  }
  .story__fill {
    position: absolute;
    inset: 0;
    background: var(--site-action);
    transform-origin: 50% 0;
  }
  .story__packet {
    display: none;
  }
  .story__live {
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
    min-height: var(--ek-space-6);
    margin-top: var(--ek-space-1);
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    line-height: var(--ek-line-height-tight);
  }
  .story__swap {
    display: grid;
    min-width: 0;
  }
  .story__live-old,
  .story__live-new {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
  }
  .story__live-old {
    opacity: 0;
  }
  .story__live-new {
    color: var(--site-action-emphasis);
  }
  .story__tick {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: var(--ek-space-5);
    height: var(--ek-space-5);
    border: var(--site-border-width) solid var(--site-action-border);
    border-radius: var(--ek-radius-md);
    background: var(--ek-color-surface);
    color: var(--site-action);
  }
  .story__dots {
    display: inline-flex;
    flex: none;
    gap: var(--ek-space-1);
  }
  .story__dots i {
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--chan, var(--site-action));
  }
  .story__step:nth-child(2) {
    --k: 1;
  }
  .story__step:nth-child(3) {
    --k: 2;
  }
  .story__step:nth-child(4) {
    --k: 3;
  }
  .story__step:nth-child(5) {
    --k: 4;
  }
  @media (min-width: 1024px) {
    .story {
      --fill-from: 0 1;
    }
    .story__line {
      container-type: inline-size;
    }
    .story__fill {
      transform-origin: 0 50%;
    }
    /* Sipariş paketi: köşeli küçük kutu; hattın başından sonuna (sonraki düğümün altına) kayar. Durağan: görünmez. */
    .story__packet {
      display: block;
      position: absolute;
      inset-block-start: 50%;
      inset-inline-start: 0;
      width: var(--ek-space-3);
      height: var(--ek-space-3);
      margin: calc(var(--ek-space-3) / -2) 0 0 calc(var(--ek-space-3) / -2);
      border: calc(var(--site-border-width) * 2) solid var(--ek-color-surface-muted);
      border-radius: var(--ek-radius-sm);
      background: var(--site-action);
      opacity: 0;
    }
    .story__card {
      position: relative;
      isolation: isolate;
    }
    /* "Sipariş şu an bu adımda" vurgusu (yalnız döngüde; durağan hâlde görünmez). */
    .story__card::before {
      content: '';
      position: absolute;
      inset: calc(var(--site-border-width) * -1);
      z-index: -1;
      border: var(--site-border-width) solid var(--site-action-border);
      border-radius: inherit;
      background: var(--site-action-subtle);
      opacity: 0;
      pointer-events: none;
    }
    /* Canlı ayrıntı kartın alt bandı: surface-muted + ince çizgi. */
    .story__live {
      margin: auto calc(var(--ek-space-5) * -1) calc(var(--ek-space-5) * -1);
      padding: var(--ek-space-3) var(--ek-space-5);
      border-top: var(--site-border-width) solid var(--ek-color-border-subtle);
      border-radius: 0 0 calc(var(--ek-radius-card) - var(--site-border-width)) calc(var(--ek-radius-card) - var(--site-border-width));
      background: var(--ek-color-surface-muted);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes story-on-1 {
      0%,
      4% {
        opacity: 0;
      }
      7%,
      95% {
        opacity: 1;
      }
      99%,
      100% {
        opacity: 0;
      }
    }
    @keyframes story-off-1 {
      0%,
      4% {
        opacity: 1;
      }
      7%,
      95% {
        opacity: 0;
      }
      99%,
      100% {
        opacity: 1;
      }
    }
    @keyframes story-fill-1 {
      0%,
      14% {
        opacity: 1;
        scale: var(--fill-from);
      }
      21%,
      95% {
        opacity: 1;
        scale: 1 1;
      }
      99%,
      100% {
        opacity: 0;
        scale: 1 1;
      }
    }
    @keyframes story-on-2 {
      0%,
      22% {
        opacity: 0;
      }
      25%,
      95% {
        opacity: 1;
      }
      99%,
      100% {
        opacity: 0;
      }
    }
    @keyframes story-off-2 {
      0%,
      22% {
        opacity: 1;
      }
      25%,
      95% {
        opacity: 0;
      }
      99%,
      100% {
        opacity: 1;
      }
    }
    @keyframes story-fill-2 {
      0%,
      32% {
        opacity: 1;
        scale: var(--fill-from);
      }
      39%,
      95% {
        opacity: 1;
        scale: 1 1;
      }
      99%,
      100% {
        opacity: 0;
        scale: 1 1;
      }
    }
    @keyframes story-on-3 {
      0%,
      40% {
        opacity: 0;
      }
      43%,
      95% {
        opacity: 1;
      }
      99%,
      100% {
        opacity: 0;
      }
    }
    @keyframes story-off-3 {
      0%,
      40% {
        opacity: 1;
      }
      43%,
      95% {
        opacity: 0;
      }
      99%,
      100% {
        opacity: 1;
      }
    }
    @keyframes story-fill-3 {
      0%,
      50% {
        opacity: 1;
        scale: var(--fill-from);
      }
      57%,
      95% {
        opacity: 1;
        scale: 1 1;
      }
      99%,
      100% {
        opacity: 0;
        scale: 1 1;
      }
    }
    @keyframes story-on-4 {
      0%,
      58% {
        opacity: 0;
      }
      61%,
      95% {
        opacity: 1;
      }
      99%,
      100% {
        opacity: 0;
      }
    }
    @keyframes story-off-4 {
      0%,
      58% {
        opacity: 1;
      }
      61%,
      95% {
        opacity: 0;
      }
      99%,
      100% {
        opacity: 1;
      }
    }
    @keyframes story-fill-4 {
      0%,
      68% {
        opacity: 1;
        scale: var(--fill-from);
      }
      75%,
      95% {
        opacity: 1;
        scale: 1 1;
      }
      99%,
      100% {
        opacity: 0;
        scale: 1 1;
      }
    }
    @keyframes story-on-5 {
      0%,
      76% {
        opacity: 0;
      }
      79%,
      95% {
        opacity: 1;
      }
      99%,
      100% {
        opacity: 0;
      }
    }
    @keyframes story-off-5 {
