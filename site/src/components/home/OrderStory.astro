---
/**
 * Senaryo / kullanım hikâyesi (S7; S12 canlı anlatım): "Bir sipariş geldiğinde ne olur" — beş adımlık, kaydırmayla adım
 * adım beliren zaman çizgisi. S12 (kullanıcı geri bildirimi: "görseller fazla teknik"): mini arayüz kopyaları yerine
 * her adımda koyu marka yüzeyinde CANLI bir sahne — akan sipariş kartları, akan stok sayacı, merkezden kanallara
 * yayılan senkron dalgası, pazaryerine giden kargo paketi, ilerleyen iade adımları. Kanal adı yok (renkli noktalar).
 *
 * Metinler pazarlama dilinde kısaltılmıştır ama her adım yayımlanmış bir yetenek kaydına bağlıdır (`cap`; kayıt yoksa
 * derleme hata verir) ve o kaydın söylediğinin ötesine geçmez (tests/home.test.ts). Sahneler aria-hidden ve
 * "Örnek görünüm" etiketlidir; sayılar örnektir. Adım başına bir sahne (`data-scene="story-step"`): görünür olunca
 * düğüm, çizgi, kart ve sahne parçaları sırayla belirir (scenes.css); döngüler yalnızca görünürken (scenes-loops.css).
 * Statik hâl (reduced-motion / durdurulmuş / JS'siz): her sahne son durumunu gösterir (sipariş listede, stok 11,
 * tüm kanallar güncel, paket pazaryerinde, iade adımları tamam).
 */
import Section from '../Section.astro'
import SectionHeading from './SectionHeading.astro'
import Icon from './Icon.astro'
import { getPublicCapabilities } from '../../data/capabilities'
import { getPublicIntegrations } from '../../data/integrations'

const capIds = new Set(getPublicCapabilities('core').map((c) => c.id))
const cap = (id: string) => {
  if (!capIds.has(id)) throw new Error(`Yetenek kaydı bulunamadı: ${id}`)
  return id
}

const codes = getPublicIntegrations().map((i) => i.code)
const sources = [
  { code: codes[0], label: 'Pazaryeri' },
  { code: codes[1], label: 'Pazaryeri' },
  { code: getPublicIntegrations('ecommerce')[0]?.code ?? codes[2], label: 'Web mağaza' },
]

const steps = [
  {
    key: 'incoming',
    cap: cap('unified-orders'),
    icon: 'orders' as const,
    title: 'Sipariş gelir',
    text: 'Pazaryerlerinden ve web mağazanızdan gelen siparişler düzenli aralıklarla çekilir, tek listede toplanır.',
  },
  {
    key: 'reserve',
    cap: cap('stock-reservation'),
    icon: 'stock' as const,
    title: 'Stok rezerve edilir',
    text: 'Eşzamanlı siparişlerde yalnızca mevcut stok kadar rezervasyon yapılır; stok eksiye düşmez, aşan sipariş aşırı satış olarak işaretlenir.',
  },
  {
    key: 'sync',
    cap: cap('multi-channel-products'),
    icon: 'refresh' as const,
    title: 'Tüm kanallar güncellenir',
    text: 'Güncellenen stok, fiyat ve ürün bilgisi bağlı satış kanallarına tek merkezden iletilir.',
  },
  {
    key: 'notice',
    cap: cap('shipping-invoice-notice'),
    icon: 'notice' as const,
    title: 'Kargo ve fatura bilgisi iletilir',
    text: 'Panelden girdiğiniz kargo takip bilgisi ve fatura bağlantısı, siparişin geldiği pazaryerine iletilir.',
  },
  {
    key: 'returns',
    cap: cap('returns'),
    icon: 'returns' as const,
    title: 'İade talebi yönetilir',
    text: 'İade talepleri kanal bazında listelenir; panelden onaylanır veya reddedilir.',
  },
]
---

<Section tone="muted" id="senaryo" labelledby="senaryo-baslik">
  <SectionHeading
    id="senaryo-baslik"
    eyebrow="Senaryo"
    title="Bir sipariş geldiğinde ne olur?"
    lead="Siparişin düştüğü andan iadeye kadar her adım tek merkezde ilerler. Aşağıdaki sahneler örnek görünümdür."
  />

  <ol class="story" data-testid="story-steps">
    {
      steps.map((s, i) => (
        <li class="story__step" data-scene="story-step" data-cap={s.cap}>
          <div class="story__rail" aria-hidden="true">
            <span class="story__node" data-part="story-node">
              <Icon name={s.icon} size="md" />
            </span>
            <span class="story__line" data-part="story-line">
              {i < steps.length - 1 && <span class="story__packet" data-part="story-packet" />}
            </span>
          </div>
          <div class="story__card" data-part="story-card" data-tilt>
            <div class="story__copy">
              <p class="story__index">Adım {i + 1}</p>
              <h3 class="story__title">{s.title}</h3>
              <p class="story__text">{s.text}</p>
            </div>

            <div class="viz" data-surface="dark" data-viz={s.key} aria-hidden="true">
              <p class="viz__tag">Örnek görünüm</p>

              {s.key === 'incoming' && (
                <div class="vin">
                  <ul class="vin__sources">
                    {sources.map((src) => (
                      <li class="vin__src" data-part="mini-item" data-code={src.code}>
                        <span class="vdot" />
                        {src.label}
                      </li>
                    ))}
                  </ul>
                  <span class="vin__pipe">
                    <i class="vin__spark" data-part="viz-spark" />
                  </span>
                  <div class="vin__inbox" data-part="mini-item">
                    <p class="vin__inbox-title">
                      <Icon name="orders" size="sm" />
                      Sipariş merkezi
                    </p>
                    <ul class="vin__list">
                      {sources.map((src, k) => (
                        <li class="vin__order" data-code={src.code} data-part={k === 0 ? 'viz-drop' : undefined}>
                          <span class="vdot" />
                          <span class="vin__bar" />
                          <span class="vin__pill">{k === 0 ? 'Yeni' : 'Alındı'}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              )}

              {s.key === 'reserve' && (
                <div class="vres">
                  <div class="vres__counter" data-part="mini-item">
                    <p class="vres__label">Kullanılabilir stok</p>
                    <p class="vres__num">
                      <span class="vres__n vres__n--from" data-part="viz-count-out">12</span>
                      <span class="vres__n vres__n--to" data-part="viz-count-in">11</span>
                    </p>
                    <span class="vres__meter">
                      <i class="vres__fill" data-part="viz-meter" />
                    </span>
                  </div>
                  <div class="vres__chip" data-part="mini-item">
                    <span class="vres__lock" data-part="viz-lock">
                      <Icon name="lock" size="sm" />
                    </span>
                    <span>
                      <b>1 adet rezerve</b>
                      <small>Sipariş için ayrıldı</small>
                    </span>
                  </div>
                </div>
              )}

              {s.key === 'sync' && (
                <div class="vsync">
                  <span class="vsync__wave" data-part="viz-wave" />
                  <span class="vsync__wave vsync__wave--2" data-part="viz-wave" />
                  <span class="vsync__wave vsync__wave--3" data-part="viz-wave" />
                  <span class="vsync__hub">
                    <Icon name="refresh" size="md" />
                  </span>
                  <ul class="vsync__ring">
                    {codes.map((code) => (
                      <li class="vsync__chan" data-code={code} data-part="viz-chan">
                        <span class="vdot" />
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {s.key === 'notice' && (
                <div class="vship">
                  <div class="vship__track">
                    <span class="vship__end vship__end--from" data-part="mini-item">
                      <Icon name="layers" size="sm" />
                    </span>
                    <span class="vship__road">
                      <span class="vship__lane" data-part="viz-parcel">
                        <span class="vship__parcel">
                          <Icon name="notice" size="sm" />
                        </span>
                      </span>
                    </span>
                    <span class="vship__end vship__end--to" data-part="mini-item" data-code={codes[0]}>
                      <span class="vdot" />
                    </span>
                  </div>
                  <ul class="vship__checks">
                    <li data-part="mini-item">
                      <Icon name="check" size="sm" />
                      Kargo takip bilgisi
                    </li>
                    <li data-part="mini-item">
                      <Icon name="check" size="sm" />
                      Fatura bağlantısı
                    </li>
                  </ul>
                </div>
              )}

              {s.key === 'returns' && (
                <div class="vret">
                  <div class="vret__card" data-part="mini-item" data-code={codes[1]}>
                    <span class="vdot" />
                    <span class="vret__title">İade talebi</span>
                    <span class="vret__bar" />
                  </div>
                  <div class="vret__steps" data-part="mini-item">
                    <span class="vret__track">
                      <i class="vret__progress" data-part="viz-progress" />
                    </span>
                    <ol class="vret__labels">
                      <li>
                        <span class="vret__dot" />
                        Talep
                      </li>
                      <li>
                        <span class="vret__dot" />
                        İnceleme
                      </li>
                      <li>
                        <span class="vret__dot" />
                        Onay / red
                      </li>
                    </ol>
                  </div>
                </div>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .story {
    display: flex;
    flex-direction: column;
    margin: var(--ek-space-12) 0 0;
    padding: 0;
    list-style: none;
  }
  .story__step {
    position: relative;
    display: grid;
    grid-template-columns: var(--ek-space-10) minmax(0, 1fr);
    gap: var(--ek-space-4);
  }
  .story__rail {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .story__node {
    position: relative;
    z-index: 1;
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-10);
    height: var(--ek-space-10);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-background);
    box-shadow:
      0 0 0 var(--site-border-width) color-mix(in srgb, var(--site-accent) 45%, transparent),
      0 0 0 var(--ek-space-1) var(--site-accent-soft);
    color: var(--site-accent);
  }
  .story__line {
    position: relative;
    flex: 1;
    width: calc(var(--site-border-width) * 2);
    margin-block: var(--ek-space-1);
    border-radius: var(--ek-radius-full);
    background: linear-gradient(180deg, var(--site-accent-line), var(--ek-color-border-default));
    transform-origin: 50% 0;
  }
  .story__step:last-child .story__line {
    background: linear-gradient(180deg, var(--site-accent-line), transparent);
  }
  /* Adımlar arasında akan veri paketi (döngü: scenes-loops.css `loop-story-packet`); statik/JS'siz hâlde görünmez. */
  .story__packet {
    position: absolute;
    inset-inline-start: 50%;
    inset-block-start: 0;
    translate: -50% 0;
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--site-accent);
    box-shadow: var(--site-glow-ring);
    opacity: 0;
    pointer-events: none;
  }
  .story__card {
    display: grid;
    gap: var(--ek-space-5);
    margin-bottom: var(--ek-space-6);
    padding: var(--ek-space-5);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--site-radius-panel);
    background: var(--ek-color-surface);
    box-shadow: var(--site-shadow-card);
  }
  .story__step:last-child .story__card {
    margin-bottom: 0;
  }
  .story__copy {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    min-width: 0;
  }
  /* Kart hiyerarşisi: site-tokens.css `--site-card-*` (eyebrow -> başlık -> gövde). */
  .story__index {
    color: var(--site-card-eyebrow-color);
    font-size: var(--site-card-eyebrow-size);
    font-weight: var(--site-card-eyebrow-weight);
    letter-spacing: var(--site-card-eyebrow-tracking);
    text-transform: uppercase;
  }
  .story__title {
    color: var(--site-card-title-color);
    font-size: var(--ek-font-size-2xl);
    font-weight: var(--site-card-title-weight);
    letter-spacing: -0.01em;
  }
  .story__text {
    color: var(--site-card-value-color);
    font-size: var(--site-card-value-size);
    font-weight: var(--site-card-value-weight);
    line-height: var(--site-font-body-line-height);
  }

  /* ------------------------------------------------------------ Canlı sahne yüzeyi (koyu marka) */
  .viz {
    container-type: inline-size;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 14rem;
    padding: var(--ek-space-10) var(--ek-space-5) var(--ek-space-6);
    border-radius: var(--ek-radius-xl);
    background: var(--site-stage-mesh);
    color: var(--site-text-on-dark-body);
    font-size: var(--ek-font-size-sm);
  }
  .viz::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--site-texture-grid);
    background-size: var(--site-texture-grid-size);
    -webkit-mask-image: var(--site-texture-fade);
    mask-image: var(--site-texture-fade);
  }
  .viz::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset-block-start: -50%;
    inset-inline-end: -30%;
    width: 80%;
    aspect-ratio: 1;
    border-radius: var(--ek-radius-full);
    background: radial-gradient(closest-side, color-mix(in srgb, var(--ek-color-secondary) 26%, transparent), transparent);
  }
  .viz__tag {
    position: absolute;
    inset-block-start: var(--ek-space-3);
    inset-inline-start: var(--ek-space-4);
    color: var(--site-text-on-dark-meta);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .vdot {
    flex: none;
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--chan, var(--site-accent));
    box-shadow: 0 0 var(--ek-space-2) color-mix(in srgb, var(--chan, var(--site-accent)) 70%, transparent);
  }
  .viz :is(.vin__src, .vin__inbox, .vres__counter, .vres__chip, .vship__checks li, .vret__card, .vret__steps) {
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-lg);
    background: var(--site-glass-bg);
  }

  /* 1) Sipariş gelir: kaynaklar -> akış -> sipariş merkezi */
  /* Dar sahne (mobil/tablet): kaynaklar üstte yan yana, akış dikey, merkez altta; geniş sahnede soldan sağa. */
  .vin {
    display: grid;
    gap: var(--ek-space-3);
  }
  .vin__sources {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-2);
  }
  .vin__pipe {
    display: none;
  }
  @container (min-width: 26rem) {
    .vin {
      grid-template-columns: auto minmax(var(--ek-space-6), 1fr) minmax(0, 1.6fr);
      align-items: center;
      gap: var(--ek-space-2);
    }
    .vin__sources {
      flex-direction: column;
    }
    .vin__pipe {
      display: block;
    }
  }
  .vin__src {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    padding: var(--ek-space-1) var(--ek-space-3) var(--ek-space-1) var(--ek-space-2);
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    white-space: nowrap;
  }
  .vin__pipe {
    position: relative;
    height: calc(var(--site-border-width) * 2);
    border-radius: var(--ek-radius-full);
    background: linear-gradient(90deg, transparent, var(--site-accent-line));
  }
  /* Kıvılcım şeridi boru boyunca uzanır; döngü şeridi 0 -> %100 kaydırır (nokta ::before). Statik hâlde görünmez. */
  .vin__spark {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .vin__spark::before {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    translate: -50% -50%;
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-background);
    box-shadow: 0 0 var(--ek-space-3) var(--site-accent);
  }
  .vin__inbox {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    padding: var(--ek-space-3);
    min-width: 0;
    background: color-mix(in srgb, var(--ek-color-background) 10%, transparent);
  }
  .vin__inbox-title {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
  }
  .vin__inbox-title :global(.icon) {
    color: var(--site-accent);
  }
  .vin__list {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
  }
  .vin__order {
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
    padding: var(--ek-space-1) var(--ek-space-2);
    border-radius: var(--ek-radius-md);
    background: color-mix(in srgb, var(--ek-color-background) 6%, transparent);
  }
  .vin__order:first-child {
    background: color-mix(in srgb, var(--ek-color-secondary) 18%, transparent);
    box-shadow: inset 0 0 0 var(--site-border-width) color-mix(in srgb, var(--ek-color-secondary) 45%, transparent);
  }
  .vin__bar {
    flex: 1;
    height: var(--ek-space-1);
    border-radius: var(--ek-radius-full);
    background: color-mix(in srgb, var(--ek-color-background) 18%, transparent);
  }
  .vin__pill {
    color: var(--site-text-on-dark-meta);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
  }
  .vin__order:first-child .vin__pill {
    color: var(--site-accent);
  }

  /* 2) Stok rezerve edilir: akan sayaç + ölçer + rezerve çipi */
  .vres {
    display: grid;
    gap: var(--ek-space-3);
  }
  @container (min-width: 26rem) {
    .vres {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--ek-space-4);
    }
  }
  .vres__counter {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    padding: var(--ek-space-4);
  }
  .vres__label {
    color: var(--site-text-on-dark-meta);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .vres__num {
    display: grid;
    overflow: hidden;
    color: var(--site-text-on-dark-heading);
    font-size: var(--site-font-display-md);
    font-weight: var(--site-font-display-weight);
    letter-spacing: var(--site-font-display-tracking);
    line-height: 1.05;
  }
  .vres__n {
    grid-area: 1 / 1;
  }
  .vres__n--from {
    opacity: 0;
  }
  .vres__meter {
    overflow: hidden;
    height: calc(var(--ek-space-1) * 1.5);
    border-radius: var(--ek-radius-full);
    background: color-mix(in srgb, var(--ek-color-background) 14%, transparent);
  }
  .vres__fill {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--ek-color-secondary-darken-1), var(--ek-color-secondary));
    transform-origin: 0 50%;
    scale: 0.846 1;
  }
  .vres__chip {
    display: flex;
    align-items: center;
    gap: var(--ek-space-3);
    padding: var(--ek-space-3) var(--ek-space-4) var(--ek-space-3) var(--ek-space-3);
    background: color-mix(in srgb, var(--ek-color-secondary) 16%, transparent);
    border-color: color-mix(in srgb, var(--ek-color-secondary) 45%, transparent);
  }
  .vres__chip b,
  .vres__chip small {
    display: block;
  }
  .vres__chip b {
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-md);
  }
  .vres__chip small {
    color: var(--site-text-on-dark-meta);
    font-size: var(--ek-font-size-xs);
  }
  .vres__lock {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-8);
    height: var(--ek-space-8);
    border-radius: var(--ek-radius-full);
    background: var(--site-accent);
    color: var(--ek-color-primary);
  }

  /* 3) Kanallar güncellenir: merkez + yayılan dalga + çevredeki kanal noktaları */
  .vsync {
    position: relative;
    align-self: center;
    width: min(100%, 15rem);
    aspect-ratio: 1.6;
  }
  .vsync__hub {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-12);
    height: var(--ek-space-12);
    translate: -50% -50%;
    border-radius: var(--ek-radius-full);
    background: linear-gradient(140deg, var(--ek-color-secondary), var(--ek-color-secondary-darken-1));
    box-shadow: 0 0 var(--ek-space-8) color-mix(in srgb, var(--ek-color-secondary) 60%, transparent);
    color: var(--site-color-on-primary);
  }
  .vsync__wave {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    width: 55%;
    aspect-ratio: 1;
    translate: -50% -50%;
