---
/**
 * Senaryo / kullanım hikâyesi (S7): "Bir sipariş geldiğinde ne olur" — beş adımlık, kaydırmayla adım adım beliren zaman çizgisi.
 * Her adımın metni yetenek kaydındaki cümleden gelir (sipariş çekme, stok rezervasyonu, kanallara iletme, kargo/fatura bildirimi,
 * iade); sınır notları (caveat) görünür. Adım başına bir sahne (`data-scene="story-step"`): görünür olunca düğüm, bağlayıcı
 * çizgi, kart ve mini arayüz sırayla belirir. Mini arayüzler HTML/CSS temsildir (aria-hidden); sayılar örnektir — bunu bölüm
 * girişi ("Gösterilen ekranlar örnektir") söyler, S15'te kutu başına ayrı "örnek" etiketi kaldırıldı.
 * S15 görsel dil: kart (yüzey) > mini arayüz (aynı renk ailesinde bir ton koyu, ikincil renge çalan cam) > öğeler (bir ton
 * açık cam, ince kenar ışığı). Döngü (12 sn, yalnızca oynatılırken ve görünürken): düğümde halka -> çizgi boyunca akan ışık
 * paketi -> mini arayüzde işlenen öğenin üzerinden geçen ince ışık -> durum değişimi (rozet / sayı / kanal noktaları).
 */
import Section from '../Section.astro'
import SectionHeading from './SectionHeading.astro'
import Icon from './Icon.astro'
import { getPublicCapabilities } from '../../data/capabilities'
import { getPublicIntegrations } from '../../data/integrations'

const all = getPublicCapabilities('core')
const cap = (id: string) => {
  const c = all.find((x) => x.id === id)
  if (!c) throw new Error(`Yetenek kaydı bulunamadı: ${id}`)
  return c
}
const orders = cap('unified-orders')
const stock = cap('stock-reservation')
const multi = cap('multi-channel-products')
const notice = cap('shipping-invoice-notice')
const returns = cap('returns')

const channels = getPublicIntegrations().map((i) => i.name)
const marketplaces = getPublicIntegrations('marketplace').map((i) => i.name)
const [chanA = ''] = marketplaces

const steps = [
  { key: 'incoming', icon: 'orders' as const, title: 'Sipariş gelir', text: orders.summary, caveat: undefined },
  { key: 'reserve', icon: 'stock' as const, title: 'Stok rezerve edilir', text: stock.summary, caveat: stock.caveat },
  { key: 'sync', icon: 'refresh' as const, title: 'Kanallar güncellenir', text: multi.summary, caveat: undefined },
  { key: 'notice', icon: 'notice' as const, title: 'Kargo ve fatura bilgisi iletilir', text: notice.summary, caveat: notice.caveat },
  { key: 'returns', icon: 'returns' as const, title: 'İade talebi gelirse', text: returns.summary, caveat: returns.caveat },
]
---

<Section tone="muted" id="senaryo" labelledby="senaryo-baslik">
  <SectionHeading
    id="senaryo-baslik"
    eyebrow="Senaryo"
    title="Bir sipariş geldiğinde ne olur?"
    lead="Bir siparişin panelde nasıl ilerlediğini adım adım görün. Gösterilen ekranlar örnektir."
  />

  <ol class="story" data-testid="story-steps">
    {
      steps.map((s, i) => (
        <li class="story__step" data-scene="story-step">
          <div class="story__rail" aria-hidden="true">
            <span class="story__node" data-part="story-node">
              <Icon name={s.icon} size="md" />
            </span>
            <span class="story__line" data-part="story-line">
              {i < steps.length - 1 && <span class="story__packet" data-part="story-packet"></span>}
            </span>
          </div>
          <div class="story__card" data-part="story-card" data-tilt>
            <div class="story__copy">
              <p class="story__index">Adım {i + 1}</p>
              <h3 class="story__title">{s.title}</h3>
              <p class="story__text">{s.text}</p>
              {s.caveat && <p class="story__caveat">{s.caveat}</p>}
            </div>

            <div class="story__visual" aria-hidden="true">
              {s.key === 'incoming' && (
                <div class="mini mini--incoming">
                  <div class="mini__row" data-part="mini-item">
                    <span class="mini__chan">{chanA}</span>
                    <span class="mini__skel"><i></i><i></i></span>
                    <span class="mini__pills">
                      <span class="mini__pill mini__pill--new">Yeni</span>
                      <span class="mini__pill mini__pill--ok" data-part="story-badge-pulse">Alındı</span>
                    </span>
                  </div>
                  <p class="mini__hint" data-part="mini-item"><Icon name="clock" size="sm" /> Düzenli aralıklarla çekilir</p>
                </div>
              )}
              {s.key === 'reserve' && (
                <div class="mini mini--reserve">
                  <div class="mini__stock" data-part="mini-item">
                    <span class="mini__label">Kullanılabilir</span>
                    <span class="mini__big"><span class="mini__num-old">12</span><span class="mini__arrow"><Icon name="arrow" size="sm" /></span><span class="mini__num-new">11</span></span>
                  </div>
                  <div class="mini__row" data-part="mini-item">
                    <span class="mini__chan">{chanA}</span>
                    <span class="mini__skel"><i></i><i></i></span>
                    <span class="mini__pill mini__pill--ok">Rezerve</span>
                  </div>
                </div>
              )}
              {s.key === 'sync' && (
                <div class="mini mini--sync">
                  <ul class="mini__chips">
                    {channels.map((name) => (
                      <li class="mini__chip" data-part="mini-item">
                        <span class="mini__dot"></span>
                        {name}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {s.key === 'notice' && (
                <div class="mini mini--notice">
                  <div class="mini__flow">
                    <span class="mini__box" data-part="mini-item"><Icon name="notice" size="sm" />Kargo takip bilgisi</span>
                    <span class="mini__box" data-part="mini-item"><Icon name="receipt" size="sm" />Fatura bağlantısı</span>
                    <span class="mini__to" data-part="mini-item"><Icon name="arrow" size="sm" />{chanA}</span>
                  </div>
                </div>
              )}
              {s.key === 'returns' && (
                <div class="mini mini--returns">
                  <div class="mini__row" data-part="mini-item">
                    <span class="mini__chan">{chanA}</span>
                    <span class="mini__skel"><i></i><i></i></span>
                    <span class="mini__pills">
                      <span class="mini__pill mini__pill--alert">İade talebi</span>
                      <span class="mini__pill mini__pill--ok" data-part="story-badge-pulse">İnceleniyor</span>
                    </span>
                  </div>
                  <div class="mini__actions" data-part="mini-item">
                    <span class="mini__btn mini__btn--primary">Onayla</span>
                    <span class="mini__btn">Reddet</span>
                  </div>
                </div>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .story {
    display: flex;
    flex-direction: column;
    margin: var(--ek-space-12) 0 0;
    padding: 0;
    list-style: none;
  }
  .story__step {
    position: relative;
    display: grid;
    grid-template-columns: var(--ek-space-10) minmax(0, 1fr);
    gap: var(--ek-space-4);
  }
  .story__rail {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .story__node {
    position: relative;
    z-index: 1;
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-10);
    height: var(--ek-space-10);
    border-radius: var(--ek-radius-full);
    background: linear-gradient(140deg, var(--ek-color-primary-darken-1), var(--ek-color-primary));
    color: var(--site-color-on-primary);
    box-shadow: var(--site-glow-ring);
  }
  .story__line {
    position: relative;
    flex: 1;
    width: var(--site-border-width);
    margin-block: var(--ek-space-1);
    background: linear-gradient(180deg, var(--ek-color-secondary), var(--ek-color-border-default));
    transform-origin: 50% 0;
  }
  .story__step:last-child .story__line {
    background: linear-gradient(180deg, var(--ek-color-secondary), transparent);
  }
  /*
   * Adımlar arasında akan ışık paketi (S15): sarmalayıcı çizgi boyundadır, kuyruklu ışık alt uçtadır; döngüde
   * sarmalayıcı `translate` ile yukarıdan aşağı kayar → paket çizginin TAMAMI boyunca akar. Statik/JS'siz hâlde görünmez.
   */
  .story__packet {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }
  .story__packet::before {
    content: '';
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 50%;
    width: calc(var(--site-border-width) * 3);
    height: var(--ek-space-10);
    translate: -50% 0;
    border-radius: var(--ek-radius-full);
    background: linear-gradient(
      180deg,
      transparent,
      var(--ek-color-secondary) 75%,
      color-mix(in srgb, var(--ek-color-secondary) 30%, var(--ek-color-surface))
    );
    box-shadow: 0 0 var(--ek-space-2) color-mix(in srgb, var(--ek-color-secondary) 60%, transparent);
  }
  /* Düğümde adım etkinleşirken açılan ince halka (statik hâlde görünmez). */
  .story__node::after {
    content: '';
    position: absolute;
    inset: 0;
    border: var(--site-border-width) solid color-mix(in srgb, var(--ek-color-secondary) 75%, transparent);
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
  }
  /* Kart: yüzey + sağ üstte ikincil renge çalan çok hafif ışıma (mini arayüzle aynı renk ailesi). */
  .story__card {
    display: grid;
    gap: var(--ek-space-5);
    margin-bottom: var(--ek-space-6);
    padding: var(--ek-space-5);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--site-radius-panel);
    background:
      radial-gradient(60% 80% at 100% 0%, color-mix(in srgb, var(--ek-color-secondary) 7%, transparent), transparent 70%),
      var(--ek-color-surface);
    box-shadow: var(--site-shadow-card);
  }
  .story__step:last-child .story__card {
    margin-bottom: 0;
  }
  .story__copy {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    min-width: 0;
  }
  .story__index {
    color: var(--ek-color-primary-darken-1);
    font-size: var(--site-card-eyebrow-size);
    font-weight: var(--site-card-eyebrow-weight);
    letter-spacing: var(--site-card-eyebrow-tracking);
    text-transform: uppercase;
  }
  /* Aynı 4 seviyeli hiyerarşi token seti (site-tokens.css `--site-card-*`): eyebrow (index) -> başlık -> değer -> açıklama. */
  .story__title {
    font-size: var(--site-card-title-size);
    font-weight: var(--site-card-title-weight);
    letter-spacing: -0.01em;
  }
  .story__text {
    color: var(--ek-color-content-strong);
    font-size: var(--site-card-value-size);
    font-weight: var(--site-card-value-weight);
  }
  .story__caveat {
    color: var(--ek-color-content-muted);
    font-size: var(--site-card-desc-size);
  }
  .story__visual {
    min-width: 0;
  }

  /*
   * --- Mini arayüzler (S15) ---
   * Katmanlar tek renk ailesinde: kart yüzeyi > mini arayüz "cam" (ikincil renge çalan, bir ton koyu; üst kenarda
   * ince ışık) > öğeler (bir ton açık cam, renkli ince kenar, yumuşak renkli gölge). Gri-mavi "sunken" zemin ve
   * nokta dokusu kaldırıldı: kutular kartın parçası gibi görünür.
   */
  .mini {
    --mini-edge: color-mix(in srgb, var(--ek-color-secondary) 22%, var(--ek-color-border-default));
    --mini-item-bg: color-mix(in srgb, var(--ek-color-surface) 86%, transparent);
    --mini-item-edge: color-mix(in srgb, var(--ek-color-secondary) 16%, var(--ek-color-border-default));
    --mini-light: color-mix(in srgb, var(--ek-color-secondary) 16%, transparent);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--ek-space-3);
    height: 100%;
    padding: var(--ek-space-4);
    border: var(--site-border-width) solid var(--mini-edge);
    border-radius: var(--ek-radius-xl);
    background:
      radial-gradient(90% 70% at 85% 0%, color-mix(in srgb, var(--ek-color-secondary) 14%, transparent), transparent 70%),
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--ek-color-secondary) 6%, var(--ek-color-surface)),
        color-mix(in srgb, var(--ek-color-secondary) 9%, var(--ek-color-surface-muted))
      );
    box-shadow:
      inset 0 var(--site-border-width) 0 color-mix(in srgb, var(--ek-color-surface) 90%, transparent),
      inset 0 0 0 var(--site-border-width) color-mix(in srgb, var(--ek-color-surface) 35%, transparent);
    font-size: var(--ek-font-size-sm);
  }
  .mini__row,
  .mini__stock,
  .mini__hint,
  .mini__box,
  .mini__to {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--ek-space-3);
    padding: var(--ek-space-3);
    overflow: hidden;
    border: var(--site-border-width) solid var(--mini-item-edge);
    border-radius: var(--ek-radius-lg);
    background: var(--mini-item-bg);
    box-shadow:
      inset 0 var(--site-border-width) 0 var(--ek-color-surface),
      0 var(--site-border-width) calc(var(--site-border-width) * 2) color-mix(in srgb, var(--ek-color-content-strong) 4%, transparent),
      0 var(--ek-space-2) var(--ek-space-4) calc(var(--ek-space-2) * -1) color-mix(in srgb, var(--ek-color-primary-darken-1) 12%, transparent);
  }
  /* İşlenen öğenin üzerinden geçen ince ışık (döngüde soldan sağa kayar; statik hâlde görünmez). */
  .mini__row::after,
  .mini__stock::after,
  .mini__box::after,
  .mini__to::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 25%, var(--mini-light) 50%, transparent 75%);
    opacity: 0;
    pointer-events: none;
  }
  .mini__chan {
    min-width: 4.5rem;
    color: var(--ek-color-content-strong);
    font-weight: var(--ek-font-weight-semibold);
  }
  .mini__skel {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--ek-space-1);
  }
  .mini__skel i {
    display: block;
    height: var(--ek-space-1);
    border-radius: var(--ek-radius-full);
    background: color-mix(in srgb, var(--ek-color-secondary) 14%, var(--ek-color-surface-sunken));
  }
  .mini__skel i:first-child {
    width: 82%;
  }
  .mini__skel i:last-child {
    width: 50%;
  }
  /* Durum rozeti yığını: ikinci rozet birincinin üzerine biner (S10 `loop-badge-cycle` ile ara sıra görünür). */
  .mini__pills {
    display: inline-grid;
    justify-items: stretch;
  }
  .mini__pills .mini__pill {
    grid-area: 1 / 1;
  }
  /* Nabız rozeti statik/JS'siz hâlde gizli kalır (yığının altındaki sabit rozet görünür); döngü: scenes-loops.css. */
  .mini__pill[data-part='story-badge-pulse'] {
    opacity: 0;
  }
  .mini__pill {
    padding: var(--ek-space-1) var(--ek-space-3);
    border: var(--site-border-width) solid transparent;
    border-radius: var(--ek-radius-full);
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    text-align: center;
    white-space: nowrap;
  }
  .mini__pill--new {
    border-color: color-mix(in srgb, var(--ek-color-info) 22%, transparent);
    background: var(--ek-color-info-subtle);
  }
  .mini__pill--ok {
    border-color: color-mix(in srgb, var(--ek-color-success) 22%, transparent);
    background: var(--ek-color-success-subtle);
  }
  .mini__pill--alert {
    border-color: color-mix(in srgb, var(--ek-color-warning) 28%, transparent);
    background: var(--ek-color-warning-subtle);
  }
  .mini__hint {
    color: var(--ek-color-content-muted);
    font-weight: var(--ek-font-weight-medium);
  }
  .mini__stock {
    justify-content: space-between;
  }
  .mini__label {
    color: var(--ek-color-content-muted);
    font-weight: var(--ek-font-weight-semibold);
  }
  .mini__big {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-2xl);
    font-weight: var(--site-font-display-weight);
  }
  .mini__num-old {
    color: var(--ek-color-content-muted);
  }
  .mini__arrow {
    display: inline-flex;
    color: var(--ek-color-secondary-darken-1);
  }
  .mini__num-new {
    display: inline-block;
  }
  .mini__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-2);
  }
  .mini__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    padding: var(--ek-space-1) var(--ek-space-3);
    border: var(--site-border-width) solid var(--mini-item-edge);
    border-radius: var(--ek-radius-full);
    background: var(--mini-item-bg);
    box-shadow:
      inset 0 var(--site-border-width) 0 var(--ek-color-surface),
      0 var(--ek-space-1) var(--ek-space-3) calc(var(--ek-space-1) * -1) color-mix(in srgb, var(--ek-color-primary-darken-1) 16%, transparent);
    color: var(--ek-color-content-strong);
    font-weight: var(--ek-font-weight-medium);
  }
  .mini__dot {
    position: relative;
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-success);
  }
  /* Kanal güncellenince noktadan açılan küçük halka (döngüde sırayla; statik hâlde görünmez). */
  .mini__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 0 0 var(--site-border-width) var(--ek-color-success);
    opacity: 0;
  }
  .mini__flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ek-space-2);
  }
  .mini__box,
  .mini__to {
    color: var(--ek-color-content-strong);
    font-weight: var(--ek-font-weight-semibold);
  }
  .mini__to {
    border-color: color-mix(in srgb, var(--ek-color-secondary) 60%, var(--ek-color-border-default));
    background: color-mix(in srgb, var(--ek-color-secondary) 8%, var(--mini-item-bg));
  }
  .mini__actions {
    display: flex;
    gap: var(--ek-space-2);
  }
  .mini__btn {
    padding: var(--ek-space-1) var(--ek-space-4);
    border: var(--site-border-width) solid var(--mini-item-edge);
    border-radius: var(--ek-radius-md);
    background: var(--mini-item-bg);
    color: var(--ek-color-content-strong);
    font-weight: var(--ek-font-weight-semibold);
  }
  .mini__btn--primary {
    border-color: var(--ek-color-primary);
    background: linear-gradient(140deg, var(--ek-color-primary-darken-1), var(--ek-color-primary));
    color: var(--site-color-on-primary);
  }

  /*
   * S15 döngüsü (12 sn `--site-motion-loop-scene`; mevcut `loop-badge-cycle` rozet ritmiyle hizalı, rozet %38–48'de belirir):
   *   %0–30 düğüm halkası -> %10–80 ışık paketi çizgi boyunca akar -> %30–50 işlenen öğenin üzerinden ışık geçer ->
   *   %42–60 durum değişimi (yeni stok sayısı, kanal noktaları sırayla). Sözleşme scenes-loops.css ile aynıdır:
   *   yalnızca reduced-motion "no-preference" + html[data-motion='play'] + sahne `data-state='play'`; `paused` başlar,
   *   yalnızca görünürken çalışır; yalnızca opacity/translate/scale. Bileşen seçicileri genel `story-packet`
   *   döngüsünden daha özgüldür (paket artık çizginin tamamında akar).
   */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes loop-story-flow {
      0%,
      10% {
        opacity: 0;
        translate: 0 -100%;
      }
      18%,
      70% {
        opacity: 1;
      }
      80%,
      100% {
        opacity: 0;
        translate: 0 0;
      }
    }
    @keyframes loop-story-ring {
      0%,
      100% {
        opacity: 0;
        scale: 1;
      }
      4% {
        opacity: 0.8;
      }
      26%,
      99% {
        opacity: 0;
        scale: 1.7;
      }
    }
    @keyframes loop-story-sheen {
      0%,
      30% {
        opacity: 0;
        translate: -100% 0;
      }
      34%,
      44% {
        opacity: 1;
      }
      50%,
      100% {
        opacity: 0;
        translate: 100% 0;
      }
    }
    @keyframes loop-story-count {
      0%,
      42%,
      100% {
        opacity: 1;
        translate: 0 0;
      }
      45% {
        opacity: 0;
        translate: 0 calc(var(--site-motion-distance) * 0.6);
      }
    }
    @keyframes loop-story-nudge {
      0%,
      36%,
      50%,
      100% {
        translate: 0 0;
      }
      43% {
        translate: calc(var(--site-motion-distance) * 0.4) 0;
      }
    }
    @keyframes loop-story-dot {
      0%,
      44% {
        opacity: 0;
        scale: 1;
      }
      48% {
        opacity: 0.7;
      }
      62%,
      100% {
        opacity: 0;
        scale: 2.6;
      }
    }

    :global(html[data-motion='play']) .story__step[data-state='play'] .story__line .story__packet {
      animation: loop-story-flow var(--site-motion-loop-scene) var(--site-motion-ease-loop) infinite paused;
    }
