---
/**
 * Güvenlik özeti (ADR-0014 Karar 2 bölüm 6 + Karar 5 "izinli iddialar"; S12 PARÇA C üst perde yenileme).
 *
 * Anlatı üst perdeden kurulur: dört sütun (Veri izolasyonu, Şifreli anahtar kasası, Yetki ve erişim kontrolü,
 * Dayanıklı altyapı) — sektör anahtar sözcüğü BAŞLIKTIR, altında tek bir fayda cümlesi ve kanıt satırları
 * (kayıttaki iddia başlıkları) yer alır. Olgular YALNIZCA `getPublicCapabilities('security')` kayıtlarından gelir;
 * sertifika/veri konumu/uptime iddiası YOK. Kayıttaki her güvenlik iddiası tam bir kez görünür (derleme zamanı
 * denetimi aşağıda: sütuna atanmamış iddia "Diğer" satırına düşmez, derleme hata verir).
 *
 * Görseller (aria-hidden, anlam çevredeki metinde):
 *  - Sağdaki kalkan/kasa illüstrasyonu (`data-scene="request-guard"`): katmanlı halkalar yavaşça döner, kasa kadranı
 *    ağır ağır çevrilir, tarama ışını (`beam`, scenes-loops.css) yukarıdan aşağı süzülür; dört koruma katmanı çipi
 *    (`guard-step`, scenes.css) sırayla yerine oturur. Çipler kayıttaki iddialara karşılık gelir.
 *  - Sütun kartlarındaki mini illüstrasyonlar: izole hücreler, maskeli anahtar, yetki kademeleri, devre kesici.
 * Döngüler yalnızca `prefers-reduced-motion: no-preference` + `html[data-motion='play']` + sahne görünürken çalışır
 * (yalnızca transform/opacity); aksi hâlde her şey anlamlı statik son durumdadır.
 */
import Section from '../Section.astro'
import SectionHeading from './SectionHeading.astro'
import Icon from './Icon.astro'
import { getPublicCapabilities } from '../../data/capabilities'
import { getPublicFaq } from '../../data/faq'
import { pageHref } from './links'

const items = getPublicCapabilities('security')
const byId = new Map(items.map((i) => [i.id, i]))
const detailHref = pageHref('/guvenlik')

// Kısmi (ödeme) iddiası için dürüst not: SSS kaydındaki son cümle ("...test (sandbox) aşamasında").
const cardAnswer = getPublicFaq().find((f) => f.id === 'kart-bilgisi')?.answer ?? ''
const partialNote = cardAnswer.split('. ').slice(-1)[0]

type IllKind = 'cells' | 'vault' | 'tiers' | 'circuit'
interface Pillar {
  key: IllKind
  icon: 'database' | 'key' | 'users' | 'shield'
  /** Sektör terimi (küçük üst etiket). */
  eyebrow: string
  title: string
  /** Fayda cümlesi: kayıttaki özet (`summaryFrom`) ya da olgu içermeyen çerçeve cümlesi. */
  lead: string
  ids: string[]
}

const summary = (id: string) => byId.get(id)?.summary ?? ''

const PILLARS: Pillar[] = [
  {
    key: 'cells',
    eyebrow: 'Çok kiracılı mimari',
    icon: 'database',
    title: 'Veri izolasyonu',
    lead: 'Ürün, stok ve sipariş verileriniz, yalnızca hesabınıza ayrılmış veritabanında tutulur.',
    ids: ['tenant-database'],
  },
  {
    key: 'vault',
    eyebrow: 'Durağan veride şifreleme',
    icon: 'key',
    title: 'Şifreli anahtar kasası',
    lead: summary('secrets-encryption'),
    ids: ['secrets-encryption', 'secrets-masked'],
  },
  {
    key: 'tiers',
    eyebrow: 'RBAC',
    icon: 'users',
    title: 'Yetki ve erişim kontrolü',
    lead: 'Ekibinizde kimin neyi yapabileceğini siz belirlersiniz; her işlem sunucuda yetki denetiminden geçer.',
    ids: ['role-based-access', 'default-deny', 'session-cookie'],
  },
  {
    key: 'circuit',
    eyebrow: 'Hata toleransı',
    icon: 'shield',
    title: 'Dayanıklı altyapı',
    lead: 'Pazaryeri bağlantılarınız geçici hatalara karşı korunur; ödeme altyapısı kart verisini sistemlerimize almayacak şekilde tasarlandı.',
    ids: ['integration-resilience', 'hosted-payment'],
  },
]

const pillars = PILLARS.map((p) => ({ ...p, claims: p.ids.map((id) => byId.get(id)).filter((c): c is NonNullable<typeof c> => Boolean(c)) })).filter(
  (p) => p.claims.length > 0,
)
const placed = new Set(pillars.flatMap((p) => p.claims.map((c) => c.id)))
const unplaced = items.filter((i) => !placed.has(i.id))
if (unplaced.length > 0) throw new Error(`Güvenlik özeti: sütuna atanmamış iddia: ${unplaced.map((i) => i.id).join(', ')}`)

// Kalkan illüstrasyonunun koruma katmanı çipleri: yalnızca kayıtta bulunan iddialar.
const GUARDS: Array<{ id: string; icon: 'lock' | 'users' | 'shield' | 'database' | 'key'; label: string; sub: string }> = [
  { id: 'tenant-database', icon: 'database', label: 'Veri izolasyonu', sub: 'Hesaba özel veritabanı' },
  { id: 'secrets-encryption', icon: 'key', label: 'Şifreli anahtarlar', sub: 'AES-256-GCM' },
  { id: 'role-based-access', icon: 'users', label: 'Rol tabanlı yetki', sub: 'Üç yetki kademesi' },
  { id: 'default-deny', icon: 'shield', label: 'Varsayılan red', sub: 'Tanımsız işlem reddedilir' },
]
const guards = GUARDS.filter((g) => byId.has(g.id))

// Kasa kadranı çentikleri (dekoratif): 24 çentik, her 6'da bir uzun.
const ticks = Array.from({ length: 24 }, (_, i) => ({ a: i * 15, long: i % 6 === 0 }))
// İzole hücre ızgarası (mini illüstrasyon): 3 satır x 8 sütun, biri "sizin" hücreniz.
const cells = Array.from({ length: 24 }, (_, i) => ({ x: (i % 8) * 29 + 4, y: Math.floor(i / 8) * 29 + 6, own: i === 13 }))
---

<Section tone="stage" id="guvenlik" labelledby="guvenlik-baslik">
  <div class="sec">
    <div class="sec__intro">
      <SectionHeading
        id="guvenlik-baslik"
        tone="dark"
        eyebrow="Güvenlik ve KVKK"
        title="Anahtarlarınız ve verileriniz için kurumsal düzeyde güvenlik"
        accent="kurumsal düzeyde güvenlik"
        lead="Pazaryeri API anahtarlarınız şifreli bir kasada, operasyon verileriniz size ayrılmış veritabanında saklanır; ekibinizin her işlemi sunucuda yetki denetiminden geçer."
      />
      <ul class="sec__specs" aria-label="Öne çıkan güvenlik katmanları">
        {byId.has('secrets-encryption') && <li><Icon name="lock" size="sm" />AES-256-GCM şifreleme</li>}
        {byId.has('tenant-database') && <li><Icon name="database" size="sm" />Hesaba özel veritabanı</li>}
        {byId.has('role-based-access') && <li><Icon name="users" size="sm" />Rol tabanlı erişim</li>}
      </ul>
      {detailHref && <a class="sec__link" href={detailHref}>Güvenlik mimarisini inceleyin <Icon name="arrow" size="sm" /></a>}
    </div>

    <div class="guard" data-scene="request-guard" aria-hidden="true">
      <span class="guard__beam" data-part="beam"></span>
      <svg class="guard__art" viewBox="0 0 400 320" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="sec-shield-stroke" x1="0" y1="0" x2="1" y2="1">
            <stop class="stop-a" offset="0" />
            <stop class="stop-b" offset="1" />
          </linearGradient>
          <radialGradient id="sec-core-glow" cx="0.5" cy="0.5" r="0.5">
            <stop class="stop-glow" offset="0" />
            <stop class="stop-clear" offset="1" />
          </radialGradient>
        </defs>
        <circle class="art-glow" cx="200" cy="160" r="150" fill="url(#sec-core-glow)" />
        <g class="art-ring art-ring--outer">
          <circle cx="200" cy="160" r="138" />
          <circle class="art-node" cx="200" cy="22" r="4" />
          <circle class="art-node art-node--dim" cx="338" cy="160" r="3" />
          <circle class="art-node art-node--dim" cx="62" cy="160" r="3" />
        </g>
        <g class="art-ring art-ring--mid">
          <circle cx="200" cy="160" r="108" />
          <circle class="art-node" cx="124" cy="84" r="3.5" />
          <circle class="art-node art-node--dim" cx="276" cy="236" r="3" />
        </g>
        <path class="art-shield" d="M200 58 L270 86 V156 C270 206 240 242 200 262 C160 242 130 206 130 156 V86 Z" />
        <path class="art-shield-inner" d="M200 74 L256 96 V156 C256 196 232 226 200 244 C168 226 144 196 144 156 V96 Z" />
        <g class="art-dial">
          <circle cx="200" cy="160" r="38" />
          {ticks.map((t) => <line x1="200" y1={t.long ? 126 : 128} x2="200" y2="133" transform={`rotate(${t.a} 200 160)`} class:list={{ 'is-long': t.long }} />)}
        </g>
        <circle class="art-core" cx="200" cy="160" r="22" />
        <g class="art-lock">
          <path d="M192 158 V151 a8 8 0 0 1 16 0 V158" />
          <rect x="187" y="157" width="26" height="19" rx="4" />
          <circle cx="200" cy="165" r="2.4" />
          <line x1="200" y1="167" x2="200" y2="171" />
        </g>
      </svg>
      <ol class="guard__list">
        {
          guards.map((g) => (
            <li class="guard__step" data-part="guard-step">
              <span class="guard__icon"><Icon name={g.icon} size="sm" /></span>
              <span class="guard__text">
                <strong>{g.label}</strong>
                <span>{g.sub}</span>
              </span>
              <span class="guard__ok"><Icon name="check" size="sm" /></span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <ul class="sec__grid" data-scene="reveal" data-testid="security-grid">
    {
      pillars.map((p) => (
        <li class="pillar" data-part="security-item" data-id={p.key} data-reveal data-tilt>
          <div class:list={['pillar__ill', `pillar__ill--${p.key}`]} aria-hidden="true">
            {p.key === 'cells' && (
              <svg viewBox="0 0 240 96" aria-hidden="true" focusable="false">
                {cells.map((c) => (
                  <rect class:list={['ill-cell', { 'ill-cell--own': c.own }]} x={c.x} y={c.y} width="20" height="20" rx="5" />
                ))}
                <rect class="ill-own-glow" x={cells[13].x - 6} y={cells[13].y - 6} width="32" height="32" rx="9" />
                <path class="ill-own-lock" d={`M${cells[13].x + 7} ${cells[13].y + 10} v-2.5 a3 3 0 0 1 6 0 v2.5 M${cells[13].x + 5.5} ${cells[13].y + 10} h9 v6 h-9 z`} />
              </svg>
            )}
            {p.key === 'vault' && (
              <svg viewBox="0 0 240 96" aria-hidden="true" focusable="false">
                <rect class="ill-field" x="8" y="28" width="224" height="40" rx="12" />
                <rect class="ill-badge" x="16" y="36" width="24" height="24" rx="7" />
                <path class="ill-badge-lock" d="M24.5 47 v-3 a3.5 3.5 0 0 1 7 0 v3 M22.5 47 h11 v7 h-11 z" />
                {Array.from({ length: 12 }, (_, i) => (
                  <circle class="ill-dot" cx={56 + i * 14} cy="48" r="3.5" />
                ))}
                <g class="ill-scan">
                  <rect x="50" y="30" width="26" height="36" rx="8" />
                </g>
              </svg>
            )}
            {p.key === 'tiers' && (
              <svg viewBox="0 0 240 96" aria-hidden="true" focusable="false">
                <line class="ill-gate" x1="176" y1="6" x2="176" y2="90" />
                <g class="ill-tier">
                  <circle cx="16" cy="20" r="7" />
                  <rect x="30" y="15" width="84" height="10" rx="5" />
                </g>
                <g class="ill-tier">
                  <circle cx="16" cy="48" r="7" />
                  <rect x="30" y="43" width="124" height="10" rx="5" />
                </g>
                <g class="ill-tier ill-tier--top">
                  <circle cx="16" cy="76" r="7" />
                  <rect x="30" y="71" width="172" height="10" rx="5" />
                </g>
                <circle class="ill-pass" cx="220" cy="76" r="9" />
                <path class="ill-pass-mark" d="M215.5 76 l3 3 l6 -6" />
                <path class="ill-block-mark" d="M186 18 l6 6 m0 -6 l-6 6" />
              </svg>
            )}
            {p.key === 'circuit' && (
              <svg viewBox="0 0 240 96" aria-hidden="true" focusable="false">
                <line class="ill-wire" x1="20" y1="48" x2="220" y2="48" />
                <circle class="ill-end" cx="20" cy="48" r="8" />
                <circle class="ill-end" cx="220" cy="48" r="8" />
                <rect class="ill-breaker" x="104" y="32" width="32" height="32" rx="9" />
                <path class="ill-breaker-mark" d="M114 48 h12 M120 42 v12" />
                <circle class="ill-packet" cx="20" cy="48" r="4.5" />
              </svg>
            )}
          </div>
          <p class="pillar__eyebrow"><Icon name={p.icon} size="sm" />{p.eyebrow}</p>
          <h3 class="pillar__title">{p.title}</h3>
          <p class="pillar__lead">{p.lead}</p>
          <ul class="pillar__proof">
            {p.claims.map((c) => (
              <li data-claim={c.id}>
                <Icon name="check" size="sm" />
                <span>{c.title}</span>
              </li>
            ))}
          </ul>
          {p.claims.some((c) => c.status === 'partial') && partialNote && <p class="pillar__note">{partialNote}</p>}
        </li>
      ))
    }
  </ul>

  <p class="sec__stamp">
    <Icon name="info" size="sm" />
    <span>Burada anlatılan her koruma, ürünün yazılımında uygulanmış bir davranışa dayanır; ayrıntılar güvenlik sayfasında.</span>
  </p>
</Section>

<style>
  .sec {
    display: grid;
    gap: var(--ek-space-10);
    align-items: center;
  }
  .sec__intro {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-6);
  }
  .sec__specs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-2);
  }
  .sec__specs li {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    padding: var(--ek-space-1) var(--ek-space-3);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-full);
    background: var(--site-glass-bg);
    color: var(--site-color-on-primary);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
  }
  .sec__specs :global(.icon) {
    color: var(--ek-color-secondary);
  }
  .sec__link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--ek-space-2);
    min-height: var(--site-tap-target);
    color: var(--site-color-on-primary);
    font-weight: var(--ek-font-weight-semibold);
  }
  .sec__link:focus-visible {
    outline-color: var(--site-color-on-primary);
  }

  /* --- Kalkan / kasa illüstrasyonu --- */
  .guard {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-areas:
      'art art'
      'list list';
    gap: var(--ek-space-3);
    padding: var(--ek-space-5);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--site-radius-panel);
    background:
      var(--site-glow-secondary) no-repeat 50% 40% / 90% 80%,
      var(--site-glass-bg);
    backdrop-filter: blur(var(--site-glass-blur));
    box-shadow: var(--site-shadow-panel);
  }
  .guard__art {
    grid-area: art;
    display: block;
    width: 100%;
    max-width: 26rem;
    height: auto;
    margin-inline: auto;
    overflow: visible;
  }
  .stop-a {
    stop-color: var(--ek-color-secondary);
  }
  .stop-b {
    stop-color: color-mix(in srgb, var(--ek-color-info) 70%, var(--ek-color-background));
  }
  .stop-glow {
    stop-color: color-mix(in srgb, var(--ek-color-secondary) 38%, transparent);
  }
  .stop-clear {
    stop-color: transparent;
  }
  .art-ring,
  .art-dial {
    transform-box: view-box;
    transform-origin: 50% 50%;
  }
  .art-ring circle:first-child,
  .art-dial circle {
    fill: none;
    stroke: var(--site-glass-border);
    stroke-width: 1.5;
  }
  .art-ring--outer circle:first-child {
    stroke-dasharray: 2 10;
    stroke-linecap: round;
  }
  .art-ring--mid circle:first-child {
    stroke: color-mix(in srgb, var(--ek-color-secondary) 45%, transparent);
    stroke-dasharray: 60 18 6 18;
  }
  .art-node {
    fill: var(--ek-color-secondary);
  }
  .art-node--dim {
    fill: color-mix(in srgb, var(--ek-color-background) 60%, transparent);
  }
  .art-shield {
    fill: color-mix(in srgb, var(--ek-color-content-strong) 72%, var(--ek-color-primary));
    stroke: url(#sec-shield-stroke);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }
  .art-shield-inner {
    fill: color-mix(in srgb, var(--ek-color-background) 5%, transparent);
    stroke: color-mix(in srgb, var(--ek-color-background) 14%, transparent);
    stroke-width: 1;
  }
  .art-dial line {
    stroke: color-mix(in srgb, var(--ek-color-background) 38%, transparent);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .art-dial line.is-long {
    stroke: var(--ek-color-secondary);
    stroke-width: 2.5;
  }
  .art-core {
    fill: color-mix(in srgb, var(--ek-color-secondary) 22%, var(--ek-color-content-strong));
    stroke: color-mix(in srgb, var(--ek-color-secondary) 70%, transparent);
    stroke-width: 1.5;
  }
  .art-lock path,
  .art-lock rect,
  .art-lock line {
    fill: none;
    stroke: var(--site-color-on-primary);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .art-lock circle {
    fill: var(--site-color-on-primary);
  }
  .guard__list {
    grid-area: list;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--ek-space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .guard__step {
    display: flex;
    align-items: center;
    gap: var(--ek-space-3);
    min-width: 0;
    padding: var(--ek-space-3);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-lg);
    background: color-mix(in srgb, var(--ek-color-content-strong) 78%, var(--ek-color-primary));
  }
  .guard__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-8);
    height: var(--ek-space-8);
    border-radius: var(--ek-radius-md);
    background: color-mix(in srgb, var(--ek-color-secondary) 24%, transparent);
    color: var(--site-color-on-primary);
  }
  .guard__text {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    color: var(--site-color-on-primary-muted);
    font-size: var(--ek-font-size-xs);
    line-height: var(--ek-line-height-tight);
  }
  .guard__text strong {
    color: var(--site-color-on-primary);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-semibold);
  }
  .guard__ok {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-5);
    height: var(--ek-space-5);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-secondary);
    color: var(--ek-color-content-strong);
  }
  /* Tarama ışını: yalnızca oynatma durumunda hareket eder (scenes-loops.css); statik hâlde görünmez. */
  .guard__beam {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 1;
    height: 30%;
    background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--ek-color-secondary) 14%, transparent) 70%, color-mix(in srgb, var(--ek-color-secondary) 40%, transparent) 72%, transparent 74%);
    opacity: 0;
    pointer-events: none;
  }

  /* --- Sütun kartları --- */
  .sec__grid {
    display: grid;
    gap: var(--ek-space-5);
    margin-top: var(--ek-space-16);
    grid-template-columns: 1fr;
  }
  .pillar {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
    padding: var(--ek-space-6);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--site-radius-panel);
    background: var(--site-glass-bg);
    /* Cam his: yarı saydam zemin + üstte ince iç kenar ışığı (yalnızca token renkleri). */
    box-shadow: inset 0 var(--site-border-width) 0 color-mix(in srgb, var(--ek-color-background) 18%, transparent);
    /* `transform` (eğim) buraya da eklenir (bkz. PricingSummary.astro aynı not: kısayol birleşmez). */
    transition:
      border-color var(--ek-duration-base) var(--ek-easing-standard),
      background-color var(--ek-duration-base) var(--ek-easing-standard),
      box-shadow var(--ek-duration-base) var(--ek-easing-standard),
      translate var(--ek-duration-base) var(--ek-easing-standard),
      transform var(--tilt-transition-duration, var(--ek-duration-fast)) var(--ek-easing-standard);
  }
  .pillar:hover {
    translate: 0 calc(var(--ek-space-1) * -1);
    border-color: color-mix(in srgb, var(--ek-color-secondary) 60%, transparent);
    background: color-mix(in srgb, var(--ek-color-background) 10%, transparent);
  }
  .pillar__ill {
    overflow: hidden;
    margin-bottom: var(--ek-space-2);
    padding: var(--ek-space-3);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-lg);
    background: color-mix(in srgb, var(--ek-color-content-strong) 55%, transparent);
  }
