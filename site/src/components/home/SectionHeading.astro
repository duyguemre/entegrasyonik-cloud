---
/**
 * SectionHeading — bölüm başlığı bloğu (eyebrow + h2 + giriş metni). Koyu ("stage") zeminde `tone="dark"`.
 * Stage zeminde başlık/metin rengini `Section` verir; burada yalnızca eyebrow ve ritim vardır.
 * Sahne (S7): `data-scene="section-head"` — üç öğe görünür olunca sırayla yükselir (reduced-motion'da statik).
 */
interface Props {
  id: string
  eyebrow?: string
  title: string
  /** Başlık içinde vurgu rengiyle işaretlenecek birebir alt dize (varsa ve title içinde geçiyorsa uygulanır). */
  accent?: string
  lead?: string
  tone?: 'light' | 'dark'
  align?: 'start' | 'center'
}

import Eyebrow from '../Eyebrow.astro'

const { id, eyebrow, title, accent, lead, tone = 'light', align = 'start' } = Astro.props
const parts = accent && title.includes(accent) ? title.split(accent) : null
---

<header class:list={['sh', `sh--${tone}`, `sh--${align}`]} data-scene="section-head">
  {
    eyebrow && (
      <Eyebrow data-reveal>{eyebrow}</Eyebrow>
    )
  }
  <h2 id={id} class="sh__title" data-reveal>
    {parts ? (
      <>
        {parts[0]}
        <span class="sh__accent">{accent}</span>
        {parts[1]}
      </>
    ) : (
      title
    )}
  </h2>
  {lead && <p class="sh__lead" data-reveal>{lead}</p>}
</header>

<style>
  .sh {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-4);
    max-width: 48rem;
  }
  .sh--center {
    margin-inline: auto;
    align-items: center;
    text-align: center;
  }
  /* SITE-DL: vurgulu kelime düz renk (degrade metin yok) — açık zeminde eylem mavisi, koyu zeminde açık eşleniği. */
  .sh__accent {
    color: var(--site-action);
  }
  .sh--dark .sh__accent {
    color: var(--site-accent-on-dark);
  }
  .sh__title {
    font-size: var(--site-font-display-md);
    font-weight: var(--site-font-display-weight);
    line-height: var(--site-font-display-line-height);
    letter-spacing: var(--site-font-display-tracking);
    text-wrap: balance;
  }
  .sh__lead {
    color: var(--ek-color-content-default);
    font-size: var(--ek-font-size-xl);
    line-height: var(--ek-line-height-normal);
  }
  .sh--dark .sh__lead {
    color: var(--site-color-on-primary-muted);
  }
</style>
