---
/**
 * Yetenekler (ADR-0014 Karar 2, bölüm 4) — S12: pazarlama dili, sade kart hiyerarşisi.
 * İki katman (ELEV A10: koyu "dört değer sütunu" bandı kaldırıldı — aynı dört fikri hemen altındaki bento
 * karoları gösteriyordu): (1) beş animasyonlu bento karo, (2) "Günlük işleriniz için" kartları. Metinler kayıttaki `home` alanlarından gelir (capabilities.ts).
 * Ana sayfada kanal ADI, durum rozeti (Mevcut/Kısmi) ve kapsam notu YOK (S12 kullanıcı geri bildirimi);
 * kanal ayrımı yalnızca isimsiz renkli noktayla (`data-code` -> `--chan`). Kapsam farkları ve sınır notları
 * alt sayfalarda (/ozellikler, /entegrasyonlar) eksiksiz yazılıdır.
 * Beş "UI parçası" (hepsi HTML/CSS; aria-hidden — anlam çevredeki metindedir; giriş hareketi scenes.css):
 *   - `stock-single-winner`: son adet için eşzamanlı iki sipariş -> hatlar koyu "rezervasyon çekirdeğinde" birleşir
 *     (halka + kalan sayacı 1 -> 0) -> biri rezerve, diğeri aşırı satış olarak işaretlenir (S15-C: ışıklı döngü)
 *   - `orders-merge`: farklı kanallardan sipariş ve iade talepleri iki yönden gelip tek listede birleşir
 *   - `integration-status`: bağlı kanallar (tür etiketiyle) tek merkezde; ürün/stok/sipariş akış çubukları
 *   - `secret-encryption`: girilen anahtar -> kilit -> şifreli kasada -> ekranda maskeli (ELEV: teknik önek/algoritma adı görselde yok, K44)
 *   - `tenant-isolation`: her müşteri hesabı kendi veritabanına bağlanır
 * Görseller örnek arayüzdür (aria-hidden; S15-C: ayrı "Örnek görünüm" etiketi yok); uydurma müşteri/ölçüm YOK.
 */
import Section from '../Section.astro'
import SectionHeading from './SectionHeading.astro'
import Icon from './Icon.astro'
import { getPublicCapabilities, type PublicProductCapability } from '../../data/capabilities'
import { getPublicIntegrations, type CapabilityKey } from '../../data/integrations'

const all = getPublicCapabilities('core')
const security = getPublicCapabilities('security')
const byId = (list: PublicProductCapability[], id: string): PublicProductCapability => {
  const c = list.find((x) => x.id === id)
  if (!c) throw new Error(`Yetenek kaydı bulunamadı: ${id}`)
  return c
}
const homeOf = (c: PublicProductCapability) => c.home ?? { title: c.title, line: c.summary }

const stock = byId(all, 'stock-reservation')
const orders = byId(all, 'unified-orders')
const secrets = byId(security, 'secrets-encryption')
const tenant = byId(security, 'tenant-database')
const spotlightIds = new Set([stock.id, orders.id])
const rest = all.filter((c) => !spotlightIds.has(c.id))

const ICONS: Record<string, 'stock' | 'layers' | 'orders' | 'returns' | 'chat' | 'finance' | 'notice' | 'plug'> = {
  'stock-reservation': 'stock',
  'multi-channel-products': 'layers',
  'unified-orders': 'orders',
  returns: 'returns',
  questions: 'chat',
  finance: 'finance',
  'shipping-invoice-notice': 'notice',
  'erp-read': 'plug',
}

// "Günlük işleriniz için" kartlarında küçük, canlı illüstrasyon (S13-C). Yalnızca biçim/iskelet: metin, sayı veya
// kanal adı taşımaz; kanal noktaları kaydın `channels` listesinden (isimsiz renk).
type Art = 'sync' | 'returns' | 'chat' | 'finance' | 'ship' | 'erp'
const ARTS: Record<string, Art> = {
  'multi-channel-products': 'sync',
  returns: 'returns',
  questions: 'chat',
  finance: 'finance',
  'shipping-invoice-notice': 'ship',
  'erp-read': 'erp',
}
const FIN_BARS = [0.45, 0.7, 0.55, 0.85, 0.6, 1]

const integrations = getPublicIntegrations()
const marketplaceCodes = getPublicIntegrations('marketplace').map((i) => i.code)
const [codeA = '', codeB = ''] = marketplaceCodes
// Örnek liste: kanal renkleri sırayla tekrar eder (ad yok); durum sözcükleri yalnızca arayüz örneğidir.
const STATUSES = ['Yeni', 'Hazırlanıyor', 'İade talebi', 'Kargoda', 'Yeni']
const rows = STATUSES.map((status, i) => ({ status, code: marketplaceCodes[i % marketplaceCodes.length] ?? '' }))
const isAlert = (s: string) => s === 'İade talebi'
// "Bağlı kanallar" karosu: çubuk yalnızca kanalın kayıtta o veri türü için yeteneği varsa dolu (dürüstlük:
// örn. ERP bağlantısı stok yazmaz → stok çubuğu soluk). Seviye farkı ana sayfada gösterilmez (alt sayfada).
const FLOW_KEYS: CapabilityKey[] = ['products', 'stockPrice', 'orders']
---

<Section id="ozellikler" labelledby="yetenek-baslik">
  <SectionHeading
    id="yetenek-baslik"
    eyebrow="Yetenekler"
    title="Siparişten iadeye, işinizin tamamı"
    lead="Stoktan siparişe, iadeden hakedişe: ekibiniz her işi aynı ekrandan, aynı adımlarla yürütür."
  />

  <div class="bento" data-testid="bento">
    {/* A: stok rezervasyonu (geniş) */}
    <article class="tile tile--stock" aria-labelledby="spot-stock-title" data-tilt data-scene="tile">
      <div class="tile__copy" data-reveal>
        <span class="tile__icon"><Icon name="stock" size="md" /></span>
        <h3 id="spot-stock-title" class="tile__title">{homeOf(stock).title}</h3>
        <p class="tile__text">{homeOf(stock).line}</p>
      </div>
      <div class="tile__frame" data-reveal>
        <div class="stock" data-scene="stock-single-winner" aria-hidden="true">
          <div class="stock__head">
            <span class="stock__live"><Icon name="clock" size="sm" />Eşzamanlı</span>
            <p class="stock__caption">Son adet için iki kanaldan aynı anda sipariş</p>
          </div>
          <div class="stock__flow">
            <div class="stock__orders">
              <div class="stock__order" data-part="order-a" data-code={codeA}>
                <span class="stock__dot"></span>
                <span class="stock__status">Yeni sipariş</span>
                <span class="stock__line stock__line--short"></span>
              </div>
              <div class="stock__order" data-part="order-b" data-code={codeB}>
                <span class="stock__dot"></span>
                <span class="stock__status">Yeni sipariş</span>
                <span class="stock__line stock__line--short"></span>
              </div>
            </div>
            <div class="stock__rail stock__rail--in" data-part="arrow-a">
              <svg class="stock__wires stock__wires--h" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path d="M0 25 H50 C75 25 75 50 100 50"></path>
                <path d="M0 75 H50 C75 75 75 50 100 50"></path>
              </svg>
              <svg class="stock__wires stock__wires--v" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path d="M25 0 V35 C25 65 50 65 50 100"></path>
                <path d="M75 0 V35 C75 65 50 65 50 100"></path>
              </svg>
              <span class="stock__carrier stock__carrier--a" data-code={codeA}><i class="stock__pulse"></i></span>
              <span class="stock__carrier stock__carrier--b" data-code={codeB}><i class="stock__pulse"></i></span>
            </div>
            <div class="stock__engine" data-part="product">
              <span class="stock__flash"></span>
              <span class="stock__engine-head">
                <span class="stock__thumb"><Icon name="stock" size="sm" /></span>
                <span class="stock__engine-label">Son adet</span>
              </span>
              <span class="stock__gauge">
                <span class="stock__wave"></span>
                <svg class="stock__ring" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                  <circle class="stock__ring-track" cx="32" cy="32" r="28"></circle>
                  <circle class="stock__ring-arc stock__ring-arc--held" cx="32" cy="32" r="28"></circle>
                  <circle class="stock__ring-arc stock__ring-arc--free" cx="32" cy="32" r="28"></circle>
                </svg>
                <span class="stock__left-num">
                  <b class="stock__left-a" data-part="left-a">1</b>
                  <b class="stock__one">1</b>
                  <b class="stock__left-b" data-part="left-b"><span class="stock__zero">0</span></b>
                </span>
              </span>
              <span class="stock__left">Kalan</span>
              <span class="stock__lock"><Icon name="lock" size="sm" />Rezervasyon</span>
            </div>
            <div class="stock__rail stock__rail--out" data-part="arrow-b">
              <svg class="stock__wires stock__wires--h" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path class="stock__wire--ok" d="M0 50 C25 50 25 25 50 25 H100"></path>
                <path class="stock__wire--warn" d="M0 50 C25 50 25 75 50 75 H100"></path>
              </svg>
              <svg class="stock__wires stock__wires--v" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path class="stock__wire--ok" d="M50 0 C50 35 25 35 25 65 V100"></path>
                <path class="stock__wire--warn" d="M50 0 C50 35 75 35 75 65 V100"></path>
              </svg>
              <span class="stock__carrier stock__carrier--ok"><i class="stock__pulse"></i></span>
              <span class="stock__carrier stock__carrier--warn"><i class="stock__pulse"></i></span>
            </div>
            <div class="stock__results">
              <div class="stock__result stock__result--ok" data-part="result-ok">
                <span class="stock__badge"><Icon name="check" size="sm" /></span>
                <div>
                  <strong>Rezerve edildi</strong>
                  <span>İlk gelen sipariş</span>
                </div>
              </div>
              <div class="stock__result stock__result--warn" data-part="result-oversold">
                <span class="stock__badge"><Icon name="info" size="sm" /></span>
                <div>
                  <strong>Aşırı satış olarak işaretlendi</strong>
                  <span>Telafi akışına alındı</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </article>

    {/* B: birleşik siparişler ve iadeler */}
    <article class="tile tile--orders" aria-labelledby="spot-orders-title" data-tilt data-scene="tile">
      <div class="tile__copy" data-reveal>
        <span class="tile__icon"><Icon name="orders" size="md" /></span>
        <h3 id="spot-orders-title" class="tile__title">{homeOf(orders).title}</h3>
        <p class="tile__text">{homeOf(orders).line}</p>
      </div>
      <div class="tile__frame" data-reveal>
        <div class="win" data-scene="orders-merge" aria-hidden="true">
          <div class="win__bar">
            <span class="win__dots"><i></i><i></i><i></i></span>
            <span class="win__title">Siparişler ve iadeler</span>
            <span class="win__search"><Icon name="search" size="sm" /><i></i></span>
          </div>
          <ul class="win__filters">
            <li class="win__filter win__filter--active">Tümü</li>
            <li class="win__filter">Yeni</li>
            <li class="win__filter">İade</li>
          </ul>
          <div class="win__body">
          <span class="win__toast" data-code={codeB}>
            <span class="win__chan"></span>
            <strong>Yeni sipariş</strong>
            <i class="win__skel win__skel--b"></i>
          </span>
          <ul class="win__rows">
            {
              rows.map((r) => (
                <li class="win__row" data-part="order-row" data-code={r.code}>
                  <span class="win__chan"></span>
                  <span class="win__cells">
                    <span class="win__skel win__skel--a"></span>
                    <span class="win__skel win__skel--b"></span>
                  </span>
                  <span class:list={['win__pill', isAlert(r.status) && 'win__pill--alert']}>{r.status}</span>
                </li>
              ))
            }
          </ul>
          </div>
        </div>
      </div>
    </article>

    {/* C: kanallar tek merkezde */}
    <article class="tile tile--status" aria-labelledby="spot-status-title" data-tilt data-scene="tile">
      <div class="tile__copy" data-reveal>
        <span class="tile__icon"><Icon name="plug" size="md" /></span>
        <h3 id="spot-status-title" class="tile__title">Her kanal aynı merkezde</h3>
        <p class="tile__text">Pazaryerleri, e-ticaret altyapınız ve ERP sisteminiz tek panelde buluşur.</p>
      </div>
      <div class="tile__frame" data-reveal>
        <div class="istat" data-scene="integration-status" aria-hidden="true">
          <p class="istat__caption">
            <span>Bağlı kanallar</span>
            <span class="istat__cols"><i>Ürün</i><i>Stok</i><i>Sipariş</i></span>
          </p>
          <ul class="istat__rows">
            {
              integrations.map((i) => (
                <li class="istat__row" data-part="istat-row" data-code={i.code}>
                  <span class="istat__dot"></span>
                  <span class="istat__name">{i.kindLabel}</span>
                  <span class="istat__meter">
                    {FLOW_KEYS.map((k) => {
                      const on = i.capabilities.some((c) => c.key === k)
                      return <i class:list={['istat__seg', on && 'is-on']} data-part={on ? 'seg' : undefined}></i>
                    })}
                  </span>
                </li>
              ))
            }
          </ul>
          <p class="istat__hub"><span class="istat__hub-icon"><Icon name="plug" size="sm" /></span>Tek panel</p>
        </div>
      </div>
    </article>

    {/* D: şifreli anahtarlar */}
    <article class="tile tile--vault" aria-labelledby="spot-vault-title" data-tilt data-scene="tile">
      <div class="tile__copy" data-reveal>
        <span class="tile__icon"><Icon name="lock" size="md" /></span>
        <h3 id="spot-vault-title" class="tile__title">{secrets.title}</h3>
        <p class="tile__text">{secrets.summary}</p>
      </div>
      <div class="tile__frame" data-reveal>
        <div class="vault" data-scene="secret-encryption" aria-hidden="true">
          <div class="vault__row">
            <span class="vault__label">Girdiğiniz anahtar</span>
            <span class="vault__field" data-part="plain"><Icon name="key" size="sm" />••••••••••••••••</span>
          </div>
          <div class="vault__step" data-part="lock">
            <Icon name="lock" size="md" />
            <span class="vault__algo" data-part="algorithm">Şifrelenir</span>
          </div>
          <div class="vault__row">
            <span class="vault__label">Kasada</span>
            <span class="vault__field vault__field--cipher" data-part="cipher">
              <span class="vault__bars"><i data-part="bar"></i><i data-part="bar"></i><i data-part="bar"></i><i data-part="bar"></i></span>
            </span>
          </div>
          <div class="vault__row">
            <span class="vault__label">Ekranlarınızda</span>
            <span class="vault__field" data-part="masked"><Icon name="eye" size="sm" />••••••••<em class="vault__hidden">gizli</em></span>
          </div>
          <span class="vault__rail"><i class="vault__spark"></i></span>
        </div>
      </div>
    </article>

    {/* E: çoklu kiracı */}
    <article class="tile tile--tenant" aria-labelledby="spot-tenant-title" data-tilt data-scene="tile">
      <div class="tile__copy" data-reveal>
        <span class="tile__icon"><Icon name="database" size="md" /></span>
        <h3 id="spot-tenant-title" class="tile__title">{tenant.title}</h3>
        <p class="tile__text">{tenant.summary}</p>
      </div>
      <div class="tile__frame" data-reveal>
        <div class="tenant" data-scene="tenant-isolation" aria-hidden="true">
          <div class="tenant__cols">
            {
              [1, 2, 3].map((n) => (
                <div class="tenant__col" data-part="tenant-col">
                  {n > 1 && <span class="tenant__wall"><Icon name="shield" size="sm" /></span>}
                  <span class="tenant__acct" data-part="tenant-acct"><Icon name="users" size="md" /><span>İşletme</span></span>
                  <span class="tenant__link" data-part="tenant-link"></span>
                  <span class="tenant__db" data-part="tenant-db"><Icon name="database" size="md" /><span>İzole alan</span><span class="tenant__rows"><i></i><i></i><i></i></span></span>
                </div>
              ))
            }
          </div>
          <p class="tenant__platform" data-part="tenant-platform"><Icon name="shield" size="sm" />Her işletmenin verisi yalnızca kendisine ait</p>
        </div>
      </div>
    </article>
  </div>

  <div class="more">
    <h3 class="more__title" data-testid="more-title">Günlük işleriniz için</h3>
    <p class="more__lead">Operasyonel verimliliği artıran araçlar, aynı panelde.</p>
  </div>

  <ul class="caps" data-scene="reveal" data-testid="capability-grid">
    {
      rest.map((c) => {
        const art = ARTS[c.id]
        const chans = c.channels.slice(0, 5)
        return (
          <li class="cap" data-part="capability" data-id={c.id} data-reveal data-tilt>
            <div class="cap__head">
              <span class="cap__icon"><Icon name={ICONS[c.id] ?? 'layers'} size="md" /></span>
              {chans.length > 0 && (
                <span class="cap__dots" aria-hidden="true">
                  {chans.map((ch) => (
                    <i data-code={ch.code} />
                  ))}
                </span>
              )}
            </div>
            <h4 class="cap__title">{homeOf(c).title}</h4>
            <p class="cap__text">{homeOf(c).line}</p>
            {art && (
              <div class={`art art--${art}`} aria-hidden="true">
                {art === 'sync' && (
                  <>
                    <span class="art__hub"><Icon name="layers" size="sm" /></span>
                    <span class="art__fan">
                      <i class="art__wire" />
                      {chans.map((ch) => (
                        <span class="art__spoke" data-code={ch.code}>
                          <i class="art__node" />
                        </span>
                      ))}
                    </span>
                  </>
                )}
                {art === 'returns' && (
                  <span class="art__steps">
                    <span class="art__track"><i class="art__progress" /></span>
                    <i class="art__step" />
                    <i class="art__step" />
                    <i class="art__step art__step--end" />
                  </span>
                )}
                {art === 'chat' && (
                  <span class="art__thread">
                    <span class="art__bubble art__bubble--in" data-code={chans[0]?.code}>
                      <i class="art__dot" />
                      <span class="art__lines"><i class="art__skel" /><i class="art__skel art__skel--short" /></span>
                    </span>
                    <span class="art__bubble art__bubble--out">
                      <i class="art__typing" />
                      <i class="art__typing" />
                      <i class="art__typing" />
                    </span>
                  </span>
                )}
                {art === 'finance' && (
                  <span class="art__bars">
                    {FIN_BARS.map((_h, k) => (
                      <i class="art__bar" data-k={k} />
                    ))}
                  </span>
                )}
                {art === 'ship' && (
                  <span class="art__road">
                    <span class="art__end"><Icon name="receipt" size="sm" /></span>
                    <span class="art__lane-wrap">
                      <span class="art__lane"><span class="art__parcel"><Icon name="notice" size="sm" /></span></span>
                    </span>
                    <span class="art__end art__end--to" data-code={chans[0]?.code}><i class="art__dot" /></span>
                  </span>
                )}
                {art === 'erp' && (
                  <span class="art__road">
                    <span class="art__box"><Icon name="database" size="sm" /></span>
                    <span class="art__lane-wrap art__lane-wrap--solid">
                      <span class="art__lane"><span class="art__packet" /></span>
                    </span>
                    <span class="art__box art__box--panel"><Icon name="eye" size="sm" /></span>
                  </span>
                )}
              </div>
            )}
          </li>
        )
      })
    }
  </ul>
</Section>

<style>
  /*
   * Renk hiyerarşisi (S12): tek başlık tonu (content-strong) + tek gövde tonu (content-default). Üçüncü bir ton
   * yok; vurgu yalnızca ikon rozetinde ve isimsiz kanal noktalarında. Tipografi `--site-card-*` token setinden.
   */

  /* --- Bento ızgarası --- */
  .bento {
    /* Yerel yardımcılar: süzülen iç kart gölgesi ve vitrin "kuyusu" zemini (yalnızca token türevleri). */
    --float-shadow:
      0 var(--site-border-width) calc(var(--site-border-width) * 2) color-mix(in srgb, var(--ek-color-content-strong) 6%, transparent),
      0 var(--ek-space-2) var(--ek-space-5) calc(var(--ek-space-2) * -1) color-mix(in srgb, var(--ek-color-primary-darken-1) 22%, transparent);
    --window-shadow:
      0 0 0 var(--site-border-width) color-mix(in srgb, var(--ek-color-content-strong) 4%, transparent),
      0 var(--ek-space-3) var(--ek-space-6) calc(var(--ek-space-3) * -1) color-mix(in srgb, var(--ek-color-content-strong) 12%, transparent),
      0 var(--ek-space-8) var(--ek-space-12) calc(var(--ek-space-6) * -1) color-mix(in srgb, var(--ek-color-primary-darken-1) 26%, transparent);
    --well-bg:
      radial-gradient(80% 70% at 50% 0%, color-mix(in srgb, var(--ek-color-secondary) 10%, transparent), transparent 70%),
      var(--site-texture-dots),
      linear-gradient(180deg, var(--ek-color-surface-sunken), color-mix(in srgb, var(--ek-color-surface-sunken) 60%, var(--ek-color-surface)));
    --well-size: auto, var(--site-texture-dots-size), auto;
    display: grid;
    gap: var(--ek-space-5);
    margin-top: var(--ek-space-8);
    grid-template-columns: minmax(0, 1fr);
  }
  /*
   * S13-C — premium karo yüzeyi (kullanıcı: "beyaz arka planlı kartlara çok daha fazla çalış"): üç katman
   * (1) köşeden sızan çok hafif vurgu ışıması + yukarıdan aşağı yüzey degradesi, (2) ince degrade kenar
   * (padding-box/border-box; üstte aydınlık, altta vurguya dönen), (3) üst iç kenarda tek piksellik ışık + derin,
   * yumuşak, çok katmanlı gölge. Sağ üstte solan nokta dokusu (::after) yüzeye derinlik verir; içerik altında kalır.
   */
  .tile {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-8);
    min-width: 0;
    padding: var(--ek-space-6);
    border: var(--site-border-width) solid transparent;
    border-radius: calc(var(--site-radius-panel) + var(--ek-space-1));
    background:
      radial-gradient(70% 55% at 0% 0%, color-mix(in srgb, var(--ek-color-secondary) 7%, transparent), transparent 70%) padding-box,
      linear-gradient(180deg, var(--ek-color-surface) 0%, var(--ek-color-surface-muted) 100%) padding-box,
      linear-gradient(
          165deg,
          color-mix(in srgb, var(--ek-color-border-default) 70%, var(--ek-color-surface)) 0%,
          var(--ek-color-border-default) 45%,
          color-mix(in srgb, var(--ek-color-secondary) 30%, var(--ek-color-border-default)) 100%
        )
        border-box;
    box-shadow:
      inset 0 var(--site-border-width) 0 var(--ek-color-surface),
      0 var(--site-border-width) calc(var(--site-border-width) * 2) color-mix(in srgb, var(--ek-color-content-strong) 5%, transparent),
      0 var(--ek-space-3) var(--ek-space-6) calc(var(--ek-space-3) * -1) color-mix(in srgb, var(--ek-color-content-strong) 9%, transparent),
      0 var(--ek-space-10) var(--ek-space-16) calc(var(--ek-space-8) * -1) color-mix(in srgb, var(--ek-color-primary-darken-1) 20%, transparent);
    /* `transform` (eğim) buraya da eklenir (bkz. PricingSummary.astro aynı not: kısayol birleşmez). */
    transition:
      box-shadow var(--ek-duration-base) var(--ek-easing-standard),
      background var(--ek-duration-base) var(--ek-easing-standard),
      transform var(--tilt-transition-duration, var(--ek-duration-fast)) var(--ek-easing-standard);
  }
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background-image: var(--site-texture-dots);
    background-size: var(--site-texture-dots-size);
    -webkit-mask-image: radial-gradient(60% 55% at 100% 0%, var(--ek-color-content-strong), transparent 75%);
    mask-image: radial-gradient(60% 55% at 100% 0%, var(--ek-color-content-strong), transparent 75%);
    opacity: 0.55;
    pointer-events: none;
  }
  .tile:hover {
    background:
      radial-gradient(70% 55% at 0% 0%, color-mix(in srgb, var(--ek-color-secondary) 10%, transparent), transparent 70%) padding-box,
      linear-gradient(180deg, var(--ek-color-surface) 0%, var(--ek-color-surface-muted) 100%) padding-box,
      var(--site-gradient-border) border-box;
    box-shadow:
      inset 0 var(--site-border-width) 0 var(--ek-color-surface),
      0 var(--site-border-width) calc(var(--site-border-width) * 2) color-mix(in srgb, var(--ek-color-content-strong) 6%, transparent),
      0 var(--ek-space-4) var(--ek-space-8) calc(var(--ek-space-4) * -1) color-mix(in srgb, var(--ek-color-content-strong) 12%, transparent),
      0 var(--ek-space-12) calc(var(--ek-space-16) * 1.5) calc(var(--ek-space-10) * -1) color-mix(in srgb, var(--ek-color-secondary-darken-1) 30%, transparent);
  }
  .tile__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ek-space-3);
    max-width: 34rem;
  }
  /*
   * İkon rozeti (karo + günlük iş kartları): derin marka degradesi, üst iç kenar ışığı, vurgu tonunda iç halka
   * ve yumuşak renkli ışıma. Hover'da rozet hafifçe yükselir, içindeki çizgi ikon küçük bir açıyla döner.
   */
  .tile__icon,
  .cap__icon {
    position: relative;
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-12);
    height: var(--ek-space-12);
    margin-bottom: var(--ek-space-2);
    border-radius: calc(var(--ek-radius-xl) + var(--site-border-width) * 2);
    background:
      radial-gradient(120% 90% at 30% 0%, color-mix(in srgb, var(--ek-color-secondary) 55%, transparent), transparent 60%),
      linear-gradient(150deg, var(--ek-color-primary) 0%, var(--ek-color-primary-darken-1) 100%);
    color: var(--site-color-on-primary);
    box-shadow:
      inset 0 var(--site-border-width) 0 color-mix(in srgb, var(--ek-color-background) 35%, transparent),
      inset 0 0 0 var(--site-border-width) color-mix(in srgb, var(--ek-color-secondary) 35%, transparent),
      0 var(--ek-space-2) var(--ek-space-4) calc(var(--ek-space-1) * -1) color-mix(in srgb, var(--ek-color-primary-darken-1) 45%, transparent),
      0 var(--ek-space-3) var(--ek-space-8) calc(var(--ek-space-3) * -1) color-mix(in srgb, var(--ek-color-secondary) 55%, transparent);
    transition: translate var(--ek-duration-base) var(--ek-easing-standard);
  }
  .tile__icon :global(svg),
  .cap__icon :global(svg) {
    transition: rotate var(--ek-duration-base) var(--ek-easing-standard), scale var(--ek-duration-base) var(--ek-easing-standard);
  }
  .tile:hover .tile__icon,
  .cap:hover .cap__icon,
  .cap:focus-within .cap__icon {
    translate: 0 calc(var(--ek-space-1) * -0.5);
  }
  .tile:hover .tile__icon :global(svg),
  .cap:hover .cap__icon :global(svg),
  .cap:focus-within .cap__icon :global(svg) {
    rotate: -8deg;
    scale: 1.1;
  }
  .tile__title {
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-2xl);
    font-weight: var(--site-font-display-weight);
    line-height: var(--ek-line-height-tight);
    letter-spacing: -0.022em;
    text-wrap: balance;
  }
  .tile__text {
    color: var(--ek-color-content-default);
    font-size: var(--site-card-desc-size);
    font-weight: var(--site-card-desc-weight);
    line-height: var(--ek-line-height-normal);
    text-wrap: pretty;
  }
  /* Mini arayüz bir "ürün vitrini" gibi karonun üzerinde süzülür; hover'da hafifçe yükselir (yalnızca translate). */
  .tile__frame {
    min-width: 0;
    margin-top: auto;
  }
  .tile__frame > * {
    transition:
      translate var(--ek-duration-slow) var(--ek-easing-standard),
      box-shadow var(--ek-duration-base) var(--ek-easing-standard);
  }
  .tile:hover .tile__frame > * {
    translate: 0 calc(var(--ek-space-1) * -1);
  }

  /* Ortak isimsiz kanal noktası (renk: [data-code] -> --chan, global.css). */
  .stock__dot,
  .win__chan,
  .istat__dot {
    position: relative;
    display: inline-block;
    flex: none;
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--chan, var(--ek-color-secondary));
    box-shadow: 0 0 0 calc(var(--site-border-width) * 3) color-mix(in srgb, var(--chan, var(--ek-color-secondary)) 18%, transparent);
  }

  /*
   * --- A: stok rezervasyonu görseli (S15-C) ---
   * Anlatı soldan sağa: eşzamanlı iki sipariş -> hatlar tek "rezervasyon çekirdeğinde" birleşir (koyu, ışıklı kart:
   * son adedin halkası + kalan sayacı) -> iki çıkış: biri rezerve (başarı rengi), diğeri aşırı satış olarak
   * işaretlenir (uyarı rengi). Masaüstünde yatay hatlar (SVG, en-boy serbest), <640px'te aynı hatlar dikey.
   * Statik hâl (hareket kapalı / reduced / JS'siz) = hikâyenin sonu: kalan 0, halka "rezerve" renginde, iki sonuç.
   */
  .stock,
  .tenant {
    padding: var(--ek-space-5);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-xl);
    background: var(--well-bg);
    background-size: var(--well-size);
    box-shadow: inset 0 var(--site-border-width) var(--ek-space-2) color-mix(in srgb, var(--ek-color-content-strong) 5%, transparent);
  }
  .stock__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ek-space-2) var(--ek-space-3);
    margin-bottom: var(--ek-space-5);
  }
  .stock__live {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-1);
    padding: calc(var(--ek-space-1) * 0.5) var(--ek-space-2);
    border: var(--site-border-width) solid color-mix(in srgb, var(--ek-color-secondary) 40%, var(--ek-color-border-default));
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface);
    color: var(--ek-color-secondary-darken-1);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-bold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .stock__caption {
    color: var(--ek-color-content-default);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
  }
  .stock__flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
  }
  .stock__orders,
  .stock__results {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--ek-space-3);
  }
  .stock__order,
  .stock__result {
    position: relative;
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-lg);
    background: var(--ek-color-surface);
    box-shadow: var(--float-shadow);
  }
  /* Vurgu halkası (döngüde siparişin geldiği / sonucun yazıldığı an yanar; statik: görünmez). */
  .stock__order::after,
  .stock__result::after {
    content: '';
    position: absolute;
    inset: calc(var(--site-border-width) * -1);
    border: calc(var(--site-border-width) * 2) solid var(--glow-c, var(--chan, var(--ek-color-secondary)));
    border-radius: inherit;
    box-shadow: 0 0 var(--ek-space-5) calc(var(--ek-space-1) * -1) var(--glow-c, var(--chan, var(--ek-color-secondary)));
    opacity: 0;
    pointer-events: none;
  }
  .stock__order {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: center;
    align-items: center;
    gap: var(--ek-space-2) var(--ek-space-3);
    padding: var(--ek-space-3);
  }
  .stock__order .stock__line {
    grid-column: 2;
  }
  .stock__status {
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
  }
  .stock__line {
    display: block;
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface-sunken);
  }
  .stock__line--short {
    width: 70%;
  }

  /* Hatlar: SVG yalnızca çizgi; üzerindeki ışık noktası (`carrier` hattı kaplar, `translate` yüzdesi = hat boyutu). */
  .stock__rail {
    position: relative;
    min-height: var(--ek-space-12);
  }
  .stock__wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: color-mix(in srgb, var(--ek-color-secondary) 50%, var(--ek-color-border-strong));
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .stock__wires path {
    vector-effect: non-scaling-stroke;
  }
  .stock__wires .stock__wire--ok {
    stroke: color-mix(in srgb, var(--ek-color-success) 70%, var(--ek-color-border-strong));
  }
  .stock__wires .stock__wire--warn {
    stroke: color-mix(in srgb, var(--ek-color-warning) 75%, var(--ek-color-border-strong));
  }
  .stock__wires--h {
    display: none;
  }
  .stock__carrier {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Dar ekran (dikey hat): başlangıç noktası ve iki ara konum. */
    --x0: 50%;
    --y0: 0%;
  }
  .stock__carrier--a {
    --x0: 25%;
    --m1: 0 35%;
    --m2: 25% 100%;
  }
  .stock__carrier--b {
    --x0: 75%;
    --m1: 0 35%;
    --m2: -25% 100%;
  }
  .stock__carrier--ok {
    --m1: -25% 65%;
    --m2: -25% 100%;
    --chan: var(--ek-color-success);
  }
  .stock__carrier--warn {
    --m1: 25% 65%;
    --m2: 25% 100%;
    --chan: var(--ek-color-warning);
  }
  .stock__pulse {
    --size: calc(var(--ek-space-2) * 1.25);
    position: absolute;
    inset-inline-start: var(--x0);
    inset-block-start: var(--y0);
    width: var(--size);
    height: var(--size);
    margin: calc(var(--size) / -2) 0 0 calc(var(--size) / -2);
    border: calc(var(--site-border-width) * 2) solid var(--ek-color-surface);
    border-radius: var(--ek-radius-full);
    background: var(--chan, var(--ek-color-secondary));
    box-shadow:
      0 0 0 var(--ek-space-1) color-mix(in srgb, var(--chan, var(--ek-color-secondary)) 22%, transparent),
      0 0 var(--ek-space-4) var(--ek-space-1) color-mix(in srgb, var(--chan, var(--ek-color-secondary)) 45%, transparent);
    opacity: 0;
  }

  /* Rezervasyon çekirdeği: koyu, ışıklı kart (sitenin sahne dili). */
  .stock__engine {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: auto auto;
    justify-content: center;
    align-items: center;
    gap: var(--ek-space-2) var(--ek-space-5);
    padding: var(--ek-space-4) var(--ek-space-5);
    border: var(--site-border-width) solid color-mix(in srgb, var(--ek-color-secondary) 45%, transparent);
    border-radius: var(--ek-radius-xl);
    background: var(--site-stage-mesh);
    box-shadow:
      inset 0 var(--site-border-width) 0 color-mix(in srgb, var(--ek-color-background) 16%, transparent),
      0 0 0 var(--ek-space-1) color-mix(in srgb, var(--ek-color-secondary) 12%, transparent),
      0 var(--ek-space-5) var(--ek-space-10) calc(var(--ek-space-4) * -1) color-mix(in srgb, var(--ek-color-secondary) 45%, transparent),
      var(--window-shadow);
    color: var(--site-color-on-primary);
  }
  .stock__engine::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(circle at 50% 38%, color-mix(in srgb, var(--ek-color-secondary) 26%, transparent), transparent 62%);
    pointer-events: none;
  }
  .stock__flash {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(circle at 50% 42%, color-mix(in srgb, var(--ek-color-secondary) 55%, transparent), transparent 65%);
    opacity: 0;
    pointer-events: none;
  }
  .stock__engine-head {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
  }
  .stock__thumb {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-6);
    height: var(--ek-space-6);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-md);
    background: var(--site-glass-bg);
    color: var(--ek-color-secondary);
  }
  .stock__engine-label,
  .stock__left {
    color: var(--site-color-on-primary-muted);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .stock__gauge {
    position: relative;
    grid-row: 1 / span 3;
    display: grid;
    place-items: center;
    width: calc(var(--ek-space-16) + var(--ek-space-4));
    aspect-ratio: 1;
  }
  .stock__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
  }
  .stock__ring-track {
    stroke: var(--site-glass-border);
    stroke-width: 4;
  }
  .stock__ring-arc {
    stroke-width: 4;
    stroke-linecap: round;
  }
  .stock__ring-arc--held {
    stroke: var(--ek-color-success);
    filter: drop-shadow(0 0 var(--ek-space-1) color-mix(in srgb, var(--ek-color-success) 70%, transparent));
  }
  .stock__ring-arc--free {
    stroke: var(--ek-color-secondary);
    filter: drop-shadow(0 0 var(--ek-space-1) color-mix(in srgb, var(--ek-color-secondary) 80%, transparent));
    opacity: 0;
  }
  .stock__wave {
    position: absolute;
    inset: 0;
    border: calc(var(--site-border-width) * 2) solid var(--ek-color-secondary);
    border-radius: var(--ek-radius-full);
    opacity: 0;
  }
  .stock__left-num {
    position: relative;
    display: inline-grid;
    color: var(--site-color-on-primary);
    font-size: var(--ek-font-size-3xl);
    font-weight: var(--site-font-display-weight);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stock__left-num > * {
    grid-area: 1 / 1;
    text-align: center;
  }
  .stock__zero {
    display: block;
  }
  .stock__left-a,
  .stock__one {
    opacity: 0;
  }
  .stock__lock {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: var(--ek-space-1);
    padding: calc(var(--ek-space-1) * 0.5) var(--ek-space-2);
    border: var(--site-border-width) solid color-mix(in srgb, var(--ek-color-success) 55%, transparent);
    border-radius: var(--ek-radius-full);
    background: color-mix(in srgb, var(--ek-color-success) 18%, transparent);
    color: var(--site-color-on-primary);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
  }

  .stock__result {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ek-space-2);
    padding: var(--ek-space-3);
    font-size: var(--ek-font-size-sm);
  }
  .stock__result--ok {
    --glow-c: var(--ek-color-success);
    border-color: color-mix(in srgb, var(--ek-color-success) 70%, var(--ek-color-border-default));
    background: linear-gradient(180deg, var(--ek-color-success-subtle), color-mix(in srgb, var(--ek-color-success-subtle) 40%, var(--ek-color-surface)));
  }
  .stock__result--warn {
    --glow-c: var(--ek-color-warning);
    border-color: color-mix(in srgb, var(--ek-color-warning) 75%, var(--ek-color-border-default));
    background: linear-gradient(180deg, var(--ek-color-warning-subtle), color-mix(in srgb, var(--ek-color-warning-subtle) 40%, var(--ek-color-surface)));
  }
  .stock__badge {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-6);
    height: var(--ek-space-6);
    border-radius: var(--ek-radius-full);
    background: var(--glow-c);
    color: var(--site-color-on-primary);
    box-shadow: 0 0 0 var(--ek-space-1) color-mix(in srgb, var(--glow-c) 18%, transparent);
  }
  .stock__result--warn .stock__badge {
    color: var(--ek-color-content-strong);
  }
  .stock__result div {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
  }
  .stock__result strong {
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-sm);
    line-height: var(--ek-line-height-tight);
  }
  .stock__result span {
    color: var(--ek-color-content-default);
  }

  /* --- B: sipariş/iade penceresi --- */
  .win,
  .istat {
    overflow: hidden;
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-xl);
    background: var(--ek-color-surface);
    box-shadow: var(--window-shadow);
  }
  .tile:hover .tile__frame > :is(.win, .istat) {
    box-shadow:
      var(--window-shadow),
      0 var(--ek-space-10) var(--ek-space-16) calc(var(--ek-space-8) * -1) color-mix(in srgb, var(--ek-color-secondary) 28%, transparent);
  }
  .win__bar {
    display: flex;
    align-items: center;
    gap: var(--ek-space-3);
    padding: var(--ek-space-2) var(--ek-space-3);
    border-bottom: var(--site-border-width) solid var(--ek-color-border-default);
    background: linear-gradient(180deg, var(--ek-color-surface), var(--ek-color-surface-muted));
  }
  .win__dots {
    display: inline-flex;
    gap: var(--ek-space-1);
  }
  .win__dots i {
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-border-strong);
  }
  .win__title {
    flex: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
  }
  /* Arama alanı iskeleti (pencereyi gerçek bir listeye benzetir; metin/sayı yok). */
  .win__search {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    width: 30%;
    min-width: var(--ek-space-16);
    padding: calc(var(--ek-space-1) * 0.75) var(--ek-space-2);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface);
    color: var(--ek-color-content-muted);
  }
  .win__search i {
    display: block;
    flex: 1;
    height: var(--ek-space-1);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface-sunken);
  }
  .win__body {
    position: relative;
  }
  /* Gelen sipariş bildirimi: döngüde listenin üstüne süzülür, birleşir ve söner (statik: görünmez). */
  .win__toast {
    position: absolute;
    inset-block-start: calc((var(--ek-space-10) + var(--ek-space-1)) * -1);
    inset-inline-end: var(--ek-space-3);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    width: 46%;
    padding: var(--ek-space-2) var(--ek-space-3);
    border: var(--site-border-width) solid color-mix(in srgb, var(--chan, var(--ek-color-secondary)) 45%, var(--ek-color-border-default));
    border-radius: var(--ek-radius-lg);
    background: var(--ek-color-surface);
    box-shadow:
      0 var(--ek-space-2) var(--ek-space-6) calc(var(--ek-space-2) * -1) color-mix(in srgb, var(--ek-color-content-strong) 28%, transparent),
      0 0 0 var(--ek-space-1) color-mix(in srgb, var(--chan, var(--ek-color-secondary)) 12%, transparent);
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-xs);
    opacity: 0;
    pointer-events: none;
  }
  .win__toast strong {
    flex: none;
    font-weight: var(--ek-font-weight-semibold);
  }
  .win__toast .win__skel {
    flex: 1;
  }
  .win__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-2);
    padding: var(--ek-space-3);
  }
  .win__filter {
    padding: var(--ek-space-1) var(--ek-space-3);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface-sunken);
    color: var(--ek-color-content-default);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
  }
  .win__filter--active {
    background: var(--ek-color-primary);
    color: var(--site-color-on-primary);
  }
  .win__rows {
    position: relative;
  }
  .win__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--ek-space-3);
    padding: var(--ek-space-3);
    border-top: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .win__cells {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
  }
  .win__skel {
    display: block;
    height: var(--ek-space-1);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface-sunken);
  }
  .win__skel--a {
    width: 72%;
    background: color-mix(in srgb, var(--ek-color-content-muted) 22%, var(--ek-color-surface-sunken));
  }
  .win__skel--b {
    width: 44%;
  }
  .win__pill {
    padding: var(--ek-space-1) var(--ek-space-3);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-info-subtle);
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    white-space: nowrap;
  }
  .win__pill--alert {
    background: var(--ek-color-warning-subtle);
  }

  /* --- C: kanallar tek merkezde --- */
  .istat {
    padding: var(--ek-space-4) var(--ek-space-5);
  }
  .istat__caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ek-space-3);
    margin-bottom: var(--ek-space-2);
    color: var(--ek-color-content-muted);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .istat__cols {
    display: inline-flex;
    gap: var(--ek-space-1);
  }
  .istat__cols i,
  .istat__seg {
    width: var(--ek-space-12);
  }
  .istat__cols i {
    font-style: normal;
    letter-spacing: 0.02em;
    text-align: center;
    text-transform: none;
  }
  /* Kanal noktaları dikey bir "veri hattı" üzerindeki duraklardır; hat alttaki tek panele iner. */
  .istat__rows {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .istat__rows::before {
    content: '';
    position: absolute;
    inset-block: calc(var(--ek-space-3) + var(--ek-space-1)) calc(var(--ek-space-4) * -1);
    inset-inline-start: calc(var(--ek-space-1) - var(--site-border-width));
    width: calc(var(--site-border-width) * 2);
    border-radius: var(--ek-radius-full);
    background: linear-gradient(180deg, color-mix(in srgb, var(--ek-color-secondary) 20%, var(--ek-color-border-default)), var(--ek-color-secondary));
  }
  /* Hat boyunca aşağı akan ışık (statik: görünmez). Sözde öğe hattın boyundadır; translate yüzdesi = hat boyu. */
  .istat__rows::after {
    content: '';
    position: absolute;
    inset-block: 0 calc(var(--ek-space-4) * -1);
    inset-inline-start: calc(var(--ek-space-1) - var(--ek-space-2) * 0.625);
    width: calc(var(--ek-space-2) * 1.25);
    background: radial-gradient(circle at 50% var(--ek-space-2), var(--ek-color-secondary) 0 calc(var(--ek-space-1) * 0.8), color-mix(in srgb, var(--ek-color-secondary) 30%, transparent) calc(var(--ek-space-1) * 1.2), transparent var(--ek-space-3)) no-repeat;
    opacity: 0;
    pointer-events: none;
  }
  .istat__hub {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    margin-top: var(--ek-space-4);
    margin-inline-start: calc(var(--ek-space-3) * -1);
    padding: var(--ek-space-1) var(--ek-space-3) var(--ek-space-1) var(--ek-space-1);
    border-radius: var(--ek-radius-full);
    background: var(--site-stage-mesh);
    box-shadow:
      0 0 0 var(--ek-space-1) color-mix(in srgb, var(--ek-color-secondary) 14%, transparent),
      0 var(--ek-space-2) var(--ek-space-5) calc(var(--ek-space-2) * -1) color-mix(in srgb, var(--ek-color-primary-darken-1) 50%, transparent);
    color: var(--site-color-on-primary);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.04em;
  }
  .istat__hub-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-6);
    height: var(--ek-space-6);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-secondary);
    color: var(--ek-color-content-strong);
  }
  .istat__hub::after {
    content: '';
    position: absolute;
    inset: calc(var(--site-border-width) * -2);
    border: calc(var(--site-border-width) * 2) solid var(--ek-color-secondary);
    border-radius: inherit;
    box-shadow: 0 0 var(--ek-space-4) var(--ek-color-secondary);
    opacity: 0;
    pointer-events: none;
  }
  .istat__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--ek-space-3);
    padding-block: var(--ek-space-3);
    border-top: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .istat__row:first-child {
    border-top: 0;
  }
  .istat__name {
    color: var(--ek-color-content-default);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-medium);
  }
  .istat__meter {
    display: inline-flex;
    gap: var(--ek-space-1);
  }
  .istat__seg {
    position: relative;
    overflow: hidden;
    display: block;
    height: var(--ek-space-1);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface-sunken);
    transform-origin: 0 50%;
  }
  .istat__seg.is-on {
    background: var(--site-gradient-accent);
  }

  /* Görünürken ince ışık kanal çubuklarında soldan sağa akar (veri akışı hissi; yalnızca translate/opacity,
     durdurulmuş/reduced/JS'siz durumda yok; görünmezken duraklatılır). */
  .istat__seg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--ek-color-background) 85%, transparent), transparent);
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    @keyframes cap-flow {
      0% {
        opacity: 0;
        translate: -100% 0;
      }
      12% {
        opacity: 1;
      }
      30%,
      100% {
        opacity: 0;
        translate: 100% 0;
      }
    }
    :global(html[data-motion='play']) .istat .istat__seg.is-on::after {
      animation: cap-flow var(--site-motion-ambient-fast) var(--site-motion-ease-loop) infinite paused;
      animation-delay: calc(var(--site-motion-ambient-fast) * var(--flow-i, 0) * 0.07);
    }
    :global(html[data-motion='play']) .istat[data-visible='true'] .istat__seg.is-on::after {
      animation-play-state: running;
    }
    .istat__row:nth-child(2) {
      --flow-i: 2;
    }
    .istat__row:nth-child(3) {
      --flow-i: 4;
    }
    .istat__row:nth-child(4) {
      --flow-i: 6;
    }
    .istat__row:nth-child(5) {
      --flow-i: 8;
    }
    .istat__row:nth-child(6) {
      --flow-i: 10;
    }
    :global(html[data-motion='play']) .istat .istat__seg.is-on:nth-child(2)::after {
      animation-delay: calc(var(--site-motion-ambient-fast) * (var(--flow-i, 0) * 0.07 + 0.05));
    }
    :global(html[data-motion='play']) .istat .istat__seg.is-on:nth-child(3)::after {
      animation-delay: calc(var(--site-motion-ambient-fast) * (var(--flow-i, 0) * 0.07 + 0.1));
    }
  }

  /* --- D: anahtar şifreleme --- */
  .vault {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
    padding: var(--ek-space-5);
    border-radius: var(--ek-radius-xl);
    border: var(--site-border-width) solid color-mix(in srgb, var(--ek-color-background) 10%, transparent);
    background: var(--site-stage-mesh);
    box-shadow:
      inset 0 var(--site-border-width) 0 color-mix(in srgb, var(--ek-color-background) 14%, transparent),
      var(--window-shadow);
    color: var(--site-color-on-primary);
  }
  .vault__row {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
  }
  .vault__label {
    color: var(--site-color-on-primary-muted);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .vault__field {
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
    padding: var(--ek-space-2) var(--ek-space-3);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-md);
    background: var(--site-glass-bg);
    color: var(--site-color-on-primary);
    font-family: var(--ek-font-mono);
    font-size: var(--ek-font-size-md);
    letter-spacing: 0.08em;
  }
  .vault__field > :global(.icon) {
    flex: none;
    color: var(--site-color-on-primary-muted);
  }
  .vault__hidden {
    margin-inline-start: auto;
    padding: 0 var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: color-mix(in srgb, var(--ek-color-secondary) 22%, transparent);
    color: var(--site-color-on-primary);
    font-family: var(--ek-font-sans, inherit);
    font-size: var(--ek-font-size-xs);
    font-style: normal;
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.02em;
  }
  /* Anahtarın yolculuğu: girdi alanından kilidin arkasından geçip saklanan alana inen ince hat; üzerinde ışık iner. */
  .vault__rail {
    position: absolute;
    inset-block-start: calc(var(--ek-space-16) + var(--ek-space-5));
    inset-inline-start: calc(50% - var(--site-border-width));
    z-index: 0;
    width: calc(var(--site-border-width) * 2);
    height: calc(var(--ek-space-16) + var(--ek-space-4));
    border-radius: var(--ek-radius-full);
    background: linear-gradient(180deg, color-mix(in srgb, var(--ek-color-secondary) 55%, transparent), color-mix(in srgb, var(--ek-color-secondary) 25%, transparent));
    pointer-events: none;
  }
  .vault > :not(.vault__rail) {
    position: relative;
    z-index: 1;
  }
  .vault__spark {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 0, var(--ek-color-secondary) 0 var(--ek-space-1), transparent calc(var(--ek-space-1) * 1.6)) no-repeat;
    background-size: var(--ek-space-3) var(--ek-space-3);
    background-position: 50% 0;
    overflow: visible;
    opacity: 0;
  }
  .vault__bars i {
    position: relative;
    overflow: hidden;
  }
  .vault__bars i::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--ek-color-secondary);
    box-shadow: 0 0 var(--ek-space-2) var(--ek-color-secondary);
    opacity: 0;
  }
  .vault__field--cipher {
    position: relative;
    overflow: hidden;
    color: var(--ek-color-secondary);
  }
  .vault__bars {
    display: inline-flex;
    flex: 1;
    gap: var(--ek-space-1);
  }
  .vault__bars i {
    display: block;
    flex: 1;
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: color-mix(in srgb, var(--ek-color-secondary) 60%, transparent);
  }
  .vault__step {
    position: relative;
    display: inline-flex;
    align-items: center;
    align-self: center;
    gap: var(--ek-space-2);
    padding: var(--ek-space-1) var(--ek-space-3);
    border-radius: var(--ek-radius-full);
    background: color-mix(in srgb, var(--ek-color-secondary) 22%, transparent);
    color: var(--site-color-on-primary);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
  }

  /* --- E: çoklu kiracı --- */
  .tenant__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--ek-space-3);
  }
  .tenant__col {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }
  .tenant__acct,
  .tenant__db {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--ek-space-1);
    padding: var(--ek-space-3) var(--ek-space-2);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-lg);
    background: var(--ek-color-surface);
    box-shadow: var(--float-shadow);
    color: var(--ek-color-primary-darken-1);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    line-height: var(--ek-line-height-tight);
    text-align: center;
  }
  .tenant__db {
    border-color: var(--ek-color-secondary);
    color: var(--ek-color-secondary-darken-1);
    box-shadow: 0 0 0 var(--ek-space-1) color-mix(in srgb, var(--ek-color-secondary) 12%, transparent), var(--float-shadow);
  }
  .tenant__acct span,
  .tenant__db span {
    color: var(--ek-color-content-strong);
  }
  .tenant__link {
    position: relative;
    align-self: center;
    width: calc(var(--site-border-width) * 2);
    height: var(--ek-space-8);
    background: linear-gradient(180deg, var(--ek-color-primary-darken-1), var(--ek-color-secondary));
    transform-origin: 50% 0;
  }
  /* İzolasyon duvarı: sütunlar arasında kesikli ayraç + kalkan rozeti (veri paylaşılmaz). */
  .tenant__wall {
    position: absolute;
    inset-block: 0;
    inset-inline-start: calc(var(--ek-space-3) / -2);
    z-index: 1;
    display: grid;
    place-items: center;
    width: 0;
    border-inline-start: var(--site-border-width) dashed color-mix(in srgb, var(--ek-color-secondary) 55%, var(--ek-color-border-strong));
    color: var(--ek-color-secondary-darken-1);
  }
  .tenant__wall :global(.icon) {
    box-sizing: content-box;
    padding: calc(var(--ek-space-1) * 0.75);
    border: var(--site-border-width) solid color-mix(in srgb, var(--ek-color-secondary) 55%, var(--ek-color-border-default));
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface);
    box-shadow: var(--float-shadow);
  }
  .tenant__db {
    position: relative;
  }
  .tenant__db::after {
    content: '';
    position: absolute;
    inset: calc(var(--site-border-width) * -1);
    border: calc(var(--site-border-width) * 2) solid var(--ek-color-secondary);
    border-radius: inherit;
    box-shadow: 0 0 var(--ek-space-5) calc(var(--ek-space-1) * -1) var(--ek-color-secondary);
    opacity: 0;
    pointer-events: none;
  }
  /* Veritabanının içindeki kayıt satırları (yalnızca biçim). */
  .tenant__rows {
    display: flex;
    flex-direction: column;
    gap: calc(var(--ek-space-1) * 0.75);
    align-self: stretch;
    margin-top: var(--ek-space-1);
  }
  .tenant__rows i {
    display: block;
    height: calc(var(--ek-space-1) * 0.75);
    border-radius: var(--ek-radius-full);
    background: color-mix(in srgb, var(--ek-color-secondary) 35%, var(--ek-color-surface-sunken));
    transform-origin: 0 50%;
  }
  .tenant__rows i:nth-child(2) {
    width: 80%;
  }
  .tenant__rows i:nth-child(3) {
    width: 55%;
  }
  .tenant__platform {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--ek-space-2);
    margin-top: var(--ek-space-4);
    padding: var(--ek-space-2) var(--ek-space-3);
    border: var(--site-border-width) dashed var(--ek-color-border-strong);
    border-radius: var(--ek-radius-lg);
    color: var(--ek-color-content-default);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    text-align: center;
  }

  /* --- Günlük işleriniz için --- */
  .more {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    margin-top: var(--ek-space-16);
  }
  .more__title {
    color: var(--ek-color-content-strong);
    font-size: var(--site-font-display-sm);
    font-weight: var(--site-font-display-weight);
    line-height: var(--site-font-display-line-height);
    letter-spacing: var(--site-font-display-tracking);
  }
  .more__lead {
    color: var(--ek-color-content-default);
    font-size: var(--ek-font-size-lg);
  }
  .caps {
    display: grid;
    gap: var(--ek-space-4);
    margin-top: var(--ek-space-8);
    grid-template-columns: minmax(0, 1fr);
  }
  /*
   * Günlük iş kartı (S13-C): sade ama etkileyici — büyük degrade ikon rozeti, tek güçlü başlık, kısa gövde ve altta
   * küçük canlı illüstrasyon ("ürün vitrini"). Katmanlı yüzey + iç kenar ışığı; hover'da üstten vurgu ışıması (::after).
   */
  .cap {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    padding: var(--ek-space-6);
    border: var(--site-border-width) solid transparent;
    border-radius: var(--site-radius-panel);
    background:
      linear-gradient(180deg, var(--ek-color-surface) 0%, var(--ek-color-surface-muted) 100%) padding-box,
      linear-gradient(170deg, color-mix(in srgb, var(--ek-color-border-default) 60%, var(--ek-color-surface)), var(--ek-color-border-default)) border-box;
    box-shadow:
      inset 0 var(--site-border-width) 0 var(--ek-color-surface),
      0 var(--site-border-width) calc(var(--site-border-width) * 2) color-mix(in srgb, var(--ek-color-content-strong) 5%, transparent),
      0 var(--ek-space-4) var(--ek-space-8) calc(var(--ek-space-4) * -1) color-mix(in srgb, var(--ek-color-content-strong) 10%, transparent);
    /* `transform` (eğim) buraya da eklenir (bkz. PricingSummary.astro aynı not: kısayol birleşmez). */
    transition:
      box-shadow var(--ek-duration-base) var(--ek-easing-standard),
      background var(--ek-duration-base) var(--ek-easing-standard),
      translate var(--ek-duration-base) var(--ek-easing-standard),
      transform var(--tilt-transition-duration, var(--ek-duration-fast)) var(--ek-easing-standard);
  }
  .cap::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(80% 60% at 20% 0%, color-mix(in srgb, var(--ek-color-secondary) 13%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity var(--ek-duration-slow) var(--ek-easing-standard);
    pointer-events: none;
  }
  .cap:hover,
  .cap:focus-within {
    translate: 0 calc(var(--ek-space-1) * -1);
    background:
      linear-gradient(180deg, var(--ek-color-surface) 0%, var(--ek-color-surface-muted) 100%) padding-box,
      var(--site-gradient-border) border-box;
    box-shadow:
      inset 0 var(--site-border-width) 0 var(--ek-color-surface),
      0 var(--site-border-width) calc(var(--site-border-width) * 2) color-mix(in srgb, var(--ek-color-content-strong) 6%, transparent),
      0 var(--ek-space-8) var(--ek-space-16) calc(var(--ek-space-8) * -1) color-mix(in srgb, var(--ek-color-secondary-darken-1) 34%, transparent);
  }
  .cap:hover::after,
  .cap:focus-within::after {
    opacity: 1;
  }
  .cap__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--ek-space-3);
    margin-bottom: var(--ek-space-3);
  }
  .cap__icon {
    margin-bottom: 0;
  }
  .cap__title {
    color: var(--ek-color-content-strong);
    font-size: var(--site-card-title-size);
    font-weight: var(--site-font-display-weight);
    line-height: var(--ek-line-height-tight);
    letter-spacing: -0.018em;
  }
  .cap__text {
    color: var(--ek-color-content-default);
    font-size: var(--site-card-desc-size);
    font-weight: var(--site-card-desc-weight);
    line-height: var(--ek-line-height-normal);
    text-wrap: pretty;
  }
  /* Kanal noktaları: isimsiz, rozetin karşısında küçük bir "bağlı kanallar" imzası (anlam metindedir). */
  .cap__dots {
    display: inline-flex;
    gap: calc(var(--ek-space-1) * 1.5);
    margin-top: var(--ek-space-2);
    padding: var(--ek-space-1) var(--ek-space-2);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface);
  }
  .cap__dots i,
  .art__dot,
  .art__node {
    display: block;
    flex: none;
    width: calc(var(--ek-space-2) * 0.75);
    height: calc(var(--ek-space-2) * 0.75);
    border-radius: var(--ek-radius-full);
    background: var(--chan, var(--ek-color-secondary));
  }

  /* --- Kart illüstrasyonları (aria-hidden; yalnızca biçim) --- */
  .art {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    height: calc(var(--ek-space-16) + var(--ek-space-4));
    margin-top: auto;
    padding: var(--ek-space-3) var(--ek-space-4);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-xl);
    background:
      radial-gradient(90% 80% at 50% 0%, color-mix(in srgb, var(--ek-color-secondary) 9%, transparent), transparent 70%),
      var(--site-texture-dots),
      var(--ek-color-surface-sunken);
    background-size: auto, var(--site-texture-dots-size), auto;
    box-shadow: inset 0 var(--site-border-width) var(--ek-space-2) color-mix(in srgb, var(--ek-color-content-strong) 5%, transparent);
    transition: border-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .cap__text {
    margin-bottom: var(--ek-space-4);
  }
  .cap:hover .art {
    border-color: color-mix(in srgb, var(--ek-color-secondary) 40%, var(--ek-color-border-default));
  }
  /* Ortak "chip" yüzeyi: süzülen beyaz öğe */
  .art__hub,
  .art__box,
  .art__end,
  .art__bubble {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    border: var(--site-border-width) solid var(--ek-color-border-default);
    background: var(--ek-color-surface);
    box-shadow:
      0 var(--site-border-width) calc(var(--site-border-width) * 2) color-mix(in srgb, var(--ek-color-content-strong) 6%, transparent),
      0 var(--ek-space-2) var(--ek-space-4) calc(var(--ek-space-2) * -1) color-mix(in srgb, var(--ek-color-primary-darken-1) 22%, transparent);
    color: var(--site-accent);
  }

  /* sync: merkez -> kanallara yelpaze */
  .art--sync {
    gap: var(--ek-space-3);
  }
  .art__hub {
    width: var(--ek-space-10);
    height: var(--ek-space-10);
    border-color: color-mix(in srgb, var(--ek-color-secondary) 55%, var(--ek-color-border-default));
    border-radius: var(--ek-radius-lg);
  }
  /* Tek tel üzerinde kanallar; sinyal soldan sağa akar, eriştiği kanal noktası kısa bir an büyür. */
  .art__fan {
    position: relative;
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    padding-inline-start: var(--ek-space-4);
  }
  .art__wire {
    position: absolute;
    inset-inline: 0 var(--ek-space-3);
    inset-block-start: 50%;
    overflow: hidden;
    height: calc(var(--site-border-width) * 2);
    translate: 0 -50%;
    border-radius: var(--ek-radius-full);
    background: linear-gradient(90deg, color-mix(in srgb, var(--ek-color-secondary) 55%, transparent), var(--ek-color-border-default));
  }
  /* Akan sinyal: tel boyunca uzanan şerit, döngüde soldan sağa kayar (statik hâlde görünmez). */
  .art__wire::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, var(--ek-color-secondary), transparent);
    translate: -100% 0;
    opacity: 0;
  }
  .art__spoke {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-6);
    height: var(--ek-space-6);
    border: var(--site-border-width) solid color-mix(in srgb, var(--chan, var(--ek-color-secondary)) 45%, var(--ek-color-border-default));
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface);
    box-shadow: 0 var(--ek-space-1) var(--ek-space-2) calc(var(--ek-space-1) * -1) color-mix(in srgb, var(--ek-color-content-strong) 20%, transparent);
  }
  .art__node {
    width: var(--ek-space-2);
    height: var(--ek-space-2);
  }

  /* returns: üç adımlı ilerleme */
  .art__steps {
    position: relative;
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--ek-space-2);
  }
  .art__track {
    position: absolute;
    inset-inline: var(--ek-space-4);
    inset-block-start: 50%;
    height: calc(var(--site-border-width) * 2);
    translate: 0 -50%;
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-border-default);
  }
  .art__progress {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--site-gradient-accent);
    transform-origin: 0 50%;
  }
  .art__step {
    position: relative;
    display: block;
    width: var(--ek-space-4);
    height: var(--ek-space-4);
    border: calc(var(--site-border-width) * 2) solid var(--site-accent);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface);
    box-shadow: 0 0 0 var(--ek-space-1) var(--site-accent-soft);
  }
  .art__step--end {
    background: var(--site-accent);
  }

  /* chat: gelen soru + yazılıyor yanıtı */
  .art__thread {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: calc(var(--ek-space-1) * 1.5);
  }
  .art__bubble {
    gap: var(--ek-space-2);
    padding: var(--ek-space-2) var(--ek-space-3);
    border-radius: var(--ek-radius-lg) var(--ek-radius-lg) var(--ek-radius-lg) var(--ek-radius-sm);
  }
  .art__bubble--in {
    align-self: flex-start;
    width: 70%;
  }
  .art__bubble--out {
    align-self: flex-end;
    gap: var(--ek-space-1);
    padding-inline: var(--ek-space-4);
    border-color: transparent;
    border-radius: var(--ek-radius-lg) var(--ek-radius-lg) var(--ek-radius-sm) var(--ek-radius-lg);
    background: linear-gradient(150deg, var(--ek-color-primary), var(--ek-color-primary-darken-1));
  }
  .art__lines {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--ek-space-1);
  }
  .art__skel--short {
    width: 60%;
  }
  .art__skel {
    display: block;
    flex: none;
    height: var(--ek-space-1);
    border-radius: var(--ek-radius-full);
    background: color-mix(in srgb, var(--ek-color-content-muted) 25%, var(--ek-color-surface-sunken));
  }
  .art__typing {
    display: block;
    width: calc(var(--ek-space-1) * 1.5);
    height: calc(var(--ek-space-1) * 1.5);
    border-radius: var(--ek-radius-full);
    background: var(--site-color-on-primary);
    opacity: 0.85;
  }

  /* finance: iskelet sütun grafik (değer/sayı yok) */
  .art__bars {
    display: flex;
    flex: 1;
    align-items: flex-end;
    gap: var(--ek-space-2);
    height: 100%;
    padding-top: var(--ek-space-1);
    border-bottom: var(--site-border-width) solid var(--ek-color-border-strong);
  }
  .art__bar {
    display: block;
    flex: 1;
    height: 100%;
    border-radius: var(--ek-radius-sm) var(--ek-radius-sm) 0 0;
    background: linear-gradient(180deg, color-mix(in srgb, var(--ek-color-secondary) 70%, var(--ek-color-surface)), color-mix(in srgb, var(--ek-color-secondary) 25%, var(--ek-color-surface)));
    transform-origin: 50% 100%;
  }
  /* Yalnızca biçim (değer yok): sabit iskelet yükseklikleri; döngü bunları ölçekler. */
  .art__bar:nth-child(1) {
    height: 45%;
  }
  .art__bar:nth-child(2) {
    height: 70%;
  }
  .art__bar:nth-child(3) {
    height: 55%;
  }
  .art__bar:nth-child(4) {
    height: 85%;
  }
  .art__bar:nth-child(5) {
    height: 62%;
  }
  .art__bar:nth-child(6) {
    background: var(--site-gradient-accent);
  }

  /* ship / erp: iki uç arasında akan paket */
  .art__road {
    display: flex;
    flex: 1;
    align-items: center;
    gap: var(--ek-space-2);
  }
  .art__end,
  .art__box {
    width: var(--ek-space-10);
    height: var(--ek-space-10);
    border-radius: var(--ek-radius-lg);
  }
  .art__end--to {
    border-radius: var(--ek-radius-full);
    border-color: color-mix(in srgb, var(--chan, var(--ek-color-secondary)) 50%, var(--ek-color-border-default));
  }
  .art__end--to .art__dot {
    width: var(--ek-space-3);
    height: var(--ek-space-3);
  }
  .art__box--panel {
    border-color: color-mix(in srgb, var(--ek-color-secondary) 55%, var(--ek-color-border-default));
  }
  .art__lane-wrap {
    position: relative;
    flex: 1;
    height: calc(var(--site-border-width) * 2);
    background: repeating-linear-gradient(90deg, var(--site-accent-line) 0 var(--ek-space-2), transparent var(--ek-space-2) var(--ek-space-3));
  }
  .art__lane-wrap--solid {
    background: linear-gradient(90deg, var(--ek-color-border-strong), var(--site-accent-line));
  }
  /* Şerit yol boyunca uzanır; statik hâlde paket varışta (%100). */
  .art__lane {
    position: absolute;
    inset: 0;
    translate: 100% 0;
  }
  .art__parcel,
  .art__packet {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    translate: -100% -50%;
  }
  .art__parcel {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-6);
    height: var(--ek-space-6);
    border-radius: var(--ek-radius-md);
    background: var(--site-accent);
    box-shadow: 0 var(--ek-space-1) var(--ek-space-3) color-mix(in srgb, var(--ek-color-secondary) 45%, transparent);
    color: var(--site-color-on-primary);
  }
  .art__packet {
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-secondary);
    box-shadow: 0 0 0 var(--ek-space-1) var(--site-accent-soft);
  }

  /*
   * Canlı döngüler (S13-C). KURALLAR (scenes-loops.css ile aynı sözleşme): yalnızca opacity/translate/scale;
   * tamamı `prefers-reduced-motion: no-preference` + `html[data-motion='play']` koşullu → durdurulmuş/reduced/JS'siz
   * durumda statik son hâl; `paused` başlar, YALNIZCA sahne görünürken (`data-visible='true'`) çalışır; sekme
   * gizliyken scenes.css genel kuralı durdurur. Süreler token (6 / 12 sn). Adlar `cap-*`.
   */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes cap-wire {
      0%,
      8% {
        opacity: 0;
        translate: -100% 0;
      }
      14% {
        opacity: 1;
      }
      34%,
      100% {
        opacity: 0;
        translate: 100% 0;
      }
    }
    @keyframes cap-node {
      0%,
      26%,
      100% {
        scale: 1;
      }
      32% {
        scale: 1.5;
      }
      44% {
        scale: 1;
      }
    }
    @keyframes cap-progress {
      0% {
        scale: 0 1;
      }
      40%,
      86% {
        scale: 1 1;
      }
      96%,
      100% {
        scale: 0 1;
      }
    }
    @keyframes cap-typing {
      0%,
      60%,
      100% {
        opacity: 0.35;
        translate: 0 0;
      }
      30% {
        opacity: 1;
        translate: 0 calc(var(--ek-space-1) * -0.5);
      }
    }
    @keyframes cap-bars {
      0%,
      100% {
        scale: 1 1;
      }
      50% {
        scale: 1 0.82;
      }
    }
    @keyframes cap-lane {
      0% {
        translate: 0 0;
        opacity: 0;
      }
      8% {
        opacity: 1;
      }
      55%,
      88% {
        translate: 100% 0;
        opacity: 1;
      }
      96%,
      100% {
        translate: 100% 0;
        opacity: 0;
      }
    }
    @keyframes cap-scan {
      0% {
        opacity: 0;
        translate: 0 0;
      }
      6%,
      18% {
        opacity: 1;
        translate: 0 0;
      }
      24%,
      38% {
        translate: 0 100%;
      }
      44%,
      58% {
        translate: 0 200%;
      }
      64%,
      78% {
        translate: 0 300%;
      }
      84%,
      92% {
        opacity: 1;
        translate: 0 400%;
      }
      100% {
        opacity: 0;
        translate: 0 400%;
      }
    }
    @keyframes cap-ring {
      0% {
        opacity: 0.55;
        scale: 1;
      }
      40%,
      100% {
        opacity: 0;
        scale: 2.6;
      }
    }
    @keyframes cap-shine {
      0%,
      30% {
        opacity: 0;
        translate: -100% 0;
      }
      38% {
        opacity: 1;
      }
      60%,
      100% {
        opacity: 0;
        translate: 100% 0;
      }
    }
    @keyframes cap-drop {
      0%,
      10% {
        opacity: 0;
        translate: -50% 0;
      }
      18% {
        opacity: 1;
      }
      42% {
        opacity: 1;
        translate: -50% var(--ek-space-8);
      }
      50%,
      100% {
        opacity: 0;
        translate: -50% var(--ek-space-8);
      }
    }

    /* --- Günlük iş kartları --- */
    :global(html[data-motion='play']) .art__wire::after {
      animation: cap-wire var(--site-motion-ambient-fast) var(--site-motion-ease-loop) infinite paused;
      animation-delay: calc(var(--site-motion-stagger) * var(--d, 0));
    }
    :global(html[data-motion='play']) .art__node {
      animation: cap-node var(--site-motion-ambient-fast) var(--site-motion-ease-loop) infinite paused;
      animation-delay: calc(var(--site-motion-stagger) * var(--d, 0));
    }
    :global(html[data-motion='play']) .art__progress {
      animation: cap-progress var(--site-motion-ambient-fast) var(--site-motion-ease-loop) infinite paused;
      animation-delay: calc(var(--site-motion-stagger) * var(--d, 0));
    }
    :global(html[data-motion='play']) .art__typing {
      animation: cap-typing calc(var(--site-motion-ambient-fast) / 4) var(--site-motion-ease-loop) infinite paused;
      animation-delay: calc(var(--site-motion-stagger) * var(--d, 0));
    }
    :global(html[data-motion='play']) .art__bar {
      animation: cap-bars var(--site-motion-ambient-fast) var(--site-motion-ease-loop) infinite paused;
      animation-delay: calc(var(--site-motion-stagger) * var(--d, 0));
    }
    :global(html[data-motion='play']) .art__lane {
      animation: cap-lane var(--site-motion-ambient-fast) var(--site-motion-ease-loop) infinite paused;
      animation-delay: calc(var(--site-motion-stagger) * var(--d, 0));
    }
    /* Faz kaydırma: `--d` × stagger (özel özellik ::after'a da miras kalır). */
    .art__spoke:nth-child(3),
    .art__typing:nth-child(2),
    .art__bar:nth-child(2),
    .tenant__col:nth-child(2) {
      --d: 3;
    }
    .art__spoke:nth-child(4),
    .art__typing:nth-child(3),
    .art__bar:nth-child(3) {
      --d: 6;
    }
    .art__spoke:nth-child(5),
    .art__bar:nth-child(4),
    .tenant__col:nth-child(3) {
      --d: 9;
    }
    .art__spoke:nth-child(6),
    .art__bar:nth-child(5) {
      --d: 12;
    }
    .art__bar:nth-child(6) {
      --d: 15;
    }
    :global(html[data-motion='play']) .caps[data-visible='true'] :is(.art__node, .art__progress, .art__typing, .art__bar, .art__lane),
    :global(html[data-motion='play']) .caps[data-visible='true'] .art__wire::after {
      animation-play-state: running;
    }

    /* --- Bento karoları --- */
    .win__rows::before {
      content: '';
      position: absolute;
      inset-inline: 0;
      inset-block-start: 0;
      z-index: 0;
      height: 20%;
      background: linear-gradient(90deg, color-mix(in srgb, var(--ek-color-secondary) 12%, transparent), color-mix(in srgb, var(--ek-color-secondary) 4%, transparent));
      box-shadow: inset calc(var(--site-border-width) * 2) 0 0 var(--ek-color-secondary);
      opacity: 0;
      pointer-events: none;
    }
    :global(html[data-motion='play']) .win__rows::before {
      animation: cap-scan var(--site-motion-loop-scene) var(--site-motion-ease-loop) infinite paused;
      animation-delay: var(--site-motion-scene-max);
    }
    :global(html[data-motion='play']) [data-scene='orders-merge'][data-visible='true'] .win__rows::before {
      animation-play-state: running;
    }

    .istat__dot::after,
    .vault__step::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      box-shadow: 0 0 0 var(--site-border-width) var(--chan, var(--ek-color-secondary));
      opacity: 0;
      pointer-events: none;
    }
    :global(html[data-motion='play']) :is(.istat__dot, .vault__step)::after {
      animation: cap-ring var(--site-motion-ambient-fast) var(--site-motion-ease-loop) infinite paused;
      animation-delay: calc(var(--site-motion-stagger) * var(--ring-i, 0) * 4);
    }
    .istat__row:nth-child(2) {
      --ring-i: 2;
    }
    .istat__row:nth-child(3) {
      --ring-i: 4;
    }
    .istat__row:nth-child(4) {
      --ring-i: 6;
    }
    .istat__row:nth-child(5) {
      --ring-i: 8;
    }
    .istat__row:nth-child(6) {
      --ring-i: 10;
    }
    :global(html[data-motion='play']) .istat[data-visible='true'] .istat__dot::after,
    :global(html[data-motion='play']) [data-scene='secret-encryption'][data-visible='true'] .vault__step::after {
      animation-play-state: running;
    }

    .vault__field--cipher::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--ek-color-secondary) 30%, transparent), transparent);
      opacity: 0;
      translate: -100% 0;
      pointer-events: none;
    }
    :global(html[data-motion='play']) .vault__field--cipher::after {
      animation: cap-shine var(--site-motion-ambient-fast) var(--site-motion-ease-loop) infinite paused;
    }
    :global(html[data-motion='play']) [data-scene='secret-encryption'][data-visible='true'] .vault__field--cipher::after {
      animation-play-state: running;
    }

    .tenant__link::after {
      content: '';
      position: absolute;
      inset-block-start: 0;
      inset-inline-start: 50%;
      width: calc(var(--ek-space-1) * 1.5);
      height: calc(var(--ek-space-1) * 1.5);
      margin-block-start: calc(var(--ek-space-1) * -0.75);
      border-radius: var(--ek-radius-full);
      background: var(--ek-color-secondary);
      box-shadow: 0 0 0 var(--ek-space-1) color-mix(in srgb, var(--ek-color-secondary) 25%, transparent);
      opacity: 0;
      translate: -50% 0;
      pointer-events: none;
    }
    :global(html[data-motion='play']) .tenant__link::after {
      animation: cap-drop var(--site-motion-ambient-fast) var(--site-motion-ease-loop) infinite paused;
      animation-delay: calc(var(--site-motion-ambient-fast) * var(--q, 0) / 3);
    }
    :global(html[data-motion='play']) [data-scene='tenant-isolation'][data-visible='true'] .tenant__link::after {
      animation-play-state: running;
    }

    /*
     * Bento karoları (S15-C) — sakin, tek odaklı döngüler (T = ambient-fast):
     *  B gelen sipariş bildirimi listeye süzülür · C ışık kanal hattından aşağı iner, "Tek panel" yanar ·
     *  D ışık anahtarın yolunu izler, kilit oturur, şifreli çubuklar sırayla parlar · E hesaplar sırayla kendi
     *  veritabanına yazar (kayıt satırları dolar, veritabanı yanar); sütunlar arası duvar sabit kalır.
     */
    @keyframes cap-toast {
      0%,
      8% {
        opacity: 0;
        translate: 0 calc(var(--ek-space-3) * -1);
      }
      14%,
      34% {
        opacity: 1;
        translate: 0 0;
      }
      42%,
      100% {
        opacity: 0;
