---
/**
 * Yetenekler (ADR-0014 Karar 2, bölüm 4) — S12: pazarlama dili, sade kart hiyerarşisi.
 * İki katman (ELEV A10: koyu "dört değer sütunu" bandı kaldırıldı — aynı dört fikri hemen altındaki bento
 * karoları gösteriyordu): (1) beş animasyonlu bento karo, (2) "Günlük işleriniz için" kartları. Metinler kayıttaki `home` alanlarından gelir (capabilities.ts).
 * Ana sayfada kanal ADI, durum rozeti (Mevcut/Kısmi) ve kapsam notu YOK (S12 kullanıcı geri bildirimi);
 * kanal ayrımı yalnızca isimsiz renkli noktayla (`data-code` -> `--chan`). Kapsam farkları ve sınır notları
 * alt sayfalarda (/ozellikler, /entegrasyonlar) eksiksiz yazılıdır.
 * Beş "UI parçası" (hepsi HTML/CSS; aria-hidden — anlam çevredeki metindedir; giriş hareketi scenes.css):
 *   - `stock-single-winner`: son adet için eşzamanlı iki sipariş -> hatlar koyu "rezervasyon çekirdeğinde" birleşir
 *     (kalan sayacı 1 -> 0, kilit) -> biri rezerve, diğeri aşırı satış olarak işaretlenir -> stok TÜM kanallarda 0 olur
 *   - `orders-merge`: kanallardan gelen siparişler sırayla TEK listeye düşer; sayaç artar, durum rozeti ilerler
 *     (Yeni -> Hazırlanıyor -> Kargoda)
 *   - `integration-status`: bağlı kanallar (tür etiketiyle) tek merkezde; ürün/stok/sipariş akış çubukları
 *   SITE-DL (F1, kullanıcı isteği 2026-10-02): üç görsel de karonun içinde GÖLGESİZ, düz bir iç alanda yaşar (kart
 *   üstüne gölgeli ikinci pencere yok) ve sakin bir DÖNGÜ oynatır (12 sn; scenes-loops.css). Hareket kapalıyken
 *   her biri hikâyesinin son karesinde durur.
 *   - `secret-encryption`: girilen anahtar -> kilit -> şifreli kasada -> ekranda maskeli (ELEV: teknik önek/algoritma adı görselde yok, K44)
 *   - `tenant-isolation`: her müşteri hesabı kendi veritabanına bağlanır
 * Görseller örnek arayüzdür (aria-hidden; S15-C: ayrı "Örnek görünüm" etiketi yok); uydurma müşteri/ölçüm YOK.
 *
 * S27a (SR4 madde 5–6, N3, N9) — KARAR: "Yetenekler" ve "Günlük işler" BİRLEŞTİ. Gerekçe: ikisi de aynı sütuna
 * (Kontrol) hizmet ediyor ve aynı kayıttan besleniyordu; ayrı başlıkla iki katman ziyaretçiye "ikinci bir yetenek
 * listesi" gibi okunuyordu. Artık tek bölüm, tek başlık: üstte üç vitrin karosu (rezervasyon, birleşik sipariş, tek
 * merkez), altında aynı bölümün içinde kompakt "Günlük işleriniz de aynı ekranda" listesi (ikon + başlık + tek satır;
 * kart/illüstrasyon yok). Şifreli anahtar ve izole veri karoları (`secret-encryption`, `tenant-isolation`) Güvenlik
 * bölümüne taşındı (orada tek kez anlatılır).
 */
import Section from '../Section.astro'
import SectionHeading from './SectionHeading.astro'
import Icon from './Icon.astro'
import { getPublicCapabilities, type PublicProductCapability } from '../../data/capabilities'
import { getPublicIntegrations, type CapabilityKey } from '../../data/integrations'

const all = getPublicCapabilities('core')
const byId = (list: PublicProductCapability[], id: string): PublicProductCapability => {
  const c = list.find((x) => x.id === id)
  if (!c) throw new Error(`Yetenek kaydı bulunamadı: ${id}`)
  return c
}
const homeOf = (c: PublicProductCapability) => c.home ?? { title: c.title, line: c.summary }

const stock = byId(all, 'stock-reservation')
const orders = byId(all, 'unified-orders')
const spotlightIds = new Set([stock.id, orders.id])
const rest = all.filter((c) => !spotlightIds.has(c.id))

const ICONS: Record<string, 'stock' | 'layers' | 'orders' | 'returns' | 'chat' | 'finance' | 'notice' | 'plug'> = {
  'stock-reservation': 'stock',
  'multi-channel-products': 'layers',
  'unified-orders': 'orders',
  returns: 'returns',
  questions: 'chat',
  finance: 'finance',
  'shipping-invoice-notice': 'notice',
  'erp-read': 'plug',
}

const integrations = getPublicIntegrations()
const marketplaceCodes = getPublicIntegrations('marketplace').map((i) => i.code)
const [codeA = '', codeB = ''] = marketplaceCodes
// Örnek liste: kanal renkleri sırayla tekrar eder (ad yok); durum sözcükleri yalnızca arayüz örneğidir. Her satırın
// durum akışı (son öğe = durağan son kare): döngüde rozet sırayla ilerler (scenes-loops.css `orders-merge`).
const ORDER_FLOWS = [['Yeni', 'Hazırlanıyor', 'Kargoda'], ['Yeni', 'Hazırlanıyor'], ['İade talebi'], ['Yeni'], ['Yeni']]
const rows = ORDER_FLOWS.map((steps, i) => ({ steps, code: marketplaceCodes[i % marketplaceCodes.length] ?? '' }))
// Sipariş kaynağı kanallar: isimsiz renkli nokta (satır i, `i mod kanal sayısı`. kanaldan düşer; döngü dört kanala göre).
const orderChannels = marketplaceCodes.slice(0, 4)
const isAlert = (s: string) => s === 'İade talebi'
// "Bağlı kanallar" karosu: çubuk yalnızca kanalın kayıtta o veri türü için yeteneği varsa dolu (dürüstlük:
// örn. ERP bağlantısı stok yazmaz → stok çubuğu soluk). Seviye farkı ana sayfada gösterilmez (alt sayfada).
const FLOW_KEYS: CapabilityKey[] = ['products', 'stockPrice', 'orders']
---

<Section id="ozellikler" labelledby="yetenek-baslik">
  <SectionHeading
    id="yetenek-baslik"
    eyebrow="Yetenekler"
    title="Siparişten iadeye, işinizin tamamı"
    lead="Stoktan siparişe, iadeden hakedişe: ekibiniz her işi aynı ekrandan, aynı adımlarla yürütür."
  />

  <div class="bento" data-testid="bento">
    {/* A: stok rezervasyonu (geniş) */}
    <article class="tile tile--stock" aria-labelledby="spot-stock-title" data-tilt data-scene="tile">
      <div class="tile__copy" data-reveal>
        <span class="tile__icon"><Icon name="stock" size="md" /></span>
        <h3 id="spot-stock-title" class="tile__title">{homeOf(stock).title}</h3>
        <p class="tile__text">{homeOf(stock).line}</p>
      </div>
      <div class="tile__frame" data-reveal>
        <div class="stock" data-scene="stock-single-winner" aria-hidden="true">
          <div class="stock__head">
            <span class="stock__live"><Icon name="clock" size="sm" />Eşzamanlı</span>
            <p class="stock__caption">Son adet için iki kanaldan aynı anda sipariş</p>
          </div>
          <div class="stock__flow">
            <div class="stock__orders">
              <div class="stock__order" data-part="order-a" data-code={codeA}>
                <span class="stock__dot"></span>
                <span class="stock__status">Yeni sipariş</span>
                <span class="stock__line stock__line--short"></span>
              </div>
              <div class="stock__order" data-part="order-b" data-code={codeB}>
                <span class="stock__dot"></span>
                <span class="stock__status">Yeni sipariş</span>
                <span class="stock__line stock__line--short"></span>
              </div>
            </div>
            <div class="stock__rail stock__rail--in" data-part="arrow-a">
              <svg class="stock__wires stock__wires--h" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path d="M0 25 H50 C75 25 75 50 100 50"></path>
                <path d="M0 75 H50 C75 75 75 50 100 50"></path>
              </svg>
              <svg class="stock__wires stock__wires--v" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path d="M25 0 V35 C25 65 50 65 50 100"></path>
                <path d="M75 0 V35 C75 65 50 65 50 100"></path>
              </svg>
              <span class="stock__carrier stock__carrier--a" data-part="carry-in" data-code={codeA}><i class="stock__pulse"></i></span>
              <span class="stock__carrier stock__carrier--b" data-part="carry-in" data-code={codeB}><i class="stock__pulse"></i></span>
            </div>
            <div class="stock__engine" data-part="product">
              <span class="stock__flash" data-part="flash"></span>
              <span class="stock__engine-head">
                <span class="stock__thumb"><Icon name="stock" size="sm" /></span>
                <span class="stock__engine-label">Son adet</span>
              </span>
              <span class="stock__left-num">
                <b class="stock__left-a" data-part="left-a">1</b>
                <b class="stock__left-b" data-part="left-b"><span class="stock__zero">0</span></b>
              </span>
              <span class="stock__left">Kalan</span>
              <span class="stock__lock" data-part="lock"><Icon name="lock" size="sm" />Rezervasyon</span>
            </div>
            <div class="stock__rail stock__rail--out" data-part="arrow-b">
              <svg class="stock__wires stock__wires--h" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path class="stock__wire--ok" d="M0 50 C25 50 25 25 50 25 H100"></path>
                <path class="stock__wire--warn" d="M0 50 C25 50 25 75 50 75 H100"></path>
              </svg>
              <svg class="stock__wires stock__wires--v" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path class="stock__wire--ok" d="M50 0 C50 35 25 35 25 65 V100"></path>
                <path class="stock__wire--warn" d="M50 0 C50 35 75 35 75 65 V100"></path>
              </svg>
              <span class="stock__carrier stock__carrier--ok" data-part="carry-ok"><i class="stock__pulse"></i></span>
              <span class="stock__carrier stock__carrier--warn" data-part="carry-warn"><i class="stock__pulse"></i></span>
            </div>
            <div class="stock__results">
              <div class="stock__result stock__result--ok" data-part="result-ok">
                <span class="stock__badge"><Icon name="check" size="sm" /></span>
                <div>
                  <strong>Rezerve edildi</strong>
                  <span>İlk gelen sipariş</span>
                </div>
              </div>
              <div class="stock__result stock__result--warn" data-part="result-oversold">
                <span class="stock__badge"><Icon name="info" size="sm" /></span>
                <div>
                  <strong>Aşırı satış olarak işaretlendi</strong>
                  <span>Telafi akışına alındı</span>
                </div>
              </div>
            </div>
          </div>
          {/* Rezervasyonun sonucu: aynı ürünün stoku bağlı kanallarda da güncellenir (1 -> 0; durağan hâl 0). */}
          <div class="stock__sync">
            <span class="stock__sync-label">Tüm kanallarda stok</span>
            <ul class="stock__chans">
              {
                marketplaceCodes.map((code) => (
                  <li class="stock__chan" data-code={code}>
                    <span class="stock__dot" />
                    <span class="stock__chan-num">
                      <b class="stock__chan-old" data-part="chan-old">1</b>
                      <b data-part="chan-new">0</b>
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </article>

    {/* B: birleşik siparişler ve iadeler */}
    <article class="tile tile--orders" aria-labelledby="spot-orders-title" data-tilt data-scene="tile">
      <div class="tile__copy" data-reveal>
        <span class="tile__icon"><Icon name="orders" size="md" /></span>
        <h3 id="spot-orders-title" class="tile__title">{homeOf(orders).title}</h3>
        <p class="tile__text">{homeOf(orders).line}</p>
      </div>
      <div class="tile__frame" data-reveal>
        <div class="ord" data-scene="orders-merge" aria-hidden="true">
          <div class="ord__head">
            <span class="ord__title">Siparişler ve iadeler</span>
            <span class="ord__count">
              <span class="ord__nums">
                {rows.map((_, i) => <b class="ord__num" data-part="ord-num">{i}</b>)}
                <b class="ord__num ord__num--final" data-part="ord-num">{rows.length}</b>
              </span>
              kayıt tek listede
            </span>
          </div>
          <ul class="ord__chans">
            {
              orderChannels.map((code) => (
                <li class="ord__chan" data-part="ord-chan" data-code={code}>
                  <span class="ord__dot" />
                  <i class="ord__chan-name" />
                </li>
              ))
            }
          </ul>
          <ul class="ord__rows">
            {
              rows.map((r) => (
                <li class="ord__row" data-part="order-row" data-code={r.code}>
                  <span class="ord__dot" />
                  <span class="ord__cells">
                    <i class="ord__skel ord__skel--a" />
                    <i class="ord__skel ord__skel--b" />
                  </span>
                  <span class="ord__st">
                    {r.steps.map((label, j) => (
                      <span
                        class:list={['ord__pill', isAlert(label) && 'ord__pill--alert', j === r.steps.length - 1 && 'ord__pill--final']}
                        data-part="ord-st"
                      >
                        {label}
                      </span>
                    ))}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </article>

    {/* C: kanallar tek merkezde */}
    <article class="tile tile--status" aria-labelledby="spot-status-title" data-tilt data-scene="tile">
      <div class="tile__copy" data-reveal>
        <span class="tile__icon"><Icon name="plug" size="md" /></span>
        <h3 id="spot-status-title" class="tile__title">Her kanal aynı merkezde</h3>
        <p class="tile__text">Pazaryerleri, e-ticaret altyapınız ve ERP sisteminiz tek panelde buluşur.</p>
      </div>
      <div class="tile__frame" data-reveal>
        <div class="istat" data-scene="integration-status" aria-hidden="true">
          <p class="istat__caption">
            <span>Bağlı kanallar</span>
            <span class="istat__cols"><i>Ürün</i><i>Stok</i><i>Sipariş</i></span>
          </p>
          <ul class="istat__rows">
            {
              integrations.map((i) => (
                <li class="istat__row" data-part="istat-row" data-code={i.code}>
                  <span class="istat__dot"></span>
                  <span class="istat__name">{i.kindLabel}</span>
                  <span class="istat__meter">
                    {FLOW_KEYS.map((k) => {
                      const on = i.capabilities.some((c) => c.key === k)
                      return <i class:list={['istat__seg', on && 'is-on']} data-part={on ? 'seg' : undefined}></i>
                    })}
                  </span>
                </li>
              ))
            }
          </ul>
          <p class="istat__hub"><span class="istat__hub-icon"><Icon name="plug" size="sm" /></span>Tek panel</p>
        </div>
      </div>
    </article>

    {/* D: şifreli anahtarlar */}
  </div>

  {/* S27a (SR4 madde 6): "Günlük işleriniz için" ayrı bölüm/katman olmaktan çıktı — aynı bölümde kompakt liste. */}
  <div class="daily" data-testid="daily">
    <h3 class="daily__title" data-testid="more-title">Günlük işleriniz de aynı ekranda</h3>
    <ul class="daily__list" data-scene="reveal" data-testid="capability-grid">
      {
        rest.map((c) => (
          <li class="daily__item" data-part="capability" data-id={c.id} data-reveal>
            <span class="daily__icon" aria-hidden="true"><Icon name={ICONS[c.id] ?? 'layers'} size="sm" /></span>
            <span class="daily__body">
              <strong class="daily__name">{homeOf(c).title}</strong>
              <span class="daily__line">{homeOf(c).line}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<style>
  /*
   * Renk hiyerarşisi (S12): tek başlık tonu (content-strong) + tek gövde tonu (content-default). Üçüncü bir ton
   * yok; vurgu yalnızca ikon rozetinde ve isimsiz kanal noktalarında. Tipografi `--site-card-*` token setinden.
   */

  /* --- Bento ızgarası --- */
  .bento {
    /* SITE-DL (F1): gölge/degrade yardımcıları kalktı; vitrin "kuyusu" düz sakin zemin. Koyu çekirdekte okunur açık mavi. */
    --well-bg: var(--ek-color-surface-muted);
    --cap-tint: var(--site-accent-on-dark);
    display: grid;
    gap: var(--ek-space-5);
    margin-top: var(--ek-space-8);
    grid-template-columns: minmax(0, 1fr);
  }
  /* SITE-DL (F1): düz karo — beyaz yüzey + ince çerçeve + kart yarıçapı; degrade, doku, gölge ve eğim yok.
     Hover yalnız çerçeve tonunu değiştirir. */
  .tile {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-8);
    min-width: 0;
    padding: var(--ek-space-6);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-card);
    background: var(--ek-color-surface);
    transition: border-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .tile:hover {
    border-color: var(--site-action-border);
  }
  .tile__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ek-space-3);
    max-width: 34rem;
  }
  /* İkon kutusu: çerçeveli kare (uygulamadaki ikon kutusuyla aynı) — degrade, ışıma ve hover hareketi yok. */
  .tile__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-10);
    height: var(--ek-space-10);
    margin-bottom: var(--ek-space-2);
    border: var(--site-border-width) solid var(--site-action-border);
    border-radius: var(--ek-radius-tile);
    background: var(--site-action-subtle);
    color: var(--site-action);
  }
  .tile__title {
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-2xl);
    font-weight: var(--site-font-display-weight);
    line-height: var(--ek-line-height-tight);
    letter-spacing: -0.022em;
    text-wrap: balance;
  }
  .tile__text {
    color: var(--ek-color-content-default);
    font-size: var(--site-card-desc-size);
    font-weight: var(--site-card-desc-weight);
    line-height: var(--ek-line-height-normal);
    text-wrap: pretty;
  }
  .tile__frame {
    min-width: 0;
    margin-top: auto;
  }

  /* Ortak isimsiz kanal noktası (renk: [data-code] -> --chan, global.css). */
  .stock__dot,
  .ord__dot,
  .istat__dot {
    position: relative;
    display: inline-block;
    flex: none;
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--chan, var(--site-action));
  }

  /*
   * Görsel "iç alanı" (SITE-DL F1): üç görsel de karonun içinde düz, sakin zeminli, ince çerçeveli tek bir alanda
   * yaşar — kart üstüne gölgeli ikinci pencere YOK. İçteki parçalar beyaz yüzey + ince çizgi.
   */
  .stock,
  .ord,
  .istat {
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-tile);
    background: var(--well-bg);
  }

  /*
   * --- A: stok rezervasyonu görseli ---
   * Anlatı soldan sağa, adım adım (döngü: scenes-loops.css `stock-single-winner`, 12 sn):
   *   1) son adet için iki kanaldan AYNI ANDA sipariş gelir  2) hatlar merkezdeki rezervasyon çekirdeğine akar
   *   3) kalan 1 -> 0, kilit yanar  4) ilk sipariş "Rezerve edildi", ikincisi "Aşırı satış olarak işaretlendi"
   *   5) aynı ürünün stoku TÜM kanallarda 0'a çekilir.
   * Masaüstünde yatay hatlar (SVG, en-boy serbest), <768px'te aynı hatlar dikey.
   * Durağan hâl (hareket kapalı / reduced / JS'siz) = hikâyenin sonu: kalan 0, iki sonuç, kanallarda 0.
   */
  .stock {
    padding: var(--ek-space-5);
  }
  .stock__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ek-space-2) var(--ek-space-3);
    margin-bottom: var(--ek-space-5);
  }
  .stock__live {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-1);
    padding: calc(var(--ek-space-1) * 0.5) var(--ek-space-2);
    border: var(--site-border-width) solid var(--site-action-border);
    border-radius: var(--ek-radius-md);
    background: var(--ek-color-surface);
    color: var(--site-action-emphasis);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-bold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .stock__caption {
    color: var(--ek-color-content-default);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
  }
  .stock__flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
  }
  .stock__orders,
  .stock__results {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--ek-space-3);
  }
  .stock__order,
  .stock__result {
    position: relative;
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-md);
    background: var(--ek-color-surface);
  }
  .stock__order {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: center;
    align-items: center;
    gap: var(--ek-space-2) var(--ek-space-3);
    padding: var(--ek-space-3);
  }
  .stock__order .stock__line {
    grid-column: 2;
  }
  .stock__status {
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
  }
  .stock__line {
    display: block;
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface-sunken);
  }
  .stock__line--short {
    width: 70%;
  }

  /* Hatlar: SVG yalnızca çizgi; üzerindeki nokta (`carrier` hattı kaplar, `translate` yüzdesi = hat boyutu). */
  .stock__rail {
    position: relative;
    min-height: var(--ek-space-12);
  }
  .stock__wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: var(--ek-color-border-strong);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .stock__wires path {
    vector-effect: non-scaling-stroke;
  }
  .stock__wires .stock__wire--ok {
    stroke: var(--site-action-border);
  }
  .stock__wires .stock__wire--warn {
    stroke: var(--ek-color-warning-border);
  }
  .stock__wires--h {
    display: none;
  }
  .stock__carrier {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Dar ekran (dikey hat): başlangıç noktası ve iki ara konum. */
    --x0: 50%;
    --y0: 0%;
  }
  .stock__carrier--a {
    --x0: 25%;
    --m1: 0 35%;
    --m2: 25% 100%;
  }
  .stock__carrier--b {
    --x0: 75%;
    --m1: 0 35%;
    --m2: -25% 100%;
  }
  .stock__carrier--ok {
    --m1: -25% 65%;
    --m2: -25% 100%;
    --chan: var(--site-action);
  }
  .stock__carrier--warn {
    --m1: 25% 65%;
    --m2: 25% 100%;
    --chan: var(--ek-color-warning);
  }
  /* Hat üzerinde ilerleyen düz nokta (ışıma yok); durağan hâlde görünmez. */
  .stock__pulse {
    --size: calc(var(--ek-space-2) * 1.25);
    position: absolute;
    inset-inline-start: var(--x0);
    inset-block-start: var(--y0);
    width: var(--size);
    height: var(--size);
    margin: calc(var(--size) / -2) 0 0 calc(var(--size) / -2);
    border: calc(var(--site-border-width) * 2) solid var(--well-bg);
    border-radius: var(--ek-radius-full);
    background: var(--chan, var(--site-action));
    opacity: 0;
  }

  /* Rezervasyon çekirdeği: düz koyu lacivert kart + ince çerçeve (ışıma/gölge/halka yok). */
  .stock__engine {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    align-content: center;
    gap: var(--ek-space-2);
    padding: var(--ek-space-4) var(--ek-space-3);
    border: var(--site-border-width) solid var(--ek-color-chrome-border);
    border-radius: var(--ek-radius-md);
    background: var(--ek-color-chrome);
    color: var(--site-color-on-primary);
    text-align: center;
  }
  /* Rezervasyon anı: çekirdek bir kez hafifçe aydınlanır (yalnız opacity; durağan: görünmez). */
  .stock__flash {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ek-color-chrome-soft);
    opacity: 0;
    pointer-events: none;
  }
  .stock__engine-head {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
  }
  .stock__thumb {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-6);
    height: var(--ek-space-6);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-sm);
    background: var(--site-glass-bg);
    color: var(--cap-tint);
  }
  .stock__engine-label,
  .stock__left {
    color: var(--site-color-on-primary-muted);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .stock__left-num {
    position: relative;
    display: inline-grid;
    overflow: hidden;
    color: var(--site-color-on-primary);
    font-size: var(--ek-font-size-4xl);
    font-weight: var(--site-font-display-weight);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .stock__left-num > * {
    grid-area: 1 / 1;
    text-align: center;
  }
  .stock__zero {
    display: block;
  }
  .stock__left-a,
  .stock__one {
    opacity: 0;
  }
  /* Koyu yüzeyde dolu rozet AÇIK renk olur (lacivert dolgu koyu zeminde görünmez). */
  .stock__lock {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-1);
    padding: calc(var(--ek-space-1) * 0.5) var(--ek-space-2);
    border-radius: var(--ek-radius-sm);
    background: var(--ek-color-background);
    color: var(--ek-color-primary);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
  }

  .stock__result {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ek-space-2);
    padding: var(--ek-space-3);
    font-size: var(--ek-font-size-sm);
  }
  /* Olumlu sonuç site vurgusuyla (lacivert; sitede yeşil yok), aşırı satış uyarı tonuyla. */
  .stock__result--ok {
    --glow-c: var(--site-action);
    border-color: var(--site-action-border);
    background: var(--site-action-subtle);
  }
  .stock__result--warn {
    --glow-c: var(--ek-color-warning);
    border-color: var(--ek-color-warning-border);
    background: var(--ek-color-warning-subtle);
  }
  .stock__badge {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-6);
    height: var(--ek-space-6);
    border-radius: var(--ek-radius-sm);
    background: var(--glow-c);
    color: var(--site-color-on-primary);
  }
  /* `.stock__result span` (gövde metni) rozetin ikon rengini ezmesin → özgüllük artırıldı. */
  .stock__result .stock__badge {
    color: var(--site-color-on-primary);
  }
  .stock__result--warn .stock__badge {
    color: var(--ek-color-content-strong);
  }
  .stock__result div {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
  }
  .stock__result strong {
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-sm);
    line-height: var(--ek-line-height-tight);
  }
  .stock__result span {
    color: var(--ek-color-content-default);
  }

  /* Sonuç şeridi: aynı ürünün stoku bağlı kanallarda da 0 (isimsiz kanal noktası + adet). */
  .stock__sync {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ek-space-2) var(--ek-space-4);
    margin-top: var(--ek-space-4);
    padding-top: var(--ek-space-4);
    border-top: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .stock__sync-label {
    color: var(--ek-color-content-muted);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .stock__chans {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stock__chan {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    padding: calc(var(--ek-space-1) * 0.5) var(--ek-space-3);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-md);
    background: var(--ek-color-surface);
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-bold);
    font-variant-numeric: tabular-nums;
  }
  .stock__chan:nth-child(2) {
    --k: 1;
  }
  .stock__chan:nth-child(3) {
    --k: 2;
  }
  .stock__chan:nth-child(n + 4) {
    --k: 3;
  }
  .stock__chan-num {
    display: inline-grid;
    overflow: hidden;
  }
  .stock__chan-num b {
    grid-area: 1 / 1;
    text-align: center;
  }
  .stock__chan-old {
    opacity: 0;
  }

  /*
   * --- B: siparişler tek listede ---
   * Pencere çerçevesi/gölge yok: üstte kaynak kanallar (isimsiz renkli nokta), altta TEK liste. Döngüde (12 sn;
   * scenes-loops.css `orders-merge`) siparişler sırayla kendi kanalından listeye düşer, sayaç artar, durum rozeti
   * ilerler (Yeni -> Hazırlanıyor -> Kargoda). Durağan hâl = dolu liste, son durumlar, sayaç = satır sayısı.
   */
  .ord {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
    padding: var(--ek-space-5);
  }
  .ord__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--ek-space-2) var(--ek-space-3);
  }
  .ord__title {
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
  }
  .ord__count {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-1);
    padding: calc(var(--ek-space-1) * 0.5) var(--ek-space-2);
    border: var(--site-border-width) solid var(--site-action-border);
    border-radius: var(--ek-radius-md);
    background: var(--ek-color-surface);
    color: var(--site-action-emphasis);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
  }
  .ord__nums {
    display: inline-grid;
    overflow: hidden;
    font-weight: var(--ek-font-weight-bold);
    font-variant-numeric: tabular-nums;
  }
  .ord__num {
    grid-area: 1 / 1;
    text-align: center;
    opacity: 0;
  }
  .ord__num--final {
    opacity: 1;
  }
  .ord__chans {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--ek-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ord__chan {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
    min-width: 0;
    padding: var(--ek-space-2) var(--ek-space-3);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-md);
    background: var(--ek-color-surface);
  }
  /* Kanaldan sipariş çıktığı an: kanal renginde ince çerçeve belirir ve söner (durağan: görünmez). */
  .ord__chan::after {
    content: '';
    position: absolute;
    inset: calc(var(--site-border-width) * -1);
    border: calc(var(--site-border-width) * 2) solid var(--chan, var(--site-action));
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
  }
  .ord__chan-name {
    display: block;
    flex: 1;
    height: var(--ek-space-1);
    border-radius: var(--ek-radius-full);
    background: color-mix(in srgb, var(--ek-color-content-muted) 22%, var(--ek-color-surface-sunken));
  }
  .ord__rows {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-md);
    background: var(--ek-color-surface);
    list-style: none;
  }
  .ord__row {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--ek-space-3);
    padding: var(--ek-space-3);
    border-top: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .ord__row:first-child {
    border-top: 0;
  }
  /* Yeni düşen satırın kısa vurgusu (yalnız opacity; durağan: görünmez). */
  .ord__row::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--site-action-subtle);
    opacity: 0;
  }
  .ord__cells {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
  }
  .ord__skel {
    display: block;
    height: var(--ek-space-1);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface-sunken);
  }
  .ord__skel--a {
    width: 72%;
    background: color-mix(in srgb, var(--ek-color-content-muted) 22%, var(--ek-color-surface-sunken));
  }
  .ord__skel--b {
    width: 44%;
  }
  /* Durum rozetleri aynı hücrede üst üste; durağan hâlde yalnız SON durum görünür. */
  .ord__st {
    display: inline-grid;
    justify-items: end;
  }
  .ord__pill {
    grid-area: 1 / 1;
    padding: calc(var(--ek-space-1) * 0.5) var(--ek-space-2);
    border: var(--site-border-width) solid var(--site-action-border);
    border-radius: var(--ek-radius-md);
    background: var(--site-action-subtle);
    color: var(--site-action-emphasis);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    white-space: nowrap;
    opacity: 0;
  }
  .ord__pill--final {
    opacity: 1;
  }
  .ord__pill--alert {
    border-color: var(--ek-color-warning-border);
    background: var(--ek-color-warning-subtle);
    color: var(--ek-color-warning-emphasis);
  }

  /* --- C: kanallar tek merkezde --- */
  .istat {
    overflow: hidden;
    padding: var(--ek-space-4) var(--ek-space-5);
  }
  .istat__caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ek-space-3);
    margin-bottom: var(--ek-space-2);
    color: var(--ek-color-content-muted);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .istat__cols {
    display: inline-flex;
    gap: var(--ek-space-1);
  }
  .istat__cols i,
  .istat__seg {
    width: var(--ek-space-12);
  }
  .istat__cols i {
    font-style: normal;
    letter-spacing: 0.02em;
    text-align: center;
    text-transform: none;
  }
  /* Kanal noktaları dikey bir "veri hattı" üzerindeki duraklardır; hat alttaki tek panele iner. */
  .istat__rows {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .istat__rows::before {
    content: '';
    position: absolute;
    inset-block: calc(var(--ek-space-3) + var(--ek-space-1)) calc(var(--ek-space-4) * -1);
    inset-inline-start: calc(var(--ek-space-1) - var(--site-border-width));
    width: calc(var(--site-border-width) * 2);
    border-radius: var(--ek-radius-full);
    background: var(--site-action-border);
  }
  /* Hat boyunca aşağı akan ışık (statik: görünmez). Sözde öğe hattın boyundadır; translate yüzdesi = hat boyu. */
  .istat__rows::after {
    content: '';
    position: absolute;
    inset-block: 0 calc(var(--ek-space-4) * -1);
    inset-inline-start: calc(var(--ek-space-1) - var(--ek-space-2) * 0.625);
    width: calc(var(--ek-space-2) * 1.25);
    /* Düz nokta (keskin kenarlı; ışıma yok) — yalnız konum animasyonu için boyalı. */
    background: radial-gradient(circle at 50% var(--ek-space-2), var(--site-action) 0 var(--ek-space-1), transparent var(--ek-space-1)) no-repeat;
    opacity: 0;
    pointer-events: none;
  }
  .istat__hub {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    margin-top: var(--ek-space-4);
    margin-inline-start: calc(var(--ek-space-3) * -1);
    padding: var(--ek-space-1) var(--ek-space-3) var(--ek-space-1) var(--ek-space-1);
    border-radius: var(--ek-radius-md);
    background: var(--ek-color-chrome);
    color: var(--site-color-on-primary);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.04em;
  }
  .istat__hub-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-6);
    height: var(--ek-space-6);
    border: var(--site-border-width) solid var(--ek-color-chrome-border);
    border-radius: var(--ek-radius-sm);
    background: var(--ek-color-chrome-raised);
    color: var(--site-color-on-primary);
  }
  .istat__hub::after {
    content: '';
    position: absolute;
    inset: calc(var(--site-border-width) * -2);
    border: calc(var(--site-border-width) * 2) solid var(--site-action);
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
  }
  .istat__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--ek-space-3);
    padding-block: var(--ek-space-3);
    border-top: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .istat__row:first-child {
    border-top: 0;
  }
  .istat__name {
    color: var(--ek-color-content-default);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-medium);
  }
  .istat__meter {
    display: inline-flex;
    gap: var(--ek-space-1);
  }
  .istat__seg {
    position: relative;
    overflow: hidden;
    display: block;
    height: var(--ek-space-1);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-border-default);
    transform-origin: 0 50%;
  }
  .istat__seg.is-on {
    background: var(--site-action);
  }



  /*
   * Hareket (SITE-DL F1, kullanıcı isteği 2026-10-02 — N9'un "karolarda döngü yok" kararının yerini alır): üç karo
   * görseli de 12 sn'lik sakin bir döngü oynatır (scenes-loops.css: stock-single-winner, orders-merge,
   * integration-status); döngü yalnız görsel ekrandayken çalışır, hareket kapalıyken durağan son kare kalır.
   */

  /* Karo iki sütuna bölündüğü ara genişlikte (1024–1279) sonuç kartlarında rozet metnin üstünde (dar sütun). */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .stock .stock__result {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  /* Stok görseli: yeterli genişlikte soldan sağa akış (hatlar yatay). */
  @media (min-width: 48rem) {
    .stock__flow {
      grid-template-columns: minmax(0, 1fr) var(--ek-space-10) minmax(0, 1fr) var(--ek-space-10) minmax(0, 1.2fr);
      align-items: stretch;
    }
    .stock__orders,
    .stock__results {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: 1fr;
    }
    .stock__rail {
      min-height: 0;
    }
    .stock__wires--h {
      display: block;
    }
    .stock__wires--v {
      display: none;
    }
    .stock__carrier {
      --x0: 0%;
    }
    .stock__carrier--a {
      --y0: 25%;
      --m1: 50% 0;
      --m2: 100% 25%;
    }
    .stock__carrier--b {
      --y0: 75%;
      --m1: 50% 0;
      --m2: 100% -25%;
    }
    .stock__carrier--ok {
      --y0: 50%;
      --m1: 50% -25%;
      --m2: 100% -25%;
    }
    .stock__carrier--warn {
      --y0: 50%;
      --m1: 50% 25%;
      --m2: 100% 25%;
    }
    .stock__result {
      flex-direction: row;
      justify-content: flex-start;
      align-items: center;
    }
  }

  @media (min-width: 1024px) {
    .bento {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .tile {
      padding: var(--ek-space-10);
    }
    .tile__text {
      font-size: var(--ek-font-size-lg);
    }
    .tile--stock {
      grid-column: span 12;
      display: grid;
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.5fr);
      align-items: center;
      gap: var(--ek-space-12);
    }
    .tile--stock .tile__frame {
      margin-top: 0;
    }
    .tile--orders {
      grid-column: span 7;
    }
    .tile--status {
      grid-column: span 5;
    }
  }
  @media (max-width: 639px) {
    .tile {
      padding: var(--ek-space-5);
    }
    .stock,
    .ord {
      padding: var(--ek-space-4);
    }
    .ord__chans {
      gap: var(--ek-space-1);
    }
    .ord__chan {
      padding-inline: var(--ek-space-2);
    }
    .istat__cols i,
    .istat__seg {
      width: var(--ek-space-8);
    }
    .tile__title {
      font-size: var(--ek-font-size-xl);
    }
  }

  /* --- Günlük işler (S27a: bento ile aynı bölümde kompakt liste; kart/illüstrasyon yok, ikon + başlık + tek satır) --- */
  .daily {
    margin-top: var(--ek-space-8);
