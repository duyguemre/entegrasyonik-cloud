---
/**
 * AssistantTeaser — ana sayfada Entegrasyonik Otopilot bölümü (S18 bant → S24 premium vitrin, kullanıcı madde 6).
 *
 * Tüm metin `assistantTeaser` kaydından (src/data/assistant.ts); vaat cümleleri `agent-claims.ts` kaydından gelir
 * (tests/agent-claims.test.ts). Aşama rozeti / "yakında" dili YOK (K43).
 *
 * Tasarım: derin lacivert vitrin paneli — üstte ince aurora ışıması ve sönük ızgara, degrade ince çerçeve. Solda ad
 * (markanın ürün adı vurgulu), tek cümle değer ve iki eylem; altında üç adım (Gözler / Önerir / Onayınızla uygular)
 * ince ayraçlı sütunlar. Sağda dekoratif ajan konsolu parçası (aria-hidden): iki ajan satırı + onay kartı; dar
 * ekranda gizlenmez, sadeleşir. Hareket yok (statik vitrin; ana sayfa zaten animasyonlu sahnelerle dolu).
 *
 * S27a (SR4 madde 2, K50 — "Otopilot anasayfada daha albenili"): vitrin büyüdü ve sahnelendi — display ölçeğinde ad
 * (ürün adı gradyan vurgulu; BRAND §4 "tek koyu vitrin kartı" istisnası), konsol dört ajanın tamamını (ad + ne yaptığı +
 * durum) gösterir, arkasında yörünge halkaları ve ışıma; onay kapısı konsolun altında öne taşan ayrı bir kart. Üç adım
 * BAĞLI bir akış: numara + oklu hat, karar adımı ("Onayınızla uygular") vurgulu. Sayfadaki yeri yükseldi (Yetenekler'in
 * hemen ardından). Hâlâ hareketsiz (döngü bütçesi hero vitrininde).
 *
 * SITE-DL-02: vitrin düzleşti (aurora/degrade çerçeve/yörünge yok) ve konsola SAKİN bir yürüyüş eklendi: vurgu dört
 * ajan satırını (gözlüyor → öneri hazır → onayınızı bekliyor → raporlandı) sırayla gezer, sonunda onay kapısında durur —
 * "gözler, önerir, onayınızla uygular" döngüsü. Yalnız opacity; durağan hâlde vurgu yok (`data-scene="reveal"` yalnız
 * oynat/görünür kancası sağlar).
 */
import Section from '../Section.astro'
import Icon from './Icon.astro'
import { ASSISTANT_PATH, AGENT_BRAND, agentConsole, assistantTeaser as t } from '../../data/assistant'

const [lead, ...restName] = t.title.split(AGENT_BRAND)
// S27a (SR4 madde 2 "daha albenili"): konsol dört ajanın tamamını (durum + ne yaptığı) gösterir; onay kapısı öne çıkar.
const rows = agentConsole.rows
---

<Section id="ajan-bandi" labelledby="ajan-bandi-baslik" class="teaser-section">
  <div class="teaser" data-testid="assistant-teaser">
    <span class="teaser__aurora" aria-hidden="true"></span>
    <span class="teaser__grid" aria-hidden="true"></span>

    <div class="teaser__body">
      <p class="teaser__eyebrow">
        <span class="teaser__eyebrow-icon" aria-hidden="true"><Icon name="sparkle" size="sm" /></span>
        {t.eyebrow}
      </p>
      <h2 id="ajan-bandi-baslik">{lead}<span class="teaser__brand">{AGENT_BRAND}</span>{restName.join(AGENT_BRAND)}</h2>
      <p class="teaser__lead">{t.lead}</p>
      <div class="teaser__actions">
        <a class="teaser__cta" href={ASSISTANT_PATH} data-testid="assistant-teaser-link">
          <span>{t.cta}</span>
          <Icon name="arrow" size="sm" />
        </a>
        <a class="teaser__link" href={`${ASSISTANT_PATH}#demo`} data-testid="assistant-teaser-demo">
          {t.demo}
        </a>
      </div>
    </div>

    <div class="teaser__visual" aria-hidden="true" data-scene="reveal">
      <span class="teaser__orbit teaser__orbit--a"></span>
      <span class="teaser__orbit teaser__orbit--b"></span>
      <div class="deck">
        <div class="deck__bar">
          <span class="deck__glyph"><Icon name="sparkle" size="sm" /></span>
          <span class="deck__title">{agentConsole.windowTitle}</span>
          <span class="deck__mode">{agentConsole.status}</span>
        </div>
        <ul class="deck__rows" role="list">
          {
            rows.map((r) => (
              <li class="deck__row" data-state-kind={r.state}>
                <span class="deck__icon"><Icon name={r.icon} size="sm" /></span>
                <span class="deck__id">
                  <span class="deck__name">{r.name}</span>
                  <span class="deck__detail">{r.detail}</span>
                </span>
                <span class="deck__state"><i></i>{r.stateLabel}</span>
              </li>
            ))
          }
        </ul>
        <div class="deck__gate">
          <span class="deck__lock"><Icon name="lock" size="sm" /></span>
          <span class="deck__gate-body">
            <span class="deck__gate-title">{agentConsole.gateTitle}</span>
            <span class="deck__gate-text">{agentConsole.gateText}</span>
          </span>
          <span class="deck__approve">{agentConsole.gateApprove}</span>
        </div>
      </div>
    </div>

    <ol class="teaser__steps" role="list">
      {
        t.points.map((p, i) => (
          <li class:list={['step', { 'step--you': i === t.points.length - 1 }]}>
            <span class="step__icon" aria-hidden="true"><Icon name={p.icon} size="sm" /></span>
            <span class="step__body">
              <strong class="step__title">{p.title}</strong>
              <span class="step__text">{p.text}</span>
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</Section>

<style>
  .teaser-section:global(.section) {
    padding-block: calc(var(--site-section-y) * 0.75);
  }
  .teaser {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: var(--ek-space-8);
    overflow: hidden;
    padding: var(--ek-space-8) var(--ek-space-5);
    border-radius: calc(var(--site-radius-panel) + var(--ek-space-2));
    background:
      radial-gradient(70% 60% at 85% -10%, color-mix(in srgb, var(--site-accent-on-dark) 22%, transparent), transparent 70%),
      radial-gradient(60% 70% at -10% 110%, color-mix(in srgb, var(--ek-color-primary-lighten) 45%, transparent), transparent 70%),
      linear-gradient(160deg, var(--site-stage-base) 0%, var(--site-stage-deep) 70%);
    box-shadow: var(--site-shadow-panel);
    color: var(--site-text-on-dark-body);
  }
  /* İnce degrade çerçeve (premium kenar) */
  .teaser::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    padding: var(--site-border-width);
    border-radius: inherit;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--site-accent-on-dark) 70%, transparent),
      color-mix(in srgb, var(--ek-color-background) 10%, transparent) 40%,
      color-mix(in srgb, var(--ek-color-background) 6%, transparent) 70%,
      color-mix(in srgb, var(--site-accent-on-dark) 40%, transparent)
    );
    -webkit-mask:
      linear-gradient(var(--ek-color-content-strong) 0 0) content-box,
      linear-gradient(var(--ek-color-content-strong) 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }
  /* Üst kenarda yumuşak aurora ışığı + sönük ızgara (derinlik; yalnızca dekor) */
  .teaser__aurora {
    position: absolute;
    inset: -40% 10% auto 30%;
    z-index: -1;
    height: 70%;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--site-accent-on-dark) 26%, transparent), transparent);
    filter: blur(2.5rem);
    pointer-events: none;
  }
  .teaser__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(color-mix(in srgb, var(--ek-color-background) 5%, transparent) var(--site-border-width), transparent var(--site-border-width)),
      linear-gradient(90deg, color-mix(in srgb, var(--ek-color-background) 5%, transparent) var(--site-border-width), transparent var(--site-border-width));
    background-size: var(--ek-space-12) var(--ek-space-12);
    -webkit-mask-image: radial-gradient(80% 70% at 70% 20%, var(--ek-color-content-strong), transparent 75%);
    mask-image: radial-gradient(80% 70% at 70% 20%, var(--ek-color-content-strong), transparent 75%);
    pointer-events: none;
  }

  /* --- Metin --- */
  .teaser__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ek-space-5);
    min-width: 0;
  }
  .teaser__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    margin: 0;
    color: var(--site-accent-on-dark);
    font-size: var(--site-card-eyebrow-size);
    font-weight: var(--site-card-eyebrow-weight);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .teaser__eyebrow-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-6);
    height: var(--ek-space-6);
    border-radius: var(--ek-radius-md);
    background: var(--site-gradient-accent-on-dark);
    color: var(--site-stage-deep);
  }
  .teaser h2 {
    font-size: var(--site-font-display-lg);
    color: var(--site-text-on-dark-heading);
    font-size: var(--site-font-display-md);
    font-weight: var(--site-font-display-weight);
    line-height: var(--site-font-display-line-height);
    letter-spacing: var(--site-font-display-tracking);
  }
  .teaser__brand {
    background: var(--site-gradient-accent-on-dark);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .teaser__lead {
    max-width: 34rem;
    font-size: var(--ek-font-size-lg);
    line-height: var(--site-font-body-line-height);
  }
  .teaser__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ek-space-3) var(--ek-space-6);
  }
  .teaser__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    min-height: var(--site-tap-target);
    padding: var(--ek-space-2) var(--ek-space-5);
    border-radius: var(--ek-radius-md);
    background: var(--ek-color-background);
    color: var(--ek-color-primary);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-semibold);
    text-decoration: none;
    transition: background-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .teaser__cta:hover {
    background: color-mix(in srgb, var(--ek-color-background) 88%, var(--site-accent-on-dark));
  }
  .teaser__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--site-tap-target);
    color: var(--site-text-on-dark-heading);
    font-weight: var(--ek-font-weight-semibold);
  }
  /* site-wdg W06: global açık zemin `a:hover` rengi (koyu teal) lacivert panelde ~2:1'e düşürüyordu. */
  .teaser__link:hover {
    color: var(--site-accent-on-dark);
  }
  .teaser__cta:focus-visible,
  .teaser__link:focus-visible {
    outline: var(--site-focus-ring-width) solid var(--ek-color-background);
    outline-offset: var(--site-focus-ring-offset);
  }

  /* --- Dekoratif ajan paneli --- */
  .teaser__visual {
    min-width: 0;
  }
  .deck {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
    padding: var(--ek-space-4);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--site-radius-panel);
    background: color-mix(in srgb, var(--site-stage-deep) 62%, transparent);
    box-shadow:
      inset 0 var(--site-border-width) 0 color-mix(in srgb, var(--ek-color-background) 10%, transparent),
      var(--site-shadow-panel);
    font-size: var(--ek-font-size-sm);
  }
  .deck__bar {
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
    padding-bottom: var(--ek-space-3);
    border-bottom: var(--site-border-width) solid var(--site-glass-border);
  }
  .deck__glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-6);
    height: var(--ek-space-6);
    border-radius: var(--ek-radius-md);
    background: var(--site-gradient-accent-on-dark);
    color: var(--site-stage-deep);
  }
  .deck__title {
    color: var(--site-text-on-dark-heading);
    font-weight: var(--ek-font-weight-semibold);
  }
  .deck__mode {
    margin-inline-start: auto;
    padding: 0 var(--ek-space-2);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-full);
    color: var(--site-text-on-dark-meta);
    font-size: var(--ek-font-size-xs);
  }
  .deck__rows {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .deck__row {
    display: flex;
    align-items: center;
    gap: var(--ek-space-3);
    padding: var(--ek-space-3);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-lg);
    background: var(--site-glass-bg);
  }
  .deck__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-8);
    height: var(--ek-space-8);
    border-radius: var(--ek-radius-md);
    background: color-mix(in srgb, var(--site-accent-on-dark) 14%, transparent);
    color: var(--site-accent-on-dark);
  }
  .deck__id {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .deck__detail {
    overflow: hidden;
    color: var(--site-text-on-dark-meta);
    font-size: var(--ek-font-size-xs);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .deck__name {
    min-width: 0;
    overflow: hidden;
    color: var(--site-text-on-dark-heading);
    font-weight: var(--ek-font-weight-medium);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .deck__state {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-1);
    margin-inline-start: auto;
    padding: 0 var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: color-mix(in srgb, var(--site-accent-on-dark) 14%, transparent);
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    white-space: nowrap;
  }
  .deck__state i {
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: 50%;
    background: var(--site-accent-on-dark);
  }
  .deck__row[data-state-kind='wait'] {
    border-color: color-mix(in srgb, var(--ek-color-amber) 45%, transparent);
  }
  .deck__row[data-state-kind='wait'] .deck__state i {
    background: var(--ek-color-amber);
  }
  .deck__row[data-state-kind='report'] .deck__state i {
    background: var(--ek-color-success);
  }
  .deck__row[data-state-kind='propose'] .deck__state i {
    background: var(--ek-color-primary-lighten);
    box-shadow: 0 0 0 var(--site-border-width) var(--site-text-on-dark-heading);
  }
  .deck__gate {
    position: relative;
    z-index: 1;
    display: flex;
    box-shadow: 0 var(--ek-space-4) var(--ek-space-10) calc(var(--ek-space-4) * -1) color-mix(in srgb, var(--ek-color-content-strong) 80%, transparent);
    background-color: color-mix(in srgb, var(--site-stage-deep) 85%, transparent);
    align-items: center;
    gap: var(--ek-space-3);
    padding: var(--ek-space-3);
    border: var(--site-border-width) dashed color-mix(in srgb, var(--ek-color-amber) 55%, transparent);
    border-radius: var(--ek-radius-lg);
    background: color-mix(in srgb, var(--ek-color-amber) 8%, transparent);
  }
  .deck__lock {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: var(--ek-space-8);
    height: var(--ek-space-8);
    border-radius: 50%;
    background: color-mix(in srgb, var(--ek-color-amber) 22%, transparent);
    color: var(--ek-color-amber-light);
  }
  .deck__gate-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .deck__gate-title {
    color: var(--site-text-on-dark-heading);
    font-weight: var(--ek-font-weight-semibold);
  }
  .deck__gate-text {
    color: var(--site-text-on-dark-meta);
    font-size: var(--ek-font-size-xs);
  }
  .deck__approve {
    flex: none;
    margin-inline-start: auto;
    padding: var(--ek-space-1) var(--ek-space-3);
    border-radius: var(--ek-radius-md);
    background: var(--site-accent-on-dark);
    color: var(--site-stage-deep);
    font-weight: var(--ek-font-weight-bold);
    box-shadow: var(--site-glow-ring);
  }

  /* Yörünge halkaları + ışıma: konsolun arkasında derinlik (dekor; hareketsiz). */
  .teaser__visual {
    position: relative;
    isolation: isolate;
  }
  .teaser__orbit {
    position: absolute;
    z-index: -1;
    inset: 50% auto auto 50%;
    aspect-ratio: 1 / 1;
    border: var(--site-border-width) solid color-mix(in srgb, var(--site-accent-on-dark) 22%, transparent);
    border-radius: var(--ek-radius-full);
    translate: -50% -50%;
    pointer-events: none;
  }
  .teaser__orbit--a {
    width: 115%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--site-accent-on-dark) 16%, transparent), transparent);
  }
  .teaser__orbit--b {
    width: 145%;
    border-style: dashed;
    opacity: 0.6;
  }

  /* --- Üç adım: bağlı akış (oklu hat), karar adımı vurgulu --- */
  .teaser__steps {
    display: grid;
    gap: var(--ek-space-5);
    margin: 0;
    padding: var(--ek-space-6) 0 0;
    border-top: var(--site-border-width) solid var(--site-glass-border);
    list-style: none;
  }
  .step {
    display: flex;
    align-items: flex-start;
    gap: var(--ek-space-3);
    min-width: 0;
  }
  .step {
    position: relative;
  }
  .step--you .step__icon {
    border-color: var(--site-accent-on-dark);
    background: var(--site-gradient-accent-on-dark);
    color: var(--site-stage-deep);
    box-shadow: var(--site-glow-ring);
  }
  .step__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: var(--ek-space-8);
    height: var(--ek-space-8);
    border: var(--site-border-width) solid color-mix(in srgb, var(--site-accent-on-dark) 40%, transparent);
    border-radius: var(--ek-radius-md);
    color: var(--site-accent-on-dark);
  }
  .step__body {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
  }
  .step__title {
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-semibold);
  }
  .step__text {
    color: var(--site-text-on-dark-body);
    font-size: var(--ek-font-size-sm);
    line-height: var(--ek-line-height-normal);
  }

  /* Dar ekran: panel sadeleşir (mod hapı ve onay metni gizli) */
  @media (max-width: 479.98px) {
    .deck__mode,
    .deck__gate-text,
    .deck__detail,
    .deck__row:nth-child(n + 3),
    .teaser__orbit--b {
      display: none;
    }
  }
  @media (min-width: 768px) {
    .teaser__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0;
    }
    .step {
      padding-inline: var(--ek-space-5) var(--ek-space-12);
    }
    .step:first-child {
      padding-inline-start: 0;
    }
    /* Adımlar arası ok: sütunun sağ kenarında ince hat + uç (sonraki adımın ikonuna bakar). */
    .step:not(:last-child)::after,
    .step:not(:last-child)::before {
      content: '';
      position: absolute;
      inset-block-start: calc(var(--ek-space-8) / 2);
      pointer-events: none;
    }
    .step:not(:last-child)::after {
      inset-inline-end: var(--ek-space-1);
      width: var(--ek-space-8);
      height: var(--site-border-width);
      background: linear-gradient(90deg, transparent, var(--site-accent-on-dark));
    }
    .step:not(:last-child)::before {
      inset-inline-end: var(--ek-space-1);
      width: var(--ek-space-2);
      height: var(--ek-space-2);
      margin-block-start: calc(var(--ek-space-1) * -1);
      border-block-start: var(--site-border-width) solid var(--site-accent-on-dark);
      border-inline-end: var(--site-border-width) solid var(--site-accent-on-dark);
      rotate: 45deg;
    }
  }
  @media (min-width: 1024px) {
    .teaser {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: center;
      column-gap: var(--ek-space-16);
      row-gap: var(--ek-space-12);
      padding: var(--site-space-24) var(--ek-space-16) var(--ek-space-12);
    }
    .teaser__steps {
      grid-column: 1 / -1;
    }
  }

  /* ================= SITE-DL-02 — uygulamanın tasarım dili (frontend/DESIGN_SYSTEM.md §35) =================
     Düz yüzey + 1px ince çerçeve + kart yarıçapı; gölge, degrade, ışıma, hover yükselmesi yok; tek vurgu eylem
     mavisi; ikonlar çerçeveli köşeli kutuda; hap rozet yerine köşeli çip. Yukarıdaki kuralları EZER (aynı özgüllük,
     kaynak sırası). */

