---
/**
 * Kanıt şeridi (S7) — hero'nun hemen altında: doğrulanabilir dört sayı/etiket + kayan (marquee) entegrasyon şeridi.
 * Değerlerin HEPSİ kayıttan gelir: entegrasyon sayısı `getPublicIntegrations()`, deneme süresi `getPublicTrial()`,
 * algoritma adı güvenlik yeteneği metninden, kiracı ayrımı yetenek başlığından. Uydurma müşteri/ölçüm/logo YOK.
 * Sahneler: `data-scene="stat-counters"` (sayaçlar görünür olunca 0'dan değere sayar; JS yok/hareket kapalıysa
 * son değer statiktir) ve `data-scene="marquee"` (şerit yalnızca oynatma durumunda ve görünürken kayar).
 * Şeritte ikinci küme aria-hidden kopyadır (kesintisiz döngü); erişilebilir liste birinci kümedir.
 */
import Icon from './Icon.astro'
import { getPublicIntegrations } from '../../data/integrations'
import { getPublicCapabilities } from '../../data/capabilities'
import { getPublicTrial } from '../../data/plans'

const items = getPublicIntegrations()
const trial = getPublicTrial()
const security = getPublicCapabilities('security')
const algorithm = security.find((c) => c.id === 'secrets-encryption')?.summary.match(/AES-256-GCM/)?.[0]
const tenant = security.find((c) => c.id === 'tenant-database')
const kinds = [...new Set(items.map((i) => i.kindLabel))].join(', ')
---

<section class="proof" aria-label="Bir bakışta">
  <div class="proof__inner">
    <ul class="stats" data-scene="stat-counters" data-testid="stat-list">
      <li class="stat" data-reveal>
        <p class="stat__value" data-testid="integration-count">
          <span class="stat__num" data-count={items.length}>{items.length}</span>
        </p>
        <p class="stat__label">uygulanan entegrasyon</p>
        <p class="stat__sub">{kinds}</p>
      </li>
      <li class="stat" data-reveal>
        <p class="stat__value"><span class="stat__num" data-count={trial.days}>{trial.days}</span></p>
        <p class="stat__label">gün ücretsiz deneme</p>
        <p class="stat__sub">{!trial.cardRequired ? 'Kart bilgisi gerekmez' : 'Deneme süresince'}</p>
      </li>
      {
        algorithm && (
          <li class="stat" data-reveal>
            <p class="stat__value stat__value--text">{algorithm}</p>
            <p class="stat__label">ile şifreli saklama</p>
            <p class="stat__sub">Entegrasyon anahtarları</p>
          </li>
        )
      }
      {
        tenant && (
          <li class="stat" data-reveal>
            <p class="stat__value stat__value--icon"><Icon name="database" size="lg" /></p>
            <p class="stat__label">Ayrı veritabanı</p>
            <p class="stat__sub">Her müşteri hesabı için</p>
          </li>
        )
      }
    </ul>

    <div class="marquee" data-scene="marquee" role="group" aria-label="Bugün bağlanabilen entegrasyonlar" data-testid="marquee">
      <div class="marquee__track">
        <ul class="marquee__set" data-testid="marquee-list">
          {
            items.map((i) => (
              <li class="marquee__item" data-code={i.code}>
                <span class="marquee__mono" aria-hidden="true">{i.name.slice(0, 1)}</span>
                <span class="marquee__name">{i.name}</span>
                <span class="marquee__kind">{i.kindLabel}</span>
              </li>
            ))
          }
        </ul>
        <ul class="marquee__set marquee__set--copy" aria-hidden="true">
          {
            items.map((i) => (
              <li class="marquee__item" data-code={i.code}>
                <span class="marquee__mono">{i.name.slice(0, 1)}</span>
                <span class="marquee__name">{i.name}</span>
                <span class="marquee__kind">{i.kindLabel}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .proof {
    position: relative;
    background: var(--ek-color-background);
    border-bottom: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .proof::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: var(--site-border-width);
    background: var(--site-gradient-hairline);
  }
  .proof__inner {
    width: 100%;
    margin-inline: auto;
    padding: var(--ek-space-10) var(--site-gutter) var(--ek-space-8);
    max-width: calc(var(--site-container-max) + 2 * var(--site-gutter));
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-8);
  }

  /* --- Sayılar --- */
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--ek-space-6) var(--ek-space-4);
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
    padding-inline-start: var(--ek-space-4);
    border-inline-start: var(--site-border-width) solid var(--ek-color-border-default);
    min-width: 0;
  }
  .stat__value {
    display: flex;
    align-items: center;
    min-height: var(--ek-space-10);
    max-width: none;
    color: var(--ek-color-content-strong);
    font-size: var(--site-font-display-md);
    font-weight: var(--site-font-display-weight);
    letter-spacing: var(--site-font-display-tracking);
    line-height: 1;
  }
  .stat__value--text {
    font-size: var(--ek-font-size-xl);
    white-space: nowrap;
    background: linear-gradient(100deg, var(--ek-color-secondary-darken-1), var(--ek-color-primary-darken-1));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--ek-color-secondary-darken-1);
  }
  .stat__value--icon {
    color: var(--ek-color-primary-darken-1);
  }
  .stat__num {
    display: inline-block;
    min-width: 2ch;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(180deg, var(--ek-color-content-strong), var(--ek-color-primary-darken-1));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .stat__label {
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-lg);
    font-weight: var(--ek-font-weight-semibold);
    line-height: var(--ek-line-height-tight);
  }
  .stat__sub {
    color: var(--ek-color-content-muted);
    font-size: var(--ek-font-size-md);
    line-height: var(--ek-line-height-normal);
  }

  /* --- Şerit --- */
  .marquee {
    position: relative;
    overflow: hidden;
    border-block: var(--site-border-width) solid var(--ek-color-border-default);
    padding-block: var(--ek-space-4);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    max-width: none;
  }
  .marquee__set {
    display: flex;
    flex: none;
    gap: var(--ek-space-4);
    padding-inline-end: var(--ek-space-4);
  }
  .marquee__set--copy {
    display: none;
  }
  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-3);
    padding: var(--ek-space-2) var(--ek-space-5) var(--ek-space-2) var(--ek-space-2);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface-muted);
    white-space: nowrap;
    transition:
      border-color var(--ek-duration-base) var(--ek-easing-standard),
      background var(--ek-duration-base) var(--ek-easing-standard);
  }
  .marquee__item:hover {
    border-color: color-mix(in srgb, var(--chan, var(--ek-color-border-strong)) 55%, var(--ek-color-border-default));
    background: var(--ek-color-surface);
  }
  .marquee__mono {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-10);
    height: var(--ek-space-10);
    border-radius: var(--ek-radius-full);
    background: linear-gradient(140deg, var(--chan, var(--ek-color-primary)), var(--chan-fill, var(--ek-color-primary-darken-1)));
    box-shadow: var(--ek-shadow-sm);
    color: var(--site-color-on-primary);
    font-size: var(--ek-font-size-2xl);
    font-weight: var(--ek-font-weight-bold);
    transition:
      transform var(--ek-duration-base) var(--ek-easing-standard),
      box-shadow var(--ek-duration-base) var(--ek-easing-standard);
  }
  /* Şerit üzerine gelince (döngü de durur) monogram hafifçe büyür — dikkat çeker, hover'a özel, döngüden bağımsız. */
  .marquee__item:hover .marquee__mono {
    transform: scale(1.08);
    box-shadow: var(--ek-shadow-md);
  }
  .marquee__name {
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-lg);
    font-weight: var(--ek-font-weight-semibold);
  }
  .marquee__kind {
    color: var(--ek-color-content-muted);
    font-size: var(--ek-font-size-sm);
  }

  /*
   * Hareket tercihi yoksa şerit tek satır + kenar solmasıdır (düzen JS'ten ÖNCE de aynıdır → CLS yok);
   * reduced-motion'da şerit sarılan, ortalanmış, tam görünür bir listedir (ikinci küme gizli).
   */
  .marquee {
    -webkit-mask-image: linear-gradient(to right, transparent, var(--ek-color-content-strong) 8%, var(--ek-color-content-strong) 92%, transparent);
    mask-image: linear-gradient(to right, transparent, var(--ek-color-content-strong) 8%, var(--ek-color-content-strong) 92%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .marquee__set--copy {
      display: flex;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
      border-block: 0;
      padding-block: 0;
    }
    .marquee__track {
      width: auto;
    }
    .marquee__set {
      flex: 1 1 100%;
      flex-wrap: wrap;
      justify-content: center;
      padding-inline-end: 0;
    }
  }

  @media (min-width: 768px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--ek-space-6);
    }
    .proof__inner {
      padding-block: var(--ek-space-12) var(--ek-space-10);
    }
  }
</style>
