---
/**
 * Güven şeridi — hero'nun hemen ardından, AÇIK zeminde dört üst seviye fayda (S7 → S24 → S27a).
 *
 * S27a (SR4-HOME madde 1, K50): hero bir KARŞILAMA ekranıdır; "Tek merkez / Eşzamanlı stok / 14 gün ücretsiz / Kurumsal
 * güvenlik" kutuları hero'dan ÇIKTI. Hero (koyu sahne) biter, şerit açık zeminde başlar: kutu/kart yok, dört sütun,
 * sütunlar arası saç çizgisi, büyük ince ikon + güçlü kısa başlık + tek satır alt metin (editoryal "olgu şeridi").
 * Kayan yetenek şeridi (marquee) kaldırıldı: aynı işler hemen aşağıdaki Yetenekler bölümünde listelenir (tekrar) ve
 * hero vitrini zaten döngü taşıyor (BRAND §4 "görünür ekranda en fazla bir döngü", NEXT_TASKS N9).
 *
 * N5 (kanıtlanabilir güven): her öğe bir kayda bağlıdır — yetenek kaydı (`capabilities.ts`, kayıt yoksa öğe çıkar) ya da
 * deneme kaydı (`plans.ts`). Uydurma müşteri/ölçüm/logo/"binlerce işletme" YOK; tek sayı deneme süresidir.
 * `data-scene="stat-counters"`: deneme günü görünür olunca 0'dan sayar (JS yok / hareket kapalıysa son değer statik).
 */
import Icon from './Icon.astro'
import { getPublicCapabilities } from '../../data/capabilities'
import { getPublicTrial } from '../../data/plans'

const trial = getPublicTrial()
const capIds = new Set(getPublicCapabilities().map((c) => c.id))

/** Her öğe: başlık + alt satır + dayandığı kayıt(lar). `source` test için DOM'a yazılır (data-source). */
const pillars = [
  { icon: 'layers' as const, title: 'Tek merkez', sub: 'Tüm satış kanallarınız tek panelde', source: ['multi-channel-products', 'unified-orders'] },
  { icon: 'stock' as const, title: 'Eşzamanlı stok', sub: 'Siparişte stok rezerve edilir, aşırı satış riski azalır', source: ['stock-reservation'] },
  { icon: 'shield' as const, title: 'Kurumsal güvenlik', sub: 'Verileriniz yalnızca size ait, anahtarlarınız şifreli', source: ['secrets-encryption', 'tenant-database'] },
].filter((p) => p.source.every((id) => capIds.has(id)))
---

<section class="proof" aria-label="Bir bakışta" data-testid="proof">
  <div class="proof__inner">
    <ul class="facts" data-scene="stat-counters" data-testid="stat-list">
      {
        pillars.slice(0, 2).map((p) => (
          <li class="fact" data-reveal data-source={p.source.join(' ')}>
            <span class="fact__icon" aria-hidden="true"><Icon name={p.icon} size="md" /></span>
            <p class="stat__label">{p.title}</p>
            <p class="fact__sub">{p.sub}</p>
          </li>
        ))
      }
      <li class="fact" data-reveal data-testid="trial-stat" data-source="trial">
        <span class="fact__icon" aria-hidden="true"><Icon name="clock" size="md" /></span>
        <p class="stat__label"><span class="stat__num" data-count={trial.days}>{trial.days}</span> gün ücretsiz</p>
        <p class="fact__sub">{!trial.cardRequired ? 'Kart bilgisi gerekmez' : 'Deneme süresince tüm özellikler'}</p>
      </li>
      {
        pillars.slice(2).map((p) => (
          <li class="fact" data-reveal data-source={p.source.join(' ')}>
            <span class="fact__icon" aria-hidden="true"><Icon name={p.icon} size="md" /></span>
            <p class="stat__label">{p.title}</p>
            <p class="fact__sub">{p.sub}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /*
   * Açık zemin (sayfa zemini); üstte koyu hero biter. Şerit kartsızdır: üst ve alt saç çizgisi bir "cetvel" gibi durur,
   * sütunlar ince dikey çizgiyle ayrılır. Vurgu yalnız ikonda (teal) — BRAND §4 vurgu ekonomisi.
   */
  .proof {
    position: relative;
    background: var(--ek-color-background);
    color: var(--site-text-body);
    padding-block: var(--ek-space-10) 0;
  }
  .proof__inner {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--site-gutter);
    max-width: calc(var(--site-container-max) + 2 * var(--site-gutter));
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-block: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .fact {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--ek-space-3);
    align-items: start;
    padding: var(--ek-space-5) var(--ek-space-4);
  }
  /* Saç çizgisi ayraçlar: dar ekranda 2x2 (dikey + yatay), geniş ekranda tek satır dört sütun (yalnız dikey). */
  .fact:nth-child(odd)::after,
  .fact:nth-child(-n + 2)::before {
    content: '';
    position: absolute;
    background: var(--ek-color-border-default);
    pointer-events: none;
  }
  .fact:nth-child(odd)::after {
    inset-block: var(--ek-space-4);
    inset-inline-end: 0;
    width: var(--site-border-width);
  }
  .fact:nth-child(-n + 2)::before {
    inset-inline: var(--ek-space-4);
    inset-block-end: 0;
    height: var(--site-border-width);
  }
  .fact__icon {
    grid-row: span 2;
    display: inline-grid;
    place-items: center;
    width: var(--ek-icon-tile-md);
    height: var(--ek-icon-tile-md);
    border-radius: var(--ek-radius-tile);
    color: var(--site-accent);
    background: var(--site-accent-soft);
  }
  .stat__label {
    margin: 0;
    font-size: var(--ek-font-size-lg);
    font-weight: var(--site-font-display-weight);
    letter-spacing: var(--site-font-display-tracking);
    line-height: var(--ek-line-height-tight);
    color: var(--site-text-heading);
  }
  .stat__num {
    color: var(--site-accent);
    font-variant-numeric: tabular-nums;
  }
  .fact__sub {
    margin: var(--ek-space-1) 0 0;
    font-size: var(--ek-font-size-sm);
    line-height: var(--ek-line-height-normal);
    color: var(--site-text-meta);
  }

  @media (min-width: 1024px) {
    .proof {
      padding-block: var(--ek-space-12) 0;
    }
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .fact {
      padding: var(--ek-space-6) var(--ek-space-6);
    }
    .fact:first-child {
      padding-inline-start: 0;
    }
    .fact:nth-child(-n + 2)::before {
      content: none;
    }
    .fact:nth-child(odd)::after {
      content: none;
    }
    .fact:not(:last-child)::after {
      content: '';
      position: absolute;
      inset-block: var(--ek-space-5);
      inset-inline-end: 0;
      width: var(--site-border-width);
      background: var(--ek-color-border-default);
    }
    .stat__label {
      font-size: var(--ek-font-size-xl);
    }
  }
  @media (max-width: 479px) {
    .fact {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--ek-space-4) var(--ek-space-3);
    }
    .fact__icon {
      grid-row: auto;
      width: var(--ek-icon-tile-sm);
      height: var(--ek-icon-tile-sm);
      margin-block-end: var(--ek-space-2);
    }
    .stat__label {
      font-size: var(--ek-font-size-md);
    }
    .fact__sub {
      font-size: var(--ek-font-size-xs);
    }
  }
</style>
