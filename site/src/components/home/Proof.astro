---
/**
 * Fayda şeridi (S7; S12 pazarlama dili; S13 premium) — hero'nun hemen altında dört üst seviye fayda + kayan yetenek şeridi.
 * S12 (kullanıcı geri bildirimi): "uygulanan entegrasyon sayısı", algoritma adı, "ayrı veritabanı" gibi durum/teknik
 * ifadeler kaldırıldı; şeritte kanal ADI yerine panelde yönetilen işler yazılır. Her fayda kanıtlı bir yetenek
 * kaydına bağlıdır (kayıt yoksa gösterilmez); tek sayı deneme süresidir (seçiciden). Uydurma müşteri/ölçüm/logo YOK.
 *
 * S13 (kullanıcı: "daha albenili" / "kayan yazı formunu çok daha profesyonel, premium bir hale çevir"):
 *  - Dört fayda, hero'nun alt kenarına taşan (koyu sahneden açık zemine köprü kuran) cam kartlardır: degrade ince
 *    kenar, ışımalı ikon karosu, güçlü tipografi; giriş sırayla yükselir (genel `[data-reveal]`), imleçle ışık/eğim
 *    (`data-tilt`, global.css — hareket kapalıyken nötr).
 *  - Şerit: sabit etiket sütunu + ikon çipleri; kenarlarda yumuşak maske; tek sıra, sakin tempo (30 sn/küme),
 *    üzerine gelince durur. Reduced-motion'da sarılan, ortalanmış, tam görünür liste.
 * Sahneler: `data-scene="stat-counters"` (deneme günü sayacı görünür olunca 0'dan sayar; JS yok/hareket kapalıysa
 * son değer statiktir) ve `data-scene="marquee"` (şerit yalnızca oynatma durumunda ve görünürken kayar).
 * Şeritte ikinci küme aria-hidden kopyadır (kesintisiz döngü); erişilebilir liste birinci kümedir.
 */
import Icon from './Icon.astro'
import { getPublicCapabilities } from '../../data/capabilities'
import { getPublicTrial } from '../../data/plans'

const trial = getPublicTrial()
const capIds = new Set(getPublicCapabilities().map((c) => c.id))
const has = (...ids: string[]) => ids.every((id) => capIds.has(id))

const pillars = [
  { icon: 'layers' as const, title: 'Tek merkez', sub: 'Tüm satış kanallarınız tek panelde', show: has('multi-channel-products', 'unified-orders') },
  { icon: 'stock' as const, title: 'Eşzamanlı stok', sub: 'Siparişte stok rezerve edilir, aşırı satış riski azalır', show: has('stock-reservation') },
  { icon: 'shield' as const, title: 'Kurumsal güvenlik', sub: 'Şifreli anahtarlar ve veri izolasyonu', show: has('secrets-encryption', 'tenant-database') },
].filter((p) => p.show)

// Şerit: panelde yönetilen işler (her biri yayımlanmış bir yetenek kaydına karşılık gelir).
const ribbon = [
  { icon: 'layers' as const, label: 'Ürün ve fiyat yönetimi', id: 'multi-channel-products' },
  { icon: 'stock' as const, label: 'Merkezi stok', id: 'stock-reservation' },
  { icon: 'orders' as const, label: 'Birleşik sipariş listesi', id: 'unified-orders' },
  { icon: 'returns' as const, label: 'İade talepleri', id: 'returns' },
  { icon: 'chat' as const, label: 'Müşteri soruları', id: 'questions' },
  { icon: 'finance' as const, label: 'Hakediş görünümü', id: 'finance' },
  { icon: 'notice' as const, label: 'Kargo ve fatura bildirimi', id: 'shipping-invoice-notice' },
  { icon: 'database' as const, label: 'ERP kataloğu', id: 'erp-read' },
].filter((r) => capIds.has(r.id))
---

<section class="proof" aria-label="Bir bakışta">
  <div class="proof__inner">
    <ul class="stats" data-scene="stat-counters" data-testid="stat-list">
      {
        pillars.slice(0, 2).map((p) => (
          <li class="stat" data-reveal data-tilt>
            <span class="stat__icon" aria-hidden="true"><Icon name={p.icon} size="md" /></span>
            <p class="stat__label">{p.title}</p>
            <p class="stat__sub">{p.sub}</p>
          </li>
        ))
      }
      <li class="stat" data-reveal data-tilt data-testid="trial-stat">
        <span class="stat__icon" aria-hidden="true"><Icon name="clock" size="md" /></span>
        <p class="stat__label"><span class="stat__num" data-count={trial.days}>{trial.days}</span> gün ücretsiz</p>
        <p class="stat__sub">{!trial.cardRequired ? 'Kart bilgisi gerekmez' : 'Deneme süresince tüm özellikler'}</p>
      </li>
      {
        pillars.slice(2).map((p) => (
          <li class="stat" data-reveal data-tilt>
            <span class="stat__icon" aria-hidden="true"><Icon name={p.icon} size="md" /></span>
            <p class="stat__label">{p.title}</p>
            <p class="stat__sub">{p.sub}</p>
          </li>
        ))
      }
    </ul>

    <div class="marquee" data-scene="marquee" role="group" aria-labelledby="marquee-title" data-testid="marquee">
      <p class="marquee__title" id="marquee-title">
        <span class="marquee__eyebrow">Tek panelde</span>
        <span class="marquee__heading">yönettikleriniz</span>
      </p>
      <div class="marquee__rail">
        <div class="marquee__track">
          <ul class="marquee__set" data-testid="marquee-list">
            {
              ribbon.map((r) => (
                <li class="marquee__item">
                  <span class="marquee__mono" aria-hidden="true"><Icon name={r.icon} size="sm" /></span>
                  <span class="marquee__name">{r.label}</span>
                </li>
              ))
            }
          </ul>
          <ul class="marquee__set marquee__set--copy" aria-hidden="true">
            {
              ribbon.map((r) => (
                <li class="marquee__item">
                  <span class="marquee__mono"><Icon name={r.icon} size="sm" /></span>
                  <span class="marquee__name">{r.label}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .proof {
    position: relative;
    z-index: 1;
    background:
      radial-gradient(60% 120% at 50% 0%, color-mix(in srgb, var(--ek-color-secondary) 7%, transparent), transparent 70%),
      var(--ek-color-background);
    border-bottom: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .proof__inner {
    width: 100%;
    margin-inline: auto;
    padding: 0 var(--site-gutter) var(--ek-space-10);
    max-width: calc(var(--site-container-max) + 2 * var(--site-gutter));
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-10);
  }

  /* --- Fayda kartları: hero'nun alt kenarına taşar (koyu sahneden açık zemine köprü) --- */
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--ek-space-3);
    margin-top: calc(var(--ek-space-10) * -1);
  }
  .stat {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
    min-width: 0;
    padding: var(--ek-space-5) var(--ek-space-4);
    /* Degrade ince kenar: iç zemin padding-box, teal -> nötr kenar border-box */
    border: var(--site-border-width) solid transparent;
    border-radius: var(--site-radius-panel);
    background:
      linear-gradient(180deg, var(--ek-color-background) 0%, var(--ek-color-surface-muted) 100%) padding-box,
      linear-gradient(
          160deg,
          color-mix(in srgb, var(--ek-color-secondary) 55%, var(--ek-color-border-default)) 0%,
          var(--ek-color-border-default) 40%,
          var(--ek-color-border-default) 100%
        )
        border-box;
    box-shadow:
      0 0.0625rem 0.125rem color-mix(in srgb, var(--ek-color-content-strong) 6%, transparent),
      0 1.25rem 2.5rem -1.25rem color-mix(in srgb, var(--ek-color-primary-darken-1) 32%, transparent);
  }
  /* sakin ışıma: ikonun arkasında yumuşak, statik teal hâle */
  .stat::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset-block-start: calc(var(--ek-space-6) * -1);
    inset-inline-start: calc(var(--ek-space-6) * -1);
    width: calc(var(--ek-space-16) * 2);
    aspect-ratio: 1 / 1;
    border-radius: var(--ek-radius-full);
    background: radial-gradient(closest-side, color-mix(in srgb, var(--ek-color-secondary) 16%, transparent), transparent);
    pointer-events: none;
  }
  .stat__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-10);
    height: var(--ek-space-10);
    margin-bottom: var(--ek-space-3);
    border: var(--site-border-width) solid var(--site-accent-line);
    border-radius: var(--ek-radius-lg);
    background: linear-gradient(145deg, color-mix(in srgb, var(--ek-color-secondary) 22%, var(--ek-color-background)), color-mix(in srgb, var(--ek-color-secondary) 8%, var(--ek-color-background)));
    box-shadow: 0 0.5rem 1.25rem -0.5rem color-mix(in srgb, var(--ek-color-secondary) 55%, transparent);
    color: var(--site-accent);
  }
  .stat__label {
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-xl);
    font-weight: var(--ek-font-weight-bold);
    letter-spacing: -0.015em;
    line-height: var(--ek-line-height-tight);
  }
  .stat__num {
    display: inline-block;
    min-width: 2ch;
    background: var(--site-gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--site-accent);
    font-variant-numeric: tabular-nums;
  }
  .stat__sub {
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-md);
    line-height: var(--ek-line-height-normal);
  }

  /* --- Şerit: sabit etiket + maskelenmiş ray üzerinde ikon çipleri --- */
  .marquee {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-4);
  }
  .marquee__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: var(--ek-space-1) var(--ek-space-2);
    max-width: none;
    text-align: center;
  }
  .marquee__eyebrow {
    color: var(--site-accent);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .marquee__heading {
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .marquee__rail {
    position: relative;
    overflow: hidden;
    min-width: 0;
    padding-block: var(--ek-space-1);
    -webkit-mask-image: linear-gradient(to right, transparent, var(--ek-color-content-strong) 12%, var(--ek-color-content-strong) 88%, transparent);
    mask-image: linear-gradient(to right, transparent, var(--ek-color-content-strong) 12%, var(--ek-color-content-strong) 88%, transparent);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    max-width: none;
  }
  .marquee__set {
    display: flex;
    flex: none;
    gap: var(--ek-space-3);
    padding-inline-end: var(--ek-space-3);
  }
  .marquee__set--copy {
    display: none;
  }
  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    padding: var(--ek-space-1) var(--ek-space-4) var(--ek-space-1) var(--ek-space-1);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-full);
    background: linear-gradient(180deg, var(--ek-color-background), var(--ek-color-surface-muted));
    box-shadow: 0 0.0625rem 0.125rem color-mix(in srgb, var(--ek-color-content-strong) 5%, transparent);
    white-space: nowrap;
  }
  .marquee__mono {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-8);
    height: var(--ek-space-8);
    border-radius: var(--ek-radius-full);
    background: var(--site-accent-soft);
    color: var(--site-accent);
  }
  .marquee__name {
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-medium);
    letter-spacing: -0.005em;
  }

  /*
   * Hareket tercihi yoksa şerit tek satır + kenar maskesidir (düzen JS'ten ÖNCE de aynıdır → CLS yok);
   * reduced-motion'da şerit sarılan, ortalanmış, tam görünür bir listedir (ikinci küme gizli).
   */
  @media (prefers-reduced-motion: no-preference) {
    .marquee__set--copy {
      display: flex;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__rail {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .marquee__track {
      width: auto;
    }
    .marquee__set {
      flex: 1 1 100%;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--ek-space-2) var(--ek-space-3);
      padding-inline-end: 0;
    }
  }

  @media (min-width: 768px) {
    .stat {
      padding: var(--ek-space-6);
    }
    .stats {
      gap: var(--ek-space-4);
      margin-top: calc(var(--ek-space-12) * -1);
    }
    .proof__inner {
      padding-bottom: var(--ek-space-12);
    }
  }
  @media (min-width: 1024px) {
    .stat__label {
      font-size: var(--ek-font-size-2xl);
    }
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    /* geniş ekranda etiket solda sabit sütun, ray sağda akar */
    .marquee {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: var(--ek-space-8);
    }
    .marquee__title {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding-inline-end: var(--ek-space-8);
      border-inline-end: var(--site-border-width) solid var(--ek-color-border-default);
      text-align: start;
    }
    .marquee__heading {
      color: var(--site-text-heading);
      font-size: var(--ek-font-size-lg);
      font-weight: var(--ek-font-weight-semibold);
      letter-spacing: -0.01em;
      text-transform: none;
    }
  }
</style>
