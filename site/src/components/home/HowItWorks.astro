---
/**
 * Nasıl çalışır (ADR-0014 Karar 2, bölüm 5) — dört adım (S8: hesap -> kanal bağlama -> ürün aktarımı ->
 * stok/sipariş yönetimi). Adım metinleri kayıttan gelir (SSS + yetenek + deneme).
 * S7: geniş ekranda sol sütun YAPIŞKAN (başlık, adım göstergesi, CTA), sağda adımlar kaydırılır; her adımın altında
 * mini arayüz (S15-C: pencere başlığında ayrı "Örnek görünüm" etiketi yok; görseller aria-hidden, anlam metinde). Kaydırırken etkin adım göstergede vurgulanır
 * (`data-spy` / `data-spy-link`, src/scripts/scenes.ts — IntersectionObserver; scroll dinleyicisi YOK).
 * Sahne: `data-scene="how-progress"` — işaretler ve aralarındaki çizgi görünür olunca sırayla dolar. Statik hâl: çizgi dolu.
 * Adım numaraları dizideki sıradan üretilir (sabit rakam yok).
 * S12: adım metinleri kısa pazarlama dilinde; görsellerde kanal ADI yok (isimsiz renkli nokta).
 *
 * S13 (parça B): her örnek görünüm kısa, sinematik bir "demo"ya dönüştü — form yazılır, bağlantı hattı akar,
 * ürün kartları kanallara uçar, çubuklar dolar, onay parlar, son adımda panel canlanır. Sağdan kayarak gelen
 * ekran (S7) korunur. Demo, bu dosyadaki küçük betikle VURUŞ (beat) olarak ilerler: görsel ekranda yeterince
 * görünür olunca (`data-live`) `data-b1..bN` öznitelikleri birikimli eklenir, tutulur, sönümlenir ve baştan
 * oynar; görünmezken, sekme arka plandayken veya hareket kapalıyken durur. Animasyonun kendisi CSS'tedir
 * (yalnızca transform/opacity). Hareket kapalı / reduced-motion / JS'siz: `data-demo-on` yok → tamamlanmış
 * statik son durum (tüm alanlar dolu, tüm kanallar bağlı, panel dolu).
 */
import Section from '../Section.astro'
import SectionHeading from './SectionHeading.astro'
import Button from '../Button.astro'
import Icon from './Icon.astro'
import { appUrls } from '../../lib/site-config'
import { getPublicTrial } from '../../data/plans'
import { getPublicCapabilities } from '../../data/capabilities'
import { getPublicIntegrations } from '../../data/integrations'

const trial = getPublicTrial()
const cap = (id: string) => {
  const c = getPublicCapabilities().find((x) => x.id === id)
  if (!c) throw new Error(`Yetenek kaydı bulunamadı: ${id}`)
  return c
}
const homeLine = (id: string) => {
  const c = cap(id)
  return c.home?.line ?? c.summary
}
const channelCodes = getPublicIntegrations('marketplace').map((i) => i.code)

/** `beats`: demonun vuruş sayısı (betik bu kadar `data-bN` ekler); `app`: pencere başlığındaki ekran adı. */
const steps = [
  {
    key: 'account',
    nav: 'Hesap',
    app: 'Kayıt',
    beats: 5,
    title: 'Hesabınızı açın',
    text: `${trial.days} gün ücretsiz deneyin${trial.cardRequired ? '' : '; kart bilgisi gerekmez'}.`,
  },
  {
    key: 'connect',
    nav: 'Kanallar',
    app: 'Kanal bağlantısı',
    beats: 6,
    title: 'Kanallarınızı bağlayın',
    text: `Bağlantı bilgilerinizi bir kez girin. ${cap('secrets-encryption').summary}`,
  },
  {
    key: 'import',
    nav: 'Ürünler',
    app: 'Ürün aktarımı',
    beats: 6,
    title: 'Ürünlerinizi aktarın',
    text: homeLine('multi-channel-products'),
  },
  {
    key: 'manage',
    nav: 'Yönetim',
    app: 'Panel',
    beats: 5,
    title: 'Satışa odaklanın',
    text: `${homeLine('unified-orders')} Merkezi stok rezervasyonu aşırı satış riskini kontrol altında tutar.`,
  },
]
const tiles = [
  { icon: 'layers' as const, label: 'Ürünler' },
  { icon: 'stock' as const, label: 'Stok' },
  { icon: 'orders' as const, label: 'Siparişler' },
  { icon: 'returns' as const, label: 'İadeler' },
]
/** Örnek görünüm alanları: gerçek müşteri verisi değil, açıkça örnek değer. */
const sampleFields = [
  { label: 'Firma adı', value: 'Örnek Mağaza' },
  { label: 'Yetkili', value: 'Ayşe Demir' },
]
/** Panel akışındaki örnek sipariş satırları: kanal ayrımı yalnızca renkli nokta. */
const feed = channelCodes.slice(0, 3)
const chartBars = Array.from({ length: 8 })
const catalog = Array.from({ length: 3 })
---

<Section tone="muted" id="nasil-calisir" labelledby="nasil-baslik" class="how-section">
  <div class="hw">
    <div class="hw__aside">
      <SectionHeading
        id="nasil-baslik"
        eyebrow="Nasıl çalışır"
        title="Dört adımda hazırsınız"
        lead="Hesabınızı açın, kanallarınızı bağlayın, ürünlerinizi aktarın. Kurulum için kod yazmanız gerekmez."
      />
      <ul class="hw__nav" aria-hidden="true">
        {
          steps.map((s, i) => (
            <li class="hw__nav-item" data-spy-link={i + 1}>
              <span class="hw__nav-dot">{i + 1}</span>
              <span class="hw__nav-label">{s.nav}</span>
            </li>
          ))
        }
      </ul>
      <div class="how__cta">
        <Button href={appUrls.register()} variant="primary" size="lg" data-testid="how-cta">Ücretsiz deneyin</Button>
      </div>
    </div>

    <ol class="how" data-testid="how-steps">
      {
        steps.map((s, i) => (
          <li class="how__step" data-scene="how-progress" data-part="step" data-spy={i + 1}>
            <span class="how__marker" data-part="marker" aria-hidden="true">{i + 1}</span>
            <div class="how__body">
              <h3 class="how__title">
                <span class="sr-only">Adım {i + 1}: </span>
                {s.title}
              </h3>
              <p class="how__text">{s.text}</p>

              <div class="how__visual" data-tilt aria-hidden="true" data-demo={s.key} data-beats={s.beats}>
                <div class="how__chrome">
                  <span class="how__dots"><i></i><i></i><i></i></span>
                  <span class="how__app">{s.app}</span>
                  <span class="how__progress"><i></i></span>
                </div>

                <div class="how__stage">
                  {s.key === 'account' && (
                    <div class="acct">
                      {sampleFields.map((f, n) => (
                        <span class:list={['field', `field--${n + 1}`]}>
                          <em>{f.label}</em>
                          <span class="type">
                            <span class="type__mask">
                              <span class="type__text">{f.value}</span>
                              <i class="type__cover"></i>
                            </span>
                            <i class="type__focus"></i>
                          </span>
                        </span>
                      ))}
                      <span class="acct__cta">
                        <span class="acct__btn">
                          Ücretsiz dene
                          <i class="acct__shine"></i>
                        </span>
                        <svg class="cursor" viewBox="0 0 16 20" aria-hidden="true" focusable="false">
                          <path d="M1 1 L1 16 L5 12.5 L8 19 L10.5 18 L7.6 11.6 L13 11.6 Z"></path>
                        </svg>
                      </span>
                      <span class="acct__done">
                        <span class="okmark">
                          <span class="okmark__glow"></span>
                          <Icon name="check" size="sm" />
                        </span>
                        <span class="acct__done-copy">
                          <b>{trial.days} gün ücretsiz deneme</b>
                          <small>{trial.cardRequired ? 'Hesabınız hazır' : 'Kart bilgisi gerekmez'}</small>
                        </span>
                      </span>
                    </div>
                  )}

                  {s.key === 'connect' && (
                    <div class="conn">
                      <ul class="conn__chips">
                        {channelCodes.map((code) => (
                          <li class="chip" data-code={code}>
                            <span class="chip__ring"></span>
                            <i class="chip__dot"></i>
                            <i class="chip__name"></i>
                            <span class="chip__ok">
                              <Icon name="check" size="sm" />
                            </span>
                          </li>
                        ))}
                      </ul>
                      <span class="field field--key">
                        <em>API anahtarı</em>
                        <span class="type">
                          <span class="type__mask">
                            <span class="type__text type__text--mono">••••••••••••</span>
                            <i class="type__cover"></i>
                          </span>
                          <i class="type__focus"></i>
                        </span>
                      </span>
                      <div class="wire">
                        <span class="wire__node wire__node--key">
                          <Icon name="key" size="sm" />
                        </span>
                        <span class="wire__line wire__line--a">
                          <i class="wire__packet"></i>
                          <i class="wire__packet wire__packet--late"></i>
                        </span>
                        <span class="wire__node wire__node--lock">
                          <span class="okmark__glow"></span>
                          <Icon name="lock" size="sm" />
                        </span>
                        <span class="wire__line wire__line--b">
                          <i class="wire__packet"></i>
                          <i class="wire__packet wire__packet--late"></i>
                        </span>
                        <span class="wire__node wire__node--hub">
                          <span class="okmark__glow"></span>
                          <Icon name="database" size="sm" />
                        </span>
                      </div>
                      <span class="conn__badge">
                        <span class="okmark__glow"></span>
                        <Icon name="lock" size="sm" />
                        Şifreli saklanır
                      </span>
                    </div>
                  )}

                  {s.key === 'import' && (
                    <div class="ship">
                      <div class="ship__catalog">
                        <span class="ship__label">Katalog</span>
                        <ul class="ship__cards">
                          {catalog.map(() => (
                            <li class="pcard">
                              <span class="pcard__thumb"></span>
                              <span class="pcard__lines">
                                <i></i>
                                <i></i>
                              </span>
                            </li>
                          ))}
                        </ul>
                      </div>
                      <div class="ship__channels">
                        <span class="ship__label">Kanallar</span>
                        <ul class="ship__rows">
                          {channelCodes.map((code) => (
                            <li class="ship__row" data-code={code}>
                              <span class="ship__dot"></span>
                              <span class="ship__bar">
                                <i class="ship__fill"></i>
                              </span>
                              <span class="okmark okmark--sm">
                                <span class="okmark__glow"></span>
                                <Icon name="check" size="sm" />
                              </span>
                            </li>
                          ))}
                        </ul>
                      </div>
                      {channelCodes.map((code) => (
                        <span class="flier" data-code={code}>
                          <span class="pcard__thumb"></span>
                        </span>
                      ))}
                    </div>
                  )}

                  {s.key === 'manage' && (
                    <div class="panel">
                      <ul class="panel__kpis">
                        {tiles.map((t) => (
                          <li class="kpi">
                            <span class="kpi__icon">
                              <Icon name={t.icon} size="sm" />
                            </span>
                            <span class="kpi__label">{t.label}</span>
                            <span class="kpi__bar">
                              <i></i>
                            </span>
                          </li>
                        ))}
                      </ul>
                      <div class="panel__row">
                        <div class="panel__chart">
                          <span class="panel__head">
                            <span class="beacon">
                              <i></i>
                            </span>
                            Satış akışı
                          </span>
                          <span class="bars">
                            {chartBars.map(() => (
                              <i></i>
                            ))}
                          </span>
                        </div>
                        <ul class="feed">
                          {feed.map((code, n) => (
                            <li class:list={['feed__row', n === 0 && 'feed__row--new']} data-code={code}>
                              <span class="feed__flash"></span>
                              <span class="feed__dot"></span>
                              <span class="feed__lines">
                                <i></i>
                                <i></i>
                              </span>
                              {n === 0 ? <span class="feed__pill">Yeni</span> : <Icon name="check" size="sm" />}
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Section>

<script>
  /**
   * Örnek görünüm demoları: yalnızca DURUM üretir (içerik eklemez). Her `[data-demo]` görseli ekranda yeterince
   * görününce (`data-live`) vuruşlarla ilerler: b1..bN birikimli eklenir → tutulur → `data-rewind` ile sönümlenir →
   * baştan. Yalnızca `html[data-motion='play']` iken ve sekme görünürken çalışır; aksi hâlde zamanlayıcılar durur.
   * Hareket kapanınca `data-demo-on` kaldırılır → CSS tamamlanmış statik son durumu gösterir.
   * Vuruş süresi CSS token'ından okunur (tek kaynak): `--site-motion-duration-reveal`.
   */
  const root = document.documentElement
  const demos = Array.from(document.querySelectorAll<HTMLElement>('[data-demo]'))
  /** Tamamlanmış hâlin ekranda kalma süresi ve sönümden sonraki bekleme (vuruş cinsinden). */
  const HOLD_BEATS = 6
  const REST_BEATS = 1

  if (demos.length > 0 && 'IntersectionObserver' in window) {
    type Demo = { el: HTMLElement; beats: number; step: number; phase: 'build' | 'hold' | 'rewind'; timer: number; live: boolean }
    const state: Demo[] = demos.map((el) => ({ el, beats: Number(el.dataset.beats) || 1, step: 0, phase: 'build', timer: 0, live: false }))

    const beatMs = () => {
      const raw = getComputedStyle(root).getPropertyValue('--site-motion-duration-reveal').trim()
      const v = parseFloat(raw)
      if (Number.isNaN(v) || v <= 0) return 700
      return raw.endsWith('ms') ? v : v * 1000
    }
    const motionOn = () => root.dataset.motion === 'play'
    const canRun = () => motionOn() && root.dataset.tab !== 'hidden'

    const setStep = (d: Demo, step: number) => {
      d.step = step
      for (let i = 1; i <= d.beats; i++) d.el.toggleAttribute(`data-b${i}`, i <= step)
    }
    const stop = (d: Demo) => {
      if (d.timer) window.clearTimeout(d.timer)
      d.timer = 0
    }
    const reset = (d: Demo) => {
      stop(d)
      setStep(d, 0)
      d.phase = 'build'
      d.el.removeAttribute('data-rewind')
    }
    const schedule = (d: Demo, beats: number) => {
      stop(d)
      d.timer = window.setTimeout(() => advance(d), beatMs() * beats)
    }
    function advance(d: Demo) {
      d.timer = 0
      if (!d.live || !canRun()) return
      if (d.phase === 'build') {
        setStep(d, d.step + 1)
        if (d.step >= d.beats) d.phase = 'hold'
        schedule(d, d.phase === 'hold' ? HOLD_BEATS : 1)
      } else if (d.phase === 'hold') {
        d.phase = 'rewind'
        d.el.setAttribute('data-rewind', '')
        schedule(d, 1)
      } else {
        reset(d)
        schedule(d, REST_BEATS)
      }
    }
    const resume = (d: Demo) => {
      if (d.live && canRun() && !d.timer) schedule(d, 1)
    }

    const sync = () => {
      for (const d of state) {
        if (!motionOn()) {
          reset(d)
          d.el.removeAttribute('data-demo-on')
          continue
        }
        if (!d.el.hasAttribute('data-demo-on')) {
          reset(d)
          d.el.setAttribute('data-demo-on', '')
        }
        if (canRun()) resume(d)
        else stop(d)
      }
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const d = state.find((x) => x.el === entry.target)
          if (!d) continue
          if (entry.isIntersecting && entry.intersectionRatio >= 0.45) d.live = true
          else if (!entry.isIntersecting) d.live = false
          d.el.dataset.live = String(d.live)
          if (d.live) resume(d)
          else stop(d)
        }
      },
      { threshold: [0, 0.45] },
    )
    for (const d of state) io.observe(d.el)

    // Hareket anahtarı / reduced-motion / sekme durumu scenes.ts tarafından <html>'e yazılır; burada yalnızca izlenir.
    new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ['data-motion', 'data-tab'] })
    sync()
  }
</script>

<style>
  /*
   * Bu bölüm koyu "sahne" zemininde (`Section tone="stage"`); o zeminin paylaşılan `overflow: hidden`
   * kuralı (diğer sahne bölümlerindeki taşan dekoratif öğeleri kırpmak için) burada `.hw__aside`'ın
   * `position: sticky` davranışını KIRAR (sticky, taşma kırpan bir atada çalışmaz). Yalnızca BU örnekte
   * (`:has` ile hedeflenir) taşma tekrar açılır; ClosingCta/SecuritySummary etkilenmez.
   */
  :global(.section--stage:has(.hw__aside)) {
    overflow: visible;
  }
  /* S27a (BRAND §4, N3): bölüm AÇIK zemine alındı — sayfada koyu sahneler hero, Otopilot vitrini ve kapanış. */
  .hw {
    display: grid;
    gap: var(--ek-space-12);
  }
  .hw__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ek-space-8);
  }
  .hw__nav {
    display: none;
    flex-direction: column;
    gap: var(--ek-space-3);
  }
  .hw__nav-item {
    display: flex;
    align-items: center;
    gap: var(--ek-space-3);
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-lg);
    font-weight: var(--ek-font-weight-semibold);
    transition: color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .hw__nav-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-8);
    height: var(--ek-space-8);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-md);
    background: var(--ek-color-background);
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-md);
    transition:
      background-color var(--ek-duration-base) var(--ek-easing-standard),
      border-color var(--ek-duration-base) var(--ek-easing-standard),
      color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .hw__nav-item[data-active='true'] {
    color: var(--site-text-heading);
  }
  .hw__nav-item[data-active='true'] .hw__nav-dot {
    border-color: var(--site-action-border);
    background: var(--site-action-subtle);
    color: var(--site-action-emphasis);
  }

  .how {
    /* Sağdan kayan "ekran" giriş sırasında yatay taşma üretmesin; `clip` kaydırma kapsayıcısı DEĞİLDİR
       (sol sütunun yapışkanlığı etkilenmez), gölge/eğim için kenarda pay bırakılır. */
    overflow-x: clip;
    overflow-clip-margin: var(--ek-space-8);
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-8);
    min-width: 0;
  }
  .how__step {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--ek-space-5);
  }
  .how__marker {
    position: relative;
    z-index: 1;
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-12);
    height: var(--ek-space-12);
    border: var(--site-border-width) solid var(--site-action-border);
    border-radius: var(--ek-radius-tile);
    background: var(--site-action-subtle);
    box-shadow: 0 0 0 var(--ek-space-2) var(--ek-color-surface-muted);
    color: var(--site-action-emphasis);
    font-size: var(--ek-font-size-xl);
    font-weight: var(--site-font-display-weight);
  }
  /* Dikey ilerleme çizgisi: sonraki adıma kadar uzanır. */
  .how__step:not(:last-child)::after {
    content: '';
    position: absolute;
    inset-block-start: var(--ek-space-12);
    inset-block-end: calc(var(--ek-space-8) * -1);
    inset-inline-start: calc(var(--ek-space-6) - var(--site-border-width));
    width: calc(var(--site-border-width) * 2);
    background: var(--site-action-border);
  }
  .how__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--ek-space-3);
    min-width: 0;
    padding-top: var(--ek-space-2);
  }
  .how__title {
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-2xl);
    font-weight: var(--ek-font-weight-bold);
    letter-spacing: -0.01em;
  }
  .how__text {
    color: var(--ek-color-content-default);
    font-size: var(--ek-font-size-lg);
  }

  /* ------------------------------------------------------------------------------------------------ */
  /* Mini arayüz ("ekran"): açık yüzeyli uygulama penceresi                                             */
  /* ------------------------------------------------------------------------------------------------ */
  .how__visual {
    --accent-soft: var(--site-action-subtle);
    position: relative;
    display: flex;
    flex-direction: column;
    margin-top: var(--ek-space-4);
    overflow: hidden;
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-card);
    background-color: var(--ek-color-surface);
  }
  .how__chrome {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--ek-space-3);
    padding: var(--ek-space-3) var(--ek-space-5);
    border-bottom: var(--site-border-width) solid var(--ek-color-border-default);
    background: var(--ek-color-surface-muted);
  }
  .how__dots {
    display: inline-flex;
    gap: var(--ek-space-1);
  }
  .how__dots i {
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-border-strong);
  }
  /* Koyu sahnede Section'ın `p`/span rengi açık zeminli kartta görünmez kalmasın → özgüllük artırıldı. */
  .how__visual .how__app {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* Pencere altındaki ince ilerleme çizgisi: demo boyunca soldan sağa dolar (statik: dolu). */
  .how__progress {
    position: absolute;
    inset-inline: 0;
    inset-block-end: calc(var(--site-border-width) * -1);
    height: calc(var(--site-border-width) * 2);
    overflow: hidden;
  }
  .how__progress i {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--site-action);
    transform-origin: 0 50%;
  }
  .how__stage {
    padding: var(--ek-space-5);
  }

  /* --- Ortak parçalar --- */
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
    min-width: 0;
    font-size: var(--ek-font-size-sm);
  }
  .field em {
    color: var(--ek-color-content-muted);
    font-size: var(--ek-font-size-xs);
    font-style: normal;
    font-weight: var(--ek-font-weight-semibold);
  }
  /* Giriş kutusu: yazılırken odak halkası (statik: nötr kenarlık). */
  .field .type {
    padding: var(--ek-space-2) var(--ek-space-3);
    border: var(--site-border-width) solid var(--ek-color-border-strong);
    border-radius: var(--ek-radius-md);
    background: var(--ek-color-surface);
  }
  .type__focus {
    position: absolute;
    inset: calc(var(--site-border-width) * -1);
    border: calc(var(--site-border-width) * 2) solid var(--site-action);
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
  }
  /* Yazılan değer: üstündeki örtü (imleçli) adım adım sağa kayarak metni açar → "yazılıyor" hissi. */
  .type {
    position: relative;
    display: flex;
    min-width: 0;
  }
  .type__mask {
    position: relative;
    display: inline-flex;
    max-width: 100%;
    overflow: hidden;
    padding-inline-end: var(--ek-space-1);
  }
  .type__text {
    overflow: hidden;
    color: var(--ek-color-content-strong);
    font-weight: var(--ek-font-weight-semibold);
    text-overflow: clip;
    white-space: nowrap;
  }
  .type__text--mono {
    font-family: var(--ek-font-mono);
    letter-spacing: 0.08em;
  }
  .type__cover {
    position: absolute;
    inset: 0;
    background: var(--ek-color-surface);
    opacity: 0;
    translate: 100% 0;
  }
  .type__cover::before {
    content: '';
    position: absolute;
    inset-block: 15%;
    inset-inline-start: 0;
    width: calc(var(--site-border-width) * 2);
    border-radius: var(--ek-radius-full);
    background: var(--site-action);
  }
  /* Onay işareti + tamamlanma ışıması */
  .okmark {
    position: relative;
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-8);
    height: var(--ek-space-8);
    border-radius: var(--ek-radius-md);
    background: var(--site-action);
    color: var(--site-color-on-primary);
  }
  .okmark--sm {
    width: var(--ek-space-6);
    height: var(--ek-space-6);
  }
  .okmark__glow {
    position: absolute;
    inset: calc(var(--ek-space-1) * -1);
    border: calc(var(--site-border-width) * 2) solid var(--site-action);
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
  }

  /* --- 1) Hesap: form yazılır, düğmeye basılır, onay kartı gelir --- */
  .acct {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
  }
  .acct__cta {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  /* İmleç: düğmeye gelip tıklar (statik: görünmez). */
  .cursor {
    position: absolute;
    inset-block-start: 55%;
    inset-inline-start: 58%;
    z-index: 1;
    width: var(--ek-space-4);
    height: var(--ek-space-5);
    fill: var(--ek-color-content-strong);
    stroke: var(--ek-color-surface);
    stroke-width: 1.2;
    stroke-linejoin: round;
    opacity: 0;
    pointer-events: none;
  }
  .acct__btn {
    position: relative;
    overflow: hidden;
    padding: var(--ek-space-3);
    border-radius: var(--ek-radius-md);
    background: var(--site-action);
    color: var(--site-color-on-primary);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-semibold);
    text-align: center;
  }
  /* Basınca üzerinden geçen parıltı (statik: görünmez). */
  .acct__shine {
    /* SITE-DL: parlama geçişi kaldırıldı (öğe DOM'da kalır; demo vuruşu yalnız düğme basışını oynatır). */
    display: none;
  }
  .acct__done {
    display: flex;
    align-items: center;
    gap: var(--ek-space-3);
    padding: var(--ek-space-3);
    border: var(--site-border-width) solid var(--site-action-border);
    border-radius: var(--ek-radius-tile);
    background: var(--site-action-subtle);
  }
  .acct__done-copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .how__visual .acct__done-copy b {
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-md);
  }
  .how__visual .acct__done-copy small {
    color: var(--ek-color-content-default);
    font-size: var(--ek-font-size-xs);
  }

  /* --- 2) Kanallar: kanal seçilir, anahtar yazılır, hat çizilir, paket akar, kanallar sırayla bağlanır --- */
  .conn {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
  }
  .conn__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-2);
  }
  .chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    height: var(--ek-space-8);
    padding-inline: var(--ek-space-3) var(--ek-space-1);
    border: var(--site-border-width) solid var(--ek-color-border-strong);
    border-radius: var(--ek-radius-md);
    background: var(--ek-color-surface);
  }
  .chip__ring {
    position: absolute;
    inset: calc(var(--site-border-width) * -1);
    border: var(--site-border-width) solid var(--site-action);
    border-radius: inherit;
    pointer-events: none;
  }
  .chip__dot {
    width: var(--ek-space-3);
    height: var(--ek-space-3);
    border-radius: var(--ek-radius-full);
    background: var(--chan, var(--site-action));
  }
  .chip__name {
    width: var(--ek-space-6);
    height: var(--ek-space-1);
    border-radius: var(--ek-radius-full);
    background: color-mix(in srgb, var(--ek-color-content-muted) 35%, var(--ek-color-surface-sunken));
  }
  .chip__ok {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-6);
    height: var(--ek-space-6);
    border-radius: var(--ek-radius-sm);
    background: var(--site-action);
    color: var(--site-color-on-primary);
  }
  .field--key .type__text {
    font-weight: var(--ek-font-weight-bold);
  }
  /* Anahtar -> kilit -> merkez: bağlantı hattı ve üzerinde akan paketler. */
  .wire {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--ek-space-2);
    padding: var(--ek-space-2) 0;
  }
  .wire__node {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-10);
    height: var(--ek-space-10);
    border: var(--site-border-width) solid var(--ek-color-border-strong);
    border-radius: var(--ek-radius-tile);
    background: var(--ek-color-surface);
    color: var(--site-action);
  }
  .wire__node--lock {
    border-color: var(--site-action-border);
    background: var(--site-action-subtle);
    color: var(--site-action-emphasis);
  }
  .wire__node--hub {
    border-color: var(--ek-color-chrome);
    background: var(--ek-color-chrome);
    color: var(--site-color-on-primary);
  }
  .wire__node .okmark__glow {
    border-color: var(--site-action);
  }
  .wire__line {
    position: relative;
    container-type: inline-size;
    height: calc(var(--site-border-width) * 2);
    border-radius: var(--ek-radius-full);
    background: var(--site-action-border);
    transform-origin: 0 50%;
  }
  .wire__packet {
    --travel: calc(100cqw - var(--ek-space-2));
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    margin-top: calc(var(--ek-space-1) * -1);
    border-radius: var(--ek-radius-full);
    background: var(--site-action);
    opacity: 0;
  }
  .conn__badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--ek-space-2);
    padding: var(--ek-space-1) var(--ek-space-3);
    border: var(--site-border-width) solid var(--site-action-border);
    border-radius: var(--ek-radius-md);
    background: var(--site-action-subtle);
    color: var(--site-action-emphasis);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
  }

  /* --- 3) Ürünler: katalogdaki ürün kartları kanallara uçar, çubuklar dolar, onay parlar --- */
  .ship {
    --row-h: var(--ek-space-10);
    --row-gap: var(--ek-space-2);
    position: relative;
    container-type: inline-size;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: end;
    gap: var(--ek-space-5);
  }
  .ship__catalog,
  .ship__channels {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    min-width: 0;
  }
  .how__visual .ship__label {
    color: var(--ek-color-content-muted);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ship__cards {
    display: flex;
    flex-direction: column;
    gap: var(--row-gap);
  }
  .pcard {
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
    height: calc((var(--row-h) * 4 + var(--row-gap)) / 3);
    padding: var(--ek-space-2);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-md);
    background: var(--ek-color-surface);
  }
  .pcard__thumb {
    flex: none;
    width: var(--ek-space-8);
    height: var(--ek-space-8);
    border: var(--site-border-width) solid var(--site-action-border);
    border-radius: var(--ek-radius-sm);
    background: var(--site-action-subtle);
  }
  .pcard:nth-child(2) .pcard__thumb {
    border-color: var(--ek-color-border-default);
    background: var(--ek-color-surface-muted);
  }
  .pcard:nth-child(3) .pcard__thumb {
    border-color: var(--site-action-border);
    background: var(--site-action-subtle);
  }
  .pcard__lines {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--ek-space-1);
    min-width: 0;
  }
  .pcard__lines i {
    display: block;
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: color-mix(in srgb, var(--ek-color-content-muted) 28%, var(--ek-color-surface-sunken));
  }
  .pcard__lines i + i {
    width: 60%;
    background: var(--ek-color-surface-sunken);
  }
  .ship__rows {
    display: flex;
    flex-direction: column;
    gap: var(--row-gap);
  }
  .ship__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--ek-space-3);
    height: var(--row-h);
    padding-inline: var(--ek-space-3) var(--ek-space-2);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-md);
    background: var(--ek-color-surface);
  }
  .ship__dot {
    width: var(--ek-space-3);
    height: var(--ek-space-3);
    border-radius: var(--ek-radius-full);
    background: var(--chan, var(--site-action));
  }
  .ship__bar {
    display: block;
    height: var(--ek-space-2);
    overflow: hidden;
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface-sunken);
  }
  .ship__fill {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--ek-radius-full);
    background: var(--site-action);
    transform-origin: 0 50%;
  }
  /* Uçan kart: katalog sütununun ortasından ilgili kanal satırının noktasına (statik: görünmez). */
  /* Geometri: kartlar ve satırlar aynı yükseklikte bir yığındır (4 satır = 3 kart); uçan kart `--ci`. kartın
     ortasından doğar, `--rj`. satırın noktasına iner. */
  .flier {
    --stack: calc(var(--row-h) * 4 + var(--row-gap) * 3);
    --hc: calc((var(--row-h) * 4 + var(--row-gap)) / 3);
    --from-y: calc(var(--ci) * (var(--hc) + var(--row-gap)) + var(--hc) / 2);
    --fx: calc(20cqw + var(--ek-space-10));
    --fy: calc(var(--rj) * (var(--row-h) + var(--row-gap)) + var(--row-h) / 2 - var(--from-y));
    position: absolute;
    z-index: 2;
    inset-inline-start: calc(20cqw - var(--ek-space-6));
    inset-block-end: calc(var(--stack) - var(--from-y) - var(--ek-space-6));
    display: grid;
    place-items: center;
    width: var(--ek-space-12);
    height: var(--ek-space-12);
    border: calc(var(--site-border-width) * 2) solid color-mix(in srgb, var(--chan, var(--site-action)) 55%, var(--ek-color-surface));
    border-radius: var(--ek-radius-tile);
    background: var(--ek-color-surface);
    opacity: 0;
    pointer-events: none;
  }
  .flier:nth-of-type(1) {
    --ci: 0;
    --rj: 0;
  }
  .flier:nth-of-type(2) {
    --ci: 1;
    --rj: 1;
  }
  .flier:nth-of-type(3) {
    --ci: 2;
    --rj: 2;
  }
  .flier:nth-of-type(n + 4) {
    --ci: 0;
    --rj: 3;
  }

  /* --- 4) Yönetim: panel canlanır — göstergeler yükselir, grafik büyür, yeni sipariş satırı parlar --- */
  .panel {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
  }
  .panel__kpis {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--ek-space-2);
  }
  .kpi {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
    gap: var(--ek-space-2);
    padding: var(--ek-space-3);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-tile);
    background: var(--ek-color-surface);
  }
  .kpi__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-8);
    height: var(--ek-space-8);
    border-radius: var(--ek-radius-md);
    border: var(--site-border-width) solid var(--site-action-border);
    background: var(--site-action-subtle);
    color: var(--site-action);
  }
  .how__visual .kpi__label {
    overflow: hidden;
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .kpi__bar {
    display: block;
    justify-self: stretch;
    height: var(--ek-space-1);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface-sunken);
  }
  .kpi__bar i {
    display: block;
    width: 64%;
    height: 100%;
    border-radius: var(--ek-radius-full);
    background: var(--site-action);
    transform-origin: 0 50%;
  }
  .kpi:nth-child(2) .kpi__bar i {
    width: 82%;
  }
  .kpi:nth-child(3) .kpi__bar i {
    width: 48%;
  }
  .kpi:nth-child(4) .kpi__bar i {
    width: 30%;
  }
  .panel__row {
    display: grid;
    gap: var(--ek-space-3);
  }
  .panel__chart {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
    padding: var(--ek-space-3);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-tile);
    background: var(--ek-color-surface);
  }
  .how__visual .panel__head {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
  }
  /* Durum ışığı: sabit yeşil nokta; hareket açıkken çevresinden halka yayılır. */
  .beacon {
    position: relative;
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--site-action);
  }
  .beacon i {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--site-action);
    opacity: 0;
  }
  .bars {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    align-items: end;
    gap: var(--ek-space-1);
    height: calc(var(--ek-space-16) + var(--ek-space-2));
    padding-bottom: var(--site-border-width);
    border-bottom: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .bars i {
    display: block;
    height: 40%;
    border-radius: var(--ek-radius-sm) var(--ek-radius-sm) 0 0;
    background: var(--site-action-border);
    transform-origin: 50% 100%;
  }
  .bars i:nth-child(2) { height: 55%; }
  .bars i:nth-child(3) { height: 48%; }
  .bars i:nth-child(4) { height: 68%; }
  .bars i:nth-child(5) { height: 60%; }
  .bars i:nth-child(6) { height: 78%; }
  .bars i:nth-child(7) { height: 72%; }
  .bars i:nth-child(8) {
    height: 92%;
    background: var(--site-action);
  }
  .feed {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
  }
  .feed__row {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--ek-space-3);
    min-height: var(--ek-space-10);
    padding-inline: var(--ek-space-3);
    overflow: hidden;
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-md);
    background: var(--ek-color-surface);
    color: var(--site-action);
  }
  .feed__row--new {
    border-color: var(--site-action-border);
    background: var(--site-action-subtle);
  }
  .feed__flash {
    position: absolute;
    inset: 0;
    background: var(--ek-color-surface);
    opacity: 0;
    translate: -100% 0;
  }
  .feed__dot {
    position: relative;
    width: var(--ek-space-3);
    height: var(--ek-space-3);
    border-radius: var(--ek-radius-full);
    background: var(--chan, var(--site-action));
  }
  .feed__lines {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
  }
  .feed__lines i {
    display: block;
    width: 70%;
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: color-mix(in srgb, var(--ek-color-content-muted) 28%, var(--ek-color-surface-sunken));
  }
  .feed__lines i + i {
    width: 42%;
    background: var(--ek-color-surface-sunken);
  }
  .how__visual .feed__pill {
    position: relative;
    padding: 0 var(--ek-space-2);
    border: var(--site-border-width) solid var(--site-action-border);
    border-radius: var(--ek-radius-sm);
    background: var(--ek-color-surface);
    color: var(--site-action-emphasis);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-bold);
    line-height: var(--ek-space-5);
  }

  @media (min-width: 480px) {
    .panel__kpis {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .panel__row {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }

  /*
   * Hareket — iki katman (yalnızca translate/scale/opacity; `prefers-reduced-motion: no-preference` +
   * `html[data-motion='play']` koşullu):
   *  A) S7 girişi: adım görünür olunca "ekran" sağdan kayarak gelir (how-progress sahnesinin `data-state`'i).
   *  B) S13 demo: betik `data-demo-on` + birikimli `data-bN` vuruşları ekler. `data-demo-on` varken ve ilgili
   *     vuruş henüz yokken öğe BAŞLANGIÇ pozundadır; vuruş eklenince tek seferlik animasyon başlar ve öğe varsayılan
   *     (statik, tamamlanmış) hâline varır. `data-rewind` tüm sahneyi söndürür, vuruşlar silinir, demo baştan oynar.
