---
/**
 * Nasıl çalışır (ADR-0014 Karar 2, bölüm 5) — dört adım (S8: hesap -> kanal bağlama -> ürün aktarımı ->
 * stok/sipariş yönetimi). Adım metinleri kayıttan gelir (SSS + yetenek + deneme).
 * S7: geniş ekranda sol sütun YAPIŞKAN (başlık, adım göstergesi, CTA), sağda adımlar kaydırılır; her adımın altında
 * "Örnek görünüm" mini arayüzü. Kaydırırken etkin adım göstergede vurgulanır
 * (`data-spy` / `data-spy-link`, src/scripts/scenes.ts — IntersectionObserver; scroll dinleyicisi YOK).
 * Sahne: `data-scene="how-progress"` — işaretler ve aralarındaki çizgi görünür olunca sırayla dolar. Statik hâl: çizgi dolu.
 * Adım numaraları dizideki sıradan üretilir (sabit rakam yok). Görsellerde kanal ADI yok (isimsiz renkli nokta).
 *
 * S13: her örnek görünüm sinematik bir mini arayüzdür ve adım ETKİN olunca (ekranın ortasındaki banda gelince,
 * bu dosyadaki betik `data-live="true"` yazar) oynar:
 *  1) hesap: alanlara yazılır (imleç ilerler), düğmeye basılır, ilerleme dolar, onay parlar
 *  2) bağlantı: anahtar maskeli yazılır, hat çizilir ve üzerinde veri akar, kilit/merkez ışır, kanallar sırayla bağlanır
 *  3) aktarım: katalogdan ürün kartları kanallara uçar, her kanalın ilerlemesi dolar, onaylar parlar
 *  4) tek panel: kutucuklar yerine oturur, grafik yükselir, sipariş akışı canlı akar
 * Etkin olmayan adımın sahnesi başlangıç pozunda bekler (duraklatılmış); tamamlanan sahne son durumda kalır.
 * Döngüler (akış, parıltı, canlı akış) yalnızca adım etkin VE görünürken çalışır. Tümü yalnızca
 * transform/opacity; `prefers-reduced-motion: no-preference` + `html[data-motion='play']` koşullu;
 * reduced-motion / "Hareket" kapalı / JS'siz → statik hâl = tamamlanmış son durum (anlamlı ekran).
 */
import Section from '../Section.astro'
import SectionHeading from './SectionHeading.astro'
import Button from '../Button.astro'
import Icon from './Icon.astro'
import { appUrls } from '../../lib/site-config'
import { getPublicTrial } from '../../data/plans'
import { getPublicCapabilities } from '../../data/capabilities'
import { getPublicIntegrations } from '../../data/integrations'

const trial = getPublicTrial()
const cap = (id: string) => {
  const c = getPublicCapabilities().find((x) => x.id === id)
  if (!c) throw new Error(`Yetenek kaydı bulunamadı: ${id}`)
  return c
}
const homeLine = (id: string) => {
  const c = cap(id)
  return c.home?.line ?? c.summary
}
const channelCodes = getPublicIntegrations('marketplace').map((i) => i.code)

const steps = [
  {
    key: 'account',
    nav: 'Hesap',
    title: 'Hesabınızı açın',
    text: `${trial.days} gün ücretsiz deneyin${trial.cardRequired ? '' : '; kart bilgisi gerekmez'}.`,
  },
  {
    key: 'connect',
    nav: 'Kanallar',
    title: 'Kanallarınızı bağlayın',
    text: `Bağlantı bilgilerinizi bir kez girin. ${cap('secrets-encryption').summary}`,
  },
  {
    key: 'import',
    nav: 'Ürünler',
    title: 'Ürünlerinizi aktarın',
    text: homeLine('multi-channel-products'),
  },
  {
    key: 'manage',
    nav: 'Yönetim',
    title: 'Tek panelden yönetin',
    text: `${homeLine('unified-orders')} Merkezi stok rezervasyonu aşırı satış riskini kontrol altında tutar.`,
  },
]
const tiles = [
  { icon: 'layers' as const, label: 'Ürünler' },
  { icon: 'stock' as const, label: 'Stok' },
  { icon: 'orders' as const, label: 'Siparişler' },
  { icon: 'returns' as const, label: 'İadeler' },
]
/** Örnek sipariş akışı: isimsiz kanal noktası + durum etiketi (sayı/tutar YOK). */
const feedStatus = [
  { label: 'Yeni', tone: 'info' },
  { label: 'Onaylandı', tone: 'success' },
  { label: 'Hazırlanıyor', tone: 'warning' },
  { label: 'Kargoda', tone: 'neutral' },
]
const feed = feedStatus.map((s, n) => ({ ...s, code: channelCodes[n % channelCodes.length] }))
const chartBars = Array.from({ length: 8 }, (_, n) => n)
---

<Section tone="stage" id="nasil-calisir" labelledby="nasil-baslik">
  <div class="hw">
    <div class="hw__aside">
      <SectionHeading
        id="nasil-baslik"
        tone="dark"
        eyebrow="Nasıl çalışır"
        title="Dört adımda tek panele geçin"
        accent="Dört adımda"
        lead="Hesabınızı açın, kanallarınızı bağlayın, ürünlerinizi aktarın: çok kanallı operasyonunuz tek panelde yönetilmeye hazır."
      />
      <ul class="hw__nav" aria-hidden="true">
        {
          steps.map((s, i) => (
            <li class="hw__nav-item" data-spy-link={i + 1}>
              <span class="hw__nav-dot">{i + 1}</span>
              <span class="hw__nav-label">{s.nav}</span>
            </li>
          ))
        }
      </ul>
      <div class="how__cta">
        <Button href={appUrls.register()} variant="inverse" size="lg" data-testid="how-cta">Ücretsiz dene</Button>
      </div>
    </div>

    <ol class="how" data-testid="how-steps">
      {
        steps.map((s, i) => (
          <li class="how__step" data-scene="how-progress" data-part="step" data-spy={i + 1} data-step={s.key}>
            <span class="how__marker" data-part="marker" aria-hidden="true">{i + 1}</span>
            <div class="how__body">
              <h3 class="how__title">
                <span class="sr-only">Adım {i + 1}: </span>
                {s.title}
              </h3>
              <p class="how__text">{s.text}</p>

              <div class="how__visual" data-tilt aria-hidden="true">
                <div class="how__chrome">
                  <span class="how__dots"><i></i><i></i><i></i></span>
                  <span class="how__tag">Örnek görünüm</span>
                </div>

                {s.key === 'account' && (
                  <div class="acct">
                    <span class="field field--name">
                      <span class="field__label">Firma adı</span>
                      <span class="type type--name">
                        Mağazanız<i class="type__cover"></i>
                      </span>
                    </span>
                    <span class="field field--mail">
                      <span class="field__label">E-posta</span>
                      <span class="type type--mail">
                        siz@firmaniz.com<i class="type__cover"></i>
                      </span>
                    </span>
                    <span class="acct__btn">
                      Ücretsiz dene
                      <i class="acct__sheen"></i>
                      <i class="acct__progress"></i>
                    </span>
                    <span class="badge done">
                      <span class="done__glow"></span>
                      <Icon name="check" size="sm" />
                      {trial.days} gün ücretsiz deneme
                    </span>
                  </div>
                )}

                {s.key === 'connect' && (
                  <div class="conn">
                    <ul class="conn__chips">
                      {channelCodes.map((code) => (
                        <li class="conn__chip" data-code={code}>
                          <i class="conn__dot"></i>
                          <span class="conn__check">
                            <Icon name="check" size="sm" />
                          </span>
                        </li>
                      ))}
                    </ul>
                    <span class="field field--key">
                      <span class="field__label">API anahtarı</span>
                      <span class="type type--key">
                        ••••••••••••<i class="type__cover"></i>
                      </span>
                    </span>
                    <div class="wire">
                      <span class="wire__node wire__node--key">
                        <Icon name="key" size="sm" />
                      </span>
                      <span class="wire__line">
                        <i class="wire__flow"></i>
                        <i class="wire__packet"></i>
                      </span>
                      <span class="wire__node wire__node--lock">
                        <span class="wire__halo"></span>
                        <Icon name="lock" size="sm" />
                      </span>
                      <span class="wire__line wire__line--b">
                        <i class="wire__flow"></i>
                        <i class="wire__packet"></i>
                      </span>
                      <span class="wire__node wire__node--hub">
                        <span class="wire__halo"></span>
                        <Icon name="database" size="sm" />
                      </span>
                    </div>
                    <span class="badge done">
                      <span class="done__glow"></span>
                      <Icon name="lock" size="sm" />
                      Şifreli saklanır
                    </span>
                  </div>
                )}

                {s.key === 'import' && (
                  <div class="ship">
                    <div class="ship__head">
                      <span class="ship__title">Ürün aktarımı</span>
                      <span class="ship__status">
                        <span class="ship__state ship__state--run">Aktarılıyor</span>
                        <span class="ship__state ship__state--done">
                          <Icon name="check" size="sm" />
                          Aktarıldı
                        </span>
                      </span>
                    </div>
                    <div class="ship__stage">
                      <div class="ship__catalog">
                        <span class="ship__caption">Katalog</span>
                        {[0, 1, 2].map(() => (
                          <span class="ship__item">
                            <i class="ship__thumb"></i>
                            <span class="ship__lines">
                              <i></i>
                              <i></i>
                            </span>
                          </span>
                        ))}
                      </div>
                      <ul class="ship__lanes">
                        {channelCodes.map((code) => (
                          <li class="ship__lane" data-code={code}>
                            <span class="ship__dot"></span>
                            <span class="ship__track">
                              <i class="ship__fill"></i>
                              <i class="ship__shine"></i>
                            </span>
                            <span class="ship__ok">
                              <span class="done__glow"></span>
                              <Icon name="check" size="sm" />
                            </span>
                            <span class="ship__card">
                              <i></i>
                            </span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                )}

                {s.key === 'manage' && (
                  <div class="panel">
                    <div class="panel__top">
                      <span class="panel__title">Tek panel</span>
                      <span class="panel__live">
                        <i class="panel__beacon"></i>
                        Canlı
                      </span>
                    </div>
                    <ul class="tiles">
                      {tiles.map((t) => (
                        <li class="tiles__item">
                          <span class="tiles__icon">
                            <Icon name={t.icon} size="sm" />
                          </span>
                          <span class="tiles__label">{t.label}</span>
                          <span class="tiles__bar">
                            <i></i>
                          </span>
                        </li>
                      ))}
                    </ul>
                    <div class="panel__grid">
                      <div class="feed">
                        <span class="panel__sub">Sipariş akışı</span>
                        <ul class="feed__list">
                          {feed.map((f) => (
                            <li class="feed__row" data-code={f.code}>
                              <i class="feed__dot"></i>
                              <span class="feed__lines">
                                <i></i>
                                <i></i>
                              </span>
                              <span class={`feed__chip feed__chip--${f.tone}`}>{f.label}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                      <div class="chart">
                        <span class="panel__sub">Hareketler</span>
                        <span class="chart__bars">
                          {chartBars.map(() => (
                            <i class="chart__bar"></i>
                          ))}
                        </span>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Section>

<script>
  /*
   * Etkin adım (S13): örnek görünümü ekranın orta bandından geçen adım `data-live="true"` alır; diğerleri "false".
   * Yalnızca durum üretir (animasyon CSS'te, hareket tercihi `html[data-motion]` ile CSS'te uygulanır).
   * Scroll dinleyicisi yok (IntersectionObserver); IO yoksa hiçbir şey yapılmaz → statik son durum.
   */
  const steps = Array.from(document.querySelectorAll<HTMLElement>('.how__step'))
  if (steps.length > 0 && 'IntersectionObserver' in window) {
    const live = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          const step = (entry.target as HTMLElement).closest<HTMLElement>('.how__step')
          for (const s of steps) s.dataset.live = String(s === step)
        }
      },
      { rootMargin: '-30% 0% -30% 0%' },
    )
    for (const s of steps) {
      const visual = s.querySelector('.how__visual')
      if (visual) live.observe(visual)
    }
  }
</script>

<style>
  /*
   * Bu bölüm koyu "sahne" zemininde (`Section tone="stage"`); o zeminin paylaşılan `overflow: hidden`
   * kuralı (diğer sahne bölümlerindeki taşan dekoratif öğeleri kırpmak için) burada `.hw__aside`'ın
   * `position: sticky` davranışını KIRAR (sticky, taşma kırpan bir atada çalışmaz). Yalnızca BU örnekte
   * (`:has` ile hedeflenir) taşma tekrar açılır; ClosingCta/SecuritySummary etkilenmez.
   */
  :global(.section--stage:has(.hw__aside)) {
    overflow: visible;
  }
  .hw {
    display: grid;
    gap: var(--ek-space-12);
  }
  .hw__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ek-space-8);
  }
  .hw__nav {
    display: none;
    flex-direction: column;
    gap: var(--ek-space-3);
  }
  .hw__nav-item {
    display: flex;
    align-items: center;
    gap: var(--ek-space-3);
    color: var(--site-color-on-primary-muted);
    font-size: var(--ek-font-size-lg);
    font-weight: var(--ek-font-weight-semibold);
    transition: color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .hw__nav-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-8);
    height: var(--ek-space-8);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-full);
    background: var(--site-glass-bg);
    color: var(--site-color-on-primary);
    font-size: var(--ek-font-size-md);
    transition:
      background-color var(--ek-duration-base) var(--ek-easing-standard),
      border-color var(--ek-duration-base) var(--ek-easing-standard),
      color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .hw__nav-item[data-active='true'] {
    color: var(--site-color-on-primary);
  }
  .hw__nav-item[data-active='true'] .hw__nav-dot {
    border-color: var(--ek-color-secondary);
    background: var(--ek-color-secondary);
    color: var(--ek-color-content-strong);
  }

  .how {
    /* Sağdan kayan "ekran" giriş sırasında yatay taşma üretmesin; `clip` kaydırma kapsayıcısı DEĞİLDİR
       (sol sütunun yapışkanlığı etkilenmez), gölge/eğim için kenarda pay bırakılır. */
    overflow-x: clip;
    overflow-clip-margin: var(--ek-space-8);
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-8);
    min-width: 0;
  }
  .how__step {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--ek-space-5);
  }
  .how__marker {
    position: relative;
    z-index: 1;
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-12);
    height: var(--ek-space-12);
    border-radius: var(--ek-radius-full);
    background: linear-gradient(140deg, var(--ek-color-primary-darken-1), var(--ek-color-primary));
    box-shadow: 0 0 0 var(--ek-space-2) var(--site-stage-base);
    color: var(--site-color-on-primary);
    font-size: var(--ek-font-size-xl);
    font-weight: var(--site-font-display-weight);
    transition: box-shadow var(--ek-duration-slow) var(--ek-easing-standard);
  }
  /* Etkin adımın işareti ince bir ikincil halka alır (hareket tercihinden bağımsız vurgu). */
  .how__step[data-live='true'] .how__marker {
    box-shadow:
      0 0 0 var(--ek-space-2) var(--site-stage-base),
      0 0 0 calc(var(--ek-space-2) + var(--site-border-width) * 2) color-mix(in srgb, var(--ek-color-secondary) 70%, transparent);
  }
  /* Dikey ilerleme çizgisi: sonraki adıma kadar uzanır. */
  .how__step:not(:last-child)::after {
    content: '';
    position: absolute;
    inset-block-start: var(--ek-space-12);
    inset-block-end: calc(var(--ek-space-8) * -1);
    inset-inline-start: calc(var(--ek-space-6) - var(--site-border-width));
    width: calc(var(--site-border-width) * 2);
    background: linear-gradient(180deg, var(--ek-color-secondary), var(--site-glass-border));
  }
  .how__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--ek-space-3);
    min-width: 0;
    padding-top: var(--ek-space-2);
  }
  .how__title {
    font-size: var(--ek-font-size-2xl);
    font-weight: var(--ek-font-weight-bold);
    letter-spacing: -0.01em;
  }
  .how__text {
    color: var(--ek-color-content-default);
    font-size: var(--ek-font-size-lg);
  }

  /* --- Mini arayüzler ("ekran"): açık yüzeyli uygulama penceresi --- */
  .how__visual {
    position: relative;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-4);
    margin-top: var(--ek-space-4);
    padding: var(--ek-space-5);
    overflow: hidden;
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--site-radius-panel);
    background-color: var(--ek-color-surface);
    background-image: var(--site-texture-dots);
    background-size: var(--site-texture-dots-size);
    box-shadow:
      0 0 0 var(--ek-space-1) color-mix(in srgb, var(--ek-color-secondary) 10%, transparent),
      var(--site-shadow-panel);
    color: var(--ek-color-content-default);
    font-size: var(--ek-font-size-sm);
    transition: transform var(--tilt-transition-duration, var(--ek-duration-fast)) var(--ek-easing-standard);
  }
  /* Üst kenarda ince ışık çizgisi: pencereye derinlik verir. */
  .how__visual::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: calc(var(--site-border-width) * 2);
    background: var(--site-gradient-accent);
    opacity: 0.7;
  }
  .how__chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ek-space-3);
    padding-bottom: var(--ek-space-3);
    border-bottom: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .how__dots {
    display: inline-flex;
    gap: var(--ek-space-1);
  }
  .how__dots i {
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-border-strong);
  }
  /* Koyu sahnede Section'ın `p`/span rengi açık zeminli kartta görünmez kalmasın → özgüllük artırıldı. */
  .how__visual .how__tag {
    color: var(--ek-color-content-muted);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* --- Ortak parçalar: form alanı, yazılan değer, rozet, ışıma --- */
  .field {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
    padding: var(--ek-space-2) var(--ek-space-3);
    border: var(--site-border-width) solid var(--ek-color-border-strong);
    border-radius: var(--ek-radius-md);
    background: var(--ek-color-surface);
  }
  /* Odak halkası: alan yazılırken belirir (statik hâlde görünmez). */
  .field::after {
    content: '';
    position: absolute;
    inset: calc(var(--site-border-width) * -1);
    border: calc(var(--site-border-width) * 2) solid var(--ek-color-secondary);
    border-radius: inherit;
    box-shadow: 0 0 0 var(--ek-space-1) color-mix(in srgb, var(--ek-color-secondary) 18%, transparent);
    opacity: 0;
    pointer-events: none;
  }
  .field__label {
    color: var(--ek-color-content-muted);
    font-size: var(--ek-font-size-xs);
  }
  /* Yazılan değer: üstündeki örtü (imleç sol kenarında) adım adım sağa kayarak metni açar. */
  .type {
    position: relative;
    display: inline-block;
    align-self: flex-start;
    overflow: hidden;
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-semibold);
    line-height: var(--ek-line-height-tight);
    white-space: nowrap;
  }
  .type--key {
    font-family: var(--ek-font-mono);
    letter-spacing: 0.08em;
  }
  .type__cover {
    position: absolute;
    inset: 0;
    background: var(--ek-color-surface);
    translate: 100% 0;
  }
  .type__cover::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: calc(var(--site-border-width) * 2);
    background: var(--ek-color-secondary-darken-1);
    opacity: var(--caret, 0);
  }
  .badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--ek-space-2);
    padding: var(--ek-space-1) var(--ek-space-3);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-success-subtle);
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
  }
  /* Tamamlanma ışıması: onay yerine oturunca bir kez genişleyip söner (statik hâlde görünmez). */
  .done__glow {
    position: absolute;
    inset: calc(var(--ek-space-1) * -1);
    border: calc(var(--site-border-width) * 2) solid var(--ek-color-success);
    border-radius: var(--ek-radius-full);
    opacity: 0;
    pointer-events: none;
  }

  /* --- 1) Hesap: kayıt formu --- */
  .acct {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
  }
  .acct__btn {
    position: relative;
    overflow: hidden;
    padding: var(--ek-space-3);
    border-radius: var(--ek-radius-md);
    background: linear-gradient(140deg, var(--ek-color-primary-darken-1), var(--ek-color-primary));
    box-shadow: 0 var(--ek-space-2) var(--ek-space-4) calc(var(--ek-space-2) * -1) color-mix(in srgb, var(--ek-color-primary) 70%, transparent);
    color: var(--site-color-on-primary);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-semibold);
    text-align: center;
  }
  .acct__sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 30%, color-mix(in srgb, var(--ek-color-background) 38%, transparent) 50%, transparent 70%);
    opacity: 0;
  }
  .acct__progress {
    position: absolute;
    inset: auto 0 0;
    height: calc(var(--site-border-width) * 3);
    background: var(--site-gradient-accent);
    transform-origin: 0 50%;
    opacity: 0.9;
  }

  /* --- 2) Bağlantı: kanal çipleri, maskeli anahtar, şifreli hat --- */
  .conn {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
  }
  .conn__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-2);
  }
  .conn__chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-1);
    height: var(--ek-space-8);
    padding-inline: var(--ek-space-3);
    border: var(--site-border-width) solid color-mix(in srgb, var(--ek-color-secondary) 60%, var(--ek-color-border-strong));
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface);
    box-shadow: 0 0 0 var(--ek-space-1) color-mix(in srgb, var(--ek-color-secondary) 12%, transparent);
    color: var(--ek-color-success);
  }
  .conn__dot {
    width: var(--ek-space-3);
    height: var(--ek-space-3);
    border-radius: var(--ek-radius-full);
    background: var(--chan, var(--ek-color-secondary));
  }
  .conn__check {
    display: inline-flex;
  }
  /* Anahtar -> kilit -> merkez: bağlantı hattı, üzerinde akan veri ve paket. */
  .wire {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--ek-space-2);
    padding: var(--ek-space-3) var(--ek-space-1);
  }
  .wire__node {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-10);
    height: var(--ek-space-10);
    border: var(--site-border-width) solid var(--ek-color-border-strong);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface);
    color: var(--ek-color-primary-darken-1);
  }
  .wire__node--lock {
    border-color: var(--ek-color-secondary);
    background: color-mix(in srgb, var(--ek-color-secondary) 10%, var(--ek-color-surface));
    color: var(--ek-color-secondary-darken-1);
  }
  .wire__node--hub {
    border-color: transparent;
    background: linear-gradient(140deg, var(--ek-color-primary-darken-1), var(--ek-color-primary));
    box-shadow: 0 var(--ek-space-2) var(--ek-space-4) calc(var(--ek-space-2) * -1) color-mix(in srgb, var(--ek-color-primary) 70%, transparent);
    color: var(--site-color-on-primary);
  }
  .wire__halo {
    position: absolute;
    inset: calc(var(--ek-space-1) * -1);
    border-radius: var(--ek-radius-full);
    background: radial-gradient(closest-side, color-mix(in srgb, var(--ek-color-secondary) 40%, transparent), transparent);
    opacity: 0;
    pointer-events: none;
  }
  .wire__line {
    position: relative;
    container-type: inline-size;
    height: calc(var(--site-border-width) * 3);
    overflow: hidden;
    border-radius: var(--ek-radius-full);
    background: linear-gradient(90deg, color-mix(in srgb, var(--ek-color-secondary) 45%, var(--ek-color-border-strong)), var(--ek-color-secondary));
    transform-origin: 0 50%;
  }
  /* Hat üzerinde akan veri: iki kat genişlikte kesikli şerit, yarısı kadar kayar (kesintisiz döngü). */
  .wire__flow {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 200%;
    background: repeating-linear-gradient(
      90deg,
      color-mix(in srgb, var(--ek-color-background) 85%, transparent) 0 var(--ek-space-1),
      transparent var(--ek-space-1) var(--ek-space-3)
    );
    opacity: 0;
  }
  .wire__packet {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    width: var(--ek-space-4);
    height: var(--ek-space-1);
    margin-top: calc(var(--ek-space-1) * -0.5);
    border-radius: var(--ek-radius-full);
    background: linear-gradient(90deg, transparent, var(--ek-color-secondary));
    opacity: 0;
  }

  /* --- 3) Aktarım: katalog -> kanal şeritleri --- */
  .ship {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
  }
  .ship__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ek-space-3);
  }
  .ship__title {
    color: var(--ek-color-content-strong);
    font-weight: var(--ek-font-weight-semibold);
  }
  .ship__status {
    display: grid;
    justify-items: end;
  }
  .ship__state {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-1);
    padding: calc(var(--ek-space-1) * 0.5) var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
  }
  .ship__state--run {
    background: var(--ek-color-info-subtle);
    opacity: 0;
  }
  .ship__state--done {
    background: var(--ek-color-success-subtle);
  }
  .ship__stage {
    --lane: var(--ek-space-10);
    --pitch: calc(var(--lane) + var(--ek-space-2));
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 2fr);
    align-items: center;
    gap: var(--ek-space-4);
  }
  .ship__catalog {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    padding: var(--ek-space-3);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-lg);
    background: var(--ek-color-surface-sunken);
  }
  .ship__caption {
    color: var(--ek-color-content-muted);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ship__item {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
    padding: var(--ek-space-2);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-md);
    background: var(--ek-color-surface);
    box-shadow: var(--ek-shadow-sm);
  }
  /* Gönderim anında ürün satırı kısa bir vurgu alır. */
  .ship__item::after {
    content: '';
    position: absolute;
    inset: calc(var(--site-border-width) * -1);
    border: calc(var(--site-border-width) * 2) solid var(--ek-color-secondary);
    border-radius: inherit;
    opacity: 0;
  }
  .ship__thumb {
    flex: none;
    width: var(--ek-space-5);
    height: var(--ek-space-5);
    border-radius: var(--ek-radius-sm);
    background: linear-gradient(140deg, color-mix(in srgb, var(--ek-color-secondary) 55%, var(--ek-color-surface)), var(--ek-color-primary));
  }
  .ship__lines,
  .feed__lines {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--ek-space-1);
    min-width: 0;
  }
  .ship__lines i,
  .feed__lines i {
    height: calc(var(--ek-space-1) * 1.25);
    border-radius: var(--ek-radius-full);
    background: color-mix(in srgb, var(--ek-color-content-muted) 28%, var(--ek-color-surface-sunken));
  }
  .ship__lines i:last-child,
  .feed__lines i:last-child {
    width: 60%;
    opacity: 0.6;
  }
  .ship__lanes {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
  }
  .ship__lane {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--ek-space-3);
    height: var(--lane);
    padding-inline: var(--ek-space-3);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-lg);
    background: var(--ek-color-surface);
  }
  .ship__dot,
  .feed__dot {
    flex: none;
    width: var(--ek-space-3);
    height: var(--ek-space-3);
    border-radius: var(--ek-radius-full);
    background: var(--chan, var(--ek-color-secondary));
    box-shadow: 0 0 0 calc(var(--site-border-width) * 3) color-mix(in srgb, var(--chan, var(--ek-color-secondary)) 18%, transparent);
  }
  .ship__track {
    position: relative;
    display: block;
    height: var(--ek-space-2);
    overflow: hidden;
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface-sunken);
  }
  .ship__fill {
    position: absolute;
    inset: 0;
    border-radius: var(--ek-radius-full);
    background: var(--site-gradient-accent);
    transform-origin: 0 50%;
  }
  .ship__shine {
    position: absolute;
    inset: 0;
    width: 40%;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--ek-color-background) 70%, transparent), transparent);
    opacity: 0;
  }
  .ship__ok {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-6);
    height: var(--ek-space-6);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-success);
    color: var(--site-color-on-primary);
  }
  /* Uçan ürün kartı: katalogdan kanal şeridinin başına uçar ve ilerlemeye karışır (statik hâlde görünmez). */
  .ship__card {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: calc(var(--ek-space-6) + var(--ek-space-3));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-8);
    height: var(--ek-space-6);
    margin-top: calc(var(--ek-space-3) * -1);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-md);
    background: var(--ek-color-surface);
    box-shadow: var(--site-shadow-card-hover);
    opacity: 0;
    pointer-events: none;
  }
  .ship__card i {
    width: var(--ek-space-4);
    height: var(--ek-space-4);
    border-radius: var(--ek-radius-sm);
    background: linear-gradient(140deg, color-mix(in srgb, var(--ek-color-secondary) 55%, var(--ek-color-surface)), var(--ek-color-primary));
  }

  /* --- 4) Tek panel: kutucuklar, sipariş akışı, grafik --- */
  .panel {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
  }
  .panel__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .panel__title {
    color: var(--ek-color-content-strong);
    font-weight: var(--ek-font-weight-semibold);
  }
  .panel__live {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    padding: calc(var(--ek-space-1) * 0.5) var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-success-subtle);
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
  }
  .panel__beacon {
    position: relative;
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-success);
  }
  .panel__beacon::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--ek-color-success);
    opacity: 0;
  }
  .panel__sub {
    color: var(--ek-color-content-muted);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--ek-space-2);
  }
  .tiles__item {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    padding: var(--ek-space-3);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-lg);
    background: var(--ek-color-surface);
    box-shadow: var(--ek-shadow-sm);
  }
  .tiles__icon {
    display: inline-flex;
    color: var(--ek-color-primary-darken-1);
  }
  .tiles__label {
    color: var(--ek-color-content-strong);
    font-weight: var(--ek-font-weight-semibold);
  }
  .tiles__bar {
    display: block;
    height: var(--ek-space-1);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface-sunken);
  }
  .tiles__bar i {
    display: block;
    width: 64%;
    height: 100%;
    border-radius: var(--ek-radius-full);
    background: var(--site-gradient-accent);
    transform-origin: 0 50%;
  }
  .tiles__item:nth-child(2) .tiles__bar i {
    width: 82%;
  }
  .tiles__item:nth-child(3) .tiles__bar i {
    width: 48%;
  }
  .tiles__item:nth-child(4) .tiles__bar i {
    width: 30%;
  }
  .panel__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--ek-space-3);
  }
  .feed,
  .chart {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    padding: var(--ek-space-3);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-lg);
    background: var(--ek-color-surface);
  }
  /* Sipariş akışı: üç satırlık pencere; satırlar yuva (slot) konumlarına translate ile yerleşir. */
  .feed__list {
    --row: var(--ek-space-8);
    --pitch: calc(var(--row) + var(--ek-space-2));
    position: relative;
    height: calc(var(--pitch) * 3 - var(--ek-space-2));
    overflow: hidden;
  }
  .feed__row {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
    height: var(--row);
    padding-inline: var(--ek-space-2);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-md);
    background: var(--ek-color-surface);
    translate: 0 calc(var(--slot) * var(--pitch));
  }
  /* Statik hâl: ilk satır sıradaki (görünmez), diğer üçü yuvalarda. */
  .feed__row:nth-child(1) {
    --slot: -1;
    opacity: 0;
  }
  .feed__row:nth-child(2) {
    --slot: 0;
  }
  .feed__row:nth-child(3) {
    --slot: 1;
  }
  .feed__row:nth-child(4) {
    --slot: 2;
  }
  .feed__chip {
    flex: none;
    padding: calc(var(--ek-space-1) * 0.5) var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
  }
  .feed__chip--info {
    background: var(--ek-color-info-subtle);
  }
  .feed__chip--success {
    background: var(--ek-color-success-subtle);
  }
  .feed__chip--warning {
    background: var(--ek-color-warning-subtle);
  }
  .feed__chip--neutral {
    background: var(--ek-color-neutral-subtle);
  }
  .chart__bars {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    align-items: end;
    gap: var(--ek-space-1);
    height: calc(var(--ek-space-16) + var(--ek-space-5));
    padding-top: var(--ek-space-2);
    border-bottom: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .chart__bar {
    height: 100%;
    border-radius: var(--ek-radius-sm) var(--ek-radius-sm) 0 0;
    background: linear-gradient(180deg, var(--ek-color-secondary), color-mix(in srgb, var(--ek-color-primary) 70%, var(--ek-color-secondary)));
    transform-origin: 50% 100%;
    scale: 1 var(--h);
  }
  .chart__bar:nth-child(1) {
    --h: 0.42;
    --h2: 0.55;
  }
  .chart__bar:nth-child(2) {
    --h: 0.58;
    --h2: 0.46;
  }
  .chart__bar:nth-child(3) {
    --h: 0.5;
    --h2: 0.68;
  }
  .chart__bar:nth-child(4) {
    --h: 0.72;
    --h2: 0.6;
  }
  .chart__bar:nth-child(5) {
    --h: 0.64;
    --h2: 0.82;
  }
  .chart__bar:nth-child(6) {
    --h: 0.84;
    --h2: 0.7;
  }
  .chart__bar:nth-child(7) {
    --h: 0.76;
    --h2: 0.92;
  }
  .chart__bar:nth-child(8) {
    --h: 0.94;
    --h2: 0.8;
  }

  @container (min-width: 30rem) {
    .tiles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .panel__grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    }
  }
  @container (max-width: 20rem) {
    .ship__stage {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 2fr);
      gap: var(--ek-space-3);
    }
    .ship__lines,
    .ship__caption {
      display: none;
    }
    .ship__item {
      justify-content: center;
    }
  }

  /*
   * Hareket — iki katman:
   *  A) Giriş (adım görünür olunca, `how-progress` sahnesinin `data-state`'i): "ekran" sağdan kayarak gelir (S7 korunur).
   *  B) Sahne (adım ETKİN olunca, `data-live='true'`): adıma özgü sinematik dizi BİR KEZ oynar. Dizi `data-state='play'`
   *     ile başlangıç pozunda DURAKLATILMIŞ bekler (backwards dolgu) ve yalnızca etkin adımda ilerler.
   *  C) Döngü: tamamlanan sahnede akış/parıltı/canlı akış — yalnızca etkin VE görünür (`data-visible='true'`) iken çalışır.
   * Yalnızca translate/scale/rotate/opacity; reduced-motion / "Hareket" kapalı / JS'siz → statik tamamlanmış hâl.
   * Zamanlama birimleri: --t0 (bekleme), --u (ana adım), --s (stagger) — hepsi --site-motion-* token'ı.
   */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes how-screen-in {
      from {
        opacity: 0;
        translate: calc(var(--site-motion-distance) * 6) 0;
      }
    }
    @keyframes how-fill {
      from {
        scale: 0 1;
      }
    }
    @keyframes how-grow {
      from {
        scale: 1 0;
      }
    }
    @keyframes how-pop {
      from {
        opacity: 0;
        scale: var(--site-motion-scale-from);
      }
    }
    @keyframes how-appear {
      from {
        opacity: 0;
      }
    }
    @keyframes how-rise {
      from {
        opacity: 0;
        translate: 0 var(--site-motion-distance);
      }
    }
    @keyframes how-type {
      from {
        translate: 0 0;
      }
    }
    @keyframes how-hold {
      0%,
      94% {
        opacity: 1;
      }
      100% {
        opacity: 0;
      }
    }
    @keyframes how-focus {
      0% {
        opacity: 0;
      }
      10%,
      86% {
        opacity: 1;
      }
      100% {
        opacity: 0;
      }
    }
    @keyframes how-press {
      0%,
      100% {
        scale: 1;
      }
      35% {
        scale: 0.97;
      }
    }
    @keyframes how-sweep {
      0% {
        opacity: 0;
        translate: -100% 0;
      }
      25% {
        opacity: 1;
      }
      100% {
        opacity: 0;
        translate: 100% 0;
      }
    }
    @keyframes how-glow {
      0% {
        opacity: 0;
        scale: 0.9;
      }
      30% {
        opacity: 0.8;
      }
      100% {
        opacity: 0;
        scale: 1.35;
      }
    }
    @keyframes how-flash {
      0%,
      100% {
        opacity: 0;
      }
      30% {
        opacity: 1;
      }
    }
    @keyframes how-connect {
      from {
        opacity: 0.4;
        scale: 0.94;
      }
    }
    @keyframes how-fly {
      0% {
        opacity: 0;
        translate: var(--fx) var(--fy);
        scale: 0.8;
      }
      15% {
        opacity: 1;
      }
      62% {
        opacity: 1;
