---
/**
 * Entegrasyon ekosistemi (ADR-0014 Karar 2, bölüm 3) — S12: durum raporu değil, entegrasyon VİZYONU.
 * Merkezde platform çekirdeği; çevresinde dört ekosistem düğümü (`getEcosystemNodes()`): pazaryerleri,
 * e-ticaret altyapıları, ERP/muhasebe, kargo ve fatura akışı. Kanal adı YOK; kanal ayrımı isimsiz renkli nokta
 * (`data-code` -> `--chan`). Her düğüm kayıttaki gerçek bir entegrasyona/yeteneğe dayanır (dayanağı yoksa
 * seçici düğümü döndürmez). Kanal bazında kapsam ve farklar /entegrasyonlar sayfasındadır.
 *
 * S13 (parça B): şema daha derin ve canlı — ışıklı, katmanlı merkez çekirdek; çevresinde iki yörünge halkası
 * ve üzerinde dönen isimsiz renkli kanal noktaları; her hatta İKİ YÖNLÜ veri paketleri (düğümden merkeze
 * kanal renginde, merkezden düğüme vurgu renginde); hatlar saat yönünde SIRAYLA ışır, paket vardığında düğüm
 * kartı parlar, merkeze varan akış çekirdekten dalga yayar. Üzerine gelinen düğümün hattı ve akışı vurgulanır,
 * diğerleri geri çekilir (`:has`, JS yok; hareket kapalıyken de çalışan statik vurgu).
 * Sahne `ecosystem` (bu dosyadaki stil): yalnızca transform/opacity; döngüler yalnızca görünürken
 * (`data-visible='true'`) çalışır; reduced-motion / "Hareket" kapalı / JS'siz durumda statik şema.
 * Alt vizyon şeridi genel `reveal` girişini kullanır.
 */
import Section from '../Section.astro'
import SectionHeading from './SectionHeading.astro'
import Icon from './Icon.astro'
import Logo from '../Logo.astro'
import { getEcosystemNodes, ecosystemPromises } from '../../data/integrations'
import { pageHref } from './links'

const nodes = getEcosystemNodes()
const detailHref = pageHref('/entegrasyonlar')
/** Masaüstü şemadaki konumlar (sol üst, sağ üst, sol alt, sağ alt). */
const SLOTS = ['tl', 'tr', 'bl', 'br'] as const
const lanes = nodes.map((n, i) => ({ slot: SLOTS[i] ?? 'tl', code: n.channelCodes[0] }))
/** Yörüngedeki isimsiz kanal noktaları: düğümlerin dayandığı kanalların birleşimi (ad yok, yalnızca renk). */
const orbitCodes = [...new Set(nodes.flatMap((n) => n.channelCodes))]
const outerCodes = orbitCodes.filter((_, i) => i % 2 === 0)
const innerCodes = orbitCodes.filter((_, i) => i % 2 === 1)
---

<Section tone="muted" id="entegrasyonlar" labelledby="entegrasyon-baslik">
  <SectionHeading
    id="entegrasyon-baslik"
    eyebrow="Entegrasyon ekosistemi"
    title="Satış ekosisteminizin tamamı, tek platformda"
    accent="tek platformda"
    lead="Entegrasyonik; pazaryerlerini, e-ticaret altyapınızı, ERP ve muhasebe sisteminizi, kargo ve fatura akışlarınızı tek merkezde buluşturmak için tasarlandı. Çok kanallı satışın verisi tek yerden yönetilir."
  />

  <div class="eco" data-scene="ecosystem" data-testid="ecosystem">
    <span class="eco__spot" aria-hidden="true"></span>
    <svg class="eco__lines" viewBox="0 0 160 70" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="eco-wire" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" class="eco__stop-a"></stop>
          <stop offset="0.5" class="eco__stop-b"></stop>
          <stop offset="1" class="eco__stop-a"></stop>
        </linearGradient>
      </defs>
      <path class="eco__wire eco__wire--tl" d="M48 17.5 L80 35"></path>
      <path class="eco__wire eco__wire--tr" d="M112 17.5 L80 35"></path>
      <path class="eco__wire eco__wire--bl" d="M48 52.5 L80 35"></path>
      <path class="eco__wire eco__wire--br" d="M112 52.5 L80 35"></path>
      <path class="eco__beam eco__beam--tl" d="M48 17.5 L80 35"></path>
      <path class="eco__beam eco__beam--tr" d="M112 17.5 L80 35"></path>
      <path class="eco__beam eco__beam--bl" d="M48 52.5 L80 35"></path>
      <path class="eco__beam eco__beam--br" d="M112 52.5 L80 35"></path>
    </svg>

    {
      lanes.map((l) => (
        <span class={`eco__lane eco__lane--${l.slot}`} aria-hidden="true">
          <i class="eco__packet eco__packet--in" data-code={l.code}></i>
          <i class="eco__packet eco__packet--in eco__packet--late" data-code={l.code}></i>
          <i class="eco__packet eco__packet--out"></i>
        </span>
      ))
    }

    <div class="eco__hub" aria-hidden="true">
      <span class="eco__orbit eco__orbit--outer">
        {outerCodes.map((code) => <i class="eco__sat" data-code={code}></i>)}
      </span>
      <span class="eco__orbit eco__orbit--inner">
        {innerCodes.map((code) => <i class="eco__sat" data-code={code}></i>)}
      </span>
      <span class="eco__ring"></span>
      <span class="eco__ring eco__ring--late"></span>
      <span class="eco__core">
        <Logo tone="inverse" />
        <span class="eco__core-label">Tek merkez</span>
      </span>
    </div>

    <ul class="eco__nodes">
      {
        nodes.map((n, i) => (
          <li class={`eco__node eco__node--${SLOTS[i] ?? 'tl'}`} data-part="eco-node" data-reveal>
            <span class="eco__lit" aria-hidden="true"></span>
            <span class="eco__icon">
              <Icon name={n.icon} size="md" />
            </span>
            <div class="eco__copy">
              <h3 class="eco__title">{n.title}</h3>
              <p class="eco__line">{n.line}</p>
            </div>
            <span class="eco__dots" aria-hidden="true">
              {n.channelCodes.map((code) => (
                <i data-code={code} />
              ))}
            </span>
          </li>
        ))
      }
    </ul>
  </div>

  <ul class="promises" data-scene="reveal" data-testid="ecosystem-promises">
    {
      ecosystemPromises.map((p) => (
        <li class="promise" data-reveal>
          <Icon name="check" size="sm" />
          <div>
            <h3 class="promise__title">{p.title}</h3>
            <p class="promise__line">{p.line}</p>
          </div>
        </li>
      ))
    }
  </ul>

  {
    detailHref && (
      <p class="eco__foot">
        <a class="eco__link" href={`${detailHref}#kapsam`} data-testid="ecosystem-link">
          Entegrasyonları ve kanal bazında kapsamı inceleyin
          <Icon name="arrow" size="sm" />
        </a>
      </p>
    )
  }
</Section>

<style>
  /*
   * Şema: mobilde (<1024px) merkez (yörüngeleriyle) + düğüm kartları dikey yığın; hat ve paketler gizli.
   * Masaüstünde sabit en-boy oranlı sahne (`aspect-ratio` + `container-type: size`): düğümler yüzde konumlu,
   * hatlar aynı oranlı viewBox'ta, paketler `cqw/cqh` ile hat boyunca kayar → geometri her genişlikte tutarlı.
   * Katman sırası: hat (svg) < paket < düğüm kartı (paket kartın altına "girer") < merkez.
   */
  .eco {
    --glow: color-mix(in srgb, var(--ek-color-secondary) 55%, transparent);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-4);
    margin-top: var(--ek-space-10);
  }
  .eco__lines,
  .eco__lane,
  .eco__spot {
    display: none;
  }

  /* --- Merkez çekirdek --- */
  .eco__hub {
    position: relative;
    display: grid;
    place-items: center;
    align-self: center;
    width: calc(var(--ek-space-16) * 2.5);
    margin-block: var(--ek-space-12);
    aspect-ratio: 1;
  }
  .eco__core {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--ek-space-2);
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: var(--site-border-width) solid color-mix(in srgb, var(--ek-color-secondary) 45%, var(--site-glass-border));
    border-radius: var(--ek-radius-full);
    background: var(--site-stage-mesh);
    box-shadow:
      0 0 0 var(--ek-space-2) color-mix(in srgb, var(--ek-color-secondary) 12%, transparent),
      0 0 var(--ek-space-16) var(--ek-space-2) color-mix(in srgb, var(--ek-color-secondary) 30%, transparent),
      var(--site-shadow-panel);
  }
  /* Derinlik: üst-solda ışık, alt kenarda iç gölge halkası (küre hissi). */
  .eco__core::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      radial-gradient(circle at 32% 24%, color-mix(in srgb, var(--ek-color-secondary) 38%, transparent), transparent 55%),
      radial-gradient(circle at 70% 90%, color-mix(in srgb, var(--ek-color-primary) 55%, transparent), transparent 60%);
    pointer-events: none;
  }
  .eco__core::after {
    content: '';
    position: absolute;
    inset: var(--ek-space-2);
    border: var(--site-border-width) solid color-mix(in srgb, var(--ek-color-background) 12%, transparent);
    border-radius: inherit;
    pointer-events: none;
  }
  .eco__core > :global(*) {
    position: relative;
    z-index: 1;
  }
  .eco__core :global(.logo__word) {
    font-size: var(--ek-font-size-md);
  }
  .eco__core-label {
    color: var(--site-color-on-primary-muted);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  /* Yörüngeler: ince halkalar, üzerinde isimsiz renkli kanal noktaları (hareket açıkken yavaşça döner). */
  .eco__orbit {
    position: absolute;
    border-radius: var(--ek-radius-full);
    pointer-events: none;
  }
  .eco__orbit--outer {
    inset: -30%;
    border: var(--site-border-width) dashed color-mix(in srgb, var(--ek-color-secondary) 40%, var(--ek-color-border-default));
  }
  .eco__orbit--inner {
    inset: -13%;
    border: var(--site-border-width) solid color-mix(in srgb, var(--ek-color-secondary) 28%, var(--ek-color-border-default));
  }
  .eco__sat {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    width: var(--ek-space-3);
    height: var(--ek-space-3);
    margin: calc(var(--ek-space-3) / -2) 0 0 calc(var(--ek-space-3) / -2);
    border: calc(var(--site-border-width) * 2) solid var(--ek-color-surface);
    border-radius: var(--ek-radius-full);
    background: var(--chan, var(--ek-color-secondary));
    box-shadow: 0 0 0 var(--ek-space-1) color-mix(in srgb, var(--chan, var(--ek-color-secondary)) 22%, transparent);
  }
  /* Nokta, yörünge çemberine açıyla yerleştirilir: merkezden yarıçap kadar dışarı (halka öğesinin yarısı). */
  .eco__orbit--outer .eco__sat {
    transform: rotate(var(--a)) translateY(calc(var(--ek-space-16) * -2)) rotate(calc(var(--a) * -1));
  }
  .eco__orbit--inner .eco__sat {
    transform: rotate(var(--a)) translateY(calc(var(--ek-space-16) * -1.575)) rotate(calc(var(--a) * -1));
  }
  .eco__sat:nth-child(1) {
    --a: 20deg;
  }
  .eco__sat:nth-child(2) {
    --a: 140deg;
  }
  .eco__sat:nth-child(3) {
    --a: 260deg;
  }
  .eco__orbit--inner .eco__sat:nth-child(1) {
    --a: 80deg;
  }
  .eco__orbit--inner .eco__sat:nth-child(2) {
    --a: 200deg;
  }
  .eco__orbit--inner .eco__sat:nth-child(3) {
    --a: 320deg;
  }
  .eco__ring {
    position: absolute;
    inset: 0;
    border: calc(var(--site-border-width) * 2) solid var(--glow);
    border-radius: var(--ek-radius-full);
    opacity: 0;
  }

  /* --- Düğümler --- */
  .eco__nodes {
    display: grid;
    gap: var(--ek-space-3);
    grid-template-columns: minmax(0, 1fr);
  }
  .eco__node {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--ek-space-2) var(--ek-space-4);
    padding: var(--ek-space-5);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-xl);
    background: var(--ek-color-surface);
    box-shadow: var(--site-shadow-card);
    transition:
      border-color var(--ek-duration-base) var(--ek-easing-standard),
      box-shadow var(--ek-duration-base) var(--ek-easing-standard),
      opacity var(--ek-duration-base) var(--ek-easing-standard);
  }
  /* Paket vardığında / üzerine gelindiğinde kartın çevresinde yanan vurgu halkası (statik: görünmez). */
  .eco__lit {
    position: absolute;
    inset: calc(var(--site-border-width) * -1);
    border: calc(var(--site-border-width) * 2) solid var(--ek-color-secondary);
    border-radius: inherit;
    box-shadow:
      0 0 0 var(--ek-space-1) color-mix(in srgb, var(--ek-color-secondary) 14%, transparent),
      0 var(--ek-space-4) var(--ek-space-10) calc(var(--ek-space-4) * -1) var(--glow);
    opacity: 0;
    pointer-events: none;
  }
  .eco__node:hover {
    box-shadow: var(--site-shadow-card-hover);
  }
  .eco__node:hover .eco__lit {
    opacity: 1;
  }
  .eco__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-10);
    height: var(--ek-space-10);
    border-radius: var(--ek-radius-lg);
    background: linear-gradient(140deg, var(--ek-color-primary-darken-1), var(--ek-color-primary));
    color: var(--site-color-on-primary);
    box-shadow: 0 0.5rem 1rem -0.5rem color-mix(in srgb, var(--ek-color-primary) 60%, transparent);
    transition: scale var(--ek-duration-base) var(--ek-easing-standard);
  }
  .eco__node:hover .eco__icon {
    scale: 1.06;
  }
  .eco__copy {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
  }
  .eco__title {
    color: var(--ek-color-content-strong);
    font-size: var(--site-card-title-size);
    font-weight: var(--site-card-title-weight);
    line-height: var(--ek-line-height-tight);
    letter-spacing: -0.01em;
  }
  .eco__line {
    color: var(--ek-color-content-default);
    font-size: var(--site-card-desc-size);
    font-weight: var(--site-card-desc-weight);
    line-height: var(--ek-line-height-normal);
  }
  .eco__dots {
    grid-column: 2;
    display: inline-flex;
    gap: var(--ek-space-2);
    padding-top: var(--ek-space-1);
  }
  .eco__dots i {
    width: calc(var(--ek-space-2) * 0.75);
    height: calc(var(--ek-space-2) * 0.75);
    border-radius: var(--ek-radius-full);
    background: var(--chan, var(--ek-color-secondary));
    opacity: 0.85;
  }

  /* --- Vizyon şeridi --- */
  .promises {
    display: grid;
    gap: var(--ek-space-5);
    margin-top: var(--ek-space-12);
    padding-top: var(--ek-space-8);
    border-top: var(--site-border-width) solid var(--ek-color-border-default);
    grid-template-columns: minmax(0, 1fr);
  }
  .promise {
    display: flex;
    align-items: flex-start;
    gap: var(--ek-space-3);
  }
  .promise > :global(.icon) {
    flex: none;
    margin-top: var(--ek-space-1);
    padding: calc(var(--ek-space-1) * 0.5);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-secondary-darken-1);
    color: var(--site-color-on-primary);
  }
  .promise__title {
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-lg);
    font-weight: var(--ek-font-weight-semibold);
  }
  .promise__line {
    color: var(--ek-color-content-default);
    font-size: var(--site-card-desc-size);
  }
  .eco__foot {
    margin-top: var(--ek-space-8);
  }
  .eco__link {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    min-height: var(--site-tap-target);
    color: var(--site-color-link);
    font-size: var(--ek-font-size-lg);
    font-weight: var(--ek-font-weight-semibold);
    text-decoration: none;
  }
  .eco__link :global(.icon) {
    transition: translate var(--ek-duration-base) var(--ek-easing-standard);
  }
  .eco__link:hover {
    text-decoration: underline;
  }
  .eco__link:hover :global(.icon) {
    translate: var(--ek-space-1) 0;
  }

  @media (min-width: 640px) {
    .eco__nodes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .promises {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* --- Masaüstü şema --- */
  @media (min-width: 1024px) {
    .eco {
      display: block;
      aspect-ratio: 16 / 7;
      container-type: size;
      overflow: hidden;
      margin-top: var(--ek-space-12);
      border: var(--site-border-width) solid var(--ek-color-border-default);
      border-radius: var(--site-radius-panel);
      background-color: var(--ek-color-surface);
      background-image: var(--site-texture-dots);
      background-size: var(--site-texture-dots-size);
      box-shadow: var(--site-shadow-card);
    }
    /* Merkezin arkasındaki yumuşak ışık alanı (derinlik). */
    .eco__spot {
      display: block;
      position: absolute;
      inset-inline-start: 50%;
      inset-block-start: 50%;
      width: 60cqw;
      height: 60cqw;
      translate: -50% -50%;
      border-radius: var(--ek-radius-full);
      background: radial-gradient(
        circle,
        color-mix(in srgb, var(--ek-color-secondary) 16%, transparent) 0%,
        color-mix(in srgb, var(--ek-color-secondary) 6%, transparent) 35%,
        transparent 65%
      );
      pointer-events: none;
    }
    .eco__lines {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      fill: none;
      stroke-linecap: round;
    }
    .eco__lines path {
      vector-effect: non-scaling-stroke;
      transition: opacity var(--ek-duration-base) var(--ek-easing-standard);
    }
    .eco__wire {
      stroke: url(#eco-wire);
      stroke-width: 2;
    }
    /* Işın: hattın üzerinde parlayan, daha kalın kopya (sırayla ışır; statik: görünmez). */
    .eco__beam {
      stroke: var(--ek-color-secondary);
      stroke-width: 5;
      opacity: 0;
    }
    .eco__stop-a {
      stop-color: color-mix(in srgb, var(--ek-color-secondary) 40%, var(--ek-color-border-default));
    }
    .eco__stop-b {
      stop-color: var(--ek-color-secondary);
    }
    .eco__hub {
      position: absolute;
      inset-inline-start: 50%;
      inset-block-start: 50%;
      z-index: 3;
      width: 19cqw;
      margin: 0;
      translate: -50% -50%;
    }
    .eco__core :global(.logo__word) {
      font-size: clamp(var(--ek-font-size-md), 1.5cqw, var(--ek-font-size-lg));
    }
    .eco__orbit--outer .eco__sat {
      transform: rotate(var(--a)) translateY(-15.2cqw) rotate(calc(var(--a) * -1));
    }
    .eco__orbit--inner .eco__sat {
      transform: rotate(var(--a)) translateY(-11.97cqw) rotate(calc(var(--a) * -1));
    }
    .eco__nodes {
      position: static;
      display: block;
    }
    .eco__node {
      position: absolute;
      width: 30cqw;
      translate: 0 -50%;
    }
    .eco__node--tl,
    .eco__node--bl {
      inset-inline-start: 3cqw;
    }
    .eco__node--tr,
    .eco__node--br {
      inset-inline-end: 3cqw;
    }
    .eco__node--tl,
    .eco__node--tr {
      inset-block-start: 25%;
    }
    .eco__node--bl,
    .eco__node--br {
      inset-block-start: 75%;
    }

    /* Paket şeritleri: her hat için bir katman (üzerine gelince topluca vurgulanır / geri çekilir). */
    .eco__lane {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      transition: opacity var(--ek-duration-base) var(--ek-easing-standard);
    }
    /* Düğüm ucu (x=30/70 %, y=25/75 %) ile merkez (50 %, 50 %) arası: `--in` düğümden merkeze, `--out` tersi. */
    .eco__lane--tl {
      --ex: 30%;
      --ey: 25%;
      --dx: 20cqw;
      --dy: 25cqh;
    }
    .eco__lane--tr {
      --ex: 70%;
      --ey: 25%;
      --dx: -20cqw;
      --dy: 25cqh;
    }
    .eco__lane--bl {
      --ex: 30%;
      --ey: 75%;
      --dx: 20cqw;
      --dy: -25cqh;
    }
    .eco__lane--br {
      --ex: 70%;
      --ey: 75%;
      --dx: -20cqw;
      --dy: -25cqh;
    }
    .eco__packet {
      --size: calc(var(--ek-space-2) * 1.25);
      position: absolute;
      width: var(--size);
      height: var(--size);
      margin: calc(var(--size) / -2) 0 0 calc(var(--size) / -2);
      border-radius: var(--ek-radius-full);
