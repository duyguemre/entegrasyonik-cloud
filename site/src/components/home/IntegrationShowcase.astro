---
/**
 * Entegrasyon vitrini (ADR-0014 Karar 2, bölüm 3). YALNIZCA `getPublicIntegrations()` (mevcut entegrasyonlar).
 * Dürüstlük: her kartta kapsam düzeyi metin olarak, bilinen sınırlar görünür liste olarak yazılır; ayrıca
 * kapsam karşılaştırma tablosu vardır. Logo yok (marka izni Açık Soru 3): metin monogramı.
 * Sahne yer tutucusu: yok (statik bölüm); kart/satır kancaları `data-part` ile.
 */
import Section from '../Section.astro'
import SectionHeading from './SectionHeading.astro'
import Icon from './Icon.astro'
import { getPublicIntegrations, CAPABILITY_LABELS, type CapabilityKey } from '../../data/integrations'
import { pageHref } from './links'

const items = getPublicIntegrations()
const detailHref = pageHref('/entegrasyonlar')

const MATRIX_KEYS: CapabilityKey[] = [
  'products',
  'stockPrice',
  'orders',
  'returns',
  'questions',
  'finance',
  'shippingNotice',
  'invoiceNotice',
]
const METER: Record<string, number> = { broad: 3, partial: 2, limited: 1 }

const levelOf = (i: (typeof items)[number], key: CapabilityKey) => i.capabilities.find((c) => c.key === key)?.level

/** Sütun başlığı ikonu + KISA ad (S10 2. tur: dar sütuna sığması için) — tam ad `CAPABILITY_LABELS`'tan gelir,
 * ekran okuyucuya kısaltılmamış hâliyle iletilir (`aria-label`); kısaltma yeni bilgi eklemez/uydurmaz. */
const MATRIX_ICON: Record<CapabilityKey, 'stock' | 'orders' | 'returns' | 'chat' | 'finance' | 'notice' | 'receipt' | 'layers'> = {
  products: 'layers',
  stockPrice: 'stock',
  orders: 'orders',
  returns: 'returns',
  questions: 'chat',
  finance: 'finance',
  shippingNotice: 'notice',
  invoiceNotice: 'receipt',
  orderActions: 'orders',
  categories: 'layers',
}
const MATRIX_SHORT: Record<CapabilityKey, string> = {
  products: 'Ürün',
  stockPrice: 'Stok/Fiyat',
  orders: 'Sipariş',
  returns: 'İade',
  questions: 'Soru-cevap',
  finance: 'Finans',
  shippingNotice: 'Kargo',
  invoiceNotice: 'Fatura',
  orderActions: 'Sipariş',
  categories: 'Kategori',
}
const STATE_LABEL = { yes: 'Destekleniyor', limited: 'Sınırlı', none: 'Sunulmuyor' } as const
const stateOf = (level: string | undefined): keyof typeof STATE_LABEL => (level === 'supported' ? 'yes' : level === 'limited' ? 'limited' : 'none')
---

<Section tone="muted" id="entegrasyonlar" labelledby="entegrasyon-baslik">
  <SectionHeading
    id="entegrasyon-baslik"
    eyebrow="Entegrasyonlar"
    title="Bugün bağlanabilen entegrasyonlar"
    lead="Yalnızca çalışan entegrasyonları listeliyoruz. Kapsam her entegrasyonda farklıdır; neyin desteklendiğini ve sınırlarını açıkça yazıyoruz."
  />

  <ul class="ig__grid" data-scene="reveal" data-testid="integration-grid">
    {
      items.map((i) => (
        <li class="ig__card" data-part="integration" data-code={i.code} data-reveal data-tilt>
          <div class="ig__head">
            <span class="ig__mono" aria-hidden="true">{i.name.slice(0, 1)}</span>
            <div class="ig__id">
              <h3 class="ig__name">{i.name}</h3>
              <p class="ig__kind">{i.kindLabel}</p>
            </div>
          </div>
          <p class="ig__summary">{i.summary}</p>
          <p class="ig__coverage">
            <span class="ig__meter" aria-hidden="true" data-level={METER[i.coverage]}>
              <span />
              <span />
              <span />
            </span>
            <span>{i.coverageLabel}</span>
          </p>
          {i.limitations.length > 0 && (
            <div class="ig__limits">
              <p class="ig__limits-title">
                <Icon name="info" size="sm" />
                <span>Bilinmesi gerekenler</span>
              </p>
              <ul>
                {i.limitations.map((l) => (
                  <li>{l}</li>
                ))}
              </ul>
            </div>
          )}
        </li>
      ))
    }
  </ul>

  <div class="ig__matrix-block">
    <h3 class="ig__matrix-title">Kapsam karşılaştırması</h3>
    <p class="ig__matrix-lead">Her satır bir entegrasyonun sekiz temel işlem için kapsamını gösterir.</p>
    <ul class="ig__legend">
      <li class="ig__legend-item">
        <span class="ig__status" data-state="yes" aria-hidden="true"><Icon name="check" size="sm" /></span>
        Destekleniyor
      </li>
      <li class="ig__legend-item">
        <span class="ig__status" data-state="limited" aria-hidden="true"></span>
        Bu sürümde kısmi
      </li>
      <li class="ig__legend-item">
        <span class="ig__status" data-state="none" aria-hidden="true"></span>
        Sunulmuyor
      </li>
    </ul>

    <!-- Masaüstü/tablet: hizalı matris (sütun=işlem, satır=entegrasyon), yatayda kaydırılabilir, başlık+ilk sütun yapışkan. -->
    <div class="ig__matrix-scroll" role="region" aria-label="Entegrasyonların desteklediği işlemler tablosu" tabindex="0">
      <table class="ig__matrix" data-scene="reveal" data-testid="integration-matrix">
        <caption class="sr-only">Entegrasyonların desteklediği işlemler</caption>
        <thead>
          <tr>
            <th scope="col" class="ig__matrix-corner">Entegrasyon</th>
            {
              MATRIX_KEYS.map((k) => (
                <th scope="col" aria-label={CAPABILITY_LABELS[k]}>
                  <span class="ig__col">
                    <Icon name={MATRIX_ICON[k]} size="sm" />
                    <span aria-hidden="true">{MATRIX_SHORT[k]}</span>
                  </span>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            items.map((i) => (
              <tr class="ig__matrix-row" data-code={i.code} data-reveal>
                <th scope="row">
                  <span class="ig__matrix-rowhead">
                    <span class="ig__mono ig__mono--sm" aria-hidden="true">{i.name.slice(0, 1)}</span>
                    <span>{i.name}</span>
                  </span>
                </th>
                {
                  MATRIX_KEYS.map((k) => {
                    const state = stateOf(levelOf(i, k))
                    return (
                      <td>
                        <span class="ig__status" data-state={state} aria-hidden="true">
                          {state === 'yes' && <Icon name="check" size="sm" />}
                        </span>
                        <span class="sr-only">
                          {i.name} — {CAPABILITY_LABELS[k]}: {STATE_LABEL[state]}
                        </span>
                      </td>
                    )
                  })
                }
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <!-- Mobil: kanal başına kompakt kart, 8 ikonlu mini ızgara (yatay kaydırma gerekmez). CSS `display:none` ile
         yalnızca aktif kırılım noktasında biri görünür/erişilebilir kalır (diğeri erişilebilirlik ağacından
         tamamen çıkar) — iki temsilin de aynı anda okunmasını önlemek için ayrı `aria-hidden` gerekmez. -->
    <ul class="ig__mcards" aria-label="Entegrasyonların desteklediği işlemler">
      {
        items.map((i) => (
          <li class="ig__mcard" data-code={i.code}>
            <div class="ig__mcard-head">
              <span class="ig__mono ig__mono--sm" aria-hidden="true">{i.name.slice(0, 1)}</span>
              <span class="ig__mcard-name">{i.name}</span>
            </div>
            <ul class="ig__mcard-grid">
              {
                MATRIX_KEYS.map((k) => {
                  const state = stateOf(levelOf(i, k))
                  return (
                    <li class="ig__mcard-cell">
                      <span class="ig__status ig__status--sm" data-state={state} aria-hidden="true">
                        {state === 'yes' && <Icon name="check" size="sm" />}
                      </span>
                      <span class="ig__mcard-cell-label" aria-hidden="true">{MATRIX_SHORT[k]}</span>
                      <span class="sr-only">
                        {CAPABILITY_LABELS[k]}: {STATE_LABEL[state]}
                      </span>
                    </li>
                  )
                })
              }
            </ul>
          </li>
        ))
      }
    </ul>
  </div>

  <p class="ig__foot">
    Burada listelenmeyen bir entegrasyon şu an mevcut değildir.
    {detailHref && <a href={detailHref}>Tüm entegrasyon ayrıntıları</a>}
  </p>
</Section>

<style>
  .ig__grid {
    display: grid;
    gap: var(--ek-space-5);
    margin-top: var(--ek-space-10);
    grid-template-columns: 1fr;
  }
  .ig__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-4);
    padding: var(--ek-space-6);
    border: var(--site-border-width) solid transparent;
    border-radius: var(--site-radius-panel);
    background:
      linear-gradient(var(--ek-color-surface), var(--ek-color-surface)) padding-box,
      linear-gradient(var(--ek-color-border-default), var(--ek-color-border-default)) border-box;
    box-shadow: var(--site-shadow-card);
    /* `transform` (eğim) buraya da eklenir (bkz. PricingSummary.astro aynı not): kısayol birleşmediği için
       aksi hâlde `[data-tilt]`'in geçişi tamamen geçersiz kalır. */
    transition:
      box-shadow var(--ek-duration-base) var(--ek-easing-standard),
      background var(--ek-duration-base) var(--ek-easing-standard),
      translate var(--ek-duration-base) var(--ek-easing-standard),
      transform var(--tilt-transition-duration, var(--ek-duration-fast)) var(--ek-easing-standard);
  }
  .ig__card:hover {
    translate: 0 calc(var(--ek-space-1) * -1);
    background:
      linear-gradient(var(--ek-color-surface), var(--ek-color-surface)) padding-box,
      var(--site-gradient-border) border-box;
    box-shadow: var(--site-shadow-card-hover);
  }
  .ig__head {
    display: flex;
    align-items: center;
    gap: var(--ek-space-3);
  }
  .ig__mono {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-12);
    height: var(--ek-space-12);
    border-radius: var(--ek-radius-lg);
    background: linear-gradient(140deg, var(--chan, var(--ek-color-primary)), var(--chan-fill, var(--ek-color-primary-darken-1)));
    box-shadow: var(--ek-shadow-md);
    color: var(--site-color-on-primary);
    font-size: var(--ek-font-size-3xl);
    font-weight: var(--site-font-display-weight);
  }
  /* Aynı 4 seviyeli hiyerarşi token seti (site-tokens.css `--site-card-*`): başlık -> değer cümlesi. */
  .ig__name {
    font-size: var(--site-card-title-size);
    font-weight: var(--site-card-title-weight);
  }
  .ig__kind {
    color: var(--ek-color-content-muted);
    font-size: var(--ek-font-size-md);
  }
  .ig__summary {
    color: var(--ek-color-content-strong);
    font-size: var(--site-card-value-size);
    font-weight: var(--site-card-value-weight);
  }
  .ig__coverage {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-semibold);
  }
  .ig__meter {
    display: inline-flex;
    gap: var(--ek-space-1);
  }
  .ig__meter span {
    width: var(--ek-space-3);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-border-strong);
  }
  .ig__meter[data-level='1'] span:nth-child(-n + 1),
  .ig__meter[data-level='2'] span:nth-child(-n + 2),
  .ig__meter[data-level='3'] span:nth-child(-n + 3) {
    background: var(--ek-color-secondary-darken-1);
  }
  .ig__limits {
    margin-top: auto;
    padding: var(--ek-space-3) var(--ek-space-4);
    border-radius: var(--ek-radius-lg);
    background: var(--ek-color-warning-subtle);
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-md);
  }
  .ig__limits-title {
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
    margin-bottom: var(--ek-space-2);
    font-weight: var(--ek-font-weight-semibold);
  }
  .ig__limits ul {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
    padding-inline-start: var(--ek-space-5);
    list-style: disc;
  }

  .ig__matrix-block {
    margin-top: var(--ek-space-12);
  }
  .ig__matrix-title {
    font-weight: var(--ek-font-weight-semibold);
    margin-bottom: var(--ek-space-2);
    font-size: var(--ek-font-size-2xl);
  }
  .ig__matrix-lead {
    max-width: var(--site-measure);
    margin-bottom: var(--ek-space-4);
    color: var(--ek-color-content-default);
    font-size: var(--ek-font-size-md);
  }
  .ig__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-2) var(--ek-space-6);
    max-width: none;
    margin-bottom: var(--ek-space-6);
    color: var(--ek-color-content-default);
    font-size: var(--ek-font-size-md);
  }
  .ig__legend-item {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
  }
  .ig__mono--sm {
    width: var(--ek-space-8);
    height: var(--ek-space-8);
    border-radius: var(--ek-radius-md);
    font-size: var(--ek-font-size-lg);
  }

  /*
   * Durum ikonu (S10 2. tur): dolu rozet + check = destekleniyor; yarım (conic-gradient) = bu sürümde kısmi;
   * boş halka = sunulmuyor. Lejantta ve hem masaüstü matriste hem mobil kompakt kartlarda AYNI görsel dil.
   */
  .ig__status {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-6);
    height: var(--ek-space-6);
    border-radius: var(--ek-radius-full);
    border: var(--site-border-width) solid var(--ek-color-border-strong);
    color: var(--site-color-on-primary);
  }
  .ig__status[data-state='yes'] {
    border-color: transparent;
    background: var(--ek-color-secondary-darken-1);
  }
  .ig__status[data-state='limited'] {
    border-color: var(--ek-color-warning);
    background: conic-gradient(from 180deg, var(--ek-color-warning) 0deg 180deg, transparent 180deg 360deg);
  }
  .ig__status[data-state='none'] {
    background: transparent;
  }
  .ig__status--sm {
    width: var(--ek-space-5);
    height: var(--ek-space-5);
  }

  /*
   * Masaüstü/tablet matrisi (S10 2. tur): gerçek <table> — sütun=işlem (ikon+kısa ad, yapışkan başlık),
   * satır=entegrasyon (monogram+ad, yapışkan ilk sütun). Satır/sütun üzerine gelince ikisi birden vurgulanır
   * ("crosshair" — `:has()` ile, JS yok). Satırlar görünür oldukça genel [data-reveal] girişiyle sırayla belirir.
   */
  .ig__matrix-scroll {
    display: none;
  }
  .ig__matrix {
    width: 100%;
    min-width: 46rem;
    border-collapse: separate;
    border-spacing: 0;
    font-size: var(--ek-font-size-sm);
  }
  .ig__matrix th,
  .ig__matrix td {
    padding: var(--ek-space-2) var(--ek-space-3);
    border-bottom: var(--site-border-width) solid var(--ek-color-border-default);
    text-align: center;
    transition: background-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  /* Yapışkan başlığın (site header + matris thead) üstüne binmemesi için satırlara kaydırma payı. */
  .ig__matrix-row {
    scroll-margin-top: calc(var(--site-header-height) + var(--ek-space-16));
  }
  .ig__matrix thead th {
    position: sticky;
    inset-block-start: var(--site-header-height);
    z-index: 3;
    padding-block: var(--ek-space-3);
    background: var(--ek-color-surface-muted);
    color: var(--ek-color-content-strong);
    font-weight: var(--ek-font-weight-semibold);
    vertical-align: bottom;
  }
  .ig__matrix-corner {
    z-index: 4;
    text-align: start;
  }
  .ig__col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--ek-space-1);
    color: var(--ek-color-content-muted);
  }
  .ig__col :global(.icon) {
    color: var(--ek-color-primary-darken-1);
  }
  .ig__matrix th[scope='row'] {
    position: sticky;
    inset-inline-start: 0;
    z-index: 2;
    background: var(--ek-color-surface);
    color: var(--ek-color-content-strong);
    font-weight: var(--ek-font-weight-semibold);
    text-align: start;
    white-space: nowrap;
  }
  .ig__matrix-rowhead {
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
  }
  .ig__matrix tbody tr:last-child th,
  .ig__matrix tbody tr:last-child td {
    border-bottom: 0;
  }
  .ig__matrix td {
    position: relative;
  }
  .ig__matrix td .ig__status {
    margin-inline: auto;
  }
  /* Satır vurgusu (hover/focus-within: klavye ile hücreye erişim de aynı vurguyu tetikler). */
  .ig__matrix tbody tr:hover th,
  .ig__matrix tbody tr:hover td,
  .ig__matrix tbody tr:focus-within th,
  .ig__matrix tbody tr:focus-within td {
    background-color: var(--ek-color-surface-muted);
  }
  /* Sütun vurgusu ("crosshair"): bir hücre üzerine gelince aynı sütundaki başlık + tüm hücreler de vurgulanır. */
  .ig__matrix:has(td:nth-child(2):hover) :is(thead th:nth-child(2), tbody td:nth-child(2)),
  .ig__matrix:has(td:nth-child(3):hover) :is(thead th:nth-child(3), tbody td:nth-child(3)),
  .ig__matrix:has(td:nth-child(4):hover) :is(thead th:nth-child(4), tbody td:nth-child(4)),
  .ig__matrix:has(td:nth-child(5):hover) :is(thead th:nth-child(5), tbody td:nth-child(5)),
  .ig__matrix:has(td:nth-child(6):hover) :is(thead th:nth-child(6), tbody td:nth-child(6)),
  .ig__matrix:has(td:nth-child(7):hover) :is(thead th:nth-child(7), tbody td:nth-child(7)),
  .ig__matrix:has(td:nth-child(8):hover) :is(thead th:nth-child(8), tbody td:nth-child(8)),
  .ig__matrix:has(td:nth-child(9):hover) :is(thead th:nth-child(9), tbody td:nth-child(9)) {
    background-color: color-mix(in srgb, var(--ek-color-secondary) 12%, var(--ek-color-surface-muted));
  }

  /*
   * Mobil kompakt kart (S10 2. tur): kanal başına bir kart, 8 durumu küçük bir ızgarada gösterir — yatay
   * kaydırma/sarılan uzun etiket YOK. >=768px'te gizlenir (matris devralır).
   */
  .ig__mcards {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
  }
  .ig__mcard {
    padding: var(--ek-space-4);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-xl);
    background: var(--ek-color-surface);
  }
  .ig__mcard-head {
    display: flex;
    align-items: center;
    gap: var(--ek-space-3);
    margin-bottom: var(--ek-space-3);
  }
  .ig__mcard-name {
    color: var(--ek-color-content-strong);
    font-weight: var(--ek-font-weight-semibold);
  }
  .ig__mcard-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--ek-space-3);
  }
  .ig__mcard-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--ek-space-1);
    text-align: center;
  }
  .ig__mcard-cell-label {
    color: var(--ek-color-content-muted);
    font-size: var(--ek-font-size-xs);
    line-height: var(--ek-line-height-tight);
  }

  .ig__foot {
    margin-top: var(--ek-space-8);
    color: var(--ek-color-content-default);
    font-size: var(--ek-font-size-lg);
  }

  @media (min-width: 768px) {
    .ig__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .ig__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Kapsam bölümü: mobilde (<768px, proje kırılım noktası) kompakt kartlar (`.ig__matrix-scroll` yukarıda
     `display:none` ile varsayılan gizli), tablet/masaüstünde (>=768px) hizalı matris (`.ig__mcards` gizlenir). */
  @media (min-width: 48rem) {
    .ig__matrix-scroll {
      display: block;
      position: relative;
      overflow-x: auto;
      border: var(--site-border-width) solid var(--ek-color-border-default);
      border-radius: var(--ek-radius-xl);
      background: var(--ek-color-surface);
    }
    .ig__mcards {
      display: none;
    }
  }
</style>
