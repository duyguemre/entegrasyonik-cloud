---
/**
 * Entegrasyon ekosistemi (ADR-0014 Karar 2, bölüm 3) — S12: durum raporu değil, entegrasyon VİZYONU.
 * Merkezde platform çekirdeği; çevresinde dört ekosistem düğümü (`getEcosystemNodes()`): pazaryerleri,
 * e-ticaret altyapıları, ERP/muhasebe, kargo ve fatura akışı. Kanal adı YOK; kanal ayrımı isimsiz renkli nokta
 * (`data-code` -> `--chan`). Her düğüm kayıttaki gerçek bir entegrasyona/yeteneğe dayanır (dayanağı yoksa
 * seçici düğümü döndürmez). Kanal bazında kapsam ve farklar /entegrasyonlar sayfasındadır (S12: kapsam
 * matrisi ana sayfadan oraya taşındı).
 * Sahne `ecosystem` (bu dosyadaki stil): düğümler sırayla belirir; görünürken merkez halkası yavaşça genişleyip
 * söner ve veri paketleri çizgiler boyunca akar (yalnızca translate/opacity; reduced-motion / "Hareket"
 * kapalı / JS'siz durumda statik şema). Alt vizyon şeridi genel `reveal` girişini kullanır.
 */
import Section from '../Section.astro'
import SectionHeading from './SectionHeading.astro'
import Icon from './Icon.astro'
import Logo from '../Logo.astro'
import { getEcosystemNodes, ecosystemPromises } from '../../data/integrations'
import { pageHref } from './links'

const nodes = getEcosystemNodes()
const detailHref = pageHref('/entegrasyonlar')
/** Masaüstü şemadaki konumlar (sol üst, sağ üst, sol alt, sağ alt); sol düğümler merkeze akar, sağdakiler merkezden. */
const SLOTS = ['tl', 'tr', 'bl', 'br'] as const
---

<Section tone="muted" id="entegrasyonlar" labelledby="entegrasyon-baslik">
  <SectionHeading
    id="entegrasyon-baslik"
    eyebrow="Entegrasyon ekosistemi"
    title="Satış ekosisteminizin tamamı, tek platformda"
    accent="tek platformda"
    lead="Entegrasyonik; pazaryerlerini, e-ticaret altyapınızı, ERP ve muhasebe sisteminizi, kargo ve fatura akışlarınızı tek merkezde buluşturmak için tasarlandı. Çok kanallı satışın verisi tek yerden yönetilir."
  />

  <div class="eco" data-scene="ecosystem" data-testid="ecosystem">
    <svg class="eco__lines" viewBox="0 0 160 70" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="eco-wire" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" class="eco__stop-a"></stop>
          <stop offset="1" class="eco__stop-b"></stop>
        </linearGradient>
      </defs>
      <path d="M48 17.5 L80 35 L112 17.5 M48 52.5 L80 35 L112 52.5"></path>
    </svg>
    <span class="eco__packet eco__packet--tl" aria-hidden="true"></span>
    <span class="eco__packet eco__packet--tl eco__packet--late" aria-hidden="true"></span>
    <span class="eco__packet eco__packet--bl" aria-hidden="true"></span>
    <span class="eco__packet eco__packet--bl eco__packet--late" aria-hidden="true"></span>
    <span class="eco__packet eco__packet--tr" aria-hidden="true"></span>
    <span class="eco__packet eco__packet--tr eco__packet--late" aria-hidden="true"></span>
    <span class="eco__packet eco__packet--br" aria-hidden="true"></span>
    <span class="eco__packet eco__packet--br eco__packet--late" aria-hidden="true"></span>

    <div class="eco__hub" aria-hidden="true">
      <span class="eco__ring"></span>
      <span class="eco__ring eco__ring--late"></span>
      <span class="eco__core">
        <Logo tone="inverse" />
        <span class="eco__core-label">Tek merkez</span>
      </span>
    </div>

    <ul class="eco__nodes">
      {
        nodes.map((n, i) => (
          <li class={`eco__node eco__node--${SLOTS[i] ?? 'tl'}`} data-part="eco-node" data-reveal>
            <span class="eco__icon">
              <Icon name={n.icon} size="md" />
            </span>
            <div class="eco__copy">
              <h3 class="eco__title">{n.title}</h3>
              <p class="eco__line">{n.line}</p>
            </div>
            <span class="eco__dots" aria-hidden="true">
              {n.channelCodes.map((code) => (
                <i data-code={code} />
              ))}
            </span>
          </li>
        ))
      }
    </ul>
  </div>

  <ul class="promises" data-scene="reveal" data-testid="ecosystem-promises">
    {
      ecosystemPromises.map((p) => (
        <li class="promise" data-reveal>
          <Icon name="check" size="sm" />
          <div>
            <h3 class="promise__title">{p.title}</h3>
            <p class="promise__line">{p.line}</p>
          </div>
        </li>
      ))
    }
  </ul>

  {
    detailHref && (
      <p class="eco__foot">
        <a class="eco__link" href={`${detailHref}#kapsam`} data-testid="ecosystem-link">
          Entegrasyonları ve kanal bazında kapsamı inceleyin
          <Icon name="arrow" size="sm" />
        </a>
      </p>
    )
  }
</Section>

<style>
  /*
   * Şema: mobilde (<1024px) merkez + düğüm kartları dikey yığın; çizgi ve paketler gizli.
   * Masaüstünde sabit en-boy oranlı sahne (`aspect-ratio` + `container-type: size`): düğümler yüzde konumlu,
   * çizgiler aynı oranlı viewBox'ta, paketler `cqw/cqh` ile çizgi boyunca kayar → geometri her genişlikte tutarlı.
   */
  .eco {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-4);
    margin-top: var(--ek-space-10);
  }
  .eco__lines,
  .eco__packet {
    display: none;
  }

  /* --- Merkez --- */
  .eco__hub {
    position: relative;
    display: grid;
    place-items: center;
    align-self: center;
    width: calc(var(--ek-space-16) * 2.5);
    margin-block: var(--ek-space-6) var(--ek-space-8);
    aspect-ratio: 1;
  }
  .eco__core {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--ek-space-2);
    width: 100%;
    height: 100%;
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-full);
    background: var(--site-stage-mesh);
    box-shadow:
      0 0 0 var(--ek-space-2) color-mix(in srgb, var(--ek-color-secondary) 12%, transparent),
      var(--site-shadow-panel);
  }
  .eco__core :global(.logo__word) {
    font-size: var(--ek-font-size-md);
  }
  .eco__core-label {
    color: var(--site-color-on-primary-muted);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  /* Statik yörünge: merkezin çevresinde ince kesik çizgili halka (hareketten bağımsız). */
  .eco__hub::before {
    content: '';
    position: absolute;
    inset: -14%;
    border: var(--site-border-width) dashed color-mix(in srgb, var(--ek-color-secondary) 40%, var(--ek-color-border-default));
    border-radius: var(--ek-radius-full);
  }
  .eco__ring {
    position: absolute;
    inset: 0;
    border: var(--site-border-width) solid color-mix(in srgb, var(--ek-color-secondary) 55%, transparent);
    border-radius: var(--ek-radius-full);
    opacity: 0;
  }

  /* --- Düğümler --- */
  .eco__nodes {
    display: grid;
    gap: var(--ek-space-3);
    grid-template-columns: minmax(0, 1fr);
  }
  .eco__node {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--ek-space-2) var(--ek-space-4);
    padding: var(--ek-space-5);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-xl);
    background: var(--ek-color-surface);
    box-shadow: var(--site-shadow-card);
    transition:
      border-color var(--ek-duration-base) var(--ek-easing-standard),
      box-shadow var(--ek-duration-base) var(--ek-easing-standard);
  }
  .eco__node:hover {
    border-color: color-mix(in srgb, var(--ek-color-secondary) 55%, var(--ek-color-border-default));
    box-shadow: var(--site-shadow-card-hover);
  }
  .eco__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-10);
    height: var(--ek-space-10);
    border-radius: var(--ek-radius-lg);
    background: linear-gradient(140deg, var(--ek-color-primary-darken-1), var(--ek-color-primary));
    color: var(--site-color-on-primary);
    box-shadow: 0 0.5rem 1rem -0.5rem color-mix(in srgb, var(--ek-color-primary) 60%, transparent);
  }
  .eco__copy {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-1);
  }
  .eco__title {
    color: var(--ek-color-content-strong);
    font-size: var(--site-card-title-size);
    font-weight: var(--site-card-title-weight);
    line-height: var(--ek-line-height-tight);
    letter-spacing: -0.01em;
  }
  .eco__line {
    color: var(--ek-color-content-default);
    font-size: var(--site-card-desc-size);
    font-weight: var(--site-card-desc-weight);
    line-height: var(--ek-line-height-normal);
  }
  .eco__dots {
    grid-column: 2;
    display: inline-flex;
    gap: var(--ek-space-2);
    padding-top: var(--ek-space-1);
  }
  .eco__dots i {
    width: calc(var(--ek-space-2) * 0.75);
    height: calc(var(--ek-space-2) * 0.75);
    border-radius: var(--ek-radius-full);
    background: var(--chan, var(--ek-color-secondary));
    opacity: 0.85;
  }

  /* --- Vizyon şeridi --- */
  .promises {
    display: grid;
    gap: var(--ek-space-5);
    margin-top: var(--ek-space-12);
    padding-top: var(--ek-space-8);
    border-top: var(--site-border-width) solid var(--ek-color-border-default);
    grid-template-columns: minmax(0, 1fr);
  }
  .promise {
    display: flex;
    align-items: flex-start;
    gap: var(--ek-space-3);
  }
  .promise > :global(.icon) {
    flex: none;
    margin-top: var(--ek-space-1);
    padding: calc(var(--ek-space-1) * 0.5);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-secondary-darken-1);
    color: var(--site-color-on-primary);
  }
  .promise__title {
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-lg);
    font-weight: var(--ek-font-weight-semibold);
  }
  .promise__line {
    color: var(--ek-color-content-default);
    font-size: var(--site-card-desc-size);
  }
  .eco__foot {
    margin-top: var(--ek-space-8);
  }
  .eco__link {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    min-height: var(--site-tap-target);
    color: var(--site-color-link);
    font-size: var(--ek-font-size-lg);
    font-weight: var(--ek-font-weight-semibold);
    text-decoration: none;
  }
  .eco__link :global(.icon) {
    transition: translate var(--ek-duration-base) var(--ek-easing-standard);
  }
  .eco__link:hover {
    text-decoration: underline;
  }
  .eco__link:hover :global(.icon) {
    translate: var(--ek-space-1) 0;
  }

  @media (min-width: 640px) {
    .eco__nodes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .promises {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* --- Masaüstü şema --- */
  @media (min-width: 1024px) {
    .eco {
      display: block;
      aspect-ratio: 16 / 7;
      container-type: size;
      margin-top: var(--ek-space-12);
      border: var(--site-border-width) solid var(--ek-color-border-default);
      border-radius: var(--site-radius-panel);
      background-color: var(--ek-color-surface);
      background-image: var(--site-texture-dots);
      background-size: var(--site-texture-dots-size);
      box-shadow: var(--site-shadow-card);
    }
    .eco__lines {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      fill: none;
      stroke: url(#eco-wire);
      stroke-width: 2;
      stroke-linecap: round;
    }
    .eco__lines path {
      vector-effect: non-scaling-stroke;
    }
    .eco__stop-a {
      stop-color: color-mix(in srgb, var(--ek-color-secondary) 45%, var(--ek-color-border-default));
    }
    .eco__stop-b {
      stop-color: var(--ek-color-secondary);
    }
    .eco__hub {
      position: absolute;
      inset-inline-start: 50%;
      inset-block-start: 50%;
      z-index: 3;
      width: 19cqw;
      margin: 0;
      translate: -50% -50%;
    }
    .eco__nodes {
      position: static;
      display: block;
    }
    .eco__node {
      position: absolute;
      width: 30cqw;
      translate: 0 -50%;
    }
    .eco__node--tl,
    .eco__node--bl {
      inset-inline-start: 3cqw;
    }
    .eco__node--tr,
    .eco__node--br {
      inset-inline-end: 3cqw;
    }
    .eco__node--tl,
    .eco__node--tr {
      inset-block-start: 25%;
    }
    .eco__node--bl,
    .eco__node--br {
      inset-block-start: 75%;
    }
    /* Veri paketi: çizginin kart ucundan (x=30cqw) merkeze (x=50cqw) — sağda tersine, merkezden karta. */
    .eco__packet {
      display: block;
      position: absolute;
      z-index: 2;
      width: var(--ek-space-2);
      height: var(--ek-space-2);
      margin: calc(var(--ek-space-1) * -1) 0 0 calc(var(--ek-space-1) * -1);
      border-radius: var(--ek-radius-full);
      background: var(--ek-color-secondary);
      box-shadow: 0 0 0 var(--ek-space-1) color-mix(in srgb, var(--ek-color-secondary) 25%, transparent);
      opacity: 0;
    }
    .eco__packet--tl {
      inset-inline-start: 30%;
      inset-block-start: 25%;
      --to: 20cqw 25cqh;
    }
    .eco__packet--bl {
      inset-inline-start: 30%;
      inset-block-start: 75%;
      --to: 20cqw -25cqh;
    }
    .eco__packet--tr {
      inset-inline-start: 50%;
      inset-block-start: 50%;
      --to: 20cqw -25cqh;
    }
    .eco__packet--br {
      inset-inline-start: 50%;
      inset-block-start: 50%;
      --to: 20cqw 25cqh;
    }
    .promises {
      margin-top: var(--ek-space-10);
      padding-top: 0;
      border-top: 0;
    }
  }

  /*
   * Hareket (yalnızca opacity/translate/scale; `prefers-reduced-motion: no-preference` + `html[data-motion='play']`):
   *  - giriş: düğümler genel [data-reveal] kuralıyla sırayla yükselir (scenes.css) — çekirdek yakınlaşarak belirir
   *  - döngü: görünürken halka yavaşça genişleyip söner; paketler çizgi boyunca akar. Görünmezken duraklatılır.
   */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes eco-core-in {
      from {
        opacity: 0;
        scale: var(--site-motion-scale-from);
      }
    }
    @keyframes eco-ring {
      0% {
        opacity: 0.7;
        scale: 1;
      }
      70%,
      100% {
        opacity: 0;
        scale: 1.45;
      }
    }
    @keyframes eco-travel {
      0% {
        opacity: 0;
        translate: 0 0;
      }
      6% {
        opacity: 1;
      }
      34% {
        opacity: 1;
      }
      40%,
      100% {
        opacity: 0;
        translate: var(--to);
      }
    }
    :global(html[data-motion='play']) .eco[data-state='ready'] .eco__core {
      opacity: 0;
    }
    :global(html[data-motion='play']) .eco[data-state='play'] .eco__core {
      animation: eco-core-in var(--site-motion-duration-reveal-lg) var(--site-motion-ease-reveal) backwards;
    }
    :global(html[data-motion='play']) .eco[data-state='play'] .eco__ring {
      animation: eco-ring var(--site-motion-ambient-fast) var(--site-motion-ease-loop) infinite paused;
    }
    :global(html[data-motion='play']) .eco[data-state='play'] .eco__ring--late {
      animation-delay: calc(var(--site-motion-ambient-fast) / 2);
    }
    :global(html[data-motion='play']) .eco[data-state='play'] .eco__packet {
      animation: eco-travel var(--site-motion-ambient-fast) var(--site-motion-ease-loop) infinite paused;
    }
    :global(html[data-motion='play']) .eco[data-state='play'] .eco__packet--bl {
      animation-delay: calc(var(--site-motion-ambient-fast) * 0.25);
    }
    :global(html[data-motion='play']) .eco[data-state='play'] .eco__packet--tr {
      animation-delay: calc(var(--site-motion-ambient-fast) * 0.4);
    }
    :global(html[data-motion='play']) .eco[data-state='play'] .eco__packet--br {
      animation-delay: calc(var(--site-motion-ambient-fast) * 0.65);
    }
    :global(html[data-motion='play']) .eco[data-state='play'] .eco__packet--late {
      animation-delay: calc(var(--site-motion-ambient-fast) * 0.5);
    }
    :global(html[data-motion='play']) .eco[data-state='play'] .eco__packet--bl.eco__packet--late {
      animation-delay: calc(var(--site-motion-ambient-fast) * 0.75);
    }
    :global(html[data-motion='play']) .eco[data-state='play'] .eco__packet--tr.eco__packet--late {
      animation-delay: calc(var(--site-motion-ambient-fast) * 0.9);
    }
    :global(html[data-motion='play']) .eco[data-state='play'] .eco__packet--br.eco__packet--late {
      animation-delay: calc(var(--site-motion-ambient-fast) * 0.15);
    }
    :global(html[data-motion='play']) .eco[data-state='play'][data-visible='true'] :is(.eco__ring, .eco__packet) {
      animation-play-state: running;
    }
  }
</style>
