---
/**
 * Sorun → çözüm (ADR-0014 Karar 2, bölüm 2; S8 premium sahne; S12 tek kurgu). Kullanıcı geri bildirimi: kötü durum
 * ile Entegrasyonik'in iyi durumu net ayrışmalı, iyi durum çok daha ön planda olmalı; alttaki karşılaştırma tablosu
 * tekrar ediyordu → KALDIRILDI, güçlü içeriği (tek stok, rezervasyon, tek sipariş akışı, güvenlik/izolasyon) ana
 * kurgunun fayda listesine yedirildi.
 *
 * Kurgu (tek sahne, `data-scene="problem-solution"` + `data-scroll-progress`):
 *  - Sol, DAR ve SOLUK: "Bugün" — her kanal kendi panelinde, çelişen stok sayıları (gri, eğik, dağınık).
 *  - Orta: köprü oku.
 *  - Sağ, GENİŞ ve PARLAK (koyu marka yüzeyi): "Entegrasyonik ile" — kanallar tek merkeze akar, tek stok değeri,
 *    kanıtlı fayda listesi.
 * Kaydırma ilerlemesi (`--scroll-p`, src/scripts/interactions.ts): sahne görünüm alanına girerken kaos solar ve geri
 * çekilir, marka kartı yükselip tam parlaklığa gelir, akış hatları merkeze doğru uzar (yalnızca transform/opacity).
 * Hareket kapalı / JS'siz: `--scroll-p` yazılmaz → varsayılan 1 = anlamlı statik SON durum (iki taraf da görünür,
 * iyi taraf baskın). Giriş ve döngü: scenes.css / scenes-loops.css.
 * S26 (SR3 madde 12 — sıfır aşırı satış hikâyesi; S15-B'nin sabit "6 — kullanılabilir stok" kartının yerine): her kanal
 * sitenin kanal rozeti (ChannelMono) + stok değeridir. 30 sn'lik sakin döngü = dört perde (farklı ürün, farklı kanal):
 * bir kanaldan sipariş gelir -> ışık paketi merkeze iner -> merkezde stok bir adet düşer ("Rezerve edildi") -> geri
 * dalga ile diğer TÜM kanallar aynı anda yeni değere geçer -> "Tüm kanallarda eşzamanlı · aşırı satış yok".
 * Statik hâl (hareket kapalı / reduced / JS'siz) = 1. perdenin SON karesi: sipariş etiketi, merkezde düşmüş stok ve
 * "Rezerve edildi", tüm kanallarda aynı yeni değer, sonuç etiketi. Yalnızca opacity/translate/scale.
 * Paketler marka kartının içinde kalır (kart `overflow: hidden`): sayfa taşması yok.
 * Stok sayıları senaryoyu anlatan sabit görseldir, gerçek veri değildir (S15-C: ayrı "örnek" etiketi yok; sahne
 * aria-hidden, anlam başlık ve fayda metinlerinde). Fayda metinleri yetenek kayıtlarına dayanır (capabilities.ts).
 */
import Section from '../Section.astro'
import SectionHeading from './SectionHeading.astro'
import Icon from './Icon.astro'
import ChannelMono from '../pages/ChannelMono.astro'
import { getPublicIntegrations } from '../../data/integrations'
import { homeAgentGain as agentGain } from '../../data/assistant'
import { getPublicCapabilities } from '../../data/capabilities'

// Örnek senaryo: her kanalın kendi panelinde farklı (çelişen) stok sayısı görmesi — sabit görsel örnek.
const EXAMPLE_STOCK = [14, 9, 21, 6]
const channels = getPublicIntegrations()
  .slice(0, EXAMPLE_STOCK.length)
  .map((c, i) => ({ code: c.code, name: c.name, stock: EXAMPLE_STOCK[i] }))

// S26 (SR3 madde 12) — sıfır aşırı satış hikâyesi: her perde bir üründür; bir kanaldan (`origin`) sipariş gelir,
// merkezde stok bir adet düşer ("Rezerve edildi"), ardından TÜM kanallar aynı anda yeni değeri gösterir. Perdeler
// sırayla farklı kanal ve ürünle döner (scenes-loops.css; perde sayısı = PS_ACTS). Statik hâl = 1. perdenin son karesi.
// Sayılar ve ürün adları senaryoyu anlatan görsel örnektir (sahne aria-hidden; anlam başlık ve fayda metinlerinde).
const acts = [
  { product: 'Keten gömlek', stock: 6, origin: 0 },
  { product: 'Deri cüzdan', stock: 3, origin: 2 },
  { product: 'Seramik kupa', stock: 12, origin: 1 },
  { product: 'Spor çanta', stock: 9, origin: 3 },
].map((a) => ({ ...a, origin: a.origin % channels.length }))

const pains = [
  'Stok her panelde ayrı ayrı, elle güncellenir',
  'Aynı ürün birden çok kanalda satılır; aşırı satış riski büyür',
  'Sipariş, iade ve sorular farklı panellere dağılır',
]

const capIds = new Set(getPublicCapabilities().map((c) => c.id))
// Her fayda en az bir yayımlanmış yetenek kaydına dayanır; kayıt yoksa gösterilmez (uydurma iddia yok).
const gains = [
  {
    icon: 'layers' as const,
    title: 'Merkezi stok yönetimi',
    text: 'Ürün, fiyat ve stok değişiklikleri bağlı kanallara tek yerden iletilir.',
    requires: ['multi-channel-products'],
  },
  {
    icon: 'stock' as const,
    title: 'Aşırı satışa karşı rezervasyon',
    text: 'Eşzamanlı siparişlerde stok rezerve edilir; stok eksiye düşmez.',
    requires: ['stock-reservation'],
  },
  {
    icon: 'orders' as const,
    title: 'Tek sipariş akışı',
    text: 'Farklı kanallardan gelen siparişler tek listede, iade ve sorular tek yerde.',
    requires: ['unified-orders', 'returns', 'questions'],
  },
  // S27a (SR4 madde 5): güvenlik maddesi Güvenlik bölümüne taşındı (tekrar yok); yerine Otopilot (Zaman sütunu).
  {
    icon: 'sparkle' as const,
    title: agentGain.title,
    text: agentGain.text,
    requires: ['unified-orders', 'stock-reservation'],
  },
].filter((g) => g.requires.every((id) => capIds.has(id)))
---

<Section labelledby="sorun-cozum-baslik" class="ps-section">
  <SectionHeading
    id="sorun-cozum-baslik"
    eyebrow="Sorun ve çözüm"
    title="Her kanal ayrı panel, ayrı stok, ayrı mesai"
    lead="Her pazaryeri kendi panelinde, kendi stok sayısıyla çalıştığında ekibiniz aynı işi defalarca yapar; son adet iki kanalda birden satılır, iptal puanınızı düşürür."
  />

  <div class="ps" data-scene="problem-solution" data-scroll-progress data-testid="problem-solution">
    <article class="ps__before" aria-labelledby="ps-before-title">
      <p class="ps__tag">Bugün</p>
      <h3 id="ps-before-title" class="ps__before-title">Her kanal ayrı panel, ayrı stok</h3>
      <ul class="ps__chaos" aria-hidden="true">
        {
          channels.map((c) => (
            <li class="ps__mpanel" data-part="messy-panel" data-code={c.code}>
              <div class="ps__mpanel-inner" data-part="float">
                <p class="ps__mpanel-head">
                  <span class="ps__mdot" />
                  <span class="ps__mskel" />
                </p>
                <p class="ps__mpanel-stat">
                  <span>Stok</span>
                  <b>{c.stock}</b>
                </p>
                <p class="ps__mflag" data-part="flag">
                  <Icon name="info" size="sm" />
                  Uyumsuz
                </p>
              </div>
            </li>
          ))
        }
      </ul>
      <ul class="ps__pains">
        {
          pains.map((p) => (
            <li>
              <span class="ps__x" aria-hidden="true"><Icon name="x" size="sm" /></span>
              <span>{p}</span>
            </li>
          ))
        }
      </ul>
    </article>

    <div class="ps__bridge" aria-hidden="true">
      <span class="ps__bridge-line"></span>
      <span class="ps__bridge-knob"><Icon name="arrow" size="sm" /></span>
    </div>

    <article class="ps__after" aria-labelledby="ps-after-title" data-surface="dark">
      <div class="ps__after-glow" aria-hidden="true"></div>
      <div class="ps__after-head">
        <p class="ps__tag ps__tag--brand">Entegrasyonik ile</p>
        <h3 id="ps-after-title" class="ps__after-title">Sipariş bir kanalda, <span class="ps__accent">stok her kanalda</span> doğru</h3>
      </div>

      <div class="ps__after-body">
        <div class="ps__net" aria-hidden="true" data-testid="ps-net">
          <p class="ps__product">
            <span class="ps__product-icon"><Icon name="stock" size="sm" /></span>
            <span class="ps__product-names">
              {
                acts.map((a, k) => (
                  <span class="ps__product-name" data-part="act" data-act={k}>
                    {a.product}
                  </span>
                ))
              }
            </span>
          </p>
          <ul class="ps__nodes">
            {
              channels.map((c, i) => (
                <li class="ps__node" data-code={c.code}>
                  <span class="ps__order-slot">
                    {acts.map((a, k) =>
                      a.origin === i ? (
                        <span class="ps__order" data-part="order" data-act={k}>
                          <Icon name="orders" size="sm" />
                          Yeni sipariş
                        </span>
                      ) : null,
                    )}
                  </span>
                  <span class="ps__chip" data-part="chip">
                    <ChannelMono code={c.code} name={c.name} size="xs" />
                    <span class="ps__chip-num">
                      {acts.map((a, k) => (
                        <>
                          <b class="ps__chip-old" data-part={a.origin === i ? 'chip-old-origin' : 'chip-old'} data-act={k}>
                            {a.stock}
                          </b>
                          <b class="ps__chip-new" data-part={a.origin === i ? 'chip-new-origin' : 'chip-new'} data-act={k}>
                            {a.stock - 1}
                          </b>
                        </>
                      ))}
                    </span>
                  </span>
                  <span class="ps__flow" data-part="flow">
                    {acts.map((a, k) =>
                      a.origin === i ? (
                        <i class="ps__packet" data-part="packet" data-act={k} />
                      ) : (
                        <i class="ps__packet ps__packet--back" data-part="packet-back" data-act={k} />
                      ),
                    )}
                  </span>
                </li>
              ))
            }
          </ul>
          <span class="ps__bus" data-part="bus"></span>
          <span class="ps__stem" data-part="bus">
            <i class="ps__packet ps__packet--stem" data-part="stem-packet" />
          </span>
          <div class="ps__hub" data-part="hub">
            <span class="ps__hub-ring" data-part="hub-ring"></span>
            <span class="ps__hub-ring ps__hub-ring--late" data-part="hub-ring"></span>
            <span class="ps__hub-icon"><Icon name="layers" size="sm" /></span>
            <span class="ps__hub-copy">
              <span class="ps__hub-label">Merkezi stok</span>
              <span class="ps__hub-num">
                {acts.map((a, k) => (
                  <>
                    <b class="ps__chip-old" data-part="hub-old" data-act={k}>{a.stock}</b>
                    <b class="ps__chip-new" data-part="hub-new" data-act={k}>{a.stock - 1}</b>
                  </>
                ))}
              </span>
            </span>
            <span class="ps__resv" data-part="resv"><Icon name="check" size="sm" />Rezerve edildi</span>
          </div>
          <p class="ps__result" data-part="result">
            <span class="ps__result-icon" data-part="result-text"><Icon name="shield" size="sm" /></span>
            <span class="ps__result-label" data-part="result-text"><span class="ps__result-part">Tüm kanallarda eşzamanlı</span><span class="ps__result-sep"> · </span><span class="ps__result-part">aşırı satış yok</span></span>
          </p>
        </div>

        <ul class="ps__gains">
          {
            gains.map((g) => (
              <li class="ps__gain" data-part="gain">
                <span class="ps__gain-icon" aria-hidden="true"><Icon name={g.icon} size="sm" /></span>
                <span class="ps__gain-copy">
                  <strong>{g.title}</strong>
                  <span>{g.text}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </article>
  </div>
</Section>

<style>
  /*
   * Kaydırma ilerlemesi: `--p` 0 (sahne yeni giriyor) -> 1 (yerine oturdu). JS yoksa / hareket kapalıysa 1.
   * Tüm türetilmiş değerler YALNIZCA transform/opacity'ye uygulanır; yerleşim değişmez (CLS 0).
   */
  .ps {
    --p: var(--scroll-p, 1);
    --q: calc(1 - var(--p));
    display: grid;
    gap: var(--ek-space-6);
    margin-top: var(--ek-space-12);
    align-items: stretch;
  }

  .ps__tag {
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ps__tag--brand {
    color: var(--site-accent);
  }

  /* ---------------------------------------------------------------- Bugün: soluk, gri, dar */
  .ps__before {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-4);
    padding: var(--ek-space-6) var(--ek-space-5);
    border: var(--site-border-width) dashed var(--ek-color-border-strong);
    border-radius: var(--site-radius-panel);
    background: var(--ek-color-surface-muted);
    transform-origin: 100% 50%;
    transform: translateX(calc(var(--p) * var(--ek-space-2) * -1)) scale(calc(1 - var(--p) * 0.03));
    opacity: calc(1 - var(--p) * 0.22);
  }
  .ps__before-title {
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-xl);
    font-weight: var(--ek-font-weight-semibold);
    line-height: var(--ek-line-height-tight);
  }
  .ps__chaos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--ek-space-4) var(--ek-space-3);
    padding: var(--ek-space-3) var(--ek-space-1);
  }
  .ps__mpanel {
    --r: 0deg;
    --dy: 0rem;
    transform: translateY(calc(var(--dy) * (1 + var(--q)))) rotate(calc(var(--r) * (1 + var(--q))));
  }
  .ps__mpanel:nth-child(1) {
    --r: -3deg;
  }
  .ps__mpanel:nth-child(2) {
    --r: 2deg;
    --dy: 0.5rem;
  }
  .ps__mpanel:nth-child(3) {
    --r: 2.5deg;
    --dy: -0.25rem;
  }
  .ps__mpanel:nth-child(4) {
    --r: -2deg;
    --dy: 0.375rem;
  }
  .ps__mpanel-inner {
    padding: var(--ek-space-3);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-lg);
    background: var(--ek-color-surface);
    box-shadow: var(--ek-shadow-sm);
  }
  .ps__mpanel-head {
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
  }
  /* Kanal rengi burada BİLİNÇLİ olarak soldurulur: kaos tarafı "gri" okunmalı. */
  .ps__mdot {
    flex: none;
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: color-mix(in srgb, var(--chan, var(--ek-color-border-strong)) 45%, var(--ek-color-border-strong));
  }
  .ps__mskel {
    flex: 1;
    height: var(--ek-space-1);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface-sunken);
  }
  .ps__mpanel-stat {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-top: var(--ek-space-2);
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-xs);
  }
  .ps__mpanel-stat b {
    color: var(--ek-color-content-subtle);
    font-size: var(--ek-font-size-2xl);
    font-weight: var(--site-font-display-weight);
    line-height: 1;
  }
  .ps__mflag {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-1);
    margin-top: var(--ek-space-1);
    color: color-mix(in srgb, var(--ek-color-error) 70%, var(--ek-color-content-muted));
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
  }
  .ps__pains {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-md);
  }
  .ps__pains li {
    display: flex;
    align-items: flex-start;
    gap: var(--ek-space-2);
  }
  .ps__x {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-5);
    height: var(--ek-space-5);
    margin-top: calc(var(--ek-space-1) * 0.25);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface-sunken);
    color: var(--ek-color-content-subtle);
  }

  /* ---------------------------------------------------------------- Köprü */
  .ps__bridge {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--ek-space-10);
  }
  .ps__bridge-line {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 50%;
    width: calc(var(--site-border-width) * 2);
    translate: -50% 0;
    background: linear-gradient(180deg, var(--ek-color-border-strong), var(--site-accent));
    transform-origin: 50% 0;
    transform: scaleY(var(--p));
  }
  .ps__bridge-knob {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-10);
    height: var(--ek-space-10);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-background);
    box-shadow: var(--site-shadow-card), 0 0 0 var(--site-border-width) var(--ek-color-border-default);
    color: var(--site-accent);
    rotate: 90deg;
    transform: translateY(calc(var(--q) * var(--ek-space-3) * -1)) scale(calc(0.85 + var(--p) * 0.15));
    opacity: calc(0.35 + var(--p) * 0.65);
  }

  /* ---------------------------------------------------------------- Entegrasyonik ile: parlak, marka, geniş */
  .ps__after {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-6);
    padding: var(--ek-space-6) var(--ek-space-5);
    border-radius: calc(var(--site-radius-panel) + var(--ek-space-1));
    background: var(--site-stage-mesh);
    box-shadow:
      0 2rem 4rem -1.5rem color-mix(in srgb, var(--ek-color-primary) 55%, transparent),
      0 0 0 var(--site-border-width) color-mix(in srgb, var(--ek-color-secondary) 35%, transparent);
    color: var(--site-text-on-dark-body);
    transform-origin: 0 50%;
    transform: translateY(calc(var(--q) * var(--ek-space-8))) scale(calc(0.96 + var(--p) * 0.04));
    opacity: calc(0.72 + var(--p) * 0.28);
  }
  .ps__after::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--site-texture-grid);
    background-size: var(--site-texture-grid-size);
    -webkit-mask-image: var(--site-texture-fade);
    mask-image: var(--site-texture-fade);
    pointer-events: none;
  }
  .ps__after-glow {
    position: absolute;
    z-index: -1;
    inset-block-start: -40%;
    inset-inline-end: -20%;
    width: 70%;
    aspect-ratio: 1;
    border-radius: var(--ek-radius-full);
    background: radial-gradient(closest-side, color-mix(in srgb, var(--ek-color-secondary) 34%, transparent), transparent);
    opacity: calc(0.3 + var(--p) * 0.7);
    pointer-events: none;
  }
  .ps__after-head {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-2);
  }
  .ps__after-title {
    color: var(--site-text-on-dark-heading);
    font-size: var(--site-font-display-sm);
    font-weight: var(--site-font-display-weight);
    letter-spacing: var(--site-font-display-tracking);
    line-height: var(--site-font-display-line-height);
    text-wrap: balance;
  }
  /* S27c (BRAND §4 vurgu ekonomisi): degrade vurgu yalnız hero, kapanış ve Otopilot vitrininde; burada kırılmaz kelime grubu. */
  .ps__accent {
    white-space: nowrap;
  }
  .ps__after-body {
    display: grid;
    gap: var(--ek-space-6);
    align-items: center;
  }

  /*
   * Ağ (S26 hikâyesi): ürün -> kanal rozetleri (sipariş etiketi + stok) -> akış hatları -> ortak hat -> merkezi stok
   * (rezerve vurgusu) -> "eşzamanlı" sonucu. Perde öğeleri (`[data-act]`) üst üste aynı hücrede durur; statik hâlde
   * YALNIZCA 1. perde (`data-act="0"`) ve onun SON karesi görünür: tüm kanallar ve merkez aynı yeni değerde.
   */
  .ps__net {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--ek-space-5) var(--ek-space-3);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-xl);
    background: var(--site-glass-bg);
  }
  .ps__net [data-act]:not([data-act='0']) {
    opacity: 0;
  }
  .ps__product {
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
    margin-bottom: var(--ek-space-4);
    padding: var(--ek-space-1) var(--ek-space-3) var(--ek-space-1) var(--ek-space-1);
    border: var(--site-border-width) solid var(--site-glass-border);
    border-radius: var(--ek-radius-full);
    background: color-mix(in srgb, var(--site-stage-deep) 70%, transparent);
    color: var(--site-text-on-dark-heading);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
  }
  .ps__product-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-6);
    height: var(--ek-space-6);
    border-radius: var(--ek-radius-full);
    background: color-mix(in srgb, var(--ek-color-secondary) 22%, transparent);
    color: var(--site-accent);
  }
  .ps__product-names {
    display: grid;
  }
  .ps__product-name {
