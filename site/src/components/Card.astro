---
/** Card — Stripe/Linear stili: gölge yerine ince kenarlık (ADR-0011 elevation notu). */
interface Props {
  as?: string
  class?: string
  [attr: string]: unknown
}

const { as: Tag = 'div', class: className, ...rest } = Astro.props
---

<Tag class:list={['card', className]} {...rest}>
  <slot />
</Tag>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
    padding: var(--ek-space-6);
    background: var(--ek-color-surface);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-xl);
  }
  .card :global(h3) {
    font-size: var(--ek-font-size-xl);
  }
  .card :global(p) {
    color: var(--ek-color-content-muted);
    font-size: var(--ek-font-size-lg);
  }
</style>
