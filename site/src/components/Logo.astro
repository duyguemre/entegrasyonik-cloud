---
/**
 * Logo — METİNSEL LOGOTİP + basit geometrik işaret YER TUTUCUSU.
 * Nihai logo/renk uyumu insan kararıdır (ADR-0014 Açık Soru 3); mevcut `logo*.png/svg` varlıkları
 * kullanılmaz. İşaret dekoratiftir (aria-hidden); erişilebilir ad metin logotiptir.
 */
interface Props {
  tone?: 'default' | 'inverse'
}
const { tone = 'default' } = Astro.props
---

<span class:list={['logo', `logo--${tone}`]}>
  <svg class="logo__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect class="logo__tile" x="0" y="0" width="32" height="32" rx="8"></rect>
    <circle class="logo__hub" cx="16" cy="16" r="5"></circle>
    <circle class="logo__node" cx="16" cy="6.5" r="2.5"></circle>
    <circle class="logo__node" cx="24.2" cy="20.8" r="2.5"></circle>
    <circle class="logo__node" cx="7.8" cy="20.8" r="2.5"></circle>
  </svg>
  <span class="logo__word">Entegrasyonik</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    color: var(--ek-color-primary);
  }
  .logo--inverse {
    color: var(--site-color-on-primary);
  }
  .logo__mark {
    width: var(--ek-space-8);
    height: var(--ek-space-8);
    flex: none;
  }
  .logo__tile {
    fill: var(--ek-color-primary);
  }
  .logo--inverse .logo__tile {
    fill: var(--ek-color-background);
  }
  .logo__hub {
    fill: var(--ek-color-secondary);
  }
  .logo__node {
    fill: var(--ek-color-background);
  }
  .logo--inverse .logo__node {
    fill: var(--ek-color-primary);
  }
  .logo__word {
    font-size: var(--ek-font-size-xl);
    font-weight: var(--site-font-display-weight);
    letter-spacing: var(--site-font-display-tracking);
    line-height: 1;
  }
</style>
