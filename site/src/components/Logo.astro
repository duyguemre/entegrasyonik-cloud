---
/**
 * Logo (S15) — özgün Entegrasyonik işareti + metin logotip.
 * Fikir: "E" monogramı çok kanalın tek merkezde buluşmasıdır — üst ve alt kollar iki kanal düğümünde (beyaz nokta)
 * biter, gövdeden çıkan orta kol teal MERKEZ düğümünde birleşir. Tek renk ailesi (lacivert + teal), küçük boyutta
 * (16 px favicon) okunur; açık zeminde lacivert karo, koyu zeminde (`tone="inverse"`) beyaz karo.
 * Geometri uygulama işaretiyle BİREBİR aynıdır (frontend/src/design/brand/logo-mark.svg, EkBrandLogo.vue,
 * frontend/public/favicon.svg — drift testi: frontend/tests/theme/logo-drift.test.ts) ve favicon (src/pages/favicon.svg.ts).
 * İşaret dekoratiftir (aria-hidden); erişilebilir ad metin logotiptir.
 */
interface Props {
  tone?: 'default' | 'inverse'
}
const { tone = 'default' } = Astro.props
---

<span class:list={['logo', `logo--${tone}`]}>
  <svg class="logo__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect class="logo__tile" x="0" y="0" width="32" height="32" rx="9"></rect>
    <circle class="logo__halo" cx="18.5" cy="16" r="5"></circle>
    <path class="logo__stroke" d="M20 9.5H13C10.8 9.5 9.5 10.8 9.5 13V19C9.5 21.2 10.8 22.5 13 22.5H20M9.5 16H15.5"></path>
    <circle class="logo__hub" cx="18.5" cy="16" r="3"></circle>
    <circle class="logo__node" cx="22" cy="9.5" r="2.25"></circle>
    <circle class="logo__node" cx="22" cy="22.5" r="2.25"></circle>
  </svg>
  <span class="logo__word" translate="no">Entegrasyonik</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    color: var(--ek-color-primary);
  }
  .logo--inverse {
    color: var(--site-color-on-primary);
  }
  .logo__mark {
    width: var(--ek-space-8);
    height: var(--ek-space-8);
    flex: none;
  }
  .logo__tile {
    fill: var(--ek-color-primary);
  }
  .logo--inverse .logo__tile {
    fill: var(--ek-color-background);
  }
  .logo__stroke {
    fill: none;
    stroke: var(--ek-color-background);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .logo--inverse .logo__stroke {
    stroke: var(--ek-color-primary);
  }
  .logo__halo {
    fill: var(--ek-color-secondary);
    opacity: 0.22;
  }
  .logo__hub {
    fill: var(--ek-color-secondary);
  }
  .logo__node {
    fill: var(--ek-color-background);
  }
  .logo--inverse .logo__node {
    fill: var(--ek-color-primary);
  }
  .logo__word {
    font-size: var(--ek-font-size-xl);
    font-weight: var(--site-font-display-weight);
    letter-spacing: var(--site-font-display-tracking);
    line-height: 1;
  }
</style>
