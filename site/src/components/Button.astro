---
/**
 * Button — bağlantı (`href` varsa <a>) veya düğme (<button>). Etkileşim geri bildirimi uygulamayla
 * aynı motion token'larını kullanır (--ek-duration-*, --ek-easing-*); hover'da yalnızca renk değişir.
 * `inverse*` varyantları koyu ("stage") zeminler içindir.
 */
interface Props {
  href?: string
  variant?: 'primary' | 'secondary' | 'ghost' | 'inverse' | 'inverse-outline'
  size?: 'md' | 'lg'
  type?: 'button' | 'submit' | 'reset'
  class?: string
  [attr: string]: unknown
}

const { href, variant = 'primary', size = 'md', type = 'button', class: className, ...rest } = Astro.props
const Tag = href ? 'a' : 'button'
const tagProps = href ? { href } : { type }
---

<Tag class:list={['btn', `btn--${variant}`, `btn--${size}`, className]} {...tagProps} {...rest}>
  <slot />
</Tag>

<style>
  .btn {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--ek-space-2);
    min-height: var(--site-tap-target);
    padding: var(--ek-space-2) var(--ek-space-5);
    overflow: hidden;
    border: var(--site-border-width) solid transparent;
    border-radius: var(--ek-radius-lg);
    background: transparent;
    font-family: inherit;
    font-size: var(--ek-font-size-lg);
    font-weight: var(--ek-font-weight-semibold);
    line-height: var(--ek-line-height-tight);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--ek-duration-base) var(--ek-easing-standard),
      border-color var(--ek-duration-base) var(--ek-easing-standard),
      color var(--ek-duration-base) var(--ek-easing-standard);
  }
  /* Vurgulu CTA'larda hover ışıması: tek geçişlik, köşegen bir parlaklık (yalnızca transform + opacity). */
  .btn--primary::after,
  .btn--inverse::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    translate: -60% 0;
    pointer-events: none;
    transition:
      translate var(--ek-duration-slow) var(--ek-easing-standard),
      opacity var(--ek-duration-slow) var(--ek-easing-standard);
  }
  /* Koyu zeminli birincil düğme: açık (beyaza yakın) ışıma. */
  .btn--primary::after {
    background: linear-gradient(
      100deg,
      transparent 30%,
      color-mix(in srgb, var(--ek-color-background) 45%, transparent) 50%,
      transparent 70%
    );
  }
  /* Açık zeminli ("inverse") düğme koyu sahnelerde kullanılır; ışıma marka rengiyle görünür kalır. */
  .btn--inverse::after {
    background: linear-gradient(
      100deg,
      transparent 30%,
      color-mix(in srgb, var(--ek-color-secondary) 40%, transparent) 50%,
      transparent 70%
    );
  }
  .btn--primary:hover::after,
  .btn--inverse:hover::after {
    opacity: 1;
    translate: 60% 0;
  }

  .btn--lg {
    min-height: calc(var(--site-tap-target) + var(--ek-space-2));
    padding: var(--ek-space-3) var(--ek-space-6);
    font-size: var(--ek-font-size-xl);
  }

  .btn--primary,
  .btn--inverse {
    position: relative;
    overflow: hidden;
  }
  /* Hover'da çok hafif ışık sweep'i (yalnızca translate; reduced-motion global.css'te otomatik kapanır). */
  .btn--primary::after,
  .btn--inverse::after {
    content: '';
    position: absolute;
    inset: 0;
    translate: -120% 0;
    transition: translate var(--ek-duration-slow) var(--ek-easing-standard);
    pointer-events: none;
  }
  .btn--primary::after {
    background: linear-gradient(120deg, transparent 30%, color-mix(in srgb, var(--ek-color-background) 30%, transparent) 50%, transparent 70%);
  }
  .btn--inverse::after {
    background: linear-gradient(120deg, transparent 30%, color-mix(in srgb, var(--ek-color-primary) 12%, transparent) 50%, transparent 70%);
  }
  .btn--primary:hover::after,
  .btn--inverse:hover::after {
    translate: 120% 0;
  }

  .btn--primary {
    background: var(--ek-color-primary);
    color: var(--site-color-on-primary);
  }
  .btn--primary:hover {
    background: var(--ek-color-primary-darken-1);
  }

  .btn--secondary {
    background: var(--ek-color-background);
    border-color: var(--ek-color-border-strong);
    color: var(--ek-color-primary);
  }
  .btn--secondary:hover {
    background: var(--ek-color-surface-muted);
    border-color: var(--ek-color-primary);
  }

  .btn--ghost {
    color: var(--ek-color-content-default);
  }
  .btn--ghost:hover {
    background: var(--ek-color-surface-sunken);
    color: var(--ek-color-content-strong);
  }

  .btn--inverse {
    background: var(--ek-color-background);
    color: var(--ek-color-primary);
  }
  .btn--inverse:hover {
    background: var(--ek-color-surface-sunken);
  }

  .btn--inverse-outline {
    border-color: var(--site-color-on-primary-muted);
    color: var(--site-color-on-primary);
  }
  .btn--inverse-outline:hover {
    background: color-mix(in srgb, var(--ek-color-background) 12%, transparent);
    border-color: var(--site-color-on-primary);
  }

  /* Koyu zeminde odak halkası açık renk olmalı (kontrast). */
  .btn--inverse:focus-visible,
  .btn--inverse-outline:focus-visible {
    outline-color: var(--site-color-on-primary);
  }
</style>
