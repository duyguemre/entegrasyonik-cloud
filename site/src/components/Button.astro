---
/**
 * Button — bağlantı (`href` varsa <a>) veya düğme (<button>). Etkileşim geri bildirimi uygulamayla
 * aynı motion token'larını kullanır (--ek-duration-*, --ek-easing-*); hover'da yalnızca renk değişir.
 * `inverse*` varyantları koyu ("stage") zeminler içindir.
 */
interface Props {
  href?: string
  variant?: 'primary' | 'secondary' | 'ghost' | 'inverse' | 'inverse-outline'
  size?: 'md' | 'lg'
  type?: 'button' | 'submit' | 'reset'
  class?: string
  [attr: string]: unknown
}

const { href, variant = 'primary', size = 'md', type = 'button', class: className, ...rest } = Astro.props
const Tag = href ? 'a' : 'button'
const tagProps = href ? { href } : { type }
---

<Tag class:list={['btn', `btn--${variant}`, `btn--${size}`, className]} {...tagProps} {...rest}>
  <slot />
</Tag>

<style>
  .btn {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--ek-space-2);
    min-height: var(--site-tap-target);
    padding: var(--ek-space-2) var(--ek-space-5);
    overflow: hidden;
    border: var(--site-border-width) solid transparent;
    /* SITE-DL-01: düz düğme — gölge/ışıma/parlama yok; hover'da yalnız renk tonu değişir. */
    border-radius: var(--ek-radius-tile);
    background: transparent;
    font-family: inherit;
    font-size: var(--ek-font-size-lg);
    font-weight: var(--ek-font-weight-semibold);
    line-height: var(--ek-line-height-tight);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--ek-duration-base) var(--ek-easing-standard),
      border-color var(--ek-duration-base) var(--ek-easing-standard),
      color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .btn--lg {
    min-height: calc(var(--site-tap-target) + var(--ek-space-2));
    padding: var(--ek-space-3) var(--ek-space-6);
    font-size: var(--ek-font-size-xl);
  }

  /* Birincil eylem = lacivert tonu (`--site-action`; kullanıcı kararı 2026-10-02: düğme/anahtar/ikonda tam lacivert
     fazla koyu → bir ton açığı). */
  .btn--primary {
    background: var(--site-action);
    border-color: var(--site-action);
    color: var(--site-action-contrast);
  }
  .btn--primary:hover {
    background: var(--site-action-hover);
    border-color: var(--site-action-hover);
  }

  .btn--secondary {
    background: var(--ek-color-surface);
    border-color: var(--ek-color-border-strong);
    color: var(--site-text-heading);
  }
  .btn--secondary:hover {
    background: var(--site-action-subtle);
    border-color: var(--site-action-border);
    color: var(--site-action-emphasis);
  }

  .btn--ghost {
    color: var(--ek-color-content-default);
  }
  .btn--ghost:hover {
    background: var(--site-action-subtle);
    color: var(--site-action-emphasis);
  }

  .btn--inverse {
    background: var(--ek-color-background);
    color: var(--ek-color-primary);
  }
  .btn--inverse:hover {
    background: var(--site-action-subtle);
  }

  .btn--inverse-outline {
    border-color: var(--site-color-on-primary-muted);
    color: var(--site-color-on-primary);
  }
  .btn--inverse-outline:hover {
    background: color-mix(in srgb, var(--ek-color-background) 12%, transparent);
    border-color: var(--site-color-on-primary);
  }

  /* Koyu zeminde odak halkası açık renk olmalı (kontrast). */
  .btn--inverse:focus-visible,
  .btn--inverse-outline:focus-visible {
    outline-color: var(--site-color-on-primary);
  }
</style>
