---
/**
 * Header — logotip, birincil gezinme, "Giriş yap" ve "Ücretsiz dene" (uygulamaya bağlantı; ADR-0014 Karar 2).
 * Masaüstü (>=1024): satır içi gezinme. Altında: yerel <details> ile açılan mobil menü — JS kapalıyken de
 * çalışır; `src/scripts/menu.ts` yalnızca Esc / dışarı tıklama / yeniden boyutlandırmada kapanmayı ekler.
 * Menüde henüz yayımlanmış sayfa yoksa (S0) yalnızca uygulama bağlantıları görünür.
 * S17: aktif sayfa göstergesi — tam eşleşmede `aria-current="page"`, alt sayfada (ör. /entegrasyonlar/trendyol)
 * `aria-current="true"`; masaüstünde vurgu alt çizgisi, mobil menüde sol vurgu çubuğu + zemin. Mobil menü satırları
 * ayırıcılı ve ok işaretli; açıkken sayfa hafifçe karartılır (dekoratif; dışarı tıklama betikle kapatır).
 */
import Icon from './home/Icon.astro'
import Container from './Container.astro'
import Button from './Button.astro'
import Logo from './Logo.astro'
import MotionToggle from './MotionToggle.astro'
import { primaryNav, published } from '../data/navigation'
import { appUrls } from '../lib/site-config'

interface Props {
  /** Sayfada animasyon sahnesi varsa "Animasyonları durdur" kontrolünü (ve sahne betiğini) ekler (S3). */
  motionControl?: boolean
}
const { motionControl = false } = Astro.props

const links = published(primaryNav)
const norm = (p: string) => (p.length > 1 ? p.replace(/\/+$/, '') : p)
const here = norm(Astro.url.pathname)
const currentOf = (href: string): 'page' | 'true' | undefined =>
  here === norm(href) ? 'page' : here.startsWith(`${norm(href)}/`) ? 'true' : undefined
const loginHref = appUrls.login()
const registerHref = appUrls.register()
---

<header class="site-header">
  <Container class="bar">
    <a class="brand" href="/" aria-label="Entegrasyonik — ana sayfa">
      <Logo />
    </a>

    <nav class="nav-desktop" aria-label="Ana gezinme">
      {
        links.length > 0 && (
          <ul class="nav-desktop__links">
            {links.map((item) => (
              <li>
                <a class="nav-link" href={item.href} aria-current={currentOf(item.href)}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <div class="nav-desktop__actions">
        <Button href={loginHref} variant="ghost" data-testid="login-link">Giriş yap</Button>
        <Button href={registerHref} variant="primary" data-testid="register-link">Ücretsiz dene</Button>
      </div>
    </nav>

    {motionControl && <MotionToggle />}

    <details class="nav-mobile" data-mobile-menu>
      <summary class="nav-mobile__toggle" data-testid="menu-toggle">
        <span class="sr-only">Menü</span>
        <svg class="icon-menu" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </summary>
      <nav class="nav-mobile__panel" aria-label="Ana gezinme">
        {
          links.length > 0 && (
            <ul class="nav-mobile__links">
              {links.map((item) => (
                <li>
                  <a class="nav-link nav-link--block" href={item.href} aria-current={currentOf(item.href)}>
                    <span>{item.label}</span>
                    <Icon name="chevron" size="sm" />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        <div class="nav-mobile__actions">
          <Button href={loginHref} variant="secondary" size="lg" data-testid="login-link-mobile">Giriş yap</Button>
          <Button href={registerHref} variant="primary" size="lg" data-testid="register-link-mobile">Ücretsiz dene</Button>
        </div>
      </nav>
    </details>
  </Container>
</header>

<script>
  import '../scripts/menu'
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--ek-color-background) 88%, transparent);
    -webkit-backdrop-filter: saturate(1.4) blur(var(--site-glass-blur));
    backdrop-filter: saturate(1.4) blur(var(--site-glass-blur));
    border-bottom: var(--site-border-width) solid var(--ek-color-border-default);
    transition:
      box-shadow var(--ek-duration-base) var(--ek-easing-standard),
      border-color var(--ek-duration-base) var(--ek-easing-standard),
      background-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  /* Kaydırınca (src/scripts/menu.ts sentinel): daha opak zemin + yumuşak gölge */
  :global(html[data-scrolled='true']) .site-header {
    background: color-mix(in srgb, var(--ek-color-background) 94%, transparent);
    border-bottom-color: color-mix(in srgb, var(--ek-color-border-strong) 70%, transparent);
    box-shadow: var(--ek-shadow-md);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ek-space-4);
    min-height: var(--site-header-height);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    min-height: var(--site-tap-target);
    text-decoration: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--site-tap-target);
    padding-inline: var(--ek-space-3);
    border-radius: var(--ek-radius-md);
    color: var(--ek-color-content-default);
    font-size: var(--ek-font-size-lg);
    font-weight: var(--ek-font-weight-medium);
    text-decoration: none;
    transition: color var(--ek-duration-base) var(--ek-easing-standard),
      background-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .nav-link:hover {
    color: var(--ek-color-content-strong);
    background: var(--ek-color-surface-sunken);
  }
  .nav-link[aria-current] {
    color: var(--ek-color-content-strong);
  }
  .nav-link--block {
    position: relative;
    display: flex;
    justify-content: space-between;
    min-height: calc(var(--site-tap-target) + var(--ek-space-1));
    padding-inline: var(--ek-space-3);
    font-size: var(--ek-font-size-lg);
  }
  .nav-link--block :global(.icon) {
    color: var(--ek-color-content-muted);
    transform: rotate(-90deg);
  }
  .nav-link--block[aria-current] {
    background: color-mix(in srgb, var(--ek-color-secondary) 10%, var(--ek-color-background));
    font-weight: var(--ek-font-weight-semibold);
  }
  .nav-link--block[aria-current]::before {
    content: '';
    position: absolute;
    inset-block: var(--ek-space-2);
    inset-inline-start: 0;
    width: calc(var(--site-border-width) * 3);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-secondary-darken-1);
  }
  .nav-link--block[aria-current] :global(.icon) {
    color: var(--site-link-accent);
  }

  /* --- Mobil / tablet (< 1024): <details> menü --- */
  .nav-desktop {
    display: none;
  }
  .nav-mobile {
    display: block;
  }
  .nav-mobile__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--site-tap-target);
    height: var(--site-tap-target);
    border-radius: var(--ek-radius-md);
    color: var(--ek-color-primary);
    cursor: pointer;
    list-style: none;
    transition: background-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .nav-mobile__toggle::-webkit-details-marker {
    display: none;
  }
  .nav-mobile__toggle:hover {
    background: var(--ek-color-surface-sunken);
  }
  .nav-mobile__toggle svg {
    width: var(--ek-space-6);
    height: var(--ek-space-6);
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .nav-mobile__toggle .icon-close {
    display: none;
  }
  .nav-mobile[open] .icon-menu {
    display: none;
  }
  .nav-mobile[open] .icon-close {
    display: block;
  }

  .nav-mobile__panel {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    max-height: calc(100dvh - var(--site-header-height));
    overflow-y: auto;
    padding: var(--ek-space-4) var(--site-gutter) var(--ek-space-6);
    background: var(--ek-color-background);
    border-bottom: var(--site-border-width) solid var(--ek-color-border-default);
    /* Sayfa karartması: panelin altına doğru yayılan gölge (yalnızca aşağıda; üst çubuk kararmaz). */
    box-shadow:
      var(--ek-shadow-md),
      0 0 0 100vmax color-mix(in srgb, var(--site-stage-deep) 35%, transparent);
    clip-path: inset(0 0 -100vmax 0);
    animation: menu-in var(--ek-duration-base) var(--ek-easing-enter);
  }
  .nav-mobile__links {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--ek-space-5);
  }
  .nav-mobile__links li + li {
    border-top: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .nav-mobile__actions {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-3);
  }
  .nav-mobile__actions :global(.btn) {
    width: 100%;
  }
  @keyframes menu-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* --- Masaüstü (>= 1024): satır içi gezinme --- */
  /* 80rem (1280 px): gezinme + eylemler + hareket kontrolü 1280–1440 arasında taşmadan sığar; altında menü düğmesi. */
  @media (min-width: 80rem) {
    .nav-mobile {
      display: none;
    }
    .nav-desktop {
      display: flex;
      flex: 1;
      align-items: center;
      justify-content: space-between;
      gap: var(--ek-space-4);
      margin-inline-start: var(--ek-space-4);
    }
    .nav-desktop__links {
      display: flex;
      align-items: center;
      gap: var(--ek-space-1);
    }
    /* S14: yedinci bağlantı ("Destek") + hareket kontrolü etiketi 1440'ta da sığsın: bağlantı iç boşluğu bir kademe dar. */
    .nav-desktop__links .nav-link {
      position: relative;
      padding-inline: var(--ek-space-2);
    }
    /* Aktif sayfa: vurgu alt çizgisi (renk tek başına değil — kalınlık ve çizgi de değişir). */
    .nav-desktop__links .nav-link[aria-current] {
      font-weight: var(--ek-font-weight-semibold);
    }
    .nav-desktop__links .nav-link[aria-current]::after {
      content: '';
      position: absolute;
      inset-inline: var(--ek-space-2);
      inset-block-end: calc(var(--ek-space-1) * 0.5);
      height: calc(var(--site-border-width) * 2);
      border-radius: var(--ek-radius-full);
      background: var(--ek-color-secondary-darken-1);
    }
    .nav-desktop__actions {
      display: flex;
      align-items: center;
      gap: var(--ek-space-2);
      margin-inline-start: auto;
    }
  }
  /* S20: sekizinci bağlantı ("Rehber") + hareket kontrolü 1280–1440 arasında sığsın: bağlantı iç boşluğu bir kademe dar. */
  @media (min-width: 80rem) and (max-width: 89.99rem) {
    .nav-desktop__links .nav-link {
      padding-inline: calc(var(--ek-space-2) * 0.75);
    }
  }
</style>
