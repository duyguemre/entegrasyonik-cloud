---
/**
 * Header — logotip, gruplanmış birincil gezinme, "Giriş yap" ve birincil CTA "Ücretsiz dene" (uygulamaya bağlantı;
 * ADR-0014 Karar 2).
 *
 * S23 (SR2-NAV): bağlantı kalabalığı yerine gruplanmış menü — Ürün / Çözümler / Kaynaklar açılır panel (mega-menü),
 * Fiyatlandırma doğrudan bağlantı; CTA'lar ayrı blokta. Model tek kaynaktan: `src/data/nav-menu.ts` (footer da aynı).
 *  - Masaüstü (>= 64rem): grup düğmeleri `aria-expanded` + `aria-controls` (WAI-ARIA disclosure navigation deseni).
 *    Klavye (`src/scripts/menu.ts`): Enter/Space aç-kapa, ↓/↑ paneli açıp ilk/son bağlantıya odak, paneldeki ↓/↑
 *    bağlantılar arası, ←/→ üst düzey öğeler arası, Home/End, Esc kapatır ve odağı düğmeye döndürür. Odak tuzağı
 *    YOK: Tab panelden çıkınca panel kapanır. JS yoksa panel üzerine gelince / odak içindeyken görünür.
 *  - Mobil/tablet (< 64rem): yerel <details> çekmece (JS'siz çalışır); içinde grup başına akordeon (<details
 *    name>): bulunulan sayfanın grubu açık gelir. Çözümler grubunda kanal rozetleri (ChannelMono) yer alır.
 * S24 (kullanıcı madde 8: "kalabalık sürüyor" → daha radikal sadelik): üç grup + "Fiyatlar" ORTADA, sağda yalnızca
 * metin bağlantısı "Giriş" ve tek birincil CTA; ayraç çizgisi kalktı, hareket kontrolü yalnızca simge. Ürün panelinde
 * Otopilot öne çıkan koyu kart olarak gösterilir (`MenuGroup.feature`; çekmece ve footer'da normal bağlantı).
 * Aktif sayfa: bağlantıda tam eşleşme `aria-current="page"`, alt sayfa `aria-current="true"`; içinde aktif bağlantı
 * olan grup düğmesi `data-active` ile alt çizgi alır (renk tek başına değil — çizgi + kalınlık).
 */
import Icon from './home/Icon.astro'
import Container from './Container.astro'
import Button from './Button.astro'
import Logo from './Logo.astro'
import MotionToggle from './MotionToggle.astro'
import ChannelMono from './pages/ChannelMono.astro'
import { menuDirect, menuGroups, type MenuLink } from '../data/nav-menu'
import { appUrls } from '../lib/site-config'

interface Props {
  /** Sayfada animasyon sahnesi varsa "Animasyonları durdur" kontrolünü (ve sahne betiğini) ekler (S3). */
  motionControl?: boolean
}
const { motionControl = false } = Astro.props

const groups = menuGroups().filter((g) => g.links.length > 0)
const direct = menuDirect()
const norm = (p: string) => (p.length > 1 ? p.replace(/\/+$/, '') : p)
const here = norm(Astro.url.pathname)
const currentOf = (href: string): 'page' | 'true' | undefined =>
  here === norm(href) ? 'page' : here.startsWith(`${norm(href)}/`) ? 'true' : undefined
const groupActive = (links: MenuLink[]) => links.some((l) => currentOf(l.href))
const descId = (group: string, i: number) => `nav-desc-${group}-${i}`
/** Masaüstü panelinin ana listesi: öne çıkan kart ayrıca gösterildiği için listeden çıkarılır. */
const mainLinks = (g: (typeof groups)[number]) => (g.feature ? g.links.filter((l) => l.href !== g.feature!.href) : g.links)
const loginHref = appUrls.login()
const registerHref = appUrls.register()
---

<header class="site-header">
  <Container class="bar">
    <a class="brand" href="/" aria-label="Entegrasyonik — ana sayfa">
      <Logo />
    </a>

    <nav class="nav-desktop" aria-label="Ana gezinme" data-nav>
      {
        (groups.length > 0 || direct.length > 0) && (
          <ul class="nav-desktop__links">
            {groups.map((g) => (
              <li class="nav-group" data-nav-group>
                <button
                  type="button"
                  class="nav-trigger"
                  aria-expanded="false"
                  aria-controls={`mega-${g.id}`}
                  data-nav-trigger={g.id}
                  data-nav-top
                  data-active={groupActive(g.links) ? 'true' : undefined}
                >
                  {g.label}
                  <Icon name="chevron" size="sm" />
                </button>
                <div class:list={['mega', `mega--${g.id}`, { 'mega--aside': !!g.aside, 'mega--feature': !!g.feature }]} id={`mega-${g.id}`} data-nav-panel>
                  <div class="mega__main">
                    <p class="mega__lead">{g.lead}</p>
                    <ul class="mega__list" role="list">
                      {mainLinks(g).map((l, i) => (
                        <li class="mega-item">
                          {l.icon && (
                            <span class="mega-item__icon">
                              <Icon name={l.icon} size="sm" />
                            </span>
                          )}
                          <a class="nav-link" href={l.href} aria-current={currentOf(l.href)} aria-describedby={l.description ? descId(g.id, i) : undefined}>{l.label}{l.badge && <span class="nav-badge" data-testid="nav-badge">{l.badge}</span>}</a>
                          {l.description && (
                            <span class="mega-item__desc" id={descId(g.id, i)}>
                              {l.description}
                            </span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                  {g.feature && (
                    <div class="mega-feature">
                      <span class="mega-feature__glow" aria-hidden="true"></span>
                      <span class="mega-feature__icon" aria-hidden="true">
                        <Icon name={g.feature.icon ?? 'sparkle'} size="md" />
                      </span>
                      {g.feature.description && (
                        <span class="mega-feature__desc" id={`nav-feature-${g.id}`}>
                          {g.feature.description}
                        </span>
                      )}
                      <a class="nav-link" href={g.feature.href} aria-current={currentOf(g.feature.href)} aria-describedby={g.feature.description ? `nav-feature-${g.id}` : undefined}>{g.feature.label}{g.feature.badge && <span class="nav-badge" data-testid="nav-badge">{g.feature.badge}</span>}</a>
                      <span class="mega-feature__cta" aria-hidden="true">
                        Keşfedin
                        <Icon name="arrow" size="sm" />
                      </span>
                    </div>
                  )}
                  {g.aside && (
                    <div class="mega__aside">
                      <p class="mega__lead">{g.aside.title}</p>
                      {g.aside.channels && (
                        <ul class="mega-chans" role="list" data-testid="nav-channels">
                          {g.aside.channels.map((c) => (
                            <li>
                              <a class="mega-chan" href={`/entegrasyonlar/${c.code}`} aria-current={currentOf(`/entegrasyonlar/${c.code}`)}>
                                <ChannelMono code={c.code} name={c.name} size="xs" />
                                {c.name}
                              </a>
                            </li>
                          ))}
                        </ul>
                      )}
                      {g.aside.links.length > 0 && (
                        <ul class="mega-aside-list" role="list">
                          {g.aside.links.map((l) => (
                            <li>
                              <a class="mega-aside-link" href={l.href} aria-current={currentOf(l.href)}>
                                {l.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      )}
                      {g.aside.more && (
                        <a class="mega-more" href={g.aside.more.href}>
                          {g.aside.more.label}
                          <Icon name="arrow" size="sm" />
                        </a>
                      )}
                    </div>
                  )}
                </div>
              </li>
            ))}
            {direct.map((l) => (
              <li>
                <a class="nav-link nav-top" href={l.href} aria-current={currentOf(l.href)} data-nav-top>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <div class="nav-desktop__actions">
        <a class="nav-link nav-login" href={loginHref} data-testid="login-link" aria-label="Giriş yap">Giriş</a>
        <Button href={registerHref} variant="primary" data-testid="register-link">Ücretsiz dene</Button>
      </div>
    </nav>

    {motionControl && <MotionToggle />}

    <details class="nav-mobile" data-mobile-menu>
      <summary class="nav-mobile__toggle" data-testid="menu-toggle">
        <span class="sr-only">Menü</span>
        <svg class="icon-menu" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </summary>
      <nav class="nav-mobile__panel" aria-label="Ana gezinme">
        <div class="drawer">
          {
            groups.map((g) => (
              <details class="drawer-group" name="nav-drawer" open={groupActive(g.links) || undefined} data-drawer-group={g.id}>
                <summary class="drawer-group__summary" data-active={groupActive(g.links) ? 'true' : undefined}>
                  <span>{g.label}</span>
                  <Icon name="chevron" size="sm" />
                </summary>
                <ul class="drawer-group__links" role="list">
                  {g.links.map((l) => (
                    <li>
                      <a class="nav-link nav-link--block" href={l.href} aria-current={currentOf(l.href)}>
                        <span>
                          {l.label}
                          {l.badge && <span class="nav-badge">{l.badge}</span>}
                        </span>
                        <Icon name="chevron" size="sm" />
                      </a>
                    </li>
                  ))}
                </ul>
                {g.aside?.channels && (
                  <ul class="drawer-chans" role="list" aria-label={g.aside.title}>
                    {g.aside.channels.map((c) => (
                      <li>
                        <a class="mega-chan" href={`/entegrasyonlar/${c.code}`} aria-current={currentOf(`/entegrasyonlar/${c.code}`)}>
                          <ChannelMono code={c.code} name={c.name} size="xs" />
                          {c.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </details>
            ))
          }
          {
            direct.map((l) => (
              <a class="nav-link nav-link--block drawer-direct" href={l.href} aria-current={currentOf(l.href)}>
                <span>{l.label}</span>
                <Icon name="chevron" size="sm" />
              </a>
            ))
          }
        </div>
        <div class="nav-mobile__actions">
          <Button href={loginHref} variant="secondary" size="lg" data-testid="login-link-mobile">Giriş yap</Button>
          <Button href={registerHref} variant="primary" size="lg" data-testid="register-link-mobile">Ücretsiz dene</Button>
        </div>
      </nav>
    </details>
  </Container>
</header>

<script>
  import '../scripts/menu'
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--ek-color-background) 88%, transparent);
    -webkit-backdrop-filter: saturate(1.4) blur(var(--site-glass-blur));
    backdrop-filter: saturate(1.4) blur(var(--site-glass-blur));
    border-bottom: var(--site-border-width) solid var(--ek-color-border-default);
    transition:
      box-shadow var(--ek-duration-base) var(--ek-easing-standard),
      border-color var(--ek-duration-base) var(--ek-easing-standard),
      background-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  /* Kaydırınca (src/scripts/menu.ts sentinel): daha opak zemin + yumuşak gölge */
  :global(html[data-scrolled='true']) .site-header {
    background: color-mix(in srgb, var(--ek-color-background) 94%, transparent);
    border-bottom-color: color-mix(in srgb, var(--ek-color-border-strong) 70%, transparent);
    box-shadow: var(--ek-shadow-md);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ek-space-4);
    min-height: var(--site-header-height);
  }
  .brand {
    display: inline-flex;
    flex: none;
    align-items: center;
    min-height: var(--site-tap-target);
    text-decoration: none;
  }

  .nav-link,
  .nav-trigger {
    display: inline-flex;
    align-items: center;
    min-height: var(--site-tap-target);
    padding-inline: var(--ek-space-3);
    border: 0;
    border-radius: var(--ek-radius-md);
    background: transparent;
    color: var(--ek-color-content-default);
    font-family: inherit;
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-medium);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color var(--ek-duration-base) var(--ek-easing-standard),
      background-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .nav-link:hover,
  .nav-trigger:hover {
    color: var(--ek-color-content-strong);
    background: var(--ek-color-surface-sunken);
  }
  .nav-link[aria-current] {
    color: var(--ek-color-content-strong);
  }
  /* S18: "Yeni" rozeti — küçük, metinli (renk tek başına anlam taşımaz); bağlantı adının parçasıdır. */
  .nav-badge {
    display: inline-flex;
    align-items: center;
    margin-inline-start: var(--ek-space-2);
    padding: 0 var(--ek-space-1);
    border-radius: var(--ek-radius-sm);
    background: var(--ek-color-primary);
    color: var(--ek-color-background);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-bold);
    letter-spacing: 0.02em;
    line-height: var(--ek-line-height-normal);
  }

  /* ------------------------------------------------------------------ kanal rozeti bağlantısı (panel + çekmece) */
  .mega-chan {
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
    min-height: var(--site-tap-target);
    padding: var(--ek-space-1) var(--ek-space-2);
    border-radius: var(--ek-radius-md);
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-md);
    font-weight: var(--ek-font-weight-medium);
    text-decoration: none;
    transition: background-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .mega-chan:hover {
    background: var(--ek-color-surface-sunken);
  }
  .mega-chan[aria-current] {
    background: color-mix(in srgb, var(--ek-color-secondary) 10%, var(--ek-color-background));
    font-weight: var(--ek-font-weight-semibold);
  }

  /* ------------------------------------------------------------------ mobil / tablet (< 64rem): çekmece */
  .nav-desktop {
    display: none;
  }
  .nav-mobile {
    display: block;
  }
  .nav-mobile__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--site-tap-target);
    height: var(--site-tap-target);
    border-radius: var(--ek-radius-md);
    color: var(--ek-color-primary);
    cursor: pointer;
    list-style: none;
    transition: background-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .nav-mobile__toggle::-webkit-details-marker {
    display: none;
  }
  .nav-mobile__toggle:hover {
    background: var(--ek-color-surface-sunken);
  }
  .nav-mobile__toggle svg {
    width: var(--ek-space-6);
    height: var(--ek-space-6);
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .nav-mobile__toggle .icon-close {
    display: none;
  }
  .nav-mobile[open] .icon-menu {
    display: none;
  }
  .nav-mobile[open] .icon-close {
    display: block;
  }

  .nav-mobile__panel {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    max-height: calc(100dvh - var(--site-header-height));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--ek-space-3) var(--site-gutter) var(--ek-space-6);
    background: var(--ek-color-background);
    border-bottom: var(--site-border-width) solid var(--ek-color-border-default);
    /* Sayfa karartması: panelin altına doğru yayılan gölge (yalnızca aşağıda; üst çubuk kararmaz). */
    box-shadow:
      var(--ek-shadow-md),
      0 0 0 100vmax color-mix(in srgb, var(--site-stage-deep) 35%, transparent);
    clip-path: inset(0 0 -100vmax 0);
    animation: menu-in var(--ek-duration-base) var(--ek-easing-enter);
  }
  .drawer {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--ek-space-5);
  }
  .drawer > * + * {
    border-top: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .drawer-group__summary {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: calc(var(--site-tap-target) + var(--ek-space-2));
    padding-inline: var(--ek-space-3);
    border-radius: var(--ek-radius-md);
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-lg);
    font-weight: var(--ek-font-weight-semibold);
    list-style: none;
    cursor: pointer;
  }
  .drawer-group__summary::-webkit-details-marker {
    display: none;
  }
  .drawer-group__summary:hover {
    background: var(--ek-color-surface-sunken);
  }
  .drawer-group__summary :global(.icon) {
    color: var(--ek-color-content-muted);
    transition: transform var(--ek-duration-base) var(--ek-easing-standard);
  }
  .drawer-group[open] > .drawer-group__summary :global(.icon) {
    transform: rotate(180deg);
  }
  .drawer-group__summary[data-active]::before {
    content: '';
    position: absolute;
    inset-block: var(--ek-space-3);
    inset-inline-start: 0;
    width: calc(var(--site-border-width) * 3);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-secondary-darken-1);
  }
  .drawer-group__links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
    gap: 0 var(--ek-space-2);
    padding: 0 0 var(--ek-space-3) var(--ek-space-3);
  }
  .drawer-chans {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.5rem), 1fr));
    gap: var(--ek-space-1) var(--ek-space-2);
    margin: 0 0 var(--ek-space-4) var(--ek-space-3);
    padding-top: var(--ek-space-3);
    border-top: var(--site-border-width) dashed var(--ek-color-border-default);
  }
  .nav-link--block {
    position: relative;
    display: flex;
    justify-content: space-between;
    min-height: var(--site-tap-target);
    padding-inline: var(--ek-space-3);
    font-size: var(--ek-font-size-md);
    white-space: normal;
  }
  .drawer-direct {
    min-height: calc(var(--site-tap-target) + var(--ek-space-2));
    font-size: var(--ek-font-size-lg);
    font-weight: var(--ek-font-weight-semibold);
    color: var(--ek-color-content-strong);
  }
  .nav-link--block :global(.icon) {
    color: var(--ek-color-content-muted);
    transform: rotate(-90deg);
  }
  .nav-link--block[aria-current] {
    background: color-mix(in srgb, var(--ek-color-secondary) 10%, var(--ek-color-background));
    font-weight: var(--ek-font-weight-semibold);
  }
  .nav-link--block[aria-current]::before {
    content: '';
    position: absolute;
    inset-block: var(--ek-space-2);
    inset-inline-start: 0;
    width: calc(var(--site-border-width) * 3);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-secondary-darken-1);
  }
  .nav-link--block[aria-current] :global(.icon) {
    color: var(--site-link-accent);
  }
  .nav-mobile__actions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--ek-space-3);
  }
  .nav-mobile__actions :global(.btn) {
    width: 100%;
  }
  @keyframes menu-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes mega-in {
    from {
      opacity: 0;
      transform: translateY(calc(var(--ek-space-1) * -1));
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ------------------------------------------------------------------ masaüstü (>= 64rem): gruplanmış menü */
  /* S23 → S24: dört üst düzey öğe (3 grup + Fiyatlar) ortada; sağda "Giriş" + tek CTA (+ simge hareket kontrolü). */
  @media (min-width: 64rem) {
    .nav-mobile {
      display: none;
    }
    .nav-desktop {
      display: flex;
      flex: 1;
      align-self: stretch;
      align-items: center;
      justify-content: space-between;
      gap: var(--ek-space-4);
      min-width: 0;
      margin-inline-start: var(--ek-space-2);
    }
    .nav-desktop__links {
      position: relative;
      display: flex;
      align-self: stretch;
      align-items: center;
      gap: var(--ek-space-2);
      margin-inline: auto;
    }
    .nav-group {
      display: flex;
      align-self: stretch;
      align-items: center;
    }
    .nav-trigger {
      position: relative;
      gap: var(--ek-space-1);
    }
    .nav-trigger :global(.icon) {
      color: var(--ek-color-content-muted);
      transition: transform var(--ek-duration-base) var(--ek-easing-standard);
    }
    .nav-trigger[aria-expanded='true'] {
      color: var(--ek-color-content-strong);
      background: var(--ek-color-surface-sunken);
    }
    .nav-trigger[aria-expanded='true'] :global(.icon) {
      transform: rotate(180deg);
    }
    /* Aktif grup / sayfa: vurgu alt çizgisi (renk tek başına değil — kalınlık ve çizgi de değişir). */
    .nav-trigger[data-active],
    .nav-top[aria-current] {
      position: relative;
      color: var(--ek-color-content-strong);
      font-weight: var(--ek-font-weight-semibold);
    }
    .nav-trigger[data-active]::after,
    .nav-top[aria-current]::after {
      content: '';
      position: absolute;
      inset-inline: var(--ek-space-3);
      inset-block-end: calc(var(--ek-space-1) * 0.5);
      height: calc(var(--site-border-width) * 2);
      border-radius: var(--ek-radius-full);
      background: var(--ek-color-secondary-darken-1);
    }
    .nav-desktop__actions {
      display: flex;
      flex: none;
      align-items: center;
      gap: var(--ek-space-3);
    }
    .nav-login {
      font-weight: var(--ek-font-weight-semibold);
      color: var(--ek-color-content-strong);
    }

    /* --- açılır panel --- */
    .mega {
      position: absolute;
      top: calc(100% - var(--ek-space-2));
      inset-inline-start: 0;
      z-index: 1;
      display: none;
