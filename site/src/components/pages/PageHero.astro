---
/**
 * PageHero — iç sayfa üst bölümü: ekmek kırıntısı + TEK <h1> + giriş metni (+ isteğe bağlı eylem/rozet yuvaları).
 * Koyu "stage" zemini (ADR-0014 Karar 4); ana sayfa hero'sundan bağımsızdır, S2a ile çakışmaz.
 * S11: isteğe bağlı `visual` adlı slot — sayfaya özgü küçük bir örnek görünüm/ikon kompozisyonu. Slot boşsa
 * tek sütunlu düzen aynen korunur (görünmez ekstra alan yok).
 */
import Section from '../Section.astro'
import Breadcrumb from './Breadcrumb.astro'
import type { Crumb } from './types'

interface Props {
  title: string
  lead?: string
  crumbs: Crumb[]
  /** Küçük üst etiket (ör. "Entegrasyon"). */
  eyebrow?: string
  /** S17: görsel panel yalnızca >=1024 px'te gösterilir (dar ekranda içerik zaten hemen aşağıdaysa, ör. /sss). */
  visualDesktopOnly?: boolean
}

const { title, lead, crumbs, eyebrow, visualDesktopOnly = false } = Astro.props
const hasVisual = Astro.slots.has('visual')
---

<Section tone="stage" labelledby="page-title" class="page-hero">
  <Breadcrumb items={crumbs} inverse />
  <div class:list={['page-hero__grid', { 'page-hero__grid--split': hasVisual }]}>
    <div class="page-hero__body">
      {eyebrow && <p class="page-hero__eyebrow">{eyebrow}</p>}
      <h1 id="page-title">{title}</h1>
      {lead && <p class="page-hero__lead">{lead}</p>}
      <div class="page-hero__extra"><slot /></div>
    </div>
    {hasVisual && (
      <div class:list={['page-hero__visual', { 'page-hero__visual--desktop': visualDesktopOnly }]} data-tilt>
        <slot name="visual" />
      </div>
    )}
  </div>
</Section>

<style>
  /* Bölüm ritmini iç sayfa için kısaltır (ana sayfa hero'su kadar geniş boşluk gerekmez). */
  .page-hero:global(.section) {
    padding-block: var(--ek-space-8) calc(var(--site-section-y) * 0.6);
  }
  .page-hero__grid {
    display: grid;
    gap: var(--ek-space-10);
    margin-top: var(--ek-space-6);
  }
  .page-hero__body {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-4);
    max-width: calc(var(--site-container-narrow) + var(--ek-space-16));
    min-width: 0;
  }
  /* ELEV (A8/A14): eyebrow = sayfa adı, ana sayfa bölüm etiketleriyle aynı dil (küçük, büyük harf, koyu zeminde teal). */
  /* Seçici, Section'ın `.section--stage p` kuralından güçlü olmalı (aksi hâlde soluk beyaza döner). */
  .page-hero__body .page-hero__eyebrow {
    color: var(--site-accent-on-dark);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  /* ELEV: önceki `.page-hero h1` seçicisi kapsam dışı kalıyordu (sınıf alt bileşen Section'da) → H1 genel 36/700'e
     düşüyordu. H1 artık bir değer cümlesidir; display ölçeği bileşenin kendi öğesine bağlanır. */
  .page-hero__body h1 {
    max-width: 20ch;
    text-wrap: balance;
    font-size: var(--site-font-display-md);
    font-weight: var(--site-font-display-weight);
    line-height: var(--site-font-display-line-height);
    letter-spacing: var(--site-font-display-tracking);
  }
  .page-hero__lead {
    font-size: var(--ek-font-size-xl);
    line-height: var(--ek-line-height-normal);
  }
  .page-hero__extra:empty {
    display: none;
  }
  .page-hero__extra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ek-space-2) var(--ek-space-3);
    margin-top: var(--ek-space-2);
  }

  /* Sayfaya özgü görsel kompozisyon: cam panel, sahne zemininin üstünde hafif yükselir. */
  .page-hero__visual {
    position: relative;
    min-width: 0;
    padding: var(--ek-space-6);
    border-radius: var(--site-radius-panel);
    background: var(--site-glass-bg);
    border: var(--site-border-width) solid var(--site-glass-border);
    backdrop-filter: blur(var(--site-glass-blur));
    -webkit-backdrop-filter: blur(var(--site-glass-blur));
    box-shadow: var(--site-shadow-panel);
    transform: perspective(75rem) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform var(--ek-duration-base) var(--ek-easing-standard);
  }
  @media (prefers-reduced-motion: reduce), (pointer: coarse) {
    .page-hero__visual {
      transform: none;
    }
  }

  @media (max-width: 1023.98px) {
    .page-hero__visual--desktop {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .page-hero__grid--split {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: center;
    }
  }
</style>
