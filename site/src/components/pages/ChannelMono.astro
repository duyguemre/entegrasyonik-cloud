---
/**
 * ChannelMono — kanal (pazaryeri/entegrasyon) rozeti (S11; S23 biçimi). Sitede kanal rozetinin TEK bileşenidir
 * (kartlar, kapsam matrisi, kanal sayfaları, destek, üst menü ve çekmece). Logo YOK (marka izni açık soru,
 * ADR-0014 Açık Soru 3): yalnızca ilk harf.
 * S23 (FR2 madde 11/15): kenarlık marka renginin KOYUSU (`--chan-badge-border`), iç zemin AÇIĞI (`--chan-badge-bg`),
 * harf koyu marka tonu (`--chan-badge-fg`, zemine ≥ 4.5:1). Üçü de `[data-code]` eşlemesiyle `src/styles/global.css`
 * formülünden gelir (oranlar `site-tokens.css` `--channel-badge-*`); burada yeni renk tanımlanmaz, gradyan yok.
 * Bilinmeyen kanal nötr (`--channel-neutral` türevi). Anlam metinle taşınır (`aria-hidden`, yanında kanal adı görünür).
 */
interface Props {
  code: string
  name: string
  size?: 'xs' | 'sm' | 'md' | 'lg'
  class?: string
}

const { code, name, size = 'md', class: className } = Astro.props
---

<span class:list={['chan-mono', `chan-mono--${size}`, className]} data-code={code} aria-hidden="true">
  {name.slice(0, 1)}
</span>

<style>
  .chan-mono {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    border: calc(var(--site-border-width) * 1.5) solid var(--chan-badge-border);
    border-radius: var(--ek-radius-lg);
    background: var(--chan-badge-bg);
    box-shadow: var(--site-shadow-card);
    color: var(--chan-badge-fg);
    font-weight: var(--ek-font-weight-bold);
    line-height: 1;
  }
  .chan-mono--xs {
    width: var(--ek-space-6);
    height: var(--ek-space-6);
    border-width: var(--site-border-width);
    border-radius: var(--ek-radius-sm);
    box-shadow: none;
    font-size: var(--ek-font-size-xs);
  }
  .chan-mono--sm {
    width: var(--ek-space-8);
    height: var(--ek-space-8);
    font-size: var(--ek-font-size-md);
    border-radius: var(--ek-radius-md);
  }
  .chan-mono--md {
    width: var(--ek-space-10);
    height: var(--ek-space-10);
    font-size: var(--ek-font-size-lg);
  }
  .chan-mono--lg {
    width: calc(var(--ek-space-16) * 0.85);
    height: calc(var(--ek-space-16) * 0.85);
    border-width: calc(var(--site-border-width) * 2);
    font-size: var(--site-font-display-sm);
  }
</style>
