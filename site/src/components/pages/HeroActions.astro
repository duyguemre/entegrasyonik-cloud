---
/**
 * HeroActions — koyu iç sayfa hero'sundaki eylem bağlantıları (S17: S16 `/guvenlik` ve `/entegrasyonlar`
 * sayfalarındaki yerel `.hero-link` deseni ortak bileşene çekildi). İlki dolu (açık zemin), diğerleri cam
 * (ghost) görünümdedir; yalnızca renk/kenarlık geçişi (150–300 ms token'ları).
 */
interface Action {
  label: string
  href: string
  testid?: string
}

interface Props {
  actions: Action[]
}

const { actions } = Astro.props
---

<div class="hero-actions">
  {
    actions.map((a, i) => (
      <a class:list={['hero-action', { 'hero-action--ghost': i > 0 }]} href={a.href} data-testid={a.testid}>
        {a.label}
      </a>
    ))
  }
</div>

<style>
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-3);
  }
  .hero-action {
    display: inline-flex;
    align-items: center;
    min-height: var(--site-tap-target);
    padding-inline: var(--ek-space-5);
    border: var(--site-border-width) solid transparent;
    border-radius: var(--ek-radius-tile);
    background: var(--ek-color-surface);
    color: var(--ek-color-primary);
    font-weight: var(--ek-font-weight-semibold);
    text-decoration: none;
    transition:
      background-color var(--ek-duration-base) var(--ek-easing-standard),
      border-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .hero-action:hover {
    background: var(--site-action-subtle);
  }
  .hero-action--ghost {
    border-color: var(--site-glass-border);
    background: var(--site-glass-bg);
    color: var(--site-color-on-primary);
  }
  .hero-action--ghost:hover {
    border-color: var(--site-color-on-primary-muted);
    background: color-mix(in srgb, var(--ek-color-background) 12%, transparent);
  }
  .hero-action:focus-visible {
    outline-color: var(--site-color-on-primary);
  }
</style>
