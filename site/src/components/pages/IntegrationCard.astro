---
/**
 * IntegrationCard — `/entegrasyonlar` vitrin kartı. Yalnızca `PublicIntegration` (getPublic* çıktısı) alır:
 * destekleneni ve temel düzeyde olanı AYRI gruplarda dürüstçe gösterir; ayrıntı sayfasına bağlanır.
 * 2026-10-02 pazarlama düzeni: kanal rengiyle ince üst çizgi, büyük monogram, yetenekler çip olarak
 * (destekleniyor = onay işaretli dolu çip, temel düzeyde = çerçeveli çip). Degrade yok.
 */
import Badge from '../Badge.astro'
import Icon from '../home/Icon.astro'
import ChannelMono from './ChannelMono.astro'
import type { PublicIntegration, CoverageLevel } from '../../data/integrations'

interface Props {
  integration: PublicIntegration
}

const { integration: i } = Astro.props
const coverageTone: Record<CoverageLevel, 'success' | 'info' | 'warning'> = {
  broad: 'success',
  partial: 'info',
  limited: 'warning',
}
/** Görsel kapsam segmenti (aria-hidden); anlam yanındaki `coverageLabel` metnindedir. */
const COVERAGE_METER: Record<CoverageLevel, number> = { broad: 3, partial: 2, limited: 1 }
const supported = i.capabilities.filter((c) => c.level === 'supported').map((c) => c.label)
const limited = i.capabilities.filter((c) => c.level === 'limited').map((c) => c.label)
const titleId = `int-${i.code}`
---

<article class="int-card" aria-labelledby={titleId} data-testid="integration-card" data-code={i.code} data-kind={i.kind}>
  <div class="int-card__head">
    <ChannelMono code={i.code} name={i.name} size="lg" />
    <div class="int-card__id">
      <h3 id={titleId}>{i.name}</h3>
      <span class="int-card__kind">{i.kindLabel}</span>
    </div>
    <span class="int-card__status" data-testid="integration-status">
      <span class="int-card__status-dot" aria-hidden="true"></span>
      {i.statusLabel}
    </span>
  </div>
  <p class="int-card__summary">{i.summary}</p>
  <p class="int-card__coverage">
    <span class="int-card__meter" aria-hidden="true" data-level={COVERAGE_METER[i.coverage]}>
      <span></span><span></span><span></span>
    </span>
    <Badge tone={coverageTone[i.coverage]}>{i.coverageLabel}</Badge>
  </p>
  <dl class="int-card__caps">
    {
      supported.length > 0 && (
        <div>
          <dt>Destekleniyor</dt>
          <dd>
            <ul class="chips" role="list">
              {supported.map((label) => (
                <li class="chip chip--on">
                  <Icon name="check" size="sm" />
                  {label}
                </li>
              ))}
            </ul>
          </dd>
        </div>
      )
    }
    {
      limited.length > 0 && (
        <div>
          <dt>Temel düzeyde</dt>
          <dd>
            <ul class="chips" role="list">
              {limited.map((label) => (
                <li class="chip">{label}</li>
              ))}
            </ul>
          </dd>
        </div>
      )
    }
  </dl>
  <a class="link int-card__link int-card__foot" href={`/entegrasyonlar/${i.code}`}>
    {i.name} ayrıntıları
    <Icon name="arrow" size="sm" />
  </a>
</article>

<style>
  .int-card {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-5);
    height: 100%;
    padding: var(--ek-space-6) var(--ek-space-6) var(--ek-space-4);
    /* SITE-DL-03: düz kart — ince çerçeve; kalın renkli üst şerit ve gölge yok (kanal kimliği monogramda). */
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-card);
    background: var(--ek-color-surface);
    transition:
      border-color var(--ek-duration-base) var(--ek-easing-standard);
  }
  .int-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ek-space-4);
  }
  .int-card__id {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--ek-space-1);
    min-width: 0;
  }
  .int-card__id h3 {
    font-size: var(--ek-font-size-2xl);
    font-weight: var(--ek-font-weight-bold);
    letter-spacing: var(--site-font-display-tracking);
  }
  .int-card__kind {
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-medium);
  }
  .int-card__coverage {
    display: flex;
    align-items: center;
    gap: var(--ek-space-2);
  }
  .int-card__meter {
    display: inline-flex;
    gap: var(--ek-space-1);
  }
  .int-card__meter span {
    width: var(--ek-space-3);
    height: var(--ek-space-1);
    border-radius: var(--ek-radius-sm);
    background: var(--ek-color-border-default);
  }
  .int-card__meter[data-level='1'] span:nth-child(1),
  .int-card__meter[data-level='2'] span:nth-child(-n + 2),
  .int-card__meter[data-level='3'] span {
    background: var(--site-accent);
  }
  .int-card__summary {
    color: var(--site-text-body);
    font-size: var(--ek-font-size-lg);
    text-wrap: pretty;
  }
  .int-card__caps {
    display: flex;
    flex-direction: column;
    gap: var(--ek-space-4);
    margin: 0;
    padding-top: var(--ek-space-4);
    border-top: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .int-card__caps dt {
    margin-bottom: var(--ek-space-2);
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .int-card__caps dd {
    margin: 0;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ek-space-2);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-1);
    padding: var(--ek-space-1) var(--ek-space-2);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--ek-radius-md);
    background: var(--ek-color-surface);
    color: var(--site-text-body);
    font-size: var(--ek-font-size-sm);
    font-weight: var(--ek-font-weight-medium);
  }
  .chip--on {
    border-color: var(--site-action-border);
    background: var(--site-action-subtle);
    color: var(--site-action-emphasis);
  }
  .chip--on :global(svg) {
    color: var(--site-accent);
  }
  /* Tüm kart tıklanabilir: alt bağlantının örtüsü (tek sekme durağı, erişilebilir ad "X ayrıntıları") */
  .int-card {
    position: relative;
  }
  .int-card__foot::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }
  .int-card__foot:focus-visible {
    outline: none;
  }
  .int-card:has(.int-card__foot:focus-visible) {
    outline: var(--site-focus-ring-width) solid var(--site-color-focus-ring);
    outline-offset: var(--site-focus-ring-offset);
  }
  .int-card__status {
    display: inline-flex;
    flex: none;
    align-items: center;
    align-self: flex-start;
    gap: var(--ek-space-2);
    padding: var(--ek-space-1) var(--ek-space-2);
    border: var(--site-border-width) solid var(--site-action-border);
    border-radius: var(--ek-radius-md);
    background: var(--site-action-subtle);
    color: var(--site-action-emphasis);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    white-space: nowrap;
  }
  .int-card__status-dot {
    width: var(--ek-space-2);
    height: var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--site-accent);
  }
  .int-card__coverage {
    padding-block: var(--ek-space-3);
    border-block: var(--site-border-width) solid var(--ek-color-border-default);
  }
  .int-card__link {
    align-self: flex-start;
    margin-top: auto;
  }

  /* SITE-DL-03: hover = çerçeve tonu (gölge/yükselme yok). */
  .int-card:hover {
    border-color: var(--site-action-border);
  }
  .int-card:hover .int-card__link {
    color: var(--site-action-emphasis);
  }
</style>
