---
/**
 * NextLinks — "Sonraki adım" bağlantı kartları (S17). İç sayfaların sonunda ilgili sayfalara net geçiş:
 * ikon karosu + başlık + tek cümle + ok. Tüm kart tıklanabilir (tek <a>), odak halkası kartın kendisinde.
 */
import Icon from '../home/Icon.astro'

type IconName = 'plug' | 'shield' | 'card' | 'help' | 'mail' | 'book' | 'stock' | 'layers' | 'search' | 'orders'

interface Item {
  href: string
  icon: IconName
  title: string
  text: string
}

interface Props {
  links: Item[]
}

const { links } = Astro.props
---

<ul class="next-links" role="list">
  {
    links.map((l) => (
      <li>
        <a class="next-link" href={l.href}>
          <span class="next-link__icon" aria-hidden="true">
            <Icon name={l.icon} size="sm" />
          </span>
          <span class="next-link__body">
            <span class="next-link__title">{l.title}</span>
            <span class="next-link__text">{l.text}</span>
          </span>
          <span class="next-link__arrow" aria-hidden="true">
            <Icon name="arrow" size="sm" />
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .next-links {
    display: grid;
    gap: var(--ek-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .next-link {
    display: flex;
    align-items: flex-start;
    gap: var(--ek-space-4);
    height: 100%;
    padding: var(--ek-space-5) var(--ek-space-6);
    border: var(--site-border-width) solid var(--ek-color-border-default);
    border-radius: var(--site-radius-panel);
    background: var(--ek-color-surface);
    box-shadow: var(--site-shadow-card);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--ek-duration-base) var(--ek-easing-standard),
      box-shadow var(--ek-duration-base) var(--ek-easing-standard);
  }
  .next-link:hover {
    border-color: color-mix(in srgb, var(--ek-color-secondary) 40%, var(--ek-color-border-default));
    box-shadow: var(--site-shadow-card-hover);
  }
  .next-link__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--ek-space-10);
    height: var(--ek-space-10);
    border-radius: var(--ek-radius-lg);
    background: color-mix(in srgb, var(--ek-color-secondary) 14%, var(--ek-color-surface));
    color: var(--site-link-accent);
  }
  .next-link__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--ek-space-1);
    min-width: 0;
  }
  .next-link__title {
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-lg);
    font-weight: var(--ek-font-weight-bold);
  }
  .next-link__text {
    color: var(--site-text-meta);
    font-size: var(--ek-font-size-md);
    line-height: var(--site-font-body-line-height);
  }
  .next-link__arrow {
    display: inline-flex;
    align-self: center;
    color: var(--site-link-accent);
  }
  /* site-wdg W16: ok kayması global.css'teki tek kuraldan (a:hover .icon[data-icon='arrow']); yerel ikinci kayma kaldırıldı. */
  @media (min-width: 768px) {
    .next-links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
