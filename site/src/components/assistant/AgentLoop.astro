---
/**
 * AgentLoop (S22) — ajan döngüsü görsel akışı: Gözle → Öner → Onayla → Uygula → Raporla.
 *
 * Geniş ekranda yatay zaman çizelgesi (düğümler bir iz çizgisiyle bağlı), dar ekranda dikey zaman çizelgesi. Ortadaki
 * "Onayla" adımı insan adımıdır: farklı renk, kilit simgesi ve "İnsan onayı kapısı" etiketi. Her adımda kimin iş yaptığı
 * (Ajan / Siz) görünür metin olarak yazılır — renk tek başına anlam taşımaz.
 *
 * Hareket (scenes-loops.css, `agent-loop`): yalnızca geniş ekranda, iz çizgisi boyunca sakin bir ışık noktası akar ve
 * sırası gelen düğüm hafifçe parlar (opacity/translate/scale). Reduced-motion / "Hareket" kapalı / JS'siz: statik (ışık
 * noktası görünmez, düğümler dolu). Liste sırası anlamı taşır: `<ol>`.
 */
import Icon from '../home/Icon.astro'
import { loopSection as l } from '../../data/assistant'
---

<div class="loop" data-scene="agent-loop" data-testid="agent-loop">
  <div class="loop__track" aria-hidden="true">
    <span class="loop__trace" data-part="loop-trace"></span>
  </div>
  <ol class="loop__steps">
    {
      l.steps.map((s) => (
        <li class:list={['step', { 'step--you': s.actor === 'you' }]} data-testid="loop-step" data-actor={s.actor}>
          <span class="step__node" data-part="loop-node">
            <Icon name={s.actor === 'you' ? 'lock' : s.icon} size="md" />
          </span>
          <p class="step__actor">{s.actor === 'you' ? l.gateLabel : l.actorLabels[s.actor]}</p>
          <h3 class="step__title">
            {s.title}
            {s.actor === 'you' && <span class="step__who">{l.actorLabels.you}</span>}
          </h3>
          <p class="step__text">{s.text}</p>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .loop {
    --node: var(--ek-space-12);
    position: relative;
  }
  .loop__steps {
    position: relative;
    display: grid;
    gap: var(--ek-space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: var(--node) minmax(0, 1fr);
    column-gap: var(--ek-space-4);
    row-gap: var(--ek-space-1);
    align-content: start;
    min-width: 0;
  }
  .step__node {
    position: relative;
    z-index: 1;
    grid-row: 1 / span 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--node);
    height: var(--node);
    border: var(--site-border-width) solid var(--site-accent-line);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-surface);
    box-shadow:
      0 0 0 var(--ek-space-1) var(--ek-color-background),
      0 0 0 calc(var(--ek-space-1) + var(--site-border-width)) var(--site-accent-soft);
    color: var(--site-accent);
  }
  .step--you .step__node {
    border-color: transparent;
    background: linear-gradient(140deg, var(--ek-color-primary), var(--ek-color-primary-darken-1));
    box-shadow:
      0 0 0 var(--ek-space-1) var(--ek-color-background),
      0 0 0 calc(var(--ek-space-1) + var(--site-border-width)) color-mix(in srgb, var(--ek-color-amber) 70%, transparent),
      0 var(--ek-space-2) var(--ek-space-6) calc(var(--ek-space-2) * -1) color-mix(in srgb, var(--ek-color-primary) 60%, transparent);
    color: var(--site-color-on-primary);
  }
  .step__actor {
    /* küçük metin: AA için --site-accent (4,36:1) yerine koyu bağlantı vurgusu */
    color: var(--site-link-accent);
    font-size: var(--site-card-eyebrow-size);
    font-weight: var(--site-card-eyebrow-weight);
    letter-spacing: var(--site-card-eyebrow-tracking);
    text-transform: uppercase;
  }
  .step--you .step__actor {
    color: var(--ek-color-warning-emphasis);
  }
  .step__title {
    display: inline-flex;
    align-items: center;
    gap: var(--ek-space-2);
    color: var(--site-text-heading);
    font-size: var(--ek-font-size-xl);
    font-weight: var(--ek-font-weight-bold);
    letter-spacing: -0.01em;
  }
  .step__who {
    padding: 0 var(--ek-space-2);
    border-radius: var(--ek-radius-full);
    background: var(--ek-color-warning-subtle);
    color: var(--ek-color-content-strong);
    font-size: var(--ek-font-size-xs);
    font-weight: var(--ek-font-weight-semibold);
    letter-spacing: 0;
  }
  .step__text {
    color: var(--site-text-body);
    font-size: var(--ek-font-size-md);
    line-height: var(--site-font-body-line-height);
  }

  /* Dar ekran: dikey iz çizgisi düğümlerin ortasından geçer. */
  .loop__track {
    position: absolute;
    inset-block: calc(var(--node) / 2);
    inset-inline-start: calc(var(--node) / 2);
    width: var(--site-border-width);
    overflow: hidden;
    background: linear-gradient(180deg, var(--site-accent-line), color-mix(in srgb, var(--ek-color-amber) 55%, transparent), var(--site-accent-line));
  }
  .loop__trace {
    display: none;
  }

  /* Geniş ekran: yatay zaman çizelgesi, iz çizgisi düğümlerin hizasında; ışık noktası bu çizgide akar. */
  @media (min-width: 1024px) {
    .loop__steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--ek-space-6);
    }
    .step {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--ek-space-2);
    }
    .step__node {
      grid-row: auto;
      margin-bottom: var(--ek-space-3);
    }
    .loop__track {
      inset-block: auto;
      inset-block-start: calc(var(--node) / 2);
      /* son düğümün merkezine kadar: sütun genişliği (20% - 4/5 boşluk) - yarım düğüm */
      inset-inline: calc(var(--node) / 2) calc(20% - var(--ek-space-6) * 0.8 - var(--node) / 2);
      width: auto;
      height: var(--site-border-width);
      background: linear-gradient(90deg, var(--site-accent-line), color-mix(in srgb, var(--ek-color-amber) 55%, transparent), var(--site-accent-line));
    }
    .loop__trace {
      position: absolute;
      inset: 0;
      display: block;
      opacity: 0;
    }
    .loop__trace::after {
      content: '';
      position: absolute;
      inset-block-start: 50%;
      inset-inline-start: 0;
      width: var(--ek-space-16);
      height: calc(var(--site-border-width) * 3);
      translate: -100% -50%;
      border-radius: var(--ek-radius-full);
      background: linear-gradient(90deg, transparent, var(--ek-color-secondary));
    }
  }

  .step:nth-child(2) .step__node {
    --k: 1;
  }
  .step:nth-child(3) .step__node {
    --k: 2;
  }
  .step:nth-child(4) .step__node {
    --k: 3;
  }
  .step:nth-child(5) .step__node {
    --k: 4;
  }
</style>
